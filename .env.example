NODE_ENV=production
# Leave empty on cPanel / Passenger: the panel passes the port itself.
PORT=3000

# REQUIRED in production: a random string of at least 32 characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Password of the "admin" account created on the very first start (empty database).
# If left empty a random password is generated and printed once in the log.
ADMIN_PASSWORD=

# Sub-path the app is served under, e.g. /studio for https://studio.asvashop.com/studio
# Leave empty when the app owns the whole (sub)domain.
BASE_PATH=

# Where data and uploaded files are kept (relative to the app folder or absolute).
DATA_DIR=data
# json (default, works on any Node version) | sqlite (Node 22.5+) | firebase
STORAGE_DRIVER=json

# true when the site is served over HTTPS (cookies get the Secure flag).
FORCE_HTTPS=true
# Number of reverse proxies in front of the app (cPanel/nginx: 1).
TRUST_PROXY=1

# Extra origins allowed to send POST requests (comma separated), normally empty.
ALLOWED_ORIGINS=
# Only for embedding in the AI Studio preview iframe.
ALLOW_PREVIEW_FRAME=false

# Firebase driver / migration only (STORAGE_DRIVER=firebase or npm run migrate).
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# FIREBASE_PROJECT_ID=
# FIRESTORE_DATABASE_ID=

# Largest file (in MB) that can be uploaded with the resumable uploader (videos, raw footage).
# Files are sent in 4MB pieces, so the web server only has to accept 5MB per request.
MAX_UPLOAD_MB=2048
