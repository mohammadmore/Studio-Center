            });
            const customConfirm = document.getElementById('custom-confirm');
            if(customConfirm && customConfirm.style.display === 'flex') {
                 // cancel it
                 document.getElementById('custom-confirm-no').click();
            }
        }
    });
</script>

<script nonce="<%= nonce %>">
    if (!window.toPersianDigits) {
        window.toPersianDigits = function(str) {
            if (str === null || str === undefined) return "";
            const persianDigits = ["۰", "۱", "۲", "۳", "۴", "۵", "۶", "۷", "۸", "۹"];
            return str.toString().replace(/\d/g, x => persianDigits[x]);
        };
    }
    if (!window.toEnglishDigits) {
        window.toEnglishDigits = function(str) {
            if (!str) return str;
            return str.replace(/[۰-۹]/g, d => '۰۱۲۳۴۵۶۷۸۹'.indexOf(d));
        };
    }
</script>


<script nonce="<%= nonce %>">
(function() {
    function enforcePersianDigits(input) {
        if (!input || !window.toPersianDigits) return;
        const oldVal = input.value;
        if (!oldVal) return;
        const newVal = window.toPersianDigits(oldVal);
        if (oldVal !== newVal) {
            let start = input.selectionStart;
            let end = input.selectionEnd;
            input.value = newVal;
            try { input.setSelectionRange(start, end); } catch(err) {}
        }
    }
    
    // For manual typing
    document.addEventListener('input', function(e) {
        if (e.target.tagName === 'INPUT' && (
            e.target.getAttribute('inputmode') === 'numeric' ||
            e.target.hasAttribute('data-jdp') ||
            e.target.classList.contains('comp-count') ||
            e.target.classList.contains('comp-count-sched') ||
            e.target.classList.contains('edit-comp-count') ||
            e.target.classList.contains('item-count') ||
            e.target.classList.contains('item-day') ||
            e.target.type === 'tel'
        )) {
            enforcePersianDigits(e.target);
        }
    });

    // Replaced polling with event
document.addEventListener("jdp:change", function(e) { enforcePersianDigits(e.target); });
})();
</script>


