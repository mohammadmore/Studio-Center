<script nonce="<%= nonce %>">
    // Omnibar Logic
    let omnibarDebounceTimer = null;
    
    function openOmnibar() {
        const modal = document.getElementById('omnibarModal');
        const container = document.getElementById('omnibarContainer');
        const input = document.getElementById('omnibarInput');
        
        modal.style.display = 'flex';
        // force reflow
        void modal.offsetWidth;
        
        modal.style.opacity = '1';
        container.style.transform = 'translateY(0)';
        
        input.value = '';
        document.getElementById('omnibarResults').innerHTML = `
            <div style="padding: 30px; text-align: center; color: var(--text-gray);">
                <p>برای شروع جستجو تایپ کنید...</p>
            </div>
        `;
        input.focus();
    }
    
    function closeOmnibar() {
        const modal = document.getElementById('omnibarModal');
        const container = document.getElementById('omnibarContainer');
        
        modal.style.opacity = '0';
        container.style.transform = 'translateY(-20px)';
        
        setTimeout(() => {
            modal.style.display = 'none';
        }, 200);
    }
    
    document.addEventListener('keydown', function(e) {
        if ((e.ctrlKey || e.metaKey) && e.shiftKey && (e.key === 'f' || e.key === 'F')) {
            e.preventDefault();
            if (document.getElementById('omnibarModal').style.display === 'flex') {
                closeOmnibar();
            } else {
                openOmnibar();
            }
        }
        if (e.key === 'Escape' && document.getElementById('omnibarModal').style.display === 'flex') {
            closeOmnibar();
        }
    });

    // Close on click outside
    document.getElementById('omnibarModal').addEventListener('click', function(e) {
        if (e.target === this) {
            closeOmnibar();
        }
    });
    
    document.getElementById('omnibarInput').addEventListener('input', function(e) {
        const q = e.target.value.trim();
        const resultsDiv = document.getElementById('omnibarResults');
        
        if (q.length < 2) {
            resultsDiv.innerHTML = `<div style="padding: 30px; text-align: center; color: var(--text-gray);">برای شروع جستجو تایپ کنید... (حداقل ۲ حرف)</div>`;
            return;
        }
        
        resultsDiv.innerHTML = `<div style="padding: 30px; text-align: center; color: var(--text-gray);"><svg class="spinner" viewBox="0 0 50 50" style="width:30px;height:30px;animation:rotate 2s linear infinite;"><circle cx="25" cy="25" r="20" fill="none" stroke-width="5" stroke="var(--primary-color)" style="stroke-linecap:round;animation:dash 1.5s ease-in-out infinite;"></circle></svg><p style="margin-top:10px;">در حال جستجو...</p></div>`;
        
        clearTimeout(omnibarDebounceTimer);
        omnibarDebounceTimer = setTimeout(async () => {
            try {
                const res = await fetch(`/api/global_search?q=${encodeURIComponent(q)}`);
                const data = await res.json();
                
                if (data.status === 'success') {
                    renderOmnibarResults(data.results, q);
                } else {
                    resultsDiv.innerHTML = `<div style="padding: 20px; text-align: center; color: var(--error-color);">خطا در جستجو</div>`;
