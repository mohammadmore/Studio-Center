<script nonce="<%= nonce %>">
window.ASVA_CURRENT_USER = '<%= typeof user !== "undefined" && user ? user.username : "guest" %>';
// --- Global Keyboard Shortcuts ---
const defaultShortcuts = {
    save: { ctrl: true, alt: false, shift: false, key: 's' },
    search: { ctrl: true, alt: false, shift: false, key: 'k' },
    add: { ctrl: false, alt: true, shift: false, key: 'n' },
    help: { ctrl: false, alt: false, shift: true, key: '?' } // ? might not need shift in some layouts, but typically it is shift+/
};

function getShortcuts() {
    try {
        const stored = localStorage.getItem('asva_shortcuts_' + window.ASVA_CURRENT_USER);
        if (stored) return JSON.parse(stored);
    } catch(e) {}
    return defaultShortcuts;
}

function matchesShortcut(e, shortcutDef) {
    if (!shortcutDef) return false;
    
    // Check modifiers
    if (!!shortcutDef.ctrl !== (e.ctrlKey || e.metaKey)) return false;
    if (!!shortcutDef.alt !== e.altKey) return false;
    if (!!shortcutDef.shift !== e.shiftKey) return false;
    
    // Check key
    // For ?, the e.key is '?' and shift might be true.
    // If user configured it as something else, we compare lowercased.
    return e.key.toLowerCase() === shortcutDef.key.toLowerCase();
}

document.addEventListener('keydown', function(e) {
    // Exclude if typing in input/textarea (unless it's save or esc)
    const isTyping = ['INPUT', 'TEXTAREA', 'SELECT'].includes(e.target.tagName) || e.target.isContentEditable;
    const shortcuts = getShortcuts();
    
    // 1. Esc to close active things (always Esc)
    if (e.key === 'Escape') {
        let handled = false;
        if (typeof window.closeOmnibar === 'function' && document.getElementById('omnibarModal') && document.getElementById('omnibarModal').style.display === 'flex') {
            window.closeOmnibar();
            handled = true;
        }
        
        if (!handled) {
            const openModals = Array.from(document.querySelectorAll('.modal, .modal-overlay, .side-drawer-overlay, [id*="Modal"]'))
                .filter(el => window.getComputedStyle(el).display !== 'none');
            if (openModals.length > 0) {
                const topModal = openModals[openModals.length - 1];
                const closeBtn = topModal.querySelector('button[onclick*="close"], button.close-btn, button[onclick*="display=\'none\'"]');
                if (closeBtn) {
                    closeBtn.click();
                    handled = true;
                } else if (topModal.style.display === 'flex' || topModal.style.display === 'block') {
                    topModal.style.display = 'none';
                    handled = true;
                }
            }
        }
        if (handled) { e.preventDefault(); return; }
    }

    // 2. Save
    if (matchesShortcut(e, shortcuts.save)) {
        e.preventDefault(); 
        const openModals = Array.from(document.querySelectorAll('.modal, .modal-overlay, .side-drawer-overlay, [id*="Modal"]'))
            .filter(el => window.getComputedStyle(el).display !== 'none' && !el.id.includes('omnibar'));
        let container = document;
        if (openModals.length > 0) container = openModals[openModals.length - 1];
        
        if (container.classList.contains('side-drawer-overlay')) {
            const saveAllBtn = container.querySelector('button[onclick*="saveAllEditFields"]');
            if (saveAllBtn) { saveAllBtn.click(); return; }
        }
        
        const buttons = Array.from(container.querySelectorAll('button:not(:disabled)'));
        const saveBtn = buttons.find(b => 
            b.innerText.includes('ذخیره') || 
            b.innerText.includes('ثبت') || 
            b.innerText.includes('تایید') ||
            b.innerText.includes('به‌روزرسانی') ||
            b.innerText.includes('ارسال')
        );
        if (saveBtn) { saveBtn.click(); return; }
    }
    
    // 3. Search
    if (matchesShortcut(e, shortcuts.search) && !isTyping) {
        e.preventDefault();
        if (typeof window.toggleOmnibar === 'function') {
            window.toggleOmnibar();
        } else if (document.getElementById('omnibarModal')) {
            const ob = document.getElementById('omnibarModal');
            if (ob.style.display === 'flex') {
                ob.style.display = 'none';
            } else {
                ob.style.display = 'flex';
                const inp = document.getElementById('omnibarInput');
                if (inp) inp.focus();
            }
        }
    }
    
    // 4. Add New
    if (matchesShortcut(e, shortcuts.add) && !isTyping) {
        e.preventDefault();
        const buttons = Array.from(document.querySelectorAll('button:not(:disabled)'));
        const addBtn = buttons.find(b => b.innerText.includes('افزودن'));
        if (addBtn) addBtn.click();
    }
    
    // 5. Help / Shortcuts
    if (matchesShortcut(e, shortcuts.help) && !isTyping) {
        e.preventDefault();
        window.showShortcutsModal();
    }
});

function formatShortcut(shortcut) {
    if (!shortcut) return '';
    let parts = [];
    if (shortcut.ctrl) parts.push('Ctrl');
    if (shortcut.alt) parts.push('Alt');
    if (shortcut.shift) parts.push('Shift');
    parts.push(shortcut.key.toUpperCase());
    return parts.map(p => `<kbd style="background: rgba(128,128,128,0.1); padding: 4px 8px; border-radius: 4px; font-family: monospace; border: 1px solid var(--border-color); color: var(--text-color);">${p}</kbd>`).join(' + ');
}

window.showShortcutsModal = function() {
    let existing = document.getElementById('shortcutsModal');
    if (existing) {
        existing.style.display = 'flex';
        renderShortcutsEditor();
        return;
    }
    
    const div = document.createElement('div');
    div.id = 'shortcutsModal';
    div.className = 'modal-overlay';
    div.style.display = 'flex';
    div.style.position = 'fixed';
    div.style.top = '0';
    div.style.left = '0';
    div.style.right = '0';
    div.style.bottom = '0';
    div.style.background = 'rgba(15, 23, 42, 0.7)';
    div.style.backdropFilter = 'blur(5px)';
    div.style.justifyContent = 'center';
    div.style.alignItems = 'center';
    div.style.zIndex = '3000';
    div.onclick = function(e) { if(e.target === div) div.style.display = 'none'; };
    
    div.innerHTML = `
        <div style="background: var(--card-bg); width: 90%; width: 100%; max-width: 500px; box-sizing: border-box; padding: 30px; border-radius: 15px; box-shadow: 0 10px 30px rgba(0,0,0,0.2);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; position: relative;">
                <div style="flex: 1;"></div>
                <h2 style="margin: 0; color: var(--text-color); display: flex; align-items: center; justify-content: center; gap: 8px; flex: 3; text-align: center;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 8h.01"/><path d="M12 12h.01"/><path d="M14 8h.01"/><path d="M16 12h.01"/><path d="M18 8h.01"/><path d="M6 8h.01"/><path d="M7 16h10"/><path d="M8 12h.01"/><rect width="20" height="16" x="2" y="4" rx="2"/></svg>
                    راهنمای کلید‌های میانبر
                </h2>
                <div style="flex: 1; display: flex; justify-content: flex-end;">
                    <button onclick="document.getElementById('shortcutsModal').style.display='none'" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: var(--text-gray);">&times;</button>
                </div>
            </div>
            
            <div id="shortcutsEditorContainer" style="display: flex; flex-direction: column; gap: 15px;">
                <!-- Populated by JS -->
            </div>
            
            <div style="margin-top: 25px; display: flex; gap: 10px;">
                <button onclick="resetShortcuts()" class="btn-outline" style="flex: 1; padding: 12px; font-size: 0.95rem; border-radius: 8px;">بازنشانی پیشفرض</button>
                <button onclick="document.getElementById('shortcutsModal').style.display='none'" class="btn-primary" style="flex: 2; padding: 12px; font-size: 1rem; border-radius: 8px;">متوجه شدم</button>
            </div>
        </div>
    `;
    document.body.appendChild(div);
    renderShortcutsEditor();
};

window.renderShortcutsEditor = function() {
    const container = document.getElementById('shortcutsEditorContainer');
    if (!container) return;
    
    const shortcuts = getShortcuts();
    
    const items = [
        { id: 'save', label: 'ذخیره کردن فرم‌ها (Save)', icon: '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>' },
        { id: 'search', label: 'جستجوی سریع (Omnibar)', icon: '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>' },
        { id: 'add', label: 'افزودن آیتم جدید', icon: '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>' },
        { id: 'help', label: 'نمایش این راهنما', icon: '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>' }
    ];
    
    let html = '';
    items.forEach(item => {
        const sc = shortcuts[item.id];
        html += `
            <div style="display: flex; justify-content: space-between; align-items: center; padding-bottom: 10px; border-bottom: 1px solid var(--border-color);">
                <span style="color: var(--text-gray); display: flex; align-items: center; gap: 8px;">
                    ${item.icon}
                    ${item.label}
                </span>
                <div style="display: flex; gap: 5px; align-items: center;">
                    <div id="shortcut-display-${item.id}" style="display: flex; gap: 5px;">
                        ${formatShortcut(sc)}
                    </div>
                    <button onclick="startEditingShortcut('${item.id}')" style="background: none; border: none; cursor: pointer; color: var(--primary-color); padding: 4px; margin-right: 5px;" title="ویرایش">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
                    </button>
                </div>
            </div>
        `;
    });
    
    // Add Esc which is fixed
    html += `
        <div style="display: flex; justify-content: space-between; align-items: center; padding-bottom: 10px;">
            <span style="color: var(--text-gray); display: flex; align-items: center; gap: 8px;">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                بستن فرم / لغو (Cancel)
            </span>
            <div style="display: flex; gap: 5px; align-items: center;">
                <div style="display: flex; gap: 5px;">
                    <kbd style="background: rgba(128,128,128,0.1); padding: 4px 8px; border-radius: 4px; font-family: monospace; border: 1px solid var(--border-color); color: var(--text-color);">ESC</kbd>
                </div>
                <div style="width: 22px;"></div> <!-- placeholder for align -->
            </div>
        </div>
    `;
    
    container.innerHTML = html;
};

let currentEditingId = null;

window.startEditingShortcut = function(id) {
    currentEditingId = id;
    const displayDiv = document.getElementById('shortcut-display-' + id);
    if (!displayDiv) return;
    
    displayDiv.innerHTML = `<span style="color: var(--primary-color); font-size: 0.85rem; padding: 4px 8px; background: rgba(2, 132, 199, 0.1); border-radius: 4px;">لطفا کلید‌های جدید را فشار دهید...</span>`;
    
    // Add one-time listener
    document.addEventListener('keydown', handleShortcutRecord);
};

window.handleShortcutRecord = function(e) {
    e.preventDefault();
    e.stopPropagation();
    
    // Ignore if it's just a modifier key
    if (['Control', 'Shift', 'Alt', 'Meta'].includes(e.key)) {
        return; 
    }
    
    const newShortcut = {
        ctrl: e.ctrlKey || e.metaKey,
        alt: e.altKey,
        shift: e.shiftKey,
        key: e.key === ' ' ? 'Space' : e.key
    };
    
    const shortcuts = getShortcuts();
    shortcuts[currentEditingId] = newShortcut;
    localStorage.setItem('asva_shortcuts_' + window.ASVA_CURRENT_USER, JSON.stringify(shortcuts));
    
    // Remove listener
    document.removeEventListener('keydown', handleShortcutRecord);
    currentEditingId = null;
    
    renderShortcutsEditor();
    
    // small toast
    if (window.showToast) window.showToast('کلید میانبر با موفقیت تغییر کرد.', 'success');
};

window.resetShortcuts = async function() {
    if (typeof window.customConfirm === 'function') {
        if (!(await window.customConfirm('آیا از بازنشانی کلید‌های میانبر به حالت پیشفرض اطمینان دارید؟'))) return;
    } else {
        if (!confirm('آیا از بازنشانی کلید‌های میانبر به حالت پیشفرض اطمینان دارید؟')) return;
    }
    localStorage.removeItem('asva_shortcuts_' + window.ASVA_CURRENT_USER);
    renderShortcutsEditor();
    if (window.showToast) window.showToast('کلید‌های میانبر به حالت پیشفرض بازگشتند.', 'success');
};
</script>



