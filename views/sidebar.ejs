<script nonce="<%= nonce %>">
    window.toPersianDigits = function(num) {
        if (num === null || num === undefined) return '';
        const persianDigits = ['۰', '۱', '۲', '۳', '۴', '۵', '۶', '۷', '۸', '۹'];
        return num.toString().replace(/\d/g, x => persianDigits[x]);
    };
    
    // Auto-convert standard numbers in DOM to Persian digits where applicable, could be done globally but we'll manually call it.

    var notifLoaded = false;
    async function fetchNotifications() {
        try {
            const res = await fetch('/api/get_notifications');
            const data = await res.json();
            if (data.status === 'success') {
                const badge = document.getElementById('notif-badge');
                if (data.unread_count > 0) {
                    badge.innerText = window.toPersianDigits ? window.toPersianDigits(data.unread_count) : data.unread_count;
                    badge.style.display = 'block';
                } else {
                    badge.style.display = 'none';
                }
                
                const list = document.getElementById('notif-list');
                list.innerHTML = '';
                if (data.notifications.length === 0) {
                    list.innerHTML = '<div style="padding: 20px; text-align: center; color: var(--text-gray); font-size: 0.9rem;">پیام جدیدی ندارید.</div>';
                } else {
                    (data.notifications || []).forEach(n => {
                        const bg = n.status === 'unread' ? 'rgba(59, 130, 246, 0.1)' : 'transparent';
                        let actionBtns = '';
                        if (n.type === 'calendar_approved') {
                            actionBtns = `<a href="calendar" style="display: inline-block; margin-top: 8px; padding: 4px 8px; font-size: 0.75rem;  color: white; border-radius: 4px; ">مشاهده تقویم</a>`;
                        } else if (n.type === 'content_reviewed' || n.type === 'content_assigned') {
                            let link = '/depot';
                            if (n.target_id) link += `?open=${n.target_id}`;
                            actionBtns = `<a href="${link}" style="display: inline-block; margin-top: 8px; padding: 4px 8px; font-size: 0.75rem;  color: white; border-radius: 4px; ">مشاهده محتوا در دپو</a>`;
                        } else if (n.link) {
                            actionBtns = `<a href="${n.link}" style="display: inline-block; margin-top: 8px; padding: 4px 8px; font-size: 0.75rem; background: var(--border-color); color: var(--text-gray); border-radius: 4px; ">مشاهده</a>`;
                        }

                        list.innerHTML += `
                            <div style="display: block; padding: 15px; border-bottom: 1px solid var(--border-color); background: ${bg}; transition: 0.2s;" onmouseover="this.style.background='rgba(128, 128, 128, 0.05)'" onmouseout="this.style.background='${bg}'">
                                <div style="font-weight: bold; color: var(--text-gray); font-size: 0.9rem; margin-bottom: 4px;">${window.toPersianDigits ? window.toPersianDigits(n.title) : n.title}</div>
                                <div style="color: var(--text-gray); font-size: 0.8rem; line-height: 1.5;">${window.toPersianDigits ? window.toPersianDigits(n.description) : n.description}</div>
                                ${actionBtns}
                                <div style="color: var(--text-gray); font-size: 0.75rem; margin-top: 6px;">${window.toPersianDigits ? window.toPersianDigits(n.created_at) : n.created_at}</div>
                            </div>
                        `;
                    });
                }
            }
        } catch(e) { console.error(e); }
    }
    
    function toggleNotifications(e) {
        if(e) e.stopPropagation();
        const drop = document.getElementById('notif-dropdown');
        const bellIcon = document.getElementById('sidebar-bell-icon');
        if (drop.style.display === 'none') {
            
            // Adjust position for mobile
            if (window.innerWidth <= 768) {
                drop.style.right = '20px';
                drop.style.left = '20px';
                drop.style.width = 'auto';
            } else {
                const isSidebarOpen = document.body.classList.contains('asva-sidebar-open');
                if (isSidebarOpen) {
                    drop.style.right = '325px';
                } else {
                    drop.style.right = '65px';
                }
                drop.style.width = '320px';
            }
            
            drop.style.display = 'block';
            if (bellIcon) bellIcon.classList.add('active');
            if (!notifLoaded) { fetchNotifications(); notifLoaded = true; }
        } else {
            drop.style.display = 'none';
            if (bellIcon) bellIcon.classList.remove('active');
        }
    }
    
    async function markAllRead() {
        try {
            const res = await fetch('/api/read_notifications', { method: 'POST' });
            if ((await res.json()).status === 'success') {
                fetchNotifications();
            }
        } catch(e) { console.error(e); }
    }
    
    fetchNotifications();
    
    document.addEventListener('click', function(e) {
        const drop = document.getElementById('notif-dropdown');
        if (drop && drop.style.display === 'block' && !e.target.closest('#notif-dropdown') && !e.target.closest('#sidebar-bell-icon')) {
            drop.style.display = 'none';
            const bellIcon = document.getElementById('sidebar-bell-icon');
            if (bellIcon) bellIcon.classList.remove('active');
        }
    });

    function toggleAsvaSidebar() {
        document.body.classList.toggle('asva-sidebar-open');
        const btn = document.getElementById('asva-sidebar-toggle-btn');
        if (document.body.classList.contains('asva-sidebar-open')) {
            btn.innerHTML = `<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align: middle;'><path d='M18 6 6 18'/><path d='m6 6 12 12'/></svg>`;
            btn.style.transform = 'rotate(90deg)';
        } else {
            btn.innerHTML = `<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align: middle;'><line x1='4' x2='20' y1='12' y2='12'/><line x1='4' x2='20' y1='6' y2='6'/><line x1='4' x2='20' y1='18' y2='18'/></svg>`;
            btn.style.transform = 'rotate(0deg)';
        }
    }

    function toggleMenu(id, element) {
        const menu = document.getElementById(id);
        if (menu) {
            const isClosing = menu.classList.contains('open');
            
            if (!isClosing) {
                document.querySelectorAll('.asva-submenu.open').forEach(openMenu => {
                    if (openMenu.id !== id) {
                        openMenu.style.maxHeight = openMenu.scrollHeight + 'px';
                        void openMenu.offsetHeight; // reflow
                        openMenu.classList.remove('open');
                        openMenu.style.maxHeight = '0px';
                        
                        const toggleDiv = openMenu.previousElementSibling;
                        if (toggleDiv) {
                            const openArrow = toggleDiv.querySelector('.asva-arrow.open');
                            if (openArrow) {
                                openArrow.classList.remove('open');
                            }
                        }
                    }
                });
            }

            if (isClosing) {
                menu.style.maxHeight = menu.scrollHeight + 'px';
                void menu.offsetHeight; // reflow
                menu.classList.remove('open');
                menu.style.maxHeight = '0px';
            } else {
                menu.classList.add('open');
                menu.style.maxHeight = menu.scrollHeight + 'px';
                setTimeout(() => {
                    if (menu.classList.contains('open')) {
                        menu.style.maxHeight = '1000px';
                    }
                }, 400);
            }
            if (element) {
                const arrow = element.querySelector('.asva-arrow');
                if (arrow) {
                    if (isClosing) {
                        arrow.classList.remove('open');
                    } else {
                        arrow.classList.add('open');
                    }
                }
            }
        }
    }

    if (window.innerWidth > 768) {
        document.body.classList.add('asva-sidebar-open');
        const btn = document.getElementById('asva-sidebar-toggle-btn');
        if (btn) {
            btn.innerHTML = `<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align: middle;'><path d='M18 6 6 18'/><path d='m6 6 12 12'/></svg>`;
            btn.style.transform = 'rotate(90deg)';
        }
    }
</script>

<div id="custom-confirm" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(8px); z-index: 2147483647 !important; align-items:center; justify-content:center; flex-direction:column;">
    <div style="background: var(--card-bg); padding:20px; border-radius:12px; width: 100%; max-width: 400px; box-sizing: border-box; text-align:center; box-shadow: 0 20px 40px -5px rgba(0,0,0,0.15);">
