    <script>
    var notifLoaded = false;
    async function fetchNotifications() {
        try {
            const res = await fetch('/api/get_notifications');
            const data = await res.json();
            if (data.status === 'success') {
                const badge = document.getElementById('notif-badge');
                if (data.unread_count > 0) {
                    badge.innerText = window.toPersianDigits ? window.toPersianDigits(data.unread_count) : data.unread_count;
                    badge.style.display = 'block';
                } else {
                    badge.style.display = 'none';
                }
                
                const list = document.getElementById('notif-list');
                list.innerHTML = '';
                if (data.notifications.length === 0) {
                    list.innerHTML = '<div style="padding: 20px; text-align: center; color: var(--text-gray); font-size: 0.9rem;">پیام جدیدی ندارید.</div>';
                } else {
                    (data.notifications || []).forEach(n => {
                        const bg = n.status === 'unread' ? 'rgba(59, 130, 246, 0.1)' : 'transparent';
                        let actionBtns = '';
                        if (n.type === 'calendar_approved') {
                            actionBtns = `<a href="client-events" style="display: inline-block; margin-top: 8px; padding: 4px 8px; font-size: 0.75rem;  color: white; border-radius: 4px; text-decoration: none;">مشاهده تقویم</a>`;
                        } else if (n.type === 'content_reviewed' || n.type === 'content_assigned') {
                            let link = '/client-review';
                            if (n.target_id) link += `?open=${n.target_id}`;
                            actionBtns = `<a href="${link}" style="display: inline-block; margin-top: 8px; padding: 4px 8px; font-size: 0.75rem;  color: white; border-radius: 4px; text-decoration: none;">بازبینی محتوا</a>`;
                        } else if (n.link) {
                            actionBtns = `<a href="${n.link}" style="display: inline-block; margin-top: 8px; padding: 4px 8px; font-size: 0.75rem; background: var(--border-color); color: var(--text-gray); border-radius: 4px; text-decoration: none;">مشاهده</a>`;
                        }

                        list.innerHTML += `
                            <div style="display: block; padding: 15px; border-bottom: 1px solid var(--border-color); background: ${bg}; transition: 0.2s;" onmouseover="this.style.background='rgba(128, 128, 128, 0.05)'" onmouseout="this.style.background='${bg}'">
                                <div style="font-weight: bold; color: var(--text-gray); font-size: 0.9rem; margin-bottom: 4px;">${window.toPersianDigits ? window.toPersianDigits(n.title) : n.title}</div>
                                <div style="color: var(--text-gray); font-size: 0.8rem; line-height: 1.5;">${window.toPersianDigits ? window.toPersianDigits(n.description) : n.description}</div>
                                ${actionBtns}
                                <div style="color: var(--text-gray); font-size: 0.75rem; margin-top: 6px;">${window.toPersianDigits ? window.toPersianDigits(n.created_at) : n.created_at}</div>
                            </div>
                        `;
                    });
                }
            }
        } catch(e) { console.error(e); }
    }
    
    function toggleNotifications(e) {
        if (e) e.stopPropagation();
        const drop = document.getElementById('notif-dropdown');
        const bellIcon = document.getElementById('client-bell-icon');
        if (drop.style.display === 'none') {
            drop.style.display = 'block';
            if (bellIcon) bellIcon.classList.add('active');
            if (!notifLoaded) { fetchNotifications(); notifLoaded = true; }
        } else {
            drop.style.display = 'none';
            if (bellIcon) bellIcon.classList.remove('active');
        }
    }
    
    async function markAllRead() {
        try {
            const res = await fetch('/api/read_notifications', { method: 'POST' });
            if ((await res.json()).status === 'success') {
                fetchNotifications();
            }
        } catch(e) { console.error(e); }
    }

    document.addEventListener('click', function(e) {
        const drop = document.getElementById('notif-dropdown');
        if (drop && drop.style.display === 'block' && !e.target.closest('#notif-dropdown') && !e.target.closest('#client-bell-icon')) {
            drop.style.display = 'none';
            const bellIcon = document.getElementById('client-bell-icon');
            if (bellIcon) bellIcon.classList.remove('active');
        }
    });

        setTimeout( async () => {
    fetchNotifications();
    <% if (user && user.role_id !== 'client') { %>
        const reportsLink = document.querySelector('a[href="reports"]');
        if (reportsLink) reportsLink.href = 'reports?org_id=<%= orgId %>';
    <% } %>
});
    </script>

