        <p style="color: var(--text-gray); opacity: 0.8; margin-bottom: 25px; line-height: 1.6;">آیا از خروج از حساب کاربری خود اطمینان دارید؟</p>
        <div style="display: flex; gap: 15px;">
            <button onclick="window.location.href='/api/logout'" class="btn-primary" style="flex: 1; background: var(--error-color); border-color: var(--error-color);">بله، خارج می‌شوم</button>
            <button onclick="document.getElementById('clientLogoutModal').style.display='none'" class="btn-outline" style="flex: 1;">انصراف</button>
        </div>
    </div>
</div>

</body>
</html>
