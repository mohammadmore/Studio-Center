<script>
    if (!window.toPersianDigits) {
        window.toPersianDigits = function(str) {
            if (str === null || str === undefined) return "";
            const persianDigits = ["۰", "۱", "۲", "۳", "۴", "۵", "۶", "۷", "۸", "۹"];
            return str.toString().replace(/\d/g, x => persianDigits[x]);
        };
    }
    if (!window.toEnglishDigits) {
        window.toEnglishDigits = function(str) {
            if (!str) return str;
            return str.replace(/[۰-۹]/g, d => '۰۱۲۳۴۵۶۷۸۹'.indexOf(d));
        };
    }
</script>


<script>
    // بستن مودال با کلیک در پس‌زمینه
    document.addEventListener('click', function(e) {
        if (e.target.classList.contains('modal-overlay') || e.target.classList.contains('modal')) {
            e.target.style.display = 'none';
        }
    });

    // بستن مودال با زدن کلید Esc
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            document.querySelectorAll('.modal-overlay, .modal').forEach(modal => {
                if (modal.style.display === 'flex' || modal.style.display === 'block') {
                    modal.style.display = 'none';
                }
            });
            const customConfirm = document.getElementById('custom-confirm');
            if(customConfirm && customConfirm.style.display === 'flex') {
                 // cancel it
                 document.getElementById('custom-confirm-no').click();
            }
        }
    });
</script>

