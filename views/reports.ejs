            <button class="btn-primary" onclick="exportExcel()" id="excelBtn" style="display: none; background: var(--warning-color); align-items: center; gap: 6px;" title="خروجی اکسل (مناسب برای تحلیل)"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-file-spreadsheet" style="vertical-align:middle;"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path><path d="M14 2v4a1 1 0 0 0 1 1h4"></path><path d="M8 13h8"></path><path d="M8 17h8"></path></svg> <span>خروجی اکسل</span></button>
