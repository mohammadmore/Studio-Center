        <div id="loadingState" style="text-align: center; padding: 50px; color: var(--text-gray); display: none;">
            <svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align: middle; margin-left: 4px;'><path d='M5 22h14'/><path d='M5 2h14'/><path d='M17 22v-4.172a2 2 0 0 0-.586-1.414L12 12l-4.414 4.414A2 2 0 0 0 7 17.828V22'/><path d='M7 2v4.172a2 2 0 0 0 .586 1.414L12 12l4.414-4.414A2 2 0 0 0 17 6.172V2'/></svg> در حال بارگذاری اطلاعات...
        </div>
        <div id="emptyState" style="text-align: center; padding: 50px; color: var(--text-gray);">
            <% if (user.role_id === 'client') { %>در حال بارگذاری گزارش...<% } else { %>لطفاً یک سازمان را برای مشاهده گزارش انتخاب کنید.<% } %>
        </div>
    </main>

    <script>
        let typeChartInst = null;
        let statusChartInst = null;
        let platformChartInst = null;
        
        // Convert to Persian digits
        function toPersianDigits(num) {
            const farsiDigits = ['۰', '۱', '۲', '۳', '۴', '۵', '۶', '۷', '۸', '۹'];
            return num.toString().replace(/\d/g, x => farsiDigits[x]);
        }

        const isClient = <%= user.role_id === 'client' ? 'true' : 'false' %>;
        
        document.addEventListener('DOMContentLoaded', () => {
            loadPlatforms();
            if (typeof jalaliDatepicker !== 'undefined') {
                jalaliDatepicker.startWatch({ persianDigits: true, time: false, hideAfterChange: true, autoHide: true, showTodayBtn: true, showEmptyBtn: true });
            }
        });

        
    let checkChartInterval = setInterval(async function() {
        if (typeof Chart !== 'undefined') {
            clearInterval(checkChartInterval);
            const urlParams = new URLSearchParams(window.location.search);
            const queryOrgId = urlParams.get('org_id');

            if (!isClient) {
                // Load organizations for dropdown
                try {
                    const res = await fetch('/api/get_orgs', { cache: 'no-store' });
                    const data = await res.json();
                    if (data.status === 'success') {
                        const sel = document.getElementById('orgSelect');
                        data.data.forEach(o => {
                            sel.innerHTML += `<option value="${o.id}">${o.org_name}</option>`;
                        });
                        if (queryOrgId) {
                            sel.value = queryOrgId;
                            loadReport();
                        }
                    }
                } catch(e) { console.error(e); }
            } else {
                // Auto load for client
                onOrgChange();
            }
        }
    }, 50);


        function toggleTimeInputs() {
            const noTime = document.getElementById('noTimeLimit').checked;
            const startDate = document.getElementById('startDate');
            const endDate = document.getElementById('endDate');
            
            startDate.disabled = noTime;
            endDate.disabled = noTime;
            
            if (noTime) {
                startDate.value = "";
                endDate.value = "";
                startDate.placeholder = "--/--/----";
                endDate.placeholder = "--/--/----";
                startDate.style.backgroundColor = "rgba(128, 128, 128, 0.1)";
                endDate.style.backgroundColor = "rgba(128, 128, 128, 0.1)";
            } else {
                startDate.placeholder = "از تاریخ";
                endDate.placeholder = "تا تاریخ";
                startDate.style.backgroundColor = "";
                endDate.style.backgroundColor = "";
            }
        }

        
        async function loadPlatforms() {
            try {
                const res = await fetch('/api/manage_settings');
                const data = await res.json();
                if (data.status === 'success' && data.data && data.data.platform) {
                    const pSelect = document.getElementById('platformSelect');
                    data.data.platform.forEach(p => {
                        pSelect.innerHTML += `<option value="${p.setting_key}">${p.setting_key}</option>`;
                    });
                }
            } catch(e) { console.error(e); }
        }

        async function onOrgChange() {
            const orgId = document.getElementById('orgSelect').value;
            const colSelect = document.getElementById('colSelect');
            colSelect.innerHTML = '<option value="">همه مجموعه‌ها</option>';
            if (orgId) {
                try {
                    const res = await fetch(`/api/get_collections?org_id=${orgId}`);
                    const data = await res.json();
                    if (data.status === 'success' && data.data) {
                        data.data.forEach(c => {
                            colSelect.innerHTML += `<option value="${c.id}">${c.title}</option>`;
                        });
                    }
                } catch(e) { console.error(e); }
            }
            loadReport();
        }

        async function loadReport() {
            let orgId = document.getElementById('orgSelect') ? document.getElementById('orgSelect').value : '';
            if (!orgId && !isClient) {
                document.getElementById('reportContainer').style.display = 'none';
                document.getElementById('pdfBtn').style.display = 'none';
                document.getElementById('emptyState').style.display = 'block';
                return;
            }
            
            document.getElementById('emptyState').style.display = 'none';
            document.getElementById('reportContainer').style.display = 'none';
            document.getElementById('loadingState').style.display = 'block';
            
            try {
                const toEnglishDigits = str => str.replace(/[۰-۹]/g, d => '۰۱۲۳۴۵۶۷۸۹'.indexOf(d));
                let startDate = toEnglishDigits(document.getElementById('startDate').value);
                let endDate = toEnglishDigits(document.getElementById('endDate').value);
                if (startDate && endDate && startDate > endDate) {
                    const temp = startDate;
                    startDate = endDate;
                    endDate = temp;
                    document.getElementById('startDate').value = window.toPersianDigits(startDate);
                    document.getElementById('endDate').value = window.toPersianDigits(endDate);
                }
                let url = `/api/get_org_report?org_id=${orgId}`;
                
                const colId = document.getElementById('colSelect') ? document.getElementById('colSelect').value : '';
                const statusF = document.getElementById('statusSelect') ? document.getElementById('statusSelect').value : '';
                const platformF = document.getElementById('platformSelect') ? document.getElementById('platformSelect').value : '';
                const noTime = document.getElementById('noTimeLimit') ? document.getElementById('noTimeLimit').checked : false;

                if (colId) url += `&col_id=${colId}`;
                if (statusF) url += `&status=${statusF}`;
                if (platformF) url += `&platform=${platformF}`;
                if (noTime) url += `&no_time_limit=true`;

                if (!noTime) {
                    if (startDate) url += `&start_date=${startDate}`;
                    if (endDate) url += `&end_date=${endDate}`;
                }
                
                                // Fetch studio info for PDF Header
                fetch('/api/get_studio_info').then(r => r.json()).then(result => {
                    if (result.status === 'success' && result.data) {
                        if (result.data.name) document.getElementById('pdfStudioName').innerText = result.data.name;
                        
                        const hasLight = !!result.data.logo_light || !!result.data.logo;
                        const hasDark = !!result.data.logo_dark || !!result.data.logo;
                        
                        if (hasLight) {
                            const logoL = document.getElementById('pdfStudioLogoLight');
                            logoL.src = result.data.logo_light || result.data.logo;
                            logoL.dataset.hasImage = "true";
                        }
                        if (hasDark) {
                            const logoD = document.getElementById('pdfStudioLogoDark');
                            logoD.src = result.data.logo_dark || result.data.logo_light || result.data.logo;
                            logoD.dataset.hasImage = "true";
                        }
                        
                        window.updateReportsLogoDisplay = function() {
                            const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
                            const logoL = document.getElementById('pdfStudioLogoLight');
                            const logoD = document.getElementById('pdfStudioLogoDark');
                            if (logoL && logoL.dataset.hasImage === "true") logoL.style.display = isDark ? 'none' : 'block';
                            if (logoD && logoD.dataset.hasImage === "true") logoD.style.display = isDark ? 'block' : 'none';
                        };
                        window.updateReportsLogoDisplay();
                        
                        // observer for theme changes
                        const observer = new MutationObserver((mutations) => {
                            mutations.forEach((mutation) => {
                                if (mutation.attributeName === 'data-theme') {
                                    window.updateReportsLogoDisplay();
                                }
                            });
                        });
                        observer.observe(document.documentElement, { attributes: true });

                        if (result.data.address) document.getElementById('pdfStudioAddress').innerText = result.data.address;
                        let contact = [];
                        if (result.data.phone) contact.push(result.data.phone);
                        if (result.data.website) contact.push(result.data.website);
                        if (contact.length > 0) document.getElementById('pdfStudioContact').innerText = contact.join(' | ');
                    }
                }).catch(e => console.error(e));

                const res = await fetch(url);
                const data = await res.json();
                
                document.getElementById('loadingState').style.display = 'none';
                
                if (data.status === 'success') {
                    renderReport(data);
                    document.getElementById('reportContainer').style.display = 'block';
                    document.getElementById('pdfBtn').style.display = 'block';
                } else {
                    showToast('خطا در دریافت اطلاعات', 'error');
                }
            } catch(e) {
                console.error(e);
                document.getElementById('loadingState').style.display = 'none';
                showToast('خطا در ارتباط با سرور', 'error');
            }
        }

        function getFormattedPersianDate(dateObj = new Date()) {
            const weekdays = ['یکشنبه', 'دوشنبه', 'سه‌شنبه', 'چهارشنبه', 'پنج‌شنبه', 'جمعه', 'شنبه'];
            const months = ['فروردین', 'اردیبهشت', 'خرداد', 'تیر', 'مرداد', 'شهریور', 'مهر', 'آبان', 'آذر', 'دی', 'بهمن', 'اسفند'];
            
            function toPersianNum(str) {
                return String(str).replace(/\d/g, x => ['۰','۱','۲','۳','۴','۵','۶','۷','۸','۹'][x]);
            }

            if (window.jalaali && typeof window.jalaali.toJalaali === 'function') {
                const j = window.jalaali.toJalaali(dateObj);
                const weekday = weekdays[dateObj.getDay()];
                const monthName = months[j.jm - 1];
                return `${weekday} ${toPersianNum(j.jd)} ${monthName} ${toPersianNum(j.jy)}`;
            }

            try {
                const parts = new Intl.DateTimeFormat('fa-IR-u-ca-persian', {
                    weekday: 'long',
                    day: 'numeric',
                    month: 'long',
                    year: 'numeric'
                }).formatToParts(dateObj);

                let weekday = '', day = '', month = '', year = '';
                parts.forEach(p => {
                    if (p.type === 'weekday') weekday = p.value;
                    if (p.type === 'day') day = p.value;
                    if (p.type === 'month') month = p.value;
                    if (p.type === 'year') year = p.value;
                });
                if (weekday && day && month && year) {
                    return `${weekday} ${day} ${month} ${year}`;
                }
            } catch (e) {}

            return new Intl.DateTimeFormat('fa-IR', { year: 'numeric', month: 'long', day: 'numeric' }).format(dateObj);
        }

                function renderReport(data) {
            const chartsContainer = document.getElementById('chartsContainer');
            const chartsTitle = document.getElementById('chartsTitle');
            if (data.contents.length === 0) {
                if (chartsContainer) chartsContainer.style.display = 'none';
                if (chartsTitle) chartsTitle.style.display = 'none';
            } else {
                if (chartsContainer) chartsContainer.style.display = '';
                if (chartsTitle) chartsTitle.style.display = '';
            }
            // Header
            
            document.getElementById('reportOrgName').innerText = data.organization.org_name;
            const logoImg = document.getElementById('pdfClientLogo');
            const avatarFallback = document.getElementById('pdfClientAvatarFallback');
            if (data.organization.logo_url) {
                logoImg.src = data.organization.logo_url;
                logoImg.style.display = 'block';
                avatarFallback.style.display = 'none';
            } else {
                logoImg.style.display = 'none';
                avatarFallback.style.display = 'flex';
                avatarFallback.style.background = data.organization.color || 'var(--primary-color)';
                avatarFallback.innerText = data.organization.org_name.substring(0, 1);
            }

            const today = getFormattedPersianDate(new Date());
            document.getElementById('reportDate').innerText = 'تاریخ تهیه گزارش: ' + today;

            // Summary
            document.getElementById('sumTotalContents').innerText = toPersianDigits(data.stats.total_contents || 0);
            document.getElementById('sumTotalComponents').innerText = toPersianDigits(data.stats.total_components || 0);

            // Table
            const tbody = document.getElementById('reportTableBody');
            tbody.innerHTML = '';
            
            if (data.contents.length === 0) {
                tbody.innerHTML = `<tr><td colspan="7" style="text-align: center; padding: 40px 20px;">
                            <div style="display: flex; flex-direction: column; align-items: center; justify-content: center;">
                                <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--text-gray)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="opacity: 0.5; margin-bottom: 12px;"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                                <div style="color: var(--text-gray); font-size: 1.1rem; font-weight: bold; margin-bottom: 4px;">رکوردی یافت نشد</div>
                                <div style="color: #94a3b8; font-size: 0.9rem;">با توجه به فیلتر‌های انتخابی شما، هیچ محتوایی در دپو یافت نشد.</div>
                            </div>
                        </td></tr>`;
            } else {
                data.contents.forEach((c, index) => {
                    let s = c.status;
                    if (s === 'done') s = 'منتشر شده';
                    else if (s === 'todo') s = 'در انتظار';
                    else if (s === 'doing') s = 'در حال تولید';
                    else if (s === 'raw') s = 'ایده خام';
                    
                    const plats = c.publish_platforms ? c.publish_platforms.join('، ') : '-';
                    const date = c.publish_date ? c.publish_date + (c.publish_time ? ' - ساعت ' + c.publish_time : '') : '-';
                    
                    tbody.innerHTML += `
                        <tr>
                            <td>${toPersianDigits(index + 1)}</td>
                            <td>${c.title}</td>
                            <td>${c.content_type || '-'}</td>
                            <td>${toPersianDigits(c.total_components || 1)}</td>
                            <td><span style="display:inline-block; padding:3px 8px; border-radius:12px; background: rgba(128, 128, 128, 0.1); font-size:0.8rem;">${s}</span></td>
                            <td>${plats}</td>
                            <td>${toPersianDigits(date)}</td>
                        </tr>
                    `;
                });
            }
            
            // Charts
            renderCharts(data.stats);
        }

        function renderCharts(stats) {
            // Common Options
            const commonOptions = {
                responsive: true, maintainAspectRatio: false, animation: false,
                plugins: {
                    legend: { position: 'bottom', labels: { font: { family: 'inherit' } } }
                }
            };

            // Type Chart
            if(typeChartInst) typeChartInst.destroy();
            typeChartInst = new Chart(document.getElementById('typeChart'), {
                type: 'pie',
                data: {
                    labels: Object.keys(stats.typeCounts),
                    datasets: [{
                        data: Object.values(stats.typeCounts),
                        backgroundColor: ['#6366f1', '#8b5cf6', '#ec4899', '#f43f5e', '#d946ef']
                    }]
                },
                options: commonOptions
            });

            // Status Chart
            if(statusChartInst) statusChartInst.destroy();
            statusChartInst = new Chart(document.getElementById('statusChart'), {
                type: 'doughnut',
                data: {
                    labels: Object.keys(stats.statusCounts),
                    datasets: [{
                        data: Object.values(stats.statusCounts),
                        backgroundColor: ['#ec4899', '#8b5cf6', '#6366f1', '#3b82f6', '#14b8a6']
                    }]
                },
                options: commonOptions
            });

            // Platform Chart
            if(platformChartInst) platformChartInst.destroy();
            platformChartInst = new Chart(document.getElementById('platformChart'), {
                type: 'bar',
                data: {
                    labels: Object.keys(stats.platformCounts),
                    datasets: [{
                        label: 'تعداد',
                        data: Object.values(stats.platformCounts),
                        backgroundColor: '#8b5cf6'
                    }]
                },
                options: {
                    onClick: (e, elements) => {
                        if (elements.length > 0) {
                            const index = elements[0].index;
                            const platforms = Object.keys(stats.by_platform || {});
                            if (platforms[index]) {
                                window.location.href = 'depot?platform=' + encodeURIComponent(platforms[index]);
                            }
                        }
                    },
                    onHover: (e, elements) => {
                        e.native.target.style.cursor = elements.length > 0 ? 'pointer' : 'default';
                    },
                    responsive: true, animation: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { beginAtZero: true, ticks: { font: { family: 'inherit' }, stepSize: 1 } },
                        x: { ticks: { font: { family: 'inherit' } } }
                    }
                }
            });
        }

        
        function exportExcel() {
            if (typeof XLSX === 'undefined') {
                showToast('کتابخانه اکسل لود نشده است.', 'error');
                return;
            }
            const table = document.querySelector('.report-table table');
            if (!table) {
                showToast('جدولی برای خروجی وجود ندارد.', 'warning');
                return;
            }
            
            const btn = document.getElementById('excelBtn');
            btn.innerHTML = `<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align: middle; margin-left: 4px;'><path d='M5 22h14'/><path d='M5 2h14'/><path d='M17 22v-4.172a2 2 0 0 0-.586-1.414L12 12l-4.414 4.414A2 2 0 0 0 7 17.828V22'/><path d='M7 2v4.172a2 2 0 0 0 .586 1.414L12 12l4.414-4.414A2 2 0 0 0 17 6.172V2'/></svg> در حال آماده‌سازی...`;
            btn.disabled = true;
            
            setTimeout(() => {

                try {
                    const wb = XLSX.utils.table_to_book(table, { sheet: "گزارش محتوا" });
                    XLSX.writeFile(wb, 'Report_' + new Date().toISOString().slice(0,10) + '.xlsx');
                    showToast('فایل اکسل با موفقیت ایجاد شد.', 'success');
                } catch(e) {
                    console.error(e);
                    showToast('خطا در تولید اکسل', 'error');
                } finally {
                    btn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-file-spreadsheet" style="vertical-align:middle;"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path><path d="M14 2v4a1 1 0 0 0 1 1h4"></path><path d="M8 13h8"></path><path d="M8 17h8"></path></svg> <span>خروجی اکسل</span>`;
                    btn.disabled = false;
                }
            }, 800);
        }

        function exportPDF() {
            const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
            if (isDark) {
                document.documentElement.setAttribute('data-theme', 'light');
                document.body.classList.add('pdf-mode-print-preview');
                if (typeof Chart !== 'undefined') {
                    Chart.defaults.color = '#000000';
                    if (typeof typeChartInst !== "undefined" && typeChartInst) typeChartInst.update();
                    if (typeof statusChartInst !== "undefined" && statusChartInst) statusChartInst.update();
                    if (typeof platformChartInst !== "undefined" && platformChartInst) platformChartInst.update();
                }
                if (window.updateReportsLogoDisplay) window.updateReportsLogoDisplay();
            }

            // Always open in new tab with auto_print=1 to ensure print works perfectly
            const currentUrl = new URL(window.location.href);
            currentUrl.searchParams.set('auto_print', '1');
            
            const orgId = document.getElementById('orgSelect').value;
            const fromDate = document.getElementById('startDate').value;
            const toDate = document.getElementById('endDate').value;
            const noTimeLimit = document.getElementById('noTimeLimit').checked;
            
            if (orgId) currentUrl.searchParams.set('org', orgId);
            if (fromDate) currentUrl.searchParams.set('from', fromDate);
            if (toDate) currentUrl.searchParams.set('to', toDate);
            if (noTimeLimit) currentUrl.searchParams.set('no_limit', '1');
            
            if (typeof showToast === 'function') {
                showToast("در حال آماده‌سازی و باز کردن تب چاپ...", "success");
            }
            
            window.open(currentUrl.toString(), '_blank');
            
            // Revert theme locally
            setTimeout(() => {
                if (isDark) {
                    document.documentElement.setAttribute('data-theme', 'dark');
                    if (typeof Chart !== 'undefined') {
                        Chart.defaults.color = 'var(--text-gray)';
                        if (typeof typeChartInst !== "undefined" && typeChartInst) typeChartInst.update();
                        if (typeof statusChartInst !== "undefined" && statusChartInst) statusChartInst.update();
                        if (typeof platformChartInst !== "undefined" && platformChartInst) platformChartInst.update();
                    }
                    if (window.updateReportsLogoDisplay) window.updateReportsLogoDisplay();
                }
            }, 1000);
        }
        
        function revertTheme(wasDark) {
            document.getElementById('pdfHeader').style.display = 'none';
            if (wasDark) {
                document.documentElement.setAttribute('data-theme', 'dark');
                if (typeof Chart !== 'undefined') {
                    Chart.defaults.color = 'var(--text-gray)';
                    if (typeof typeChartInst !== "undefined" && typeChartInst) typeChartInst.update();
                    if (typeof statusChartInst !== "undefined" && statusChartInst) statusChartInst.update();
                    if (typeof platformChartInst !== "undefined" && platformChartInst) platformChartInst.update();
                }
                if (window.updateReportsLogoDisplay) window.updateReportsLogoDisplay();
            }
        }

        
        



        document.addEventListener('DOMContentLoaded', () => {
            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.get('auto_print') === '1') {
                
                // Force light theme immediately
                document.documentElement.setAttribute('data-theme', 'light');
                document.body.classList.add('pdf-mode-print-preview');
                
                // Set form values
                const orgId = urlParams.get('org');
                if (orgId) {
                    const orgSel = document.getElementById('orgSelect');
                    if(orgSel) orgSel.value = orgId;
                    
                    if (urlParams.get('no_limit') === '1') {
                        const ntl = document.getElementById('noTimeLimit');
                        if(ntl) ntl.checked = true;
                        if(typeof toggleTimeInputs === 'function') toggleTimeInputs();
                    } else {
                        if (urlParams.get('from')) {
                            const sd = document.getElementById('startDate');
                            if(sd) sd.value = urlParams.get('from');
                        }
                        if (urlParams.get('to')) {
                            const ed = document.getElementById('endDate');
                            if(ed) ed.value = urlParams.get('to');
                        }
                    }
                    
                    // Trigger load
                    if(typeof loadReport === 'function') {
                        loadReport().then(() => {
                            // After load finishes
                            setTimeout(() => {
                                const ph = document.getElementById('pdfHeader');
                                if(ph) ph.style.display = 'block';
                                
                                if (typeof Chart !== 'undefined') {
                                    Chart.defaults.color = '#000000';
                                    if(typeof typeChartInst !== 'undefined' && typeChartInst) typeChartInst.update();
                                    if(typeof statusChartInst !== 'undefined' && statusChartInst) statusChartInst.update();
                                    if(typeof platformChartInst !== 'undefined' && platformChartInst) platformChartInst.update();
                                }
                                if (window.updateReportsLogoDisplay) window.updateReportsLogoDisplay();
                                
                                // Finally print
                                
                                
                                // Render images instead of canvas for perfect printing
                                const chartsToPrint = [
                                    { inst: typeChartInst, id: 'typeChart' },
                                    { inst: statusChartInst, id: 'statusChart' },
                                    { inst: platformChartInst, id: 'platformChart' }
                                ];
                                
                                chartsToPrint.forEach(c => {
                                    if(c.inst && document.getElementById(c.id)) {
                                        const canvas = document.getElementById(c.id);
                                        const parent = canvas.parentElement;
                                        
                                        // Set a rigid square size to force a good chart aspect ratio
                                        if (parent) {
                                            parent.style.width = '300px';
                                            parent.style.height = '300px';
                                        }
                                        c.inst.resize();
                                        
                                        // Wait a moment for Chart.js to redraw at 300x300, then capture
                                        setTimeout(() => {
                                            const imgUrl = c.inst.toBase64Image();
                                            const img = document.createElement('img');
                                            img.src = imgUrl;
                                            img.style.width = '100%';
                                            img.style.height = '200px';
                                            img.style.objectFit = 'contain';
                                            img.style.display = 'block';
                                            img.style.margin = '0 auto';
                                            
                                            canvas.style.display = 'none';
                                            if (parent) parent.appendChild(img);
                                            
                                            if (parent) {
                                                parent.style.width = '100%';
                                                parent.style.height = 'auto';
                                            }
                                        }, 150);
                                    }
                                });

                                setTimeout(() => {
                                    window.print();
                                }, 900);
                            }, 1000);
                        }).catch(e => {
                            console.error("Auto print load failed", e);
                            setTimeout(() => window.print(), 1000);
                        });
                    }
                } else {
                    setTimeout(() => window.print(), 1000);
                }
            }
        });

    </script>
<script src="assets/js/app.js?v=4"></script>
