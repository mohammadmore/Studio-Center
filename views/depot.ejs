            <label><input type="checkbox" value="پژوهش و سناریو"> پژوهش و سناریو</label>
            <label><input type="checkbox" value="فیلمبرداری"> فیلمبرداری</label>
            <label><input type="checkbox" value="عکاسی"> عکاسی</label>
            <label><input type="checkbox" value="طراحی گرافیک"> طراحی گرافیک</label>
            <label><input type="checkbox" value="تدوین"> تدوین</label>
            <label><input type="checkbox" value="گویندگی"> گویندگی</label>
        </div>

        <div style="margin-top:24px; display:flex; gap:12px;">
            <button onclick="saveNewContent()" class="btn-primary" style="flex:1;"><svg style="pointer-events: none;" xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align: middle; margin-left: 4px;'><path d='M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z'/><polyline points='17 21 17 13 7 13 7 21'/><polyline points='7 3 7 8 15 8'/></svg> ذخیره و ارسال به میز کار</button>
            <button type="button" class="btn-outline"  onclick="closeModal()" style="flex: 1;">انصراف</button>
        </div>
    </div>
</div>



<!-- پاپ‌آپ ورود گروهی با اکسل -->
<div class="modal" id="excelModal">
    <div class="modal-content" style="max-height: 90vh; overflow-y: auto; width: 100%; max-width: 780px; box-sizing: border-box; max-width: 95%;">
