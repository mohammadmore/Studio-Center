async function submitBatchEdit() {
    const action = document.getElementById('batchAction').value;
    if (!action || selectedBatchIds.length === 0) return;
    
    if (action === 'delete') {
        if (!(await window.customConfirm('آیا از حذف گروهی این محتوا‌ها اطمینان دارید؟'))) return;
    }
    
    let payload = {
        ids: selectedBatchIds,
        action: action
    };
    
    if (action === 'status') {
        payload.status = document.getElementById('batchStatusValue').value;
    } else if (action === 'org') {
        payload.org_id = document.getElementById('batchOrgValue').value;
    } else if (action === 'collection') {
        payload.collection_title = document.getElementById('batchCollectionValue').value;
    } else if (action === 'type') {
        payload.content_type = document.getElementById('batchTypeValue').value;
    } else if (action === 'manager') {
        payload.project_manager = document.getElementById('batchManagerValue').value;
    } else if (action === 'team') {
        payload.team = Array.from(document.querySelectorAll('.batch-team-cb:checked')).map(cb => cb.value);
    } else if (action === 'platforms') {
        payload.platforms = Array.from(document.querySelectorAll('.batch-plat-cb:checked')).map(cb => cb.value);
    } else if (action === 'stages') {
        payload.stages = Array.from(document.querySelectorAll('.batch-stage-cb:checked')).map(cb => cb.value);
    } else if (action === 'components') {
        
        const counts = {};
        document.querySelectorAll('.batch-comp-count').forEach(el => {

            const val = parseInt(el.value);
            if (val > 0) counts[el.dataset.name] = val;
        });
        payload.components = counts;
    }
    
    const btn = document.getElementById('batchSubmitBtn');
    const oldText = btn.innerText;
    btn.innerText = 'در حال انجام...';
    btn.disabled = true;
    
    try {
        const res = await fetch('/api/batch_edit_contents', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        });
        const data = await res.json();
        if (data.status === 'success') {
            document.getElementById('batchEditModal').style.display = 'none';
            if(window.showToast) {
                if (action === 'delete' && data.bin_ids && data.bin_ids.length > 0) {
                    window.showToast(data.message, 'success', {
                        text: 'بازگردانی',
                        callback: async () => {
                            for (let bin_id of data.bin_ids) {
                                await fetch('/api/recycle_bin', {
                                    method: 'POST',
                                    headers: {'Content-Type': 'application/json'},
                                    body: JSON.stringify({ action: 'restore', bin_id: bin_id })
                                });
                            }
                            window.showToast('محتوا‌های حذف شده بازگردانی شدند', 'success');
                            loadDepot();
                        }
                    });
                } else {
                    window.showToast('عملیات با موفقیت انجام شد', 'success');
                }
            }
            clearBatchSelection();
            loadDepot();
        } else {
            if(window.showToast) window.showToast(data.message || 'خطا در انجام عملیات', 'error');
        }
    } catch(err) {
        if(window.showToast) window.showToast('خطا در ارتباط با سرور', 'error');
    }
    btn.innerText = oldText;
    btn.disabled = false;
}

