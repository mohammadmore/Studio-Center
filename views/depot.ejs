async function confirmStageTransition(id, newStatusId, newStatusName) {
    if (!newStatusId) return;
    const item = (window.allDepotItems || []).find(i => i.id == id);
    const itemName = item ? (item.title || 'بدون عنوان') : 'بدون عنوان';
    const itemType = item ? (item.content_type || 'محتوای') : 'محتوای';
    if (await window.customConfirm(`${itemType} «${itemName}» به مرحله ${newStatusName} منتقل شود!؟`)) {
        try {
            const res = await fetch('/api/add_content', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({ action: 'update_status', id: parseInt(id), status: newStatusId })
            });
            const result = await res.json();
            if (result.status === 'success') {
                const item = (window.allDepotItems || []).find(i => i.id == id);
                if (item) {
                    const oldStatus = item.status || 'raw';
                    item.status = newStatusId;
                    // Optimistic UI update without full reload
                    const cardEl = document.querySelector(`[data-id="${id}"]`);
                    const newColBody = document.getElementById(`col-body-${newStatusId}`);
                    const oldColBody = document.getElementById(`col-body-${oldStatus}`);
                    if (cardEl && newColBody) {
                        // Remove 'خالی' from destination if it exists
                        const emptyMsg = newColBody.querySelector('.empty-state');
                        if (emptyMsg) emptyMsg.remove();

                        newColBody.appendChild(cardEl);

                        // Add 'خالی' to source if empty
                        if (oldColBody && oldColBody.querySelectorAll('.task-card').length === 0) {
                            oldColBody.innerHTML = '<div style="text-align:center; color:#94a3b8; padding:20px; font-size:0.9rem;" class="empty-state">خالی</div>';
                        }

                        const oldCountSpan = document.getElementById(`col-count-${oldStatus}`);
                        const newCountSpan = document.getElementById(`col-count-${newStatusId}`);
                        if(oldCountSpan) oldCountSpan.innerText = window.toPersianDigits(Math.max(0, parseInt(oldCountSpan.innerText.replace(/[۰-۹]/g, d => '۰۱۲۳۴۵۶۷۸۹'.indexOf(d))) - 1));
                        if(newCountSpan) newCountSpan.innerText = window.toPersianDigits(parseInt(newCountSpan.innerText.replace(/[۰-۹]/g, d => '۰۱۲۳۴۵۶۷۸۹'.indexOf(d))) + 1);
                    } else {
                        filterCards();
                    }
                }
                openContentDetails(id, false); // Reload modal details
                if (window.showToast) window.showToast('وضعیت با موفقیت تغییر کرد', 'success');
            } else {
                if (window.showToast) window.showToast('خطا در انتقال کارت', 'error');
            }
        } catch(e) {
            if (window.showToast) window.showToast('خطا در انتقال کارت', 'error');
        }
    }
}





