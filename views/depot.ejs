async function saveNewContent() {
    const title = document.getElementById('newTitle').value;
    const org_id = document.getElementById('newOrg').value;
    const type = document.getElementById('newType').value;
    const project_manager = document.getElementById('newManager').value;
    
    const assigned_colleagues = Array.from(document.querySelectorAll('input[name="new_team_cb"]:checked')).map(cb => cb.value);
    const stages = Array.from(document.querySelectorAll('#newStages input[type="checkbox"]:checked')).map(cb => cb.value);
    
    let components_count = {};
    document.querySelectorAll('#newComponentsCount .comp-count').forEach(inp => {
        let val = parseInt(inp.value);
        if (val > 0) {
            components_count[inp.dataset.name] = val;
        }
    });

    const res = await fetch('/api/add_content', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({
            title,
            org_id,
            type,
            project_manager,
            assigned_colleagues,
            stages,
            components_count
        })
    });
    const result = await res.json();
    if (result.status === 'success') {
        closeModal();
        if (typeof showToast === 'function') showToast(result.message);
        if (typeof loadDepot === 'function') loadDepot();
    } else {
        showToast(result.message);
    }
}
let selectedBatchIds = [];

let lastCheckedCheckboxValue = null;

function toggleBatchSelect(event, id, isChecked) {
    id = parseInt(id);
    
    // Fallback if event is not passed correctly or isn't a mouse event (e.g. called from somewhere else)
    if (!event || !event.shiftKey) {
        if (isChecked) {
            if (!selectedBatchIds.includes(id)) selectedBatchIds.push(id);
        } else {
            selectedBatchIds = selectedBatchIds.filter(i => i !== id);
        }
        lastCheckedCheckboxValue = id;
    } else {
        // Shift key is pressed
        const checkboxes = Array.from(document.querySelectorAll('.batch-checkbox'));
        let start = -1;
        let end = -1;
        
        for (let i = 0; i < checkboxes.length; i++) {
            const cbId = parseInt(checkboxes[i].value);
            if (cbId === lastCheckedCheckboxValue) start = i;
            if (cbId === id) end = i;
        }
        
        if (start !== -1 && end !== -1) {
            const min = Math.min(start, end);
            const max = Math.max(start, end);
            
            for (let i = min; i <= max; i++) {
                const cb = checkboxes[i];
                const cbId = parseInt(cb.value);
                cb.checked = isChecked;
                if (isChecked) {
                    if (!selectedBatchIds.includes(cbId)) selectedBatchIds.push(cbId);
                } else {
                    selectedBatchIds = selectedBatchIds.filter(val => val !== cbId);
                }
            }
        } else {
            // Fallback if lastChecked isn't found
            if (isChecked) {
                if (!selectedBatchIds.includes(id)) selectedBatchIds.push(id);
            } else {
                selectedBatchIds = selectedBatchIds.filter(i => i !== id);
            }
        }
        lastCheckedCheckboxValue = id;
    }
    if (event && event.shiftKey) {
        if (window.getSelection) {
            window.getSelection().removeAllRanges();
        }
    }
    updateBatchUI();
}

function handleCardClick(event, id) {
