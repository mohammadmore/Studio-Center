        origRenderKanban(items);
        
    };

function updateBatchUI() {
    const bar = document.getElementById('batchActionsBar');
    const count = document.getElementById('batchCount');
    
    // Sync checkboxes
    document.querySelectorAll('.batch-checkbox').forEach(cb => {
        cb.checked = selectedBatchIds.includes(parseInt(cb.value));
    });

    if (selectedBatchIds.length > 0) {
        bar.style.display = 'flex';
        count.innerText = selectedBatchIds.length + ' محتوا انتخاب شده';
    } else {
        bar.style.display = 'none';
    }
}

function clearBatchSelection() {
    selectedBatchIds = [];
    updateBatchUI();
}

// Ensure batch UI is updated after renderKanban
const oldRenderKanban = renderKanban;
renderKanban = function(items) {
    oldRenderKanban(items);
    updateBatchUI();
};

