    // Auto-collapse columns on mobile initially
    function applyMobileAccordion() {
        if (window.innerWidth <= 768) {
            document.querySelectorAll('.kanban-column').forEach((col, idx) => {
                // Keep the first column open, collapse the rest
                if (idx > 0) {
                    col.classList.add('column-collapsed');
                } else {
                    col.classList.remove('column-collapsed');
                }
            });
        }
    }
    
    const origRenderKanban = renderKanban;
