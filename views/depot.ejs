<script nonce="<%= nonce %>">
;


let cachedTokens = null;






function autoFillPmDate() {
    if (document.getElementById('pmAutoFill').checked) {
        const dDate = document.getElementById('pmDefaultDate').value;
        const dTime = document.getElementById('pmDefaultTime').value;
        if (!dDate) {
            if (window.showToast) window.showToast('تاریخ و زمانی روی این کارت تنظیم نشده است', 'error');
            document.getElementById('pmAutoFill').checked = false;
            return;
        }
        document.getElementById('pmDate').value = dDate;
        if (document.getElementById('pmDate').dispatchEvent) document.getElementById('pmDate').dispatchEvent(new Event('change'));
        document.getElementById('pmTime').value = dTime;
        if (document.getElementById('pmTime').dispatchEvent) document.getElementById('pmTime').dispatchEvent(new Event('change'));
    } else {
        document.getElementById('pmDate').value = '';
        if (document.getElementById('pmDate').dispatchEvent) document.getElementById('pmDate').dispatchEvent(new Event('change'));
        document.getElementById('pmTime').value = '';
        if (document.getElementById('pmTime').dispatchEvent) document.getElementById('pmTime').dispatchEvent(new Event('change'));
    }
}










</script>


