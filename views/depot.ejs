async function loadDepot(silent = false) {
    const board = document.getElementById('kanbanBoard');
    if(!silent) board.innerHTML = '<div style="padding:120px; text-align:center; color: var(--text-gray);">در حال لود...</div>';
    
    try {
        if (!window.allOrgs) {
            const [orgRes, colRes, setRes, collectionsRes] = await Promise.all([
                fetch('/api/get_orgs', { cache: 'no-store' }),
                fetch('/api/get_colleagues'),
                fetch('/api/manage_settings', { cache: 'no-store' }),
                fetch('/api/get_collections', { cache: 'no-store' })
            ]);
            window.allOrgs = (await orgRes.json()).data || [];
            window.allColleagues = (await colRes.json()).users || [];
            window.allSettings = (await setRes.json()).data || {};
            window.allCollections = (await collectionsRes.json()).data || [];
        } else {
            const collectionsRes = await fetch('/api/get_collections', { cache: 'no-store' });
            window.allCollections = (await collectionsRes.json()).data || [];
        }
        const res = await fetch('/api/get_depot_contents', { cache: 'no-store' });
        const result = await res.json();
        const items = result.data || [];
        window.allDepotItems = items;
        
        // Populate type filter
        const typeSelect = document.getElementById('typeFilter');
        if (typeSelect && typeSelect.options.length <= 1) {
            (window.allSettings?.content_type || []).filter(t => t.is_active !== 0).forEach(t => {
                const opt = document.createElement('option');
                opt.value = t.setting_key;
                opt.text = t.setting_key;
                typeSelect.appendChild(opt);
            });
        }
        // Populate platform filter
        const platformSelect = document.getElementById('platformFilter');
        if (platformSelect && platformSelect.options.length <= 1) {
            (window.allSettings?.platform || []).filter(p => p.is_active !== 0).forEach(p => {
                const opt = document.createElement('option');
                opt.value = p.setting_key;
                opt.text = p.setting_key;
                platformSelect.appendChild(opt);
            });
        }
        // Populate org filter
        const orgSelect = document.getElementById('orgFilter');
        const orgs = new Set();
        Array.from(items).forEach(i => { if(i.org_name) orgs.add(i.org_name); });
        
        let orgHtml = '<option value="">همه کارفرماها</option>';
        Array.from(orgs).sort().forEach(o => {
            orgHtml += `<option value="${o}">${o}</option>`;
        });
        orgSelect.innerHTML = orgHtml;

        renderKanban(items);
    } catch(e) {
        board.innerHTML = '<div style="color:red; text-align:center;">خطا در لود</div>';
    }
}


function allowDrop(ev) {
    ev.preventDefault();
}

function drag(ev) {
    ev.dataTransfer.setData("text", ev.currentTarget.dataset.id);
}

const statusNames = {
    'raw': 'ورودی خام',
    'todo': 'در صف انتظار',
    'in_progress': 'در حال تولید',
    'review': 'ارزیابی استودیو',
    'client_review': 'ارزیابی کارفرما',
    'needs_revision': 'نیاز به اصلاح',
    'done': 'تکمیل شده',
    'approved_by_client': 'تایید کارفرما',
    'ready_to_publish': 'آماده انتشار',
    'published': 'منتشر شده'
};

async function drop(ev, newStatus) {
    ev.preventDefault();
    const id = ev.dataTransfer.getData("text");
    if (!id) return;
    
    const item = (window.allDepotItems || []).find(i => i.id == id);
    if (!item) return;
    if (item.status === newStatus) return; // Dropped in the same column

    const typeStr = item.content_type || 'محتوا';
    const titleStr = item.title || 'بدون عنوان';
    const stageStr = statusNames[newStatus] || newStatus;
    
    if (!(await window.customConfirm(`${typeStr} «${titleStr}» به مرحله «${stageStr}» منتقل شود!؟`))) {
        return;
    }
    
    // update local state optimistically
    let oldStatus = item.status || 'raw';
    item.status = newStatus;
    
    const cardEl = document.querySelector(`[data-id="${id}"]`);
    // Find the correct new column body
    let newColBody = null;
    let oldColBody = null;
    if (window.isGroupedByOrg) {
        const groupEl = cardEl ? cardEl.closest('.kanban-group') : null;
        if (groupEl) {
            newColBody = Array.from(groupEl.querySelectorAll('.column-body')).find(el => el.id.startsWith('col-body-' + newStatus + '-'));
            oldColBody = Array.from(groupEl.querySelectorAll('.column-body')).find(el => el.id.startsWith('col-body-' + oldStatus + '-'));
        }
    } else {
        newColBody = document.getElementById(`col-body-${newStatus}`);
        oldColBody = document.getElementById(`col-body-${oldStatus}`);
    }

    if (cardEl && newColBody) {
        const emptyMsg = newColBody.querySelector('.empty-state');
        if (emptyMsg) emptyMsg.remove();
        
        newColBody.appendChild(cardEl);
        
        // Find counts
        let container = window.isGroupedByOrg ? cardEl.closest('.kanban-group') : document;
        if (container) {
            const oldBadge = Array.from(container.querySelectorAll('span[id^="col-count-"]')).find(el => el.id.startsWith('col-count-' + oldStatus));
            if (oldBadge) {
                let currentVal = parseInt(window.toEnglishDigits ? window.toEnglishDigits(oldBadge.innerText) : oldBadge.innerText);
                if (isNaN(currentVal)) currentVal = 1;
                oldBadge.innerText = (window.toPersianDigits ? window.toPersianDigits(Math.max(0, currentVal - 1)) : Math.max(0, currentVal - 1));
            }
            const newBadge = Array.from(container.querySelectorAll('span[id^="col-count-"]')).find(el => el.id.startsWith('col-count-' + newStatus));
            if (newBadge) {
                let currentVal = parseInt(window.toEnglishDigits ? window.toEnglishDigits(newBadge.innerText) : newBadge.innerText);
                if (isNaN(currentVal)) currentVal = 0;
                newBadge.innerText = (window.toPersianDigits ? window.toPersianDigits(currentVal + 1) : currentVal + 1);
            }
        }
    } else {
        if (typeof renderKanban === 'function') renderKanban(window.allDepotItems);
    }
    
    try {
        const res = await fetch('/api/update_content_details', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({
                id: id,
                status: newStatus
            })
        });
        const data = await res.json();
        if(data.status !== 'success') {
            if(window.showToast) window.showToast(data.message || 'خطا در ذخیرهسازی', 'error');
        } else {
            if(window.showToast) {
                window.showToast('وضعیت محتوا تغییر یافت', 'success', {
                    text: 'بازگردانی',
                    callback: async () => {
                        if (item) {
                            item.status = oldStatus;
                            if (typeof renderKanban === 'function') renderKanban(window.allDepotItems);
                        }
                        await fetch('/api/update_content_details', {
                            method: 'POST',
                            headers: {'Content-Type': 'application/json'},
                            body: JSON.stringify({ id: id, status: oldStatus })
                        });
                        window.showToast('تغییر وضعیت لغو شد', 'info');
                    }
                });
            }
        }
    } catch(e) {
        console.error(e);
        if(window.showToast) window.showToast('خطا در ارتباط با سرور', 'error');
    }
}

function renderKanban(allItems) {
