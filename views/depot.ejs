        .column-header { padding: 20px; font-weight: 700; font-size: 1.15rem; border-bottom: 2px solid var(--border-color); }
        .task-card { 
            margin: 12px; padding: 18px; border-radius: 12px; background: var(--card-bg); 
            box-shadow: 0 2px 8px rgba(0,0,0,0.06); transition: all 0.2s; cursor: grab; 
        }
        .task-card:hover { transform: translateY(-4px); box-shadow: 0 8px 20px rgba(0,0,0,0.1); }
        
        /* پاپ‌آپ */
        .modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.7); z-index: 2147483647 !important; justify-content: center; align-items: center; }
        .modal-content { background: var(--card-bg); padding: 32px; border-radius: 16px; width: 90%; width: 100%; max-width: 480px; box-sizing: border-box; box-shadow: 0 20px 40px rgba(0,0,0,0.2); }
        jdp-container, .jdp-container, .jdp-overlay { z-index: 2147483647 !important; }
    
        .kanban-column { transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1); position: relative; }
        .column-collapsed { min-width: 60px !important; width: 60px !important; overflow: hidden; background: rgba(128, 128, 128, 0.02) !important; }
        .column-collapsed .column-body { display: none !important; }
        .col-toggle-btn svg { transition: transform 0.3s; transform: rotate(180deg); }
        .column-collapsed:not(.column-expanded) .col-toggle-btn svg { transform: rotate(0deg); }
        .column-collapsed .column-header .col-title-text { display: none !important; }
        .column-collapsed .column-header > div { 
            display: flex !important; 
            flex-direction: column !important; 
            align-items: center !important; 
            gap: 16px !important; 
            justify-content: center !important;
            width: 100%;
            margin: 0 auto;
        }
        .column-collapsed .column-header { padding: 20px 0 !important; justify-content: center !important; border-bottom: none !important; }
        .column-collapsed .col-collapsed-icon { display: flex !important; margin-bottom: 12px; margin-top: 0; justify-content: center; align-items: center; }
        .column-collapsed .col-actions {
            display: flex !important;
            flex-direction: column !important;
            align-items: center !important;
            gap: 4px !important;
        }
        .column-collapsed .col-expand-btn, .column-collapsed .col-toggle-btn {
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            width: 44px !important;
            height: 44px !important;
            padding: 0 !important;
            margin: 0 !important;
        }
        
        .column-collapsed::after {
            content: attr(data-title);
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%) rotate(-90deg);
            white-space: nowrap;
            font-weight: bold;
            color: var(--text-gray);
            font-size: 1.1rem;
        }

    
        /* Mobile Kanban (Accordion) */
        @media (max-width: 768px) {
            .kanban-board, .swimlane-content { 
                display: flex !important;
                flex-direction: column !important; 
                height: auto !important; 
                overflow-x: hidden !important; 
                overflow-y: visible !important;
                padding: 10px 0 !important;
                gap: 12px !important;
                width: 100% !important;
                align-items: stretch !important;
            }
            .kanban-column { 
                min-width: 100% !important; 
                max-width: 100% !important;
                width: 100% !important; 
                height: auto !important; 
                display: flex !important;
                flex-direction: column !important;
                margin: 0 !important;
                box-sizing: border-box !important;
                flex: none !important;
            }
            .column-collapsed::after { content: none !important; display: none !important; }
            .column-collapsed .col-collapsed-icon { display: none !important; }
            
            .column-collapsed { 
                min-width: 100% !important; 
                max-width: 100% !important;
                width: 100% !important; 
                height: auto !important; 
                min-height: 70px !important; 
                overflow: hidden !important; 
                margin: 0 !important;
                box-sizing: border-box !important;
                flex: none !important;
            }
            .column-collapsed .column-body { display: none !important; }
            
            /* Keep header items visible on mobile, unlike desktop */
            .column-collapsed .column-header .col-title-text { 
                display: inline-flex !important; 
                align-items: center; 
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
                flex-shrink: 1;
            }
            
            .column-collapsed .column-header { 
                padding: 12px 16px !important; 
                justify-content: space-between !important; 
                align-items: center !important;
                border-bottom: none !important; 
                display: flex !important;
                flex-direction: row !important;
            }
            .column-collapsed .column-header > div {
                display: flex !important;
                flex-direction: row !important;
                width: auto !important;
                margin: 0 !important;
                align-items: center !important;
                gap: 8px !important;
                justify-content: flex-end !important;
                flex-shrink: 0;
            }
            
            /* Make the purple badge smaller on mobile if it's too big */
            span[id^="col-count"] {
                width: 32px !important;
                height: 32px !important;
                min-width: 32px !important;
                font-size: 0.95rem !important;
            }
            
            /* Toggle icon directions: open = up, closed = down */
            .col-toggle-btn svg { transition: transform 0.3s; transform: rotate(90deg) !important; }
            .column-collapsed .col-toggle-btn svg { transform: rotate(-90deg) !important; }
       
            
            
            
            

        }
    </style>
</head>
