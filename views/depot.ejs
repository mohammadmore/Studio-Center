    function handleHeaderClick(event, headerElem) {
        if (event.target.closest('button')) return; 
        const col = headerElem.closest('.kanban-column');
        if (col.classList.contains('column-collapsed')) return;
        
        // Prevent event bubbling so the column's onclick doesn't immediately reverse this!
        event.stopPropagation();
        
        if (col.classList.contains('column-expanded')) {
            const expandBtn = col.querySelector('.col-expand-btn');
            if (expandBtn) toggleColumnExpand(expandBtn);
        } else {
            const toggleBtn = col.querySelector('.col-toggle-btn');
            if (toggleBtn) toggleColumnCollapse(toggleBtn);
        }
    }


    function toggleColumnCollapse(btn) {
        const col = btn.closest('.kanban-column');
        const board = btn.closest('.kanban-board');
        if (col.classList.contains('column-expanded')) {
            col.classList.remove('column-expanded');
            board.classList.remove('board-has-expanded');
            const expandBtn = col.querySelector('.col-expand-btn');
            if (expandBtn) {
                expandBtn.innerHTML = `<svg style="pointer-events: none;" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"/><path d="M9 21H3v-6"/><path d="M21 3l-7 7"/><path d="M3 21l7-7"/></svg>`;
                expandBtn.title = "تمام صفحه";
            }
        }
        col.classList.toggle('column-collapsed');
    }

    function toggleColumnExpand(btn) {
        const col = btn.closest('.kanban-column');
        const board = btn.closest('.kanban-board');
        
        if (col.classList.contains('column-expanded')) {
            col.classList.remove('column-expanded');
            board.classList.remove('board-has-expanded');
            btn.innerHTML = `<svg style="pointer-events: none;" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"/><path d="M9 21H3v-6"/><path d="M21 3l-7 7"/><path d="M3 21l7-7"/></svg>`;
            btn.title = "تمام صفحه";
        } else {
            const doExpand = () => {
                // Collapse any other expanded column first to prevent multiple fullscreens
                board.querySelectorAll('.column-expanded').forEach(c => {
                    c.classList.remove('column-expanded');
                    const expandBtn = c.querySelector('.col-expand-btn');
                    if(expandBtn) {
                        expandBtn.innerHTML = `<svg style="pointer-events: none;" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"/><path d="M9 21H3v-6"/><path d="M21 3l-7 7"/><path d="M3 21l7-7"/></svg>`;
                        expandBtn.title = "تمام صفحه";
                    }
                });
                
                col.classList.add('column-expanded');
                board.classList.add('board-has-expanded');
                btn.innerHTML = `<svg style="pointer-events: none;" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 14h6v6"/><path d="M20 10h-6V4"/><path d="M14 10l7-7"/><path d="M3 21l7-7"/></svg>`;
                btn.title = "خروج از تمام صفحه";
            };
            
            if (col.classList.contains('column-collapsed')) {
                col.classList.remove('column-collapsed');
            }
            doExpand();
        }
    }

