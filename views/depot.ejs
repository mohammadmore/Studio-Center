                    'مقادیر معتبر / موجود در سیستم': 'متن آزاد'
                },
                {
                    'نام ستون': 'لینک کاور',
                    'نوع': 'اختیاری',
                    'توضیحات و راهنما': 'آدرس اینترنتی پوستر یا تصویر کاور',
                    'مقادیر معتبر / موجود در سیستم': 'آدرس کامل HTTP/HTTPS'
                },
                {
                    'نام ستون': 'لینک ویدیو',
                    'نوع': 'اختیاری',
                    'توضیحات و راهنما': 'آدرس اینترنتی فایل ویدیویی یا ضمیمه',
                    'مقادیر معتبر / موجود در سیستم': 'آدرس کامل HTTP/HTTPS'
                }
            ];

            const wsGuide = XLSX.utils.json_to_sheet(guideData);
            XLSX.utils.book_append_sheet(wb, wsGuide, 'راهنمای فرمت');

            XLSX.writeFile(wb, 'Asva_Content_Depot_Template.xlsx');
            if (window.showToast) window.showToast('قالب اکسل با موفقیت دانلود شد');
        } catch (err) {
            console.error('Error downloading template:', err);
            window.location.href = '/api/download_content_excel_template';
        }
    }
    window.downloadExcelTemplate = downloadExcelTemplate;

    // Drag and drop setup for excel dropzone
    setTimeout( () => {
        const dropZone = document.getElementById('excelDropZone');
        if (dropZone) {
            ['dragenter', 'dragover'].forEach(eventName => {
                dropZone.addEventListener(eventName, (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    dropZone.style.background = '#dbeafe';
                    dropZone.style.borderColor = '#2563eb';
                }, false);
            });
            ['dragleave', 'drop'].forEach(eventName => {
                dropZone.addEventListener(eventName, (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    dropZone.style.background = '#eff6ff';
                    dropZone.style.borderColor = 'var(--primary-color)';
                }, false);
            });
            dropZone.addEventListener('drop', (e) => {
                const dt = e.dataTransfer;
                const files = dt ? dt.files : null;
                if (files && files.length > 0) {
                    const fileInput = document.getElementById('excelFileInput');
                    if (fileInput) fileInput.files = files;
                    handleExcelSelect({ target: { files: files } });
                }
            }, false);
        }
    });
</script>


