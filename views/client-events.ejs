<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<script nonce="<%= nonce %>">
// Global Network Error Handler
(function() {
    if (window._fetchIntercepted) return;
    window._fetchIntercepted = true;
    const originalFetch = window.fetch;
    window.fetch = async function(...args) {
        try {
            return await originalFetch.apply(this, args);
        } catch (e) {
            // Suppress network error toasts which commonly trigger on dev server restart polling
            // console.error('Network Error:', e);
            return new Response(JSON.stringify({status: 'error', message: 'Network error'}), {
                status: 200, 
                headers: { 'Content-Type': 'application/json' }
            });
        }
    };
})();
</script>

        <base href="<%= typeof BASE_URL !== 'undefined' ? BASE_URL + '/' : '/' %>">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= STUDIO_NAME %> | انتخاب مناسبت‌های تقویمی</title>
    <link rel="stylesheet" href="assets/css/style.css?v=6">
    <script src="assets/js/jalaali.min.js?v=2"></script>
    <style nonce="<%= nonce %>">
        body { background-color: var(--bg-color); padding: 20px; }
        .container { width: 100%; max-width: 800px; box-sizing: border-box; margin: 0 auto; background: var(--card-bg); padding: 30px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); }
        .event-row { display: flex; justify-content: space-between; align-items: center; padding: 15px; border-bottom: 1px solid var(--border-color); transition: 0.2s; }
        .event-row:hover { background: rgba(128, 128, 128, 0.05); }
        .event-date { font-weight: bold; color: var(--primary-color); min-width: 100px; }
        .event-title { flex-grow: 1; font-weight: bold; color: var(--text-gray); }
        .event-badge { font-size: 0.8rem; padding: 4px 8px; border-radius: 6px; }
        .btn-submit { background: var(--success-color); color: white; border: none; padding: 15px 30px; border-radius: 8px; font-size: 1.1rem; font-weight: bold; cursor: pointer; width: 100%; margin-top: 30px; transition: 0.2s; }
        .btn-submit:hover { background: #059669; }
    
        @media (max-width: 768px) {
            .header-icons-left .back-text { display: none !important; }
            .header-icons-left .back-icon { display: block !important; }
            .header-icons-left .back-btn { padding: 0 !important; width: 40px !important; height: 40px !important; border-radius: 50% !important; border: none !important; margin-right: 0 !important; }
        }
        @media (max-width: 768px) {
            .header-icons-left {
                flex-direction: row !important;
                flex-wrap: nowrap !important;
                width: auto !important;
                justify-content: center !important;
            }
            .header-icons-left > * {
                width: auto !important;
                flex: 0 0 auto !important;
            }
        }
        @media (max-width: 768px) {
            .client-header-container {
                flex-direction: row !important;
                align-items: center !important;
                justify-content: space-between !important;
                padding: 10px 15px !important;
                gap: 10px !important;
                margin-bottom: 20px !important;
            }
            .header-right-logo {
                width: 45px !important;
                height: 45px !important;
                font-size: 1.2rem !important;
            }
            .header-right-name {
                font-size: 0.95rem !important;
            }
            .client-header-container > div:first-child {
                gap: 10px !important;
            }
            .header-icons-left {
                gap: 8px !important;
            }
            .header-icons-left button, 
            .header-icons-left a {
                width: 36px !important;
                height: 36px !important;
                padding: 0 !important;
            }
            .header-icons-left svg {
                width: 20px !important;
                height: 20px !important;
            }
        }

</style>
<script nonce="<%= nonce %>">
    var savedTheme = localStorage.getItem('theme');
    if (savedTheme) {
        document.documentElement.setAttribute('data-theme', savedTheme);
    } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
        document.documentElement.setAttribute('data-theme', 'dark');
    }
</script>
</head>
<body>
