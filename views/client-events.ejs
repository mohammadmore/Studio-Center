    <script nonce="<%= nonce %>">
        const monthNames = ["فروردین", "اردیبهشت", "خرداد", "تیر", "مرداد", "شهریور", "مهر", "آبان", "آذر", "دی", "بهمن", "اسفند"];
        const urlParams = new URLSearchParams(window.location.search);
        const j = typeof jalaali !== 'undefined' ? jalaali : window.jalaali; const year = urlParams.get('year') || (j ? j.toJalaali(new Date()).jy : 1403);
        const month = urlParams.get('month') || (j ? j.toJalaali(new Date()).jm : 5);
        const org_id = urlParams.get('org_id');

        document.getElementById('monthNameLabel').innerText = monthNames[month - 1];
        document.getElementById('yearLabel').innerText = toPersianDigits(year);

        function toPersianDigits(str) {
            const persianNumbers = ['۰', '۱', '۲', '۳', '۴', '۵', '۶', '۷', '۸', '۹'];
            if(!str && str !== 0) return '';
            return str.toString().replace(/[0-9]/g, function (w) {
                return persianNumbers[+w];
            });
        }

        async function loadEvents() {
            try {
                const res = await fetch(`/api/get_smart_events_monthly?year=${year}&month=${month}&org_id=${org_id}&for_client=1`, { cache: 'no-store' });
                const data = await res.json();
                const list = document.getElementById('eventsList');
                list.innerHTML = '';
                
                                if (data.status === 'success' && data.data.length > 0) {
                    if (data.unlock_reason && !data.is_final) {
                        const insText = document.getElementById('clientInstructionsText');
                        if (insText) {
                            insText.innerText = data.unlock_reason;
                            insText.style.color = '#92400e';
                            insText.style.fontWeight = 'bold';
                            insText.style.background = '#fffbeb';
                            insText.style.padding = '10px';
                            insText.style.borderRadius = '8px';
                            insText.style.border = '1px solid #fde68a';
                        }
                    }
                    (data.data || []).sort((a,b) => a.publish_day - b.publish_day).forEach(ev => {
                        let badgeText = 'ملی';
                        let badgeBg = 'rgba(128, 128, 128, 0.05)';
                        let badgeColor = '#475569';
                        
                        if(ev.calendar_type === 'shamsi') { badgeText = 'ملی (شمسی)'; badgeBg = '#d1fae5'; badgeColor = '#065f46'; }
                        else if(ev.calendar_type === 'ghamari') { badgeText = 'مذهبی (قمری)'; badgeBg = '#fef3c7'; badgeColor = '#92400e'; }
                        else if(ev.calendar_type === 'miladi') { badgeText = 'جهانی (میلادی)'; badgeBg = '#dbeafe'; badgeColor = '#1e40af'; }
                        else { badgeText = 'اختصاصی'; }
                        
                        const isChecked = data.client_selection && data.client_selection.includes(ev.title) ? 'checked' : '';
                        const isDisabled = data.is_final ? 'disabled' : '';
                        
                        list.innerHTML += `
                            <label class="event-row" style="cursor: ${data.is_final ? 'not-allowed' : 'pointer'}; opacity: ${data.is_final && !isChecked ? '0.6' : '1'};">
                                <div style="display: flex; flex-direction: column; flex-grow: 1; justify-content: center;">
                                    <div style="display: flex; align-items: center; gap: 15px;">
                                        <input type="checkbox" value="${ev.title}" data-day="${ev.publish_day}" style="transform: scale(1.3); margin: 0;" ${isChecked} ${isDisabled}>
                                        <div class="event-date" style="min-width: 80px;">${toPersianDigits(ev.publish_day)} ${monthNames[month-1]}</div>
                                        <div class="event-title">${ev.title}</div>
                                    </div>
                                    ${ev.description ? `<div style="font-size: 0.9rem; color: var(--text-gray); margin-top: 6px; margin-right: 110px; opacity: 0.75; line-height: 1.5; white-space: pre-wrap;">${ev.description}</div>` : ''}
                                </div>
                                <div style="display: flex; gap: 8px; align-items: center;">
                                    ${ev.org_name ? `<span class="event-badge" style="background: color-mix(in srgb, ${ev.org_color} 12%, transparent); color: ${ev.org_color}; border: 1px solid color-mix(in srgb, ${ev.org_color} 25%, transparent);">${ev.org_name}</span>` : ""}
                                    <span class="event-badge" style="background: ${badgeBg}; color: ${badgeColor};">${badgeText}</span>
                                </div>
                            </label>
                        `;
                    });
                    
                    if (data.is_final) {
                        document.getElementById('submitContainer').style.display = 'none';
                        document.getElementById('finalMessage').style.display = 'block';
                    }
                } else {
                    list.innerHTML = '<div style="padding: 30px; text-align: center; color: #94a3b8;">مناسبتی برای این ماه یافت نشد.</div>';
                    document.getElementById('submitContainer').style.display = 'none';
                }
            } catch (e) {
                document.getElementById('eventsList').innerHTML = '<div style="padding: 30px; text-align: center; color: red;">خطا در بارگذاری اطلاعات.</div>';
            }
        }
        
        function showConfirmation() {
            const checkboxes = document.querySelectorAll('input[type="checkbox"]:checked');
            if (checkboxes.length === 0) {
                showToast('لطفاً حداقل یک مناسبت را انتخاب کنید.');
                return;
            }
            document.getElementById('submitContainer').style.display = 'none';
            document.getElementById('confirmationContainer').style.display = 'block';
        }
        
        function hideConfirmation() {
            document.getElementById('submitContainer').style.display = 'block';
            document.getElementById('confirmationContainer').style.display = 'none';
        }

        async function submitSelection(isDraft) {
            if (!org_id) {
                showToast('شناسه کارفرما نامعتبر است (ارسال از طریق لینک نامعتبر).');
                return;
            }
            
            const checkboxes = document.querySelectorAll('input[type="checkbox"]:checked');
            const selectedEvents = Array.from(checkboxes).map(cb => ({ title: cb.value, publish_day: cb.getAttribute('data-day') }));
            
            try {
                const res = await fetch('/api/add_client_events', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        year: parseInt(year),
                        month: parseInt(month),
                        org_id: org_id,
                        events: selectedEvents,
                        is_draft: isDraft
                    })
                });
                
                const data = await res.json();
                if (data.status === 'success') {
                    if (isDraft) {
                        showToast('انتخاب‌های شما با موفقیت به صورت موقت ذخیره شد.', 'success');
                        hideConfirmation();
                        loadEvents();
                    } else {
                        showToast('انتخاب‌های شما نهایی شد و به استودیو ارسال گردید.');
                        document.getElementById('confirmationContainer').style.display = 'none';
                        loadEvents();
                    }
                } else {
                    showToast(data.message || 'خطا در ثبت اطلاعات.');
                }
            } catch(e) {
                showToast('خطای اتصال به سرور.', 'error');
            }
        }

        loadEvents();
    </script>

<%- include('ux-script') %>


<script nonce="<%= nonce %>">
    if (!window.toEnglishDigits) {
        window.toEnglishDigits = function(str) {
            if (!str) return str;
            return str.replace(/[۰-۹]/g, d => '۰۱۲۳۴۵۶۷۸۹'.indexOf(d));
        };
    }
</script>


<script nonce="<%= nonce %>">
    // بستن مودال با کلیک در پس‌زمینه
    document.addEventListener('click', function(e) {
        if (e.target.classList.contains('modal-overlay') || e.target.classList.contains('modal')) {
            e.target.style.display = 'none';
        }
    });

    // بستن مودال با زدن کلید Esc
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            document.querySelectorAll('.modal-overlay, .modal').forEach(modal => {
                if (modal.style.display === 'flex' || modal.style.display === 'block') {
                    modal.style.display = 'none';
                }
            });
            const customConfirm = document.getElementById('custom-confirm');
            if(customConfirm && customConfirm.style.display === 'flex') {
                 // cancel it
                 document.getElementById('custom-confirm-no').click();
            }
        }
    });
</script>

<script src="assets/js/app.js?v=4"></script>

<div id="clientLogoutModal" style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(15, 23, 42, 0.7); backdrop-filter: blur(5px); z-index: 9999; align-items: center; justify-content: center;">
