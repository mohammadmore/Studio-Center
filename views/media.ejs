<script nonce="<%= nonce %>">
    let pendingExcelMedia = [];

    function openExcelGuideModal() {
        document.getElementById('excelGuideModal').style.display = 'flex';
    }

    function handleExcelImport(event) {
        const file = event.target.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = function(e) {
            const data = new Uint8Array(e.target.result);
            const workbook = XLSX.read(data, { type: 'array' });
            const sheetName = workbook.SheetNames[0];
            const worksheet = workbook.Sheets[sheetName];
            const json = XLSX.utils.sheet_to_json(worksheet, { header: 1 });
            
            if (json.length < 2) {
                showToast('فایل اکسل خالی است یا فرمت نامعتبر است', 'error');
                return;
            }

            // parse columns
            const headers = json[0].map(h => typeof h === 'string' ? h.trim() : h);
            const nameIdx = headers.indexOf('نام فایل');
            const typeIdx = headers.indexOf('نوع فایل');
            const urlIdx = headers.indexOf('لینک مستقیم');
            const orgIdx = headers.indexOf('نام کاربری سازمان (اختیاری)');

            if (nameIdx === -1 || urlIdx === -1 || typeIdx === -1) {
                showToast('ستون‌های نام فایل، نوع فایل یا لینک مستقیم یافت نشدند.', 'error');
                return;
            }

            pendingExcelMedia = [];
            
            for (let i = 1; i < json.length; i++) {
                const row = json[i];
                if (!row || row.length === 0 || !row[nameIdx]) continue;
                
                const asset_name = String(row[nameIdx]).trim();
                const asset_type = String(row[typeIdx]).trim();
                const file_url = String(row[urlIdx]).trim();
                const org_username = orgIdx !== -1 && row[orgIdx] ? String(row[orgIdx]).trim() : '';

                pendingExcelMedia.push({
                    asset_name, asset_type, file_url, org_username
                });
            }

            if (pendingExcelMedia.length === 0) {
                showToast('هیچ رسانه‌ای در فایل یافت نشد', 'error');
                return;
            }

            showExcelPreview();
        };
        reader.readAsArrayBuffer(file);
        event.target.value = ''; // reset
    }

    function showExcelPreview() {
        const container = document.getElementById('excelPreviewContainer');
        container.innerHTML = '';
        
        pendingExcelMedia.forEach((media, index) => {
            container.innerHTML += `
                <div style="margin-bottom: 15px; padding: 15px; background: rgba(128,128,128,0.05); border-radius: 10px; border: 1px solid var(--border-color); display: flex; gap: 15px; align-items: center;">
                    <div style="flex: 1; display: grid; grid-template-columns: 1fr 1fr; gap: 10px; font-size: 0.9rem;">
                        <div>نام فایل: <span style="font-weight:bold;">${media.asset_name}</span></div>
                        <div>نوع فایل: <span style="font-weight:bold;">${media.asset_type}</span></div>
                        <div style="grid-column: 1/-1;">لینک: <a href="${media.file_url}" target="_blank" style="color:var(--primary-color)">${media.file_url.substring(0,40)}...</a></div>
                        <div>نام کاربری سازمان: <span style="font-weight:bold;">${media.org_username || 'بدون سازمان'}</span></div>
                    </div>
                </div>
            `;
        });
        
        document.getElementById('excelPreviewModal').style.display = 'flex';
    }

    async function saveExcelMedia() {
        if (pendingExcelMedia.length === 0) return;
        
        if (window.showLoading) window.showLoading('در حال ذخیره...');
        try {
            const payload = {
                action: 'batch_add',
                media: pendingExcelMedia
            };
            
            const res = await fetch('/api/save_media', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify(payload)
            });
            const result = await res.json();
            
            if (window.hideLoading) window.hideLoading();
            
            if (result.status === 'success') {
                showToast('رسانه‌های اکسل با موفقیت ذخیره شدند', 'success');
                document.getElementById('excelPreviewModal').style.display = 'none';
                loadMedia();
            } else {
                showToast(result.message || 'خطا در ذخیره رسانه‌ها', 'error');
            }
        } catch(e) {
            if (window.hideLoading) window.hideLoading();
            showToast('خطا در ارتباط با سرور', 'error');
        }
    }
</script>
</body>
</html>