        .media-controls {
            display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;
            background: var(--card-bg); padding: 20px; border-radius: 12px; border: 1px solid var(--border-color);
        }
        .media-grid {
            display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 20px;
        }
        .media-card {
            background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 12px; padding: 20px;
            display: flex; flex-direction: column; align-items: center; text-align: center; transition: 0.2s;
        }
        .media-card:hover { border-color: var(--primary-color); transform: translateY(-5px); box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1); }
        .media-icon { font-size: 3rem; margin-bottom: 15px; }
        .media-title { font-weight: bold; color: var(--text-dark); margin-bottom: 5px; font-size: 1.1rem; }
        .media-org { font-size: 0.85rem; color: var(--text-gray); margin-bottom: 15px; background: rgba(128, 128, 128, 0.1); padding: 4px 10px; border-radius: 15px; }
        .btn-download { width: 100%; background: rgba(128, 128, 128, 0.05); color: var(--primary-color); border: 1px solid var(--border-color); padding: 10px; border-radius: 8px; font-weight: bold; cursor: pointer; text-decoration: none; }
        .btn-download:hover {  color: white; }
        
        /* پاپ‌آپ */
        .modal-overlay { display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(15, 23, 42, 0.7); backdrop-filter: blur(5px); justify-content: center; align-items: center; z-index: 1000; }
        .modal-box { background: var(--card-bg); width: 90%; width: 100%; max-width: 500px; box-sizing: border-box; padding: 30px; border-radius: 15px; }
    </style>
</head>
