<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<script>
// Global Network Error Handler
(function() {
    if (window._fetchIntercepted) return;
    window._fetchIntercepted = true;
    const originalFetch = window.fetch;
    window.fetch = async function(...args) {
        try {
            return await originalFetch.apply(this, args);
        } catch (e) {
            // Suppress network error toasts which commonly trigger on dev server restart polling
            // console.error('Network Error:', e);
            return new Response(JSON.stringify({status: 'error', message: 'Network error'}), {
                status: 200, 
                headers: { 'Content-Type': 'application/json' }
            });
        }
    };
})();

    var notifLoaded = false;
    async function fetchNotifications() {
        try {
            const res = await fetch('/api/get_notifications?limit=5');
            const result = await res.json();
            const list = document.getElementById('notif-list');
            const badge = document.getElementById('notif-badge');
            
            if (result.status === 'success') {
                if (result.unread_count > 0) {
                    badge.style.display = 'block';
                    badge.innerText = result.unread_count > 9 ? '9+' : result.unread_count;
                } else {
                    badge.style.display = 'none';
                }
                
                list.innerHTML = '';
                if (result.notifications.length === 0) {
                    list.innerHTML = '<div style="padding: 20px; text-align: center; color: var(--border-color);">اعلان جدیدی ندارید</div>';
                } else {
                    result.notifications.forEach(n => {
                        let icon = '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--primary-color);"><path d="M22 17H2a3 3 0 0 0 3-3V9a7 7 0 0 1 14 0v5a3 3 0 0 0 3 3zm-8.27 4a2 2 0 0 1-3.46 0"></path></svg>';
                        let bg = n.status === 'unread' ? 'rgba(128, 128, 128, 0.05)' : 'transparent';
                        list.innerHTML += `
                            <div style="padding: 15px; border-bottom: 1px solid var(--border-color); display: flex; gap: 15px; align-items: flex-start; background: ${bg}; cursor: pointer; transition: background 0.2s;">
                                <div style="background: rgba(128, 128, 128, 0.1); width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">${icon}</div>
                                <div>
                                    <div style="font-weight: bold; font-size: 0.9rem; margin-bottom: 5px; color: var(--text-gray);">${n.title}</div>
                                    <div style="font-size: 0.8rem; color: var(--border-color); line-height: 1.5; margin-bottom: 5px;">${n.description}</div>
                                    <div style="font-size: 0.7rem; color: var(--border-color); opacity: 0.7;">${n.created_at}</div>
                                </div>
                            </div>
                        `;
                    });
                }
            }
        } catch(e) { console.error(e); }
    }
    
    function toggleNotifications(e) {
        if (e) e.stopPropagation();
        const drop = document.getElementById('notif-dropdown');
        const bellIcon = document.getElementById('client-bell-icon');
        if (drop.style.display === 'none') {
            drop.style.display = 'block';
            if (bellIcon) bellIcon.classList.add('active');
            if (!notifLoaded) { fetchNotifications(); notifLoaded = true; }
        } else {
            drop.style.display = 'none';
            if (bellIcon) bellIcon.classList.remove('active');
        }
    }
    
    async function markAllRead() {
        try {
            const res = await fetch('/api/read_notifications', { method: 'POST' });
            if ((await res.json()).status === 'success') {
                fetchNotifications();
            }
        } catch(e) { console.error(e); }
    }
    
    document.addEventListener('click', function(e) {
        const drop = document.getElementById('notif-dropdown');
        if (drop && drop.style.display === 'block' && !e.target.closest('#notif-dropdown') && !e.target.closest('#client-bell-icon')) {
            drop.style.display = 'none';
            const bellIcon = document.getElementById('client-bell-icon');
            if (bellIcon) bellIcon.classList.remove('active');
        }
    });

    // Check notif on load
    document.addEventListener('DOMContentLoaded', () => {
        fetch('/api/get_notifications?limit=1')
            .then(res => res.json())
            .then(res => {
                if (res.status === 'success' && res.unread_count > 0) {
                    const badge = document.getElementById('notif-badge');
                    if (badge) {
                        badge.style.display = 'block';
                        badge.innerText = res.unread_count > 9 ? '9+' : res.unread_count;
                    }
                }
            }).catch(e => console.error(e));
    });

</script>

        <base href="<%= typeof BASE_URL !== 'undefined' ? BASE_URL + '/' : '/' %>">
    <meta charset="UTF-8">
