        .content-type { display: inline-block; padding: 4px 10px; background: rgba(128, 128, 128, 0.1); color: var(--text-gray); border-radius: 6px; font-size: 0.85rem; }
        .content-status { font-size: 0.85rem; font-weight: bold; padding: 4px 10px; border-radius: 6px; }
        .status-needs_revision { background: rgba(239, 68, 68, 0.15); color: var(--error-color); }
        .status-approved_by_client { background: rgba(16, 185, 129, 0.15); color: #166534; }
