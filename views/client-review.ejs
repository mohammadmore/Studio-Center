    <style>
        body { background-color: var(--bg-color); padding: 20px; }
        .container { width: 100%; max-width: 900px; box-sizing: border-box; margin: 0 auto; background: var(--card-bg); padding: 30px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); }
