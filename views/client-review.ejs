    <script>
        const allSettings = <%- JSON.stringify(typeof settings !== 'undefined' ? settings : {}) %>;
        const urlParams = new URLSearchParams(window.location.search);
        const org_id = urlParams.get('org_id');

        function toPersianDigits(str) {
            const persianNumbers = ['۰', '۱', '۲', '۳', '۴', '۵', '۶', '۷', '۸', '۹'];
            if(!str && str !== 0) return '';
            return str.toString().replace(/[0-9]/g, function (w) {
                return persianNumbers[+w];
            });
        }

        async function loadContent() {
    try {
        const res = await fetch(`/api/get_client_data?org_id=${org_id}`);
        const text = await res.text();
        let data;
        try {
            data = JSON.parse(text);
        } catch(e) {
            console.error("Failed to parse JSON, response was:", text);
            throw new Error("Invalid response from server");
        }
        
        const list = document.getElementById('contentList');
        list.innerHTML = '';
        
        if (data.status === 'success' && data.pending && data.pending.length > 0) {
            let readyHtml = `<h3 style="color: var(--primary-color); border-bottom: 2px solid var(--border-color); padding-bottom: 10px; margin-bottom: 20px;"><svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align: middle; margin-left: 4px;'><path d='M20 6 9 17l-5-5'/></svg> محتوا‌های آماده / در انتظار تایید</h3>`;
            let prepHtml = `<h3 style="color: var(--text-gray); border-bottom: 2px solid var(--border-color); padding-bottom: 10px; margin-bottom: 20px; margin-top: 40px;"><svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align: middle; margin-left: 4px;'><path d='M5 22h14'/><path d='M5 2h14'/><path d='M17 22v-4.172a2 2 0 0 0-.586-1.414L12 12l-4.414 4.414A2 2 0 0 0 7 17.828V22'/><path d='M7 2v4.172a2 2 0 0 0 .586 1.414L12 12l4.414-4.414A2 2 0 0 0 17 6.172V2'/></svg> محتوا‌های در حال آماده‌سازی</h3>`;
            
            let hasReady = false;
            let hasPrep = false;
            
            (data.pending || []).forEach(item => {
                if (item.status === 'done') return; // Do not show published contents
                
                const hasLink = !!item.video_link;
                const hasDate = !!item.publish_date || !!item.shamsi_day;
                
                if (!hasLink && !hasDate) return; // Skip if no link and no date
                
                const isReady = hasLink;
                
                let statusBadge = '';
                if (item.status === 'pending_client_review') {
                    statusBadge = '<span class="status-badge" style="background: #fef9c3; color: #a16207;">در انتظار تایید شما</span>';
                } else if (item.status === 'approved_by_client') {
                    statusBadge = '<span class="status-badge" style="background: rgba(16, 185, 129, 0.15); color: #15803d;">تایید شده - در انتظار انتشار</span>';
                } else if (item.status === 'needs_revision') {
                    statusBadge = '<span class="status-badge" style="background: rgba(239, 68, 68, 0.15); color: var(--error-color);">نیاز به اصلاح</span>';
                }
                
                let cardHtml = `
                    <div class="content-card" id="card-${item.id}">
                        <div class="flex-responsive" style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 15px;">
                            <div>
                                <h3 style="margin: 0; color: var(--text-gray);">${item.title}</h3>
                                <div class="content-type" style="margin-top: 5px;">${item.content_type || 'نامشخص'}</div>
                            </div>
                            ${statusBadge}
                        </div>
                        
                        <div class="details-grid">
                            <div class="detail-item">
                                <span class="detail-label"><svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align: middle; margin-left: 4px;'><path d='M8 2v4'/><path d='M16 2v4'/><rect width='18' height='18' x='3' y='4' rx='2'/><path d='M3 10h18'/></svg> تاریخ و ساعت انتشار:</span>
                                <span style="color: var(--text-gray);">
                                    ${item.publish_date ? toPersianDigits(item.publish_date) : (item.shamsi_day ? toPersianDigits(item.shamsi_day) + ' ' + (window.getShamsiMonthName ? window.getShamsiMonthName(item.shamsi_month) : '') : 'نامشخص')}
                                    ${item.publish_time ? ' - ساعت ' + toPersianDigits(item.publish_time.substring(0,5)) : ''}
                                </span>
                            </div>
                            <div class="detail-item">
                                <span class="detail-label"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle;"><rect width="14" height="20" x="5" y="2" rx="2" ry="2"/><path d="M12 18h.01"/></svg> پلتفرم‌های انتشار:</span>
                                <span style="color: var(--text-gray); display: flex; gap: 8px; flex-wrap: wrap; margin-top: 5px;">
                                    ${item.publish_platforms ? (Array.isArray(item.publish_platforms) ? item.publish_platforms : [item.publish_platforms]).map(p => {
                                        let logoHtml = '';
                                        let icon = p;
                                        if (allSettings.platform) {
                                            const pSet = allSettings.platform.find(s => s.setting_key === p);
                                            if (pSet) {
                                                icon = pSet.icon || p;
                                                if (pSet.logo_url) {
                                                    const isSvg = pSet.logo_url.toLowerCase().includes('.svg') || pSet.logo_url.toLowerCase().includes('data:image/svg');
                                                    if (isSvg) {
                                                        logoHtml = `<span style="display:inline-block; width:20px; height:20px; background-color:currentColor; -webkit-mask-image:url('${pSet.logo_url}'); -webkit-mask-size:contain; -webkit-mask-repeat:no-repeat; -webkit-mask-position:center; mask-image:url('${pSet.logo_url}'); mask-size:contain; mask-repeat:no-repeat; mask-position:center; vertical-align:middle; margin-right:4px;"></span>`;
                                                    } else {
                                                        logoHtml = `<img alt="" src="${pSet.logo_url}" style="width:20px; height:20px; object-fit:cover; border-radius:50%; vertical-align:middle; margin-right:4px;" loading="lazy">`;
                                                    }
                                                }
                                            }
                                        }
                                        return `<span style="background: rgba(128, 128, 128, 0.1); padding: 4px 8px; border-radius: 6px; font-size: 0.85rem; display: inline-flex; align-items: center;">${logoHtml || icon}</span>`;
                                    }).join('') : 'نامشخص'}
                                </span>
                            </div>
                        </div>
                        
                        ${item.caption ? `
                        <div style="background: rgba(128, 128, 128, 0.05); padding: 15px; border-radius: 8px; margin-bottom: 15px;">
                            <span class="detail-label"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle;"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg> کپشن پیشنهادی:</span>
                            <div style="white-space: pre-wrap; font-size: 0.95rem; line-height: 1.6; color: var(--text-gray);">${item.caption}</div>
                        </div>
                        ` : ''}
                        
                        ${item.video_link ? `
                        <div style="margin-bottom: 15px;">
                            <span class="detail-label"><svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align: middle; margin-left: 4px;'><path d='M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71'/><path d='M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71'/></svg> لینک محتوا:</span>
                            <a href="${item.video_link}" class="btn-link" target="_blank" rel="noopener noreferrer">مشاهده محتوا</a>
                        </div>
                        ` : ''}
                        
                        ${item.cover_link ? `
                        <div style="margin-bottom: 15px;">
                            <span class="detail-label"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle;"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>️ لینک کاور / تصویر:</span>
                            <a href="${item.cover_link}" class="btn-link" target="_blank" rel="noopener noreferrer" style="background: #8b5cf6; margin-bottom: 10px;">مشاهده کاور</a>
                            <br>
                            <img alt="" src="${item.cover_link}" style="max-width: 200px; border-radius: 8px; border: 1px solid var(--border-color); display: block; margin-top: 5px;" loading="lazy">
                        </div>
                        ` : ''}
                `;
                
                if (isReady) {
                    cardHtml += `
                        <div class="action-buttons">
                            <button class="btn-approve" onclick="reviewContent(${item.id}, 'approve')" ${item.status === 'approved_by_client' ? 'style="opacity: 0.5; cursor: not-allowed;" disabled' : ''}><svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align: middle; margin-left: 4px;'><path d='M20 6 9 17l-5-5'/></svg> تایید نهایی</button>
                            <button class="btn-reject" onclick="reviewContent(${item.id}, 'reject')" ${item.status === 'needs_revision' ? 'style="opacity: 0.5; cursor: not-allowed;" disabled' : ''}><svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align: middle; margin-left: 4px;'><path d='M18 6 6 18'/><path d='m6 6 12 12'/></svg> نیاز به اصلاح</button>
                        </div>
                    `;
                    readyHtml += cardHtml + '</div>';
                    hasReady = true;
                } else {
                    prepHtml += cardHtml + '</div>';
                    hasPrep = true;
                }
            });
            
            if (!hasReady && !hasPrep) {
                list.innerHTML = '<div style="padding: 40px; text-align: center; color: var(--text-gray); background: rgba(128, 128, 128, 0.05); border-radius: 8px; border: 1px dashed var(--border-color);">محتوایی برای بررسی وجود ندارد.</div>';
            } else {
                list.innerHTML = (hasReady ? readyHtml : '') + (hasPrep ? prepHtml : '');
            }
            
        } else {
            list.innerHTML = '<div style="padding: 40px; text-align: center; color: var(--text-gray); background: rgba(128, 128, 128, 0.05); border-radius: 8px; border: 1px dashed var(--border-color);">محتوایی برای بررسی وجود ندارد.</div>';
        }
    } catch (e) {
        console.error(e);
        document.getElementById('contentList').innerHTML = '<div style="color: red; text-align: center;">خطا در دریافت اطلاعات: ' + e.message + '</div>';
    }
}

        let currentReviewId = null;
        let currentReviewAction = null;
        
        function reviewContent(id, action) {
            currentReviewId = id;
            currentReviewAction = action;
            
            const modal = document.getElementById('reviewModal');
            const title = document.getElementById('modalTitle');
            const desc = document.getElementById('modalDesc');
            const commentSec = document.getElementById('commentSection');
            const confirmBtn = document.getElementById('modalConfirmBtn');
            const commentInput = document.getElementById('reviewComment');
            
            commentInput.value = '';
            
            if (action === 'approve') {
                title.innerText = 'تایید نهایی محتوا';
                title.style.color = 'var(--success-color)';
                desc.innerText = 'آیا از تایید این محتوا اطمینان دارید؟ محتوا پس از تایید جهت انتشار در زمان مقرر ارسال خواهد شد.';
                commentSec.style.display = 'block'; // Allow optional comment on approve too
                confirmBtn.innerText = 'بله، تایید می‌کنم';
                confirmBtn.style.background = 'var(--success-color)';
            } else {
                title.innerText = 'نیاز به اصلاح';
                title.style.color = 'var(--error-color)';
                desc.innerText = 'لطفاً در صورت امکان دلایل خود برای نیاز به اصلاح را بنویسید تا تیم تولید محتوا سریعتر مشکل را برطرف کنند.';
                commentSec.style.display = 'block';
                confirmBtn.innerText = 'ثبت و ارسال به تیم تولید';
                confirmBtn.style.background = 'var(--error-color)';
            }
            
            modal.style.display = 'flex';
        }
        
        function closeReviewModal() {
            document.getElementById('reviewModal').style.display = 'none';
        }

        setTimeout( async () => {
            document.getElementById('modalConfirmBtn').addEventListener('click', async () => {
                const id = currentReviewId;
                const action = currentReviewAction;
                const comment = document.getElementById('reviewComment').value.trim();
                
                closeReviewModal();
                
                try {
                    const res = await fetch('/api/client_review', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ content_id: id, action: action, comment: comment })
                    });
                    const result = await res.json();
                    
                    if (result.status === 'success') {
                        loadContent();
                    } else {
                        showToast(result.message || 'خطا در ثبت درخواست');
                    }
                } catch(e) {
                    console.error(e);
                    showToast('خطا در ارتباط با سرور', 'error');
                }
            });

            await loadContent();
            const params = new URLSearchParams(window.location.search);
            const openId = params.get('open');
            if (openId) {
                setTimeout(() => {
                    const el = document.getElementById('card-' + openId);
                    if (el) {
                        el.style.boxShadow = "0 0 0 4px var(--primary-color)";
                        el.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    }
                }, 500);
            }
        });
</script>

<%- include('ux-script') %>


<script>
    if (!window.toEnglishDigits) {
        window.toEnglishDigits = function(str) {
            if (!str) return str;
            return str.replace(/[۰-۹]/g, d => '۰۱۲۳۴۵۶۷۸۹'.indexOf(d));
        };
    }
</script>


<script>
    // بستن مودال با کلیک در پس‌زمینه
    document.addEventListener('click', function(e) {
        if (e.target.classList.contains('modal-overlay') || e.target.classList.contains('modal')) {
            e.target.style.display = 'none';
        }
    });

    // بستن مودال با زدن کلید Esc
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            document.querySelectorAll('.modal-overlay, .modal').forEach(modal => {
                if (modal.style.display === 'flex' || modal.style.display === 'block') {
                    modal.style.display = 'none';
                }
            });
            const customConfirm = document.getElementById('custom-confirm');
            if(customConfirm && customConfirm.style.display === 'flex') {
                 // cancel it
                 document.getElementById('custom-confirm-no').click();
            }
        }
    });
</script>


    <!-- Modals -->
    <div id="reviewModal" style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(15, 23, 42, 0.7); backdrop-filter: blur(5px); justify-content: center; align-items: center; z-index: 1000; padding: 20px;">
        <div style="background: var(--card-bg); width: 100%; width: 100%; max-width: 450px; box-sizing: border-box; padding: 30px; border-radius: 15px; box-shadow: 0 10px 25px rgba(0,0,0,0.1);">
            <h3 id="modalTitle" style="color: var(--primary-color); margin-bottom: 15px; margin-top: 0;">عنوان مُدال</h3>
            <p id="modalDesc" style="color: var(--text-gray); margin-bottom: 20px; font-size: 0.95rem;">توضیحات</p>
            
            <div id="commentSection" style="display: none; margin-bottom: 20px;">
                <label style="display: block; font-weight: bold; margin-bottom: 8px; color: var(--text-gray);">توضیحات / دلایل (اختیاری):</label>
                <textarea id="reviewComment" rows="4" style="width: 100%; padding: 12px; border: 1px solid var(--border-color); border-radius: 8px; font-family: Tahoma; resize: vertical;" placeholder="دلایل خود را اینجا بنویسید..."></textarea>
            </div>
            
            <div style="display: flex; gap: 10px; justify-content: flex-end;">
                <button type="button" class="btn-outline"  onclick="closeReviewModal()" >انصراف</button>
                <button class="btn-primary"  id="modalConfirmBtn" style="">تایید</button>
            </div>
        </div>
    </div>

<script src="assets/js/app.js?v=4"></script>

