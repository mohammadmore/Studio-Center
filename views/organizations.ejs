    <script nonce="<%= nonce %>">
        let cropper = null;

        setTimeout( () => {
            loadOrganizations();
            loadIndustries();
        });

        // لود حوزه‌های فعالیت از Master Data (فایل تنظیمات که در مرحله قبل ساختیم)
        async function loadIndustries() {
            try {
                const res = await fetch('/api/manage_settings', { cache: 'no-store' });
                const result = await res.json();
                const select = document.getElementById('orgIndustry');
                select.innerHTML = '<option value="">-- انتخاب کنید --</option>';
                if(result.status === 'success' && result.data['industry']) {
                    (result.data && result.data['industry'] || []).forEach(item => {
                        select.innerHTML += `<option value="${item.setting_key}">${item.setting_key}</option>`;
                    });
                }
            } catch(e) { console.log(e); }
        }

        // واکشی لیست کارفرماها از دیتابیس
        
        function filterOrgs() {
            const query = document.getElementById('searchOrg').value.toLowerCase();
            const cards = document.querySelectorAll('#orgsList .org-card');
            cards.forEach(card => {
                const text = card.innerText.toLowerCase();
                card.style.display = text.includes(query) ? 'flex' : 'none';
            });
        }

        async function loadOrganizations() {
            try {
                const res = await fetch('/api/manage_orgs');
                const result = await res.json();
                const container = document.getElementById('orgContainer');
                container.innerHTML = '';
                if(result.data.length === 0) {
                    container.innerHTML = `
                    <div style="grid-column:1/-1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 60px 20px; text-align: center; background: var(--card-bg); border-radius: 16px; border: 1px dashed var(--border-color); margin-top: 20px;">
                        <div style="width: 80px; height: 80px; background: rgba(99, 102, 241, 0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-bottom: 20px;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--primary-color)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"></path><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"></path><path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"></path><path d="M10 6h4"></path><path d="M10 10h4"></path><path d="M10 14h4"></path><path d="M10 18h4"></path></svg>
                        </div>
                        <h3 style="font-size: 1.5rem; color: var(--text-dark); margin-bottom: 10px;">هنوز کارفرما یا سازمانی ثبت نکرده‌اید!</h3>
                        <p style="color: var(--text-gray); width: 100%; max-width: 400px; box-sizing: border-box; margin-bottom: 25px; line-height: 1.6;">با افزودن سازمان‌ها می‌توانید پروژه‌ها، محتوا‌ها و رویداد‌های مربوط به هر مشتری را به صورت تفکیک‌شده مدیریت کنید.</p>
                        <button class="btn-primary"  onclick="document.getElementById('orgModal').style.display='flex'" style=""  >
