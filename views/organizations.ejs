    <style nonce="<%= nonce %>">
        .org-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-top: 20px; min-width: 0; }
        .org-card { background: var(--card-bg); border: 1px solid var(--border-color); padding: 24px; border-radius: 16px; display: flex; flex-direction: column; gap: 20px; transition: 0.3s; box-shadow: 0 2px 15px -3px rgba(0,0,0,0.04); transition: box-shadow 0.3s ease, transform 0.3s ease; min-width: 0; }
        .org-card:hover { border-color: var(--primary-color); box-shadow: 0 5px 15px rgba(0,0,0,0.05); transform: translateY(-3px); }
        .org-logo { width: 60px; height: 60px; border-radius: 50%; object-fit: cover; border: 2px solid var(--border-color); background: var(--card-bg); flex-shrink: 0; }
        .btn-delete { position: absolute; left: 15px; top: 15px; background: rgba(239, 68, 68, 0.15); color: var(--error-color); border: none; padding: 5px 10px; border-radius: 6px; cursor: pointer; font-size: 0.8rem; font-weight: bold; }
        
        @media (max-width: 1400px) { .org-grid { grid-template-columns: repeat(3, 1fr); } }
        @media (max-width: 1024px) { .org-grid { grid-template-columns: repeat(2, 1fr); } }
        @media (max-width: 640px) { .org-grid { grid-template-columns: 1fr; } }
        
        /* استایل‌های مودال و کراپ */
        .modal-overlay { display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(15, 23, 42, 0.7); backdrop-filter: blur(5px); justify-content: center; align-items: center; z-index: 1000; }
        .modal-box { background: var(--card-bg); width: 90%; width: 100%; max-width: 500px; box-sizing: border-box; padding: 30px; border-radius: 15px; max-height: 90vh; overflow-y: auto; }
        .img-container { width: 100%; max-height: 300px; margin-bottom: 20px; display: none; background: rgba(128, 128, 128, 0.05); border-radius: 8px; overflow: hidden; }
        .img-container img { max-width: 100%; }
        .upload-trigger { border: 2px dashed var(--primary-color); padding: 20px; text-align: center; border-radius: 8px; background: rgba(128, 128, 128, 0.05); cursor: pointer; margin-bottom: 15px; color: var(--primary-color); font-weight: bold; }
    </style>
</head>

