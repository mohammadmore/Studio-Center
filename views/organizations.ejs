                // توابع مودال
        function openModal(id = null, name = '', industry = '') {
            document.getElementById('addOrgModal').style.display = 'flex';
            document.getElementById('orgForm').reset();
            document.getElementById('orgId').value = id || '';
            const modalTitle = document.getElementById('modalTitle');
            
            // Clear dynamic fields
            document.getElementById('extraPhonesContainer').innerHTML = '';
            document.getElementById('emailsContainer').innerHTML = '';
            document.getElementById('addressesContainer').innerHTML = '';
            document.getElementById('logoUrl').value = '';
            document.getElementById('logoPreviewContainer').style.display = 'none';
            document.getElementById('logoPreview').src = '';
            
            // Clear color selection
            document.getElementById('orgColor').value = '';
            document.querySelectorAll('.color-swatch').forEach(sw => sw.style.border = '2px solid transparent');
            
            toggleTelegram();

            if (id) {
                document.getElementById('orgName').value = name;
                document.getElementById('orgIndustry').value = industry;
                document.getElementById('saveBtn').disabled = false;
                document.getElementById('saveBtn').innerHTML = `<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align: middle; margin-left: 4px;'><path d='M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z'/><polyline points='17 21 17 13 7 13 7 21'/><polyline points='7 3 7 8 15 8'/></svg> ویرایش برند`;
                if(modalTitle) modalTitle.innerText = 'ویرایش کارفرما';
            } else {
                document.getElementById('saveBtn').disabled = true;
                document.getElementById('saveBtn').innerHTML = `<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align: middle; margin-left: 4px;'><path d='M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z'/><polyline points='17 21 17 13 7 13 7 21'/><polyline points='7 3 7 8 15 8'/></svg> ذخیره برند`;
                if(modalTitle) modalTitle.innerText = '+ تعریف کارفرمای جدید';
            }
            
            document.getElementById('cropperContainer').style.display = 'none';
            if(cropper) { cropper.destroy(); cropper = null; }
        }
        function closeModal() { document.getElementById('addOrgModal').style.display = 'none'; }

        // فعالسازی Cropper.js بعد از انتخاب فایل
        function initCropper(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    const img = document.getElementById('imageToCrop');
                    img.src = e.target.result;
                    document.getElementById('cropperContainer').style.display = 'block';
                    
                    if (cropper) cropper.destroy();
                    // تنظیمات برش عکس: مربع (1:1) برای لوگو
                    cropper = new Cropper(img, { aspectRatio: 1, viewMode: 1 });
                    
                    document.getElementById('saveBtn').disabled = false;
                }
                reader.readAsDataURL(input.files[0]);
            }
        }

        // ثبت فرم (آپلود عکس کراپ شده -> دریافت لینک -> ذخیره کارفرما)
        async function saveOrganization(e) {
            e.preventDefault();
            const btn = document.getElementById('saveBtn');
            btn.innerHTML = `<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align: middle; margin-left: 4px;\"><path d=\"M5 22h14\"/><path d=\"M5 2h14\"/><path d=\"M17 22v-4.172a2 2 0 0 0-.586-1.414L12 12l-4.414 4.414A2 2 0 0 0 7 17.828V22\"/><path d=\"M7 2v4.172a2 2 0 0 0 .586 1.414L12 12l4.414-4.414A2 2 0 0 0 17 6.172V2\"/></svg> در حال ثبت اطلاعات...`;
            btn.disabled = true;

            const payload = {
                action: document.getElementById('orgId').value ? 'edit' : 'add',
                id: document.getElementById('orgId').value,
                org_name: document.getElementById('orgName').value,
                industry: document.getElementById('orgIndustry').value,
                color: document.getElementById('orgColor').value,
                contact_name: document.getElementById('contactName').value,
                phone_number: document.getElementById('phoneNumber').value,
                has_telegram: document.getElementById('hasTelegram').checked,
                telegram_number: document.getElementById('telegramNumber').value,
                extra_phones: Array.from(document.querySelectorAll('input[name="extraPhones[]"]')).map(i => i.value).filter(v => v),
                emails: Array.from(document.querySelectorAll('input[name="emails[]"]')).map(i => i.value).filter(v => v),
                addresses: Array.from(document.querySelectorAll('input[name="addresses[]"]')).map(i => i.value).filter(v => v),
                username: document.getElementById('orgUsername').value,
                password: document.getElementById('orgPassword').value,
                logo_url: document.getElementById('logoUrl').value
            };

            const submitForm = async () => {
                try {
                    const orgRes = await fetch('/api/manage_orgs', {
                        method: 'POST', headers: {'Content-Type': 'application/json'},
                        body: JSON.stringify(payload)
                    });
                    const orgData = await orgRes.json();
                    
                    if (orgData.status === 'success') {
                        closeModal();
                        loadOrganizations();
                    } else showToast(`<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align: middle; margin-left: 4px;'><path d='M18 6 6 18'/><path d='m6 6 12 12'/></svg> ` + orgData.message);
                } catch(err) { showToast('خطا در ارتباط با سرور', 'error'); }
                finally { btn.innerHTML = `<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align: middle; margin-left: 4px;\"><path d=\"M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z\"/><polyline points=\"17 21 17 13 7 13 7 21\"/><polyline points=\"7 3 7 8 15 8\"/></svg> ذخیره برند`; btn.disabled = false; }
            };

            if (cropper) {
                const canvas = cropper.getCroppedCanvas({ width: 300, height: 300 });
                const base64Image = canvas.toDataURL('image/jpeg', 0.8);
                try {
                    btn.innerHTML = `<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align: middle; margin-left: 4px;\"><path d=\"M5 22h14\"/><path d=\"M5 2h14\"/><path d=\"M17 22v-4.172a2 2 0 0 0-.586-1.414L12 12l-4.414 4.414A2 2 0 0 0 7 17.828V22\"/><path d=\"M7 2v4.172a2 2 0 0 0 .586 1.414L12 12l4.414-4.414A2 2 0 0 0 17 6.172V2\"/></svg> در حال آپلود لوگو...`;
                    const uploadRes = await fetch('/api/upload_image', {
                        method: 'POST', headers: {'Content-Type': 'application/json'},
                        body: JSON.stringify({ image: base64Image })
                    });
                    const uploadData = await uploadRes.json();
                    if (uploadData.status === 'success') {
                        payload.logo_url = uploadData.url;
                        btn.innerHTML = `<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align: middle; margin-left: 4px;\"><path d=\"M5 22h14\"/><path d=\"M5 2h14\"/><path d=\"M17 22v-4.172a2 2 0 0 0-.586-1.414L12 12l-4.414 4.414A2 2 0 0 0 7 17.828V22\"/><path d=\"M7 2v4.172a2 2 0 0 0 .586 1.414L12 12l4.414-4.414A2 2 0 0 0 17 6.172V2\"/></svg> در حال ثبت اطلاعات...`;
                        await submitForm();
                    } else {
                        showToast(`<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align: middle; margin-left: 4px;'><path d='M18 6 6 18'/><path d='m6 6 12 12'/></svg> خطا در آپلود تصویر`, 'error');
                        btn.innerHTML = `<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align: middle; margin-left: 4px;\"><path d=\"M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z\"/><polyline points=\"17 21 17 13 7 13 7 21\"/><polyline points=\"7 3 7 8 15 8\"/></svg> ذخیره برند`; btn.disabled = false;
                    }
                } catch(e) {
                    showToast('خطا در آپلود تصویر', 'error');
                    btn.innerHTML = `<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align: middle; margin-left: 4px;\"><path d=\"M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z\"/><polyline points=\"17 21 17 13 7 13 7 21\"/><polyline points=\"7 3 7 8 15 8\"/></svg> ذخیره برند`; btn.disabled = false;
                }
            } else {
                if(!payload.logo_url) { showToast("لطفا لوگو را انتخاب کنید!"); btn.innerHTML = `<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align: middle; margin-left: 4px;\"><path d=\"M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z\"/><polyline points=\"17 21 17 13 7 13 7 21\"/><polyline points=\"7 3 7 8 15 8\"/></svg> ذخیره برند`; btn.disabled = false; return; }
                await submitForm();
            }
        }

        // حذف نرم
        function editOrg(id) {
            const org = window.allOrgsData.find(o => o.id == id);
            if(!org) return;
            
            document.getElementById('addOrgModal').style.display = 'flex';
            document.getElementById('orgForm').reset();
            
            document.getElementById('orgId').value = org.id;
            document.getElementById('orgName').value = org.org_name;
            document.getElementById('orgIndustry').value = org.industry;
            document.getElementById('contactName').value = org.contact_name || '';
            document.getElementById('phoneNumber').value = org.phone_number || '';
            document.getElementById('hasTelegram').checked = org.has_telegram || false;
            toggleTelegram();
            document.getElementById('telegramNumber').value = org.telegram_number || '';
            document.getElementById('orgUsername').value = org.username || '';
            document.getElementById('orgPassword').value = '';
            document.getElementById('logoUrl').value = org.logo_url || '';
            
            if (org.logo_url) {
                document.getElementById('logoPreviewContainer').style.display = 'block';
                document.getElementById('logoPreview').src = org.logo_url;
                document.getElementById('saveBtn').disabled = false;
            }
            
            toggleTelegram();
            selectColor(org.color || 'var(--primary-color)', document.querySelector(`.color-swatch[data-color="${org.color}"]`));
            
            document.getElementById('extraPhonesContainer').innerHTML = '';
            (org.extra_phones || []).forEach(p => {
                addDynamicField('extraPhonesContainer', 'extraPhones[]', 'شماره تماس');
                document.getElementById('extraPhonesContainer').lastElementChild.querySelector('input').value = p;
            });
            
            document.getElementById('emailsContainer').innerHTML = '';
            (org.emails || []).forEach(e => {
                addDynamicField('emailsContainer', 'emails[]', 'ایمیل');
                document.getElementById('emailsContainer').lastElementChild.querySelector('input').value = e;
            });
            
            document.getElementById('addressesContainer').innerHTML = '';
            (org.addresses || []).forEach(a => {
                addDynamicField('addressesContainer', 'addresses[]', 'آدرس');
                document.getElementById('addressesContainer').lastElementChild.querySelector('input').value = a;
            });
            
            document.getElementById('saveBtn').innerHTML = `<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align: middle; margin-left: 4px;'><path d='M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z'/><polyline points='17 21 17 13 7 13 7 21'/><polyline points='7 3 7 8 15 8'/></svg> ویرایش برند`;
            document.getElementById('modalTitle').innerText = 'ویرایش کارفرما';
            
            document.getElementById('emergencyUnlockContainer').style.display = 'block';
            
            const btnCurrent = document.getElementById('btnUnlockCurrent');
            const btnNext = document.getElementById('btnUnlockNext');
            
            if (org.current_month_locked) {
                btnCurrent.innerText = 'باز کردن قفل این ماه';
                btnCurrent.style.borderColor = 'var(--error-color)';
                btnCurrent.style.color = 'var(--error-color)'; btnCurrent.style.backgroundColor = 'transparent';
                btnCurrent.disabled = false;
            } else {
                btnCurrent.innerText = 'هنوز تایید نشده';
                btnCurrent.style.borderColor = 'var(--success-color)';
                btnCurrent.style.color = 'var(--success-color)'; btnCurrent.style.backgroundColor = '#d1fae5';
                btnCurrent.disabled = true;
            }
            
            if (org.next_month_locked) {
                btnNext.innerText = 'باز کردن قفل ماه آینده';
                btnNext.style.borderColor = 'var(--error-color)';
                btnNext.style.color = 'var(--error-color)'; btnNext.style.backgroundColor = 'transparent';
                btnNext.disabled = false;
            } else {
                btnNext.innerText = 'هنوز تایید نشده';
                btnNext.style.borderColor = 'var(--success-color)';
                btnNext.style.color = 'var(--success-color)'; btnNext.style.backgroundColor = '#d1fae5';
                btnNext.disabled = true;
            }

            
            document.getElementById('cropperContainer').style.display = 'none';
            if(cropper) { cropper.destroy(); cropper = null; }
        }
                

        let pendingUnlockMonthType = null;
        function unlockEvents(monthType) {
            pendingUnlockMonthType = monthType;
            document.getElementById('unlockReason').value = 'لیست مناسبت‌ها برای تغییرات باز شد. لطفا اصلاحات را با دقت انجام داده و سپس تایید نهایی کنید';
            document.getElementById('unlockConfirmModal').style.display = 'flex';
        }
        
        function closeUnlockModal() {
            document.getElementById('unlockConfirmModal').style.display = 'none';
            pendingUnlockMonthType = null;
        }

        async function executeUnlock() {
            const reason = document.getElementById('unlockReason').value.trim();
            if (!reason) {
                if(window.showToast) window.showToast('وارد کردن پیام تایید الزامی است', 'error');
                return;
            }
            
            const orgId = document.getElementById('orgId').value;
            if(!orgId || !pendingUnlockMonthType) return;
            
            const btn = document.querySelector('#unlockConfirmModal .btn-primary');
            const originalText = btn.innerText;
            btn.innerText = 'در حال انجام...';
            btn.disabled = true;
            
            try {
                const res = await fetch('/api/unlock_events', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ org_id: orgId, type: pendingUnlockMonthType, reason: reason })
                });
                const data = await res.json();
                if(data.status === 'success') {
                    if(window.showToast) window.showToast('قفل با موفقیت باز شد', 'success');
                    closeUnlockModal();
                    document.getElementById('addOrgModal').style.display = 'none';
                    if (typeof loadOrganizations === 'function') loadOrganizations();
                } else {
                    if(window.showToast) window.showToast(data.message, 'error');
                }
            } catch(e) {
                if(window.showToast) window.showToast('خطا در برقراری ارتباط', 'error');
            } finally {
                btn.innerText = originalText;
                btn.disabled = false;
            }
        }

        async function toggleOrgActive(id, isActive) {
            try {
                await fetch('/api/manage_orgs', {
                    method: 'POST', headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ action: 'toggle_active', id: id, is_active: isActive })
                });
                loadOrganizations();
            } catch(err) { showToast('خطا در سرور', 'error'); }
        }
        
        async function deleteOrg(id) {
            if (!(await window.customConfirm("آیا از حذف این سازمان اطمینان دارید؟"))) return;
            try {
                const res = await fetch('/api/manage_orgs', {
                    method: 'POST', headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ action: 'delete', id: id })
                }).then(r => r.json());
                
                loadOrganizations();
                
                if (res.status === 'success' && res.bin_id) {
                    window.showToast('سازمان به سطل زباله منتقل شد', 'info', {
                        text: 'بازگردانی',
                        callback: async () => {
                            await fetch('/api/recycle_bin', {
                                method: 'POST', headers: {'Content-Type': 'application/json'},
                                body: JSON.stringify({ action: 'restore', bin_id: res.bin_id })
                            });
                            window.showToast('سازمان بازگردانی شد', 'success');
                            loadOrganizations();
                        }
                    });
                } else if (res.status === 'success') {
                    window.showToast('سازمان حذف شد', 'success');
                } else {
                    window.showToast(res.message || 'خطا در عملیات', 'error');
                }
            } catch(err) { showToast('خطا در سرور', 'error'); }
        }
    </script>

<script nonce="<%= nonce %>">
