<div class="modal-overlay" id="excelPreviewModal">
    <div class="modal-box" style="width: 100%; max-width: 800px; box-sizing: border-box; max-height: 90vh; display: flex; flex-direction: column;">
        <h3 style="margin-bottom: 15px; color: var(--text-dark);">پیش‌نمایش سازمان‌های اکسل</h3>
