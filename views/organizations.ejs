<script src="/assets/js/xlsx.full.min.js"></script>
<script nonce="<%= nonce %>">
    let pendingExcelOrgs = [];

    function openExcelGuideModal() {
        document.getElementById('excelGuideModal').style.display = 'flex';
    }

    function handleExcelImport(event) {
        const file = event.target.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = function(e) {
            const data = new Uint8Array(e.target.result);
            const workbook = XLSX.read(data, { type: 'array' });
            const sheetName = workbook.SheetNames[0];
            const worksheet = workbook.Sheets[sheetName];
            const json = XLSX.utils.sheet_to_json(worksheet, { header: 1 });
            
            if (json.length < 2) {
                showToast('فایل اکسل خالی است یا فرمت نامعتبر است', 'error');
                return;
            }

            // parse columns
            const headers = json[0].map(h => typeof h === 'string' ? h.trim() : h);
            const nameIdx = headers.indexOf('نام برند');
            const typeIdx = headers.indexOf('نوع قرارداد');
            const contactIdx = headers.indexOf('نام رابط');
            const phoneIdx = headers.indexOf('تلفن');
            const colorIdx = headers.indexOf('رنگ سازمانی (Hex)');

            if (nameIdx === -1) {
                showToast('ستون "نام برند" یافت نشد. لطفا راهنمای اکسل را مطالعه کنید.', 'error');
                return;
            }

            pendingExcelOrgs = [];
            
            for (let i = 1; i < json.length; i++) {
                const row = json[i];
                if (!row || row.length === 0 || !row[nameIdx]) continue;
                
                const org_name = String(row[nameIdx]).trim();
                const industry = typeIdx !== -1 && row[typeIdx] ? String(row[typeIdx]).trim() : 'سایر';
                const contact_name = contactIdx !== -1 && row[contactIdx] ? String(row[contactIdx]).trim() : '';
                const phone_number = phoneIdx !== -1 && row[phoneIdx] ? String(row[phoneIdx]).trim() : '';
                let color = colorIdx !== -1 && row[colorIdx] ? String(row[colorIdx]).trim() : '#6366F1';
                
                if (!color.startsWith('#')) color = '#' + color;

                pendingExcelOrgs.push({
                    org_name, industry, contact_name, phone_number, color
                });
            }

            if (pendingExcelOrgs.length === 0) {
                showToast('هیچ سازمانی در فایل یافت نشد', 'error');
                return;
            }

            showExcelPreview();
        };
        reader.readAsArrayBuffer(file);
        event.target.value = ''; // reset
    }

    function showExcelPreview() {
        const container = document.getElementById('excelPreviewContainer');
        container.innerHTML = '';
        
        pendingExcelOrgs.forEach((org, index) => {
            container.innerHTML += `
                <div style="margin-bottom: 15px; padding: 15px; background: rgba(128,128,128,0.05); border-radius: 10px; border: 1px solid var(--border-color); display: flex; gap: 15px; align-items: center;">
                    <div style="width: 40px; height: 40px; border-radius: 50%; background: ${org.color}; flex-shrink: 0; display: flex; align-items: center; justify-content: center; color: white; font-weight: bold;">
                        ${org.org_name.charAt(0)}
                    </div>
                    <div style="flex: 1; display: grid; grid-template-columns: 1fr 1fr; gap: 10px; font-size: 0.9rem;">
                        <div>نام: <span style="font-weight:bold;">${org.org_name}</span></div>
                        <div>نوع: <span style="font-weight:bold;">${org.industry}</span></div>
                        <div>رابط: <span style="font-weight:bold;">${org.contact_name || '-'}</span></div>
                        <div>تلفن: <span style="font-weight:bold;">${org.phone_number || '-'}</span></div>
                    </div>
                </div>
            `;
        });
        
        document.getElementById('excelPreviewModal').style.display = 'flex';
    }

    async function saveExcelOrgs() {
        if (pendingExcelOrgs.length === 0) return;
        
        if (window.showLoading) window.showLoading('در حال ذخیره...');
        try {
            const payload = {
                action: 'batch_add',
                orgs: pendingExcelOrgs
            };
            
            const res = await fetch('/api/manage_orgs', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify(payload)
            });
            const result = await res.json();
            
            if (window.hideLoading) window.hideLoading();
            
            if (result.status === 'success') {
                showToast('سازمان‌های اکسل با موفقیت ذخیره شدند', 'success');
                document.getElementById('excelPreviewModal').style.display = 'none';
                loadOrganizations();
            } else {
                showToast(result.message || 'خطا در ذخیره سازمان‌ها', 'error');
            }
        } catch(e) {
            if (window.hideLoading) window.hideLoading();
            showToast('خطا در ارتباط با سرور', 'error');
        }
    }
</script>

</body>
</html>