            "</div>";
        if (opts.show_notes && String(doc.notes || "").trim()) left += '<div class="box"><h4><i class=ai data-ic=notebook-pen></i> توضیحات</h4><div class="notes">' + esc(doc.notes) + "</div></div>";
        if (opts.show_payment && hasBank && !quote) {
