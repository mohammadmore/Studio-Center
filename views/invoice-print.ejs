        } catch (e) { note.textContent = "خطا در ارتباط با سرور."; }
    };
    window.sendToClient = async function () {
        if (!doc) return;
        var quote = doc.doc_type === "quote";
        var again = quote ? doc.status !== "draft" : !!doc.sent_at;
        var question = (again ? "این سند قبلاً برای کارفرما ارسال شده است. دوباره ارسال شود؟" : "پس از ارسال، کارفرما این " + (quote ? "پیش‌فاکتور" : "فاکتور") + " را در پنل خود می‌بیند و می‌تواند PDF آن را دریافت کند.");
        var ok = window.customConfirm ? await window.customConfirm(question) : confirm(question);
        if (!ok) return;
        try { await window.savePrintOptions(); } catch (e) {}
        var r = await fetch("/api/invoices", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ action: quote ? "send_quote" : "send_invoice", id: doc.id }) });
        var j = await r.json();
