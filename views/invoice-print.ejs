        readLetterheadInputs();
    }
    document.addEventListener("input", function (e) { if (e.target.closest && e.target.closest("#panel")) { readPanel(); render(); } });
    document.addEventListener("change", function (e) { if (e.target.closest && e.target.closest("#panel")) { readPanel(); render(); } });
    window.savePrintOptions = async function () {
        readPanel();
        var note = $("optNote");
        try {
            var r = await fetch("/api/invoices", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ action: "save_print_options", id: doc.id, print_options: opts }) });
            var j = await r.json();
