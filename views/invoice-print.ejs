                (bank.title ? '<div class="kv"><span>بانک</span><b>' + esc(bank.title) + "</b></div>" : "") +
                (bank.holder ? '<div class="kv"><span>صاحب حساب</span><b>' + esc(bank.holder) + "</b></div>" : "") +
