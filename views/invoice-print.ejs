    async function load() {
        var res = await fetch(dataUrl(), { cache: "no-store" }).then(function (r) { return r.json(); });
        if (res.status !== "success") throw new Error(res.message || "load");
        doc = res.data; org = res.organization;
        doc.org_id = org && org.id;
        viewing = res.viewing_version || null;
        render();
    }

    async function init() {
        if (!docId) { $("sheet").innerHTML = '<div class="state">سندی انتخاب نشده است.</div>'; return; }
        if (!IS_CLIENT) $("backLink").setAttribute("href", "invoice?id=" + encodeURIComponent(docId));
        try {
            var info = await fetch("/api/get_studio_info", { cache: "no-store" }).then(function (r) { return r.json(); }).catch(function () { return {}; });
            studio = (info && info.data) || {};
            lh = letterheadFromStudio();
            if ($("lhName")) Object.keys(LH).forEach(function (id) { $(id).value = lh[LH[id]] || ($(id).type === "color" ? "#6366f1" : ""); });
            var res = await fetch(dataUrl(), { cache: "no-store" }).then(function (r) { return r.json(); });
            if (res.status !== "success") { $("sheet").innerHTML = '<div class="state">' + esc(res.message || "سند پیدا نشد.") + "</div>"; return; }
            doc = res.data; org = res.organization; doc.org_id = org && org.id;
            viewing = res.viewing_version || null;
            if (viewing) {
                var ov = $("oldVersion");
                ov.hidden = false;
                ov.innerHTML = "<span><b>نسخه‌ی قدیمی:</b> نسخه‌ی " + fa(viewing.no) + " از " + fa(viewing.latest) + " — ذخیره‌شده در " + esc(when(viewing.saved_at)) + (viewing.saved_by ? " توسط " + esc(viewing.saved_by) : "") + '</span><a href="invoice-print?id=' + encodeURIComponent(docId) + '">نمایش آخرین نسخه</a>';
                if ($("panelBtn")) $("panelBtn").hidden = true;
            }
            opts = Object.assign(defaultOptions(), doc.print_options || {});
            if (q.get("theme") === "glass" || q.get("theme") === "plain") opts.theme = q.get("theme");
            if (q.get("paper") === "A4" || q.get("paper") === "A5") opts.paper = q.get("paper");
            syncControls();
            render();
            if (q.get("print") === "1") setTimeout(window.downloadPdf, 400);
        } catch (e) {
            console.error(e);
            $("sheet").innerHTML = '<div class="state">فاکتور بارگذاری نشد. صفحه را دوباره باز کنید.</div>';
        }
    }
    init();
})();
</script>
</body>
</html>
