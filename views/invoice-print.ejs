        if (opts.show_signature) h += '<section class="signs"><div class="sign">مهر و امضای ' + esc(lh.report_name || "استودیو") + '</div><div class="sign">مهر و امضای کارفرما</div></section>';

        var stamp = doc.status === "cancelled" ? '<span class="stamp void">باطل شد</span>' : (!quote && doc.status === "paid" ? '<span class="stamp">تسویه شد</span>' : "");
        h += '<footer class="thanks"><span>از اعتماد شما به ' + esc(lh.report_name || "ما") + " سپاسگزاریم.</span>" + stamp + "</footer>";

        $("sheet").innerHTML = h;
        document.title = docName() + " " + fa(doc.invoice_number) + (viewing ? " — نسخه " + fa(viewing.no) : "") + (org && org.org_name ? " — " + org.org_name : "");
        renderBankSwitch();
        var sb = $("sendBtn");
