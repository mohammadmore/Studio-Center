        try {
            await fetch("/api/invoices", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ action: "set_bank_account", id: doc.id, bank_account_id: id }) });
        } catch (err) {}
    });
    function when(iso) {
        if (!iso) return "—";
        try { return new Intl.DateTimeFormat("fa-IR", { year: "numeric", month: "2-digit", day: "2-digit", hour: "2-digit", minute: "2-digit" }).format(new Date(iso)); } catch (e) { return String(iso); }
    }

    // ───────── Render ─────────
    function docName() {
        return opts.title || (doc.doc_type === "quote" ? "پیش‌فاکتور" : "فاکتور");
    }
    function pageRules() {
        var a5 = opts.paper === "A5";
        var footer = opts.show_page_numbers
            ? '"' + (doc.doc_type === "quote" ? "پیش‌فاکتور" : "فاکتور") + " شماره " + fa(doc.invoice_number) + ' — صفحه " counter(page, persian) " از " counter(pages, persian)'
            : '""';
        $("pageRules").textContent =
            "@page { size: " + (a5 ? "A5" : "A4") + "; margin: " + (a5 ? "7mm 0 10mm" : "10mm 0 13mm") + ";" +
            " @bottom-center { content: " + footer + "; font-family: Vazirmatn, Tahoma, sans-serif; font-size: " + (a5 ? "7pt" : "8.5pt") + "; color: #64748b; } }";
    }
    function dueChip() {
        if (!opts.show_due) return "";
        if (doc.status === "cancelled") return '<span class="chip bad">لغو شده</span>';
        if (doc.doc_type === "invoice" && (doc.status === "paid" || (num(doc.total) > 0 && num(doc.paid_amount) >= num(doc.total)))) return '<span class="chip good"><i class=ai data-ic=circle-check></i> پرداخت شده</span>';
        var due = normDate(doc.due_date);
        if (!due) return "";
        var today = todayJalali();
        if (today && due < today && doc.doc_type === "invoice") return '<span class="chip bad"><i class=ai data-ic=alarm-clock></i> سررسید گذشته — ' + fa(due) + "</span>";
        return '<span class="chip due"><i class=ai data-ic=hourglass></i> ' + (doc.doc_type === "quote" ? "اعتبار تا " : "مهلت پرداخت: ") + fa(due) + "</span>";
    }
    function render() {
        if (!doc) return;
        var plain = opts.theme === "plain";
        var html = document.documentElement;
        html.setAttribute("data-inv-theme", plain ? "plain" : "glass");
        html.setAttribute("data-paper", opts.paper === "A5" ? "A5" : "A4");
        html.style.setProperty("--accent", plain ? "#111827" : (safeColor(lh.report_accent) || "#6366f1"));
        pageRules();

        var cur = doc.currency === "rial" ? "ریال" : "تومان";
        var quote = doc.doc_type === "quote";
        var logo = safeUrl(studio.logo_light || studio.logo);
        var contact = [lh.report_phone && ('<i class=ai data-ic=phone></i> <span dir="ltr">' + esc(fa(lh.report_phone)) + "</span>"), lh.report_email && ('<span dir="ltr">' + esc(lh.report_email) + "</span>"), lh.report_website && ('<span dir="ltr">' + esc(lh.report_website) + "</span>"), lh.report_address && esc(lh.report_address)].filter(Boolean);
        var items = doc.items || [];
        var showPlat = !!opts.show_platform;
        var subtotal = num(doc.subtotal) || items.reduce(function (s, it) { return s + num(it.row_total != null ? it.row_total : num(it.qty) * num(it.unit_price)); }, 0);
        var tax = num(doc.tax), discount = num(doc.discount), total = num(doc.total) || (subtotal + tax - discount), paid = num(doc.paid_amount);
        var remain = Math.max(0, total - paid);
        var orgLogo = org && safeUrl(org.logo_url);

        var h = "";
        h += '<header class="letterhead"><div class="lh-studio">' +
            (opts.show_logo && logo ? '<img class="lh-logo" src="' + esc(logo) + '" alt="">' : "") +
            '<div><div class="lh-name">' + esc(lh.report_name || "استودیو") + "</div>" + (lh.report_subtitle ? '<div class="lh-sub">' + esc(lh.report_subtitle) + "</div>" : "") + "</div></div>" +
            (contact.length ? '<div class="lh-contact">' + contact.map(function (b) { return "<div>" + b + "</div>"; }).join("") + "</div>" : "") +
            "</header>";

        h += '<section class="doc-head"><h1 class="doc-title">' + esc(docName()) + "<small>" + (quote ? "پیش‌فاکتور" : "فاکتور") + " شماره " + fa(doc.invoice_number) + "</small></h1>" +
            '<div class="chips">' + (viewing ? '<span class="chip ver">نسخه‌ی ' + fa(viewing.no) + " — " + esc(when(viewing.saved_at)) + "</span>" : "") + (doc.status === "draft" ? '<span class="chip">پیش‌نویس</span>' : "") + dueChip() + "</div></section>";

        h += '<section class="parties"><div class="box"><div class="label">' + (quote ? "پیشنهاد برای" : "صورتحساب برای") + '</div><div class="client">' +
            (org ? (orgLogo ? '<img src="' + esc(orgLogo) + '" alt="" data-fallback-icon="building-2">' : '<span class="avatar" style="' + (plain ? "" : "background:" + (safeColor(org.color) || "var(--accent)")) + '">' + esc((org.org_name || "؟").charAt(0)) + "</span>") : "") +
            '<div style="min-width:0"><div class="big">' + esc((org && org.org_name) || "—") + "</div>" +
            (org && (org.contact_name || org.phone) ? '<div class="line">' + [org.contact_name && esc(org.contact_name), org.phone && ('<span dir="ltr">' + esc(fa(org.phone)) + "</span>")].filter(Boolean).join(" — ") + "</div>" : "") +
            "</div></div></div>" +
            '<div class="box"><div class="kv"><span>شماره</span><b>' + fa(doc.invoice_number) + "</b></div>" +
            '<div class="kv"><span>تاریخ صدور</span><b>' + (doc.issue_date ? fa(doc.issue_date) : "—") + "</b></div>" +
            (doc.due_date ? '<div class="kv"><span>' + (quote ? "اعتبار تا" : "سررسید") + "</span><b>" + fa(doc.due_date) + "</b></div>" : "") +
            '<div class="kv"><span>وضعیت</span><b>' + esc(STATUS[doc.status] || doc.status || "—") + "</b></div></div></section>";

        h += '<div class="table-card"><table class="items"><thead><tr><th>#</th><th>شرح خدمات</th>' + (showPlat ? "<th>پلتفرم</th>" : "") +
            '<th class="num">تعداد</th><th class="num">فی (' + cur + ')</th><th class="num">مبلغ (' + cur + ")</th></tr></thead><tbody>" +
            (items.length ? items.map(function (it, i) {
                var qty = num(it.qty) || 0, unit = num(it.unit_price), rt = it.row_total != null ? num(it.row_total) : qty * unit;
                return '<tr class="' + (rt < 0 ? "neg" : "") + '"><td class="n">' + fa(i + 1) + '</td><td class="desc">' + esc(it.type || it.title || "") + "</td>" +
                    (showPlat ? '<td class="plat">' + esc(it.platform && it.platform !== "بدون پلتفرم" && it.platform !== "---" ? it.platform : "—") + "</td>" : "") +
                    '<td class="num">' + fa(qty) + '</td><td class="num">' + money(unit) + '</td><td class="num total">' + money(rt) + "</td></tr>";
            }).join("") : '<tr><td colspan="' + (showPlat ? 6 : 5) + '" style="text-align:center; color:var(--muted); padding:18px;">قلمی ثبت نشده است.</td></tr>') +
            "</tbody></table></div>";

        var acc = currentAccount() || {};
        var bank = { holder: acc.holder || "", card: acc.card || "", shaba: acc.shaba || "", title: acc.title || "" };
        var hasBank = bank.holder || bank.card || bank.shaba;
        var groupCard = function (c) { return fa(latin(c).replace(/\D/g, "").replace(/(\d{4})(?=\d)/g, "$1 ")); };
        var shaba = latin(bank.shaba).replace(/\s+/g, "").toUpperCase();
