    };

    // ───────── Bank accounts (several in basic settings; one click switches) ─────────
    function accounts() {
        if (Array.isArray(studio.bank_accounts) && studio.bank_accounts.length) return studio.bank_accounts;
        if (studio.shaba || studio.card_number || studio.account_holder) return [{ id: "main", title: "", holder: studio.account_holder || studio.manager_name || "", card: studio.card_number || "", shaba: studio.shaba || "", is_default: true }];
        return [];
    }
    function currentAccount() {
        var list = accounts();
        return list.find(function (a) { return doc && a.id === doc.bank_account_id; }) || list.find(function (a) { return a.is_default; }) || list[0] || null;
    }
    function renderBankSwitch() {
        var box = $("bankSwitch");
        if (!box) return;
        var list = accounts(), cur = currentAccount();
        box.hidden = !CAN_EDIT || viewing || list.length < 2 || !doc || doc.doc_type === "quote";
        if (box.hidden) return;
        box.innerHTML = '<span class="bank-label">حساب پرداخت:</span>' + list.map(function (a) {
            return '<button type="button" aria-pressed="' + String(cur && a.id === cur.id) + '" data-acc="' + esc(a.id) + '" title="' + esc([a.holder, a.card].filter(Boolean).join(" — ")) + '">' + esc(a.title || a.holder || "حساب") + "</button>";
        }).join("");
    }
    document.addEventListener("click", async function (e) {
        var b = e.target.closest && e.target.closest("#bankSwitch [data-acc]");
