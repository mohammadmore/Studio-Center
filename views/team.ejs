                    <label>سطح دسترسی (نقش):</label>
                    <select id="roleId" class="form-control" required>
                        <option value="">در حال لود نقش‌ها...</option>
                    </select>
                </div>

                <div style="display: flex; gap: 10px; margin-top: 25px;">
                    <button type="submit" id="saveBtn" class="btn-primary" style="flex: 1;"><svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align: middle; margin-left: 4px;'><path d='M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z'/><polyline points='17 21 17 13 7 13 7 21'/><polyline points='7 3 7 8 15 8'/></svg> ایجاد حساب</button>
                    <button type="button" class="btn-outline"  onclick="closeModal()" style="flex: 1;">انصراف</button>
