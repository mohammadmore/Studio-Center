    <style nonce="<%= nonce %>">
        .user-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-top: 20px; min-width: 0; }
        .user-card { background: var(--card-bg); border: 1px solid var(--border-color); padding: 20px; border-radius: 12px; display: flex; flex-direction: column; position: relative; transition: 0.2s; min-width: 0; }
        .user-card:hover { border-color: var(--primary-color); box-shadow: 0 5px 15px rgba(0,0,0,0.05); transform: translateY(-3px); }
        .user-header { display: flex; align-items: center; gap: 15px; margin-bottom: 15px; border-bottom: 1px solid var(--border-color); padding-bottom: 15px; }
        .avatar { width: 55px; height: 55px; border-radius: 50%; object-fit: cover; border: 2px solid var(--border-color); flex-shrink: 0; }
        .avatar-fallback { width: 55px; height: 55px; border-radius: 50%; background: rgba(99, 102, 241, 0.15); color: var(--primary-color); display: flex; justify-content: center; align-items: center; font-size: 1.5rem; font-weight: bold; border: 2px solid var(--border-color); flex-shrink: 0; }
        
        @media (max-width: 1400px) { .user-grid { grid-template-columns: repeat(3, 1fr); } }
        @media (max-width: 1024px) { .user-grid { grid-template-columns: repeat(2, 1fr); } }
        @media (max-width: 640px) { .user-grid { grid-template-columns: 1fr; } }
        
        .role-badge { display: inline-block; padding: 3px 10px; background: rgba(128, 128, 128, 0.05); color: var(--text-gray); border-radius: 6px; font-size: 0.8rem; font-weight: bold; border: 1px solid var(--border-color); }
        .role-badge.admin { background: rgba(239, 68, 68, 0.15); color: var(--error-color); border-color: rgba(239, 68, 68, 0.3); }
        
        .btn-delete { position: absolute; left: 15px; top: 15px; background: rgba(128, 128, 128, 0.05); color: var(--text-gray); border: 1px solid var(--border-color); padding: 5px 10px; border-radius: 6px; cursor: pointer; font-size: 0.8rem; font-weight: bold; transition: 0.2s; }
        .btn-delete:hover { background: rgba(239, 68, 68, 0.15); color: var(--error-color); border-color: rgba(239, 68, 68, 0.3); }
        
        .modal-overlay { display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(15, 23, 42, 0.7); backdrop-filter: blur(5px); justify-content: center; align-items: center; z-index: 1000; }
        .modal-box { background: var(--card-bg); width: 90%; width: 100%; max-width: 500px; box-sizing: border-box; padding: 30px; border-radius: 15px; max-height: 90vh; overflow-y: auto;}
        
        .img-container { width: 100%; max-height: 300px; margin-bottom: 20px; display: none; background: rgba(128, 128, 128, 0.05); border-radius: 8px; overflow: hidden; }
        .img-container img { max-width: 100%; }
        .upload-trigger { border: 2px dashed var(--primary-color); padding: 15px; text-align: center; border-radius: 8px; background: rgba(128, 128, 128, 0.05); cursor: pointer; margin-bottom: 15px; color: var(--primary-color); font-weight: bold; font-size: 0.9rem;}
    </style>
</head>

