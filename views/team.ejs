    </div>

    <script src="assets/js/app.js?v=4"></script>
    <script nonce="<%= nonce %>">
        let cropper = null;
        
        let allRoles = [];
        function renderRoleOptions(isAdmin = false) {
            const sel = document.getElementById('roleId');
            if (!sel) return;
            sel.innerHTML = '';
            (allRoles || []).forEach(r => {
                if (r.name.includes('مدیر کل') && !isAdmin) return;
                sel.innerHTML += `<option value="${r.id}">${r.name}</option>`;
            });
        }
        
        async function loadRolesForSelect() {
            try {
                const res = await fetch('/api/manage_roles');
                const data = await res.json();
                if (data.status === 'success') {
                    allRoles = data.data;
                    renderRoleOptions(false);
                }
            } catch(e) {}
        }
        
        setTimeout( () => {
            loadRolesForSelect();
            loadUsers();
            jalaliDatepicker.startWatch({
                minDate: "attr",
                maxDate: "attr",
                time: false,
                hideAfterChange: true,
                hasHiddenInput: false
            });
        });
        


        
        let currentTab = 'active';
        let cachedUsersList = [];

        function switchTeamTab(tab) {
            currentTab = tab;
            const activeBtn = document.getElementById('tabActiveBtn');
            const archivedBtn = document.getElementById('tabArchivedBtn');

            if (tab === 'active') {
                activeBtn.className = 'btn-primary';
                activeBtn.style.background = '';
                activeBtn.style.color = '';

                archivedBtn.className = 'btn-outline';
                archivedBtn.style.background = 'var(--bg-color)';
                archivedBtn.style.borderColor = 'var(--text-gray)';
                archivedBtn.style.color = '#64748b';
            } else {
                archivedBtn.className = 'btn-primary';
                archivedBtn.style.background = '#64748b';
                archivedBtn.style.borderColor = '#64748b';
                archivedBtn.style.color = '#fff';

                activeBtn.className = 'btn-outline';
                activeBtn.style.background = 'var(--bg-color)';
                activeBtn.style.borderColor = 'var(--text-gray)';
                activeBtn.style.color = '#64748b';
            }
            renderUsers();
        }

        function filterTeam() {
            const query = (document.getElementById('searchTeam').value || '').toLowerCase();
            const cards = document.querySelectorAll('#usersContainer .user-card');
            cards.forEach(card => {
                const text = card.innerText.toLowerCase();
                card.style.display = text.includes(query) ? 'flex' : 'none';
            });
        }

        async function loadUsers() {
            try {
                const res = await fetch('/api/manage_users?include_inactive=1');
                const result = await res.json();
                
                if (result.status === 'error') {
                    document.getElementById('usersContainer').innerHTML = `<div style="grid-column: 1/-1; text-align: center; color: red; padding: 40px; font-weight: bold;"><svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align: middle; margin-left: 4px;'><circle cx='12' cy='12' r='10'/><path d='m4.9 4.9 14.2 14.2'/></svg> ${result.message}</div>`;
                    return;
                }

                cachedUsersList = result.data || [];
                
                const activeUsers = cachedUsersList.filter(u => u.is_active !== 0);
                const archivedUsers = cachedUsersList.filter(u => u.is_active === 0);

                document.getElementById('activeCount').innerText = window.toPersianDigits(activeUsers.length);
                document.getElementById('archivedCount').innerText = window.toPersianDigits(archivedUsers.length);

                renderUsers();
            } catch(e) { console.error("خطا در لود همکاران", e); }
        }

        function renderUsers() {
            const container = document.getElementById('usersContainer');
            container.innerHTML = '';

            const list = cachedUsersList.filter(u => currentTab === 'active' ? (u.is_active !== 0) : (u.is_active === 0));

            if(list.length === 0) {
                const msg = currentTab === 'active' ? 'همکار فعالی یافت نشد.' : 'هیچ همکار غیرفعال یا آرشیو شده‌ای وجود ندارد.';
                const titleMsg = currentTab === 'active' ? 'همکار فعالی یافت نشد!' : 'همکار غیرفعالی وجود ندارد!';
                const subMsg = currentTab === 'active' ? 'با افزودن همکاران به سیستم، می‌توانید وظایف را به آن‌ها محول کنید و روند تولید محتوا را به صورت تیمی پیش ببرید.' : 'در حال حاضر هیچ یک از همکاران غیرفعال یا آرشیو نشده‌اند.';
                const ctaBtn = currentTab === 'active' ? `
                    <button class="btn-primary"  onclick="document.getElementById('addModal').style.display='flex'" style=""  >
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                        افزودن اولین همکار
                    </button>` : '';

                container.innerHTML = `
                    <div style="grid-column:1/-1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 60px 20px; text-align: center; background: var(--card-bg); border-radius: 16px; border: 1px dashed var(--border-color); margin-top: 20px;">
                        <div style="width: 80px; height: 80px; background: rgba(99, 102, 241, 0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-bottom: 20px;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--primary-color)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><line x1="19" y1="8" x2="19" y2="14"></line><line x1="22" y1="11" x2="16" y2="11"></line></svg>
                        </div>
                        <h3 style="font-size: 1.5rem; color: var(--text-dark); margin-bottom: 10px;">${titleMsg}</h3>
                        <p style="color: var(--text-gray); width: 100%; max-width: 400px; box-sizing: border-box; margin-bottom: 25px; line-height: 1.6;">${subMsg}</p>
                        ${ctaBtn}
                    </div>`;
                return;
            }

            list.forEach(user => {
                const roleObj = allRoles.find(r => r.id === user.role_id);
                const roleName = roleObj ? roleObj.name : user.role_name;
                const isAdmin = roleName && roleName.includes('مدیر کل');
                const badgeClass = isAdmin ? 'role-badge admin' : 'role-badge';
                
                let avatarHTML = '';
                if (user.avatar_url && user.avatar_url !== '') {
                    avatarHTML = `<img src="${user.avatar_url}" class="avatar" alt="Avatar" loading="lazy">`;
                } else {
                    const firstChar = user.full_name ? user.full_name.charAt(0) : `<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align: middle; margin-left: 4px;'><path d='M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2'/><circle cx='12' cy='7' r='4'/></svg>`;
                    avatarHTML = `<div class="avatar-fallback">${firstChar}</div>`;
                }

                let extraInfo = '';
                if (user.phone) extraInfo += `<div><span style="color: var(--text-gray);">موبایل: </span><span style="font-weight: 500; color: var(--text-gray); direction: ltr; display: inline-block;">${window.toPersianDigits(user.phone)}</span></div>`;
                if (user.work_type) extraInfo += `<div><span style="color: var(--text-gray);">نوع همکاری: </span><span style="font-weight: 600; color: #0284c7;">${user.work_type}</span></div>`;
                
                let actionButtonsHTML = '';
                if (user.is_active !== 0) {
                    actionButtonsHTML = `
                        <div style="position: absolute; left: 10px; top: 10px; display: flex; gap: 5px;">
                            <button onclick="editUser(${user.id})" style="background: none; border: none; font-size: 1.2rem; cursor: pointer; color: var(--primary-color); display: inline-flex; align-items: center; justify-content: center; padding: 4px;" title="ویرایش مشخصات همکار">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-edit-3"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
                            </button>
                            <button class="btn-delete" onclick="deleteUser(${user.id})" style="position: static;" title="غیرفعال کردن و انتقال به آرشیو"><svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align: middle;'><path d='M18 6 6 18'/><path d='m6 6 12 12'/></svg></button>
                        </div>
                    `;
                } else {
                    actionButtonsHTML = `
                        <div style="position: absolute; left: 10px; top: 10px; display: flex; gap: 5px; align-items: center;">
                            <button onclick="editUser(${user.id})" style="background: none; border: none; font-size: 1.1rem; cursor: pointer; color: var(--primary-color); display: inline-flex; align-items: center; justify-content: center; padding: 4px;" title="ویرایش مشخصات">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-edit-3"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
                            </button>
                            <button onclick="restoreUser(${user.id})" style="background: var(--success-color); color: white; border: none; padding: 5px 11px; border-radius: 6px; font-weight: bold; font-size: 0.8rem; cursor: pointer; display: flex; align-items: center; gap: 4px; box-shadow: 0 2px 4px rgba(16,185,129,0.25);" title="فعالسازی مجدد">
                                <svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align: middle; margin-left: 4px;'><path d='M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8'/><path d='M3 3v5h5'/></svg> فعالسازی
                            </button>
                        </div>
                    `;
                }

                const statusBadge = user.is_active === 0 ? `<span style="background: rgba(239, 68, 68, 0.15); color: #dc2626; font-size: 0.72rem; padding: 2px 8px; border-radius: 4px; font-weight: bold; border: 1px solid rgba(239, 68, 68, 0.3);">غیرفعال / آرشیو</span>` : '';

                container.innerHTML += `
                    <div class="user-card searchable-item" style="${user.is_active === 0 ? 'opacity: 0.88; background: #fafafa; border-style: dashed;' : ''}">
                        ${actionButtonsHTML}
                        <div class="user-header">
                            ${avatarHTML}
                            <div>
                                <div style="font-weight: bold; font-size: 1.1rem; color: var(--text-dark); display: flex; align-items: center; gap: 8px;">
                                    ${user.full_name}
                                    ${statusBadge}
                                </div>
                                <div style="display: flex; gap: 5px; margin-top: 5px; align-items: center;"><div class="${badgeClass}">${roleName}</div><button onclick="reorderUser(${user.id}, 'up')" style="background: #f3f4f6; color: #4b5563; border: 1px solid #d1d5db; padding: 2px 6px; border-radius: 4px; cursor: pointer; font-size: 0.9rem; line-height: 1;" title="بالا">↑</button><button onclick="reorderUser(${user.id}, 'down')" style="background: #f3f4f6; color: #4b5563; border: 1px solid #d1d5db; padding: 2px 6px; border-radius: 4px; cursor: pointer; font-size: 0.9rem; line-height: 1;" title="پایین">↓</button></div>
                            </div>
                        </div>
                        <div style="background: rgba(128, 128, 128, 0.05); padding: 10px; border-radius: 8px; font-size: 0.88rem; display: flex; flex-direction: column; gap: 4px;">
                            <div>
                                <span style="color: var(--text-gray);">نام کاربری: </span>
                                <span style="font-weight: bold; color: var(--primary-color); direction: ltr; display: inline-block;">${user.username}</span>
                            </div>
                            ${extraInfo}
                        </div>
                    </div>
                `;
            });

            filterTeam();
        }

        let editingUserId = null;
        let avatarDeleted = false;
        function removeCurrentAvatar() {
            avatarDeleted = true;
            document.getElementById('currentAvatarPreview').style.display = 'none';
        }
        function openModal() { 
            editingUserId = null;
            document.getElementById('modalTitle').innerText = '+ تعریف حساب کاربری و پروفایل جدید';
            document.getElementById('saveBtn').innerHTML = `<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align: middle; margin-left: 4px;'><path d='M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z'/><polyline points='17 21 17 13 7 13 7 21'/><polyline points='7 3 7 8 15 8'/></svg> ایجاد حساب`;
            document.getElementById('password').required = true;
            document.getElementById('userForm').reset();
            avatarDeleted = false;
            document.getElementById('currentAvatarPreview').style.display = 'none';
            if (typeof renderRoleOptions === 'function') renderRoleOptions(false);
            document.getElementById('roleId').disabled = false;
            if(document.getElementById('roleId').parentElement) {
                document.getElementById('roleId').parentElement.title = "";
                document.getElementById('roleId').parentElement.style.cursor = "default";
            }
            document.getElementById('cropperContainer').style.display = 'none';
            if(cropper) { cropper.destroy(); cropper = null; }
            document.getElementById('addUserModal').style.display = 'flex';
        }
        
        async function reorderUser(id, direction) {
            try {
                if (window.showLoading) window.showLoading("در حال جابجایی...");
                const res = await fetch('/api/manage_users', {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ action: "reorder", id: id, direction: direction })
                });
                const data = await res.json();
                if(data.status === "success") {
                    await loadUsers();
                } else {
                    if (window.showToast) window.showToast(data.message || "خطا در جابجایی", "error");
                }
            } catch(e) {
                if (window.showToast) window.showToast("خطا در ارتباط با سرور", "error");
            } finally {
                if (window.hideLoading) window.hideLoading();
            }
        }

        async function editUser(id) {
            try {
                const res = await fetch('/api/manage_users?include_inactive=1');
                const result = await res.json();
                if(result.status === 'success') {
                    const user = result.data.find(u => u.id === id);
                    if(user) {
                        editingUserId = user.id;
                        
                        if (user.full_name) {
                            const nameParts = user.full_name.split(' ');
                            if (nameParts.length > 1) {
                                document.getElementById('firstName').value = nameParts[0];
                                document.getElementById('lastName').value = nameParts.slice(1).join(' ');
                            } else {
                                document.getElementById('firstName').value = user.full_name;
                                document.getElementById('lastName').value = '';
                            }
                        } else {
                            document.getElementById('firstName').value = '';
                            document.getElementById('lastName').value = '';
                        }
                        document.getElementById('phone').value = user.phone || '';
                        document.getElementById('email').value = user.email || '';
                        document.getElementById('portfolio').value = user.portfolio || '';
                        document.getElementById('username').value = user.username || '';
                        document.getElementById('password').value = '';
                        document.getElementById('password').required = false;

                        document.getElementById('workType').value = user.work_type || 'تمام‌وقت (حضوری)';
                        document.getElementById('capacity').value = user.capacity || '';
                        document.getElementById('startDate').value = user.start_date || user.startDate || '';
                        document.getElementById('shaba').value = user.shaba || '';
                        const roleObj = allRoles.find(r => r.id == user.role_id);
                        const rName = roleObj ? roleObj.name : (user.role_name || '');
                        
                        if (rName.includes('مدیر کل')) {
                            if (typeof renderRoleOptions === 'function') renderRoleOptions(true);
                            document.getElementById('roleId').value = user.role_id || '';
                        document.getElementById('gender').value = user.gender || 'male';
                            document.getElementById('roleId').disabled = true;
                            if (document.getElementById('roleId').parentElement) {
                                document.getElementById('roleId').parentElement.title = "بدلیل مسائل امنیتی، تغییر سطح دسترسی مدیر کل امکان‌پذیر نیست.";
                                document.getElementById('roleId').parentElement.style.cursor = "not-allowed";
                            }
                        } else {
                            if (typeof renderRoleOptions === 'function') renderRoleOptions(false);
                            document.getElementById('roleId').value = user.role_id || '';
                            document.getElementById('roleId').disabled = false;
                            if (document.getElementById('roleId').parentElement) {
                                document.getElementById('roleId').parentElement.title = "";
                                document.getElementById('roleId').parentElement.style.cursor = "default";
                            }
                        }
                        
                        document.getElementById('modalTitle').innerText = 'ویرایش مشخصات همکار';
                        document.getElementById('saveBtn').innerHTML = `<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align: middle; margin-left: 4px;'><path d='M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z'/><polyline points='17 21 17 13 7 13 7 21'/><polyline points='7 3 7 8 15 8'/></svg> ذخیره تغییرات`;
                        
                        avatarDeleted = false;
                        if (user.avatar_url && !user.avatar_url.includes('data:image/svg+xml')) {
                            document.getElementById('currentAvatarImg').src = user.avatar_url;
                            document.getElementById('currentAvatarPreview').style.display = 'flex';
                        } else {
                            document.getElementById('currentAvatarPreview').style.display = 'none';
                        }
                        
                        document.getElementById('addUserModal').style.display = 'flex';
                        document.getElementById('cropperContainer').style.display = 'none';
                        if(cropper) { cropper.destroy(); cropper = null; }
                    }
                }
            } catch(e) { console.error(e); }
        }
        function closeModal() { document.getElementById('addUserModal').style.display = 'none'; }

        function initCropper(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    const img = document.getElementById('imageToCrop');
                    img.src = e.target.result;
                    document.getElementById('cropperContainer').style.display = 'block';
                    
                    if (cropper) cropper.destroy();
                    cropper = new Cropper(img, { aspectRatio: 1, viewMode: 1 });
                }
                reader.readAsDataURL(input.files[0]);
            }
        }

        async function saveUser(e) {
            e.preventDefault();
            const btn = document.getElementById('saveBtn');
            btn.innerHTML = editingUserId ? `<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align: middle; margin-left: 4px;'><path d='M5 22h14'/><path d='M5 2h14'/><path d='M17 22v-4.172a2 2 0 0 0-.586-1.414L12 12l-4.414 4.414A2 2 0 0 0 7 17.828V22'/><path d='M7 2v4.172a2 2 0 0 0 .586 1.414L12 12l4.414-4.414A2 2 0 0 0 17 6.172V2'/></svg> در حال ذخیره تغییرات...` : `<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align: middle; margin-left: 4px;'><path d='M5 22h14'/><path d='M5 2h14'/><path d='M17 22v-4.172a2 2 0 0 0-.586-1.414L12 12l-4.414 4.414A2 2 0 0 0 7 17.828V22'/><path d='M7 2v4.172a2 2 0 0 0 .586 1.414L12 12l4.414-4.414A2 2 0 0 0 17 6.172V2'/></svg> در حال ساخت اکانت...`;
            btn.disabled = true;

            let finalAvatarUrl = avatarDeleted ? 'DELETE' : '';

            // اگر عکس انتخاب و کراپ شده بود، اول آپلودش کن
            if (cropper) {
                btn.innerHTML = `<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align: middle; margin-left: 4px;\"><path d=\"M5 22h14\"/><path d=\"M5 2h14\"/><path d=\"M17 22v-4.172a2 2 0 0 0-.586-1.414L12 12l-4.414 4.414A2 2 0 0 0 7 17.828V22\"/><path d=\"M7 2v4.172a2 2 0 0 0 .586 1.414L12 12l4.414-4.414A2 2 0 0 0 17 6.172V2\"/></svg> در حال آپلود عکس...`;
                const canvas = cropper.getCroppedCanvas({ width: 200, height: 200 });
                const base64Image = canvas.toDataURL('image/jpeg', 0.8);
                
                try {
                    const uploadRes = await fetch('/api/upload_image', {
                        method: 'POST', headers: {'Content-Type': 'application/json'},
                        body: JSON.stringify({ image: base64Image })
                    });
                    const uploadData = await uploadRes.json();
                    if (uploadData.status === 'success') {
                        finalAvatarUrl = uploadData.url;
                    } else {
                        showToast("خطا در آپلود تصویر پروفایل.", 'error');
                        btn.innerHTML = editingUserId ? `<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align: middle; margin-left: 4px;'><path d='M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z'/><polyline points='17 21 17 13 7 13 7 21'/><polyline points='7 3 7 8 15 8'/></svg> ذخیره تغییرات` : `<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align: middle; margin-left: 4px;'><path d='M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z'/><polyline points='17 21 17 13 7 13 7 21'/><polyline points='7 3 7 8 15 8'/></svg> ایجاد حساب`; btn.disabled = false;
                        return;
                    }
                } catch(err) {
                    showToast("خطای شبکه در آپلود تصویر.", 'error');
                    btn.innerHTML = editingUserId ? `<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align: middle; margin-left: 4px;'><path d='M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z'/><polyline points='17 21 17 13 7 13 7 21'/><polyline points='7 3 7 8 15 8'/></svg> ذخیره تغییرات` : `<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align: middle; margin-left: 4px;'><path d='M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z'/><polyline points='17 21 17 13 7 13 7 21'/><polyline points='7 3 7 8 15 8'/></svg> ایجاد حساب`; btn.disabled = false;
                    return;
                }
            }

            btn.innerHTML = `<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align: middle; margin-left: 4px;\"><path d=\"M5 22h14\"/><path d=\"M5 2h14\"/><path d=\"M17 22v-4.172a2 2 0 0 0-.586-1.414L12 12l-4.414 4.414A2 2 0 0 0 7 17.828V22\"/><path d=\"M7 2v4.172a2 2 0 0 0 .586 1.414L12 12l4.414-4.414A2 2 0 0 0 17 6.172V2\"/></svg> در حال ذخیره اطلاعات...`;

            const payload = {
                action: editingUserId ? 'edit' : 'add',
                id: editingUserId,
                full_name: document.getElementById('firstName').value + ' ' + document.getElementById('lastName').value,
                phone: document.getElementById('phone').value,
                email: document.getElementById('email').value,
                portfolio: document.getElementById('portfolio').value,
                username: document.getElementById('username').value,
                password: document.getElementById('password').value,
                workType: document.getElementById('workType').value,
                capacity: document.getElementById('capacity').value,
                startDate: document.getElementById('startDate').value,
                shaba: document.getElementById('shaba').value,
                role_id: document.getElementById('roleId').value,
                gender: document.getElementById('gender').value,
                avatar_url: finalAvatarUrl
            };
            if(editingUserId && !payload.password) delete payload.password;


            try {
                const res = await fetch('/api/manage_users', {
                    method: 'POST', headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify(payload)
                });
                const data = await res.json();
                
                if (data.status === 'success') {
                    closeModal();
                    loadUsers(); 
                } else showToast(`<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align: middle; margin-left: 4px;'><path d='M18 6 6 18'/><path d='m6 6 12 12'/></svg> ` + data.message);
            } catch(err) { showToast('خطا در ارتباط با سرور', 'error'); }
            finally { btn.innerHTML = editingUserId ? `<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align: middle; margin-left: 4px;'><path d='M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z'/><polyline points='17 21 17 13 7 13 7 21'/><polyline points='7 3 7 8 15 8'/></svg> ذخیره تغییرات` : `<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align: middle; margin-left: 4px;'><path d='M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z'/><polyline points='17 21 17 13 7 13 7 21'/><polyline points='7 3 7 8 15 8'/></svg> ایجاد حساب`; btn.disabled = false; }
        }

        async function deleteUser(id) {
            if(!(await window.customConfirm("آیا از غیرفعال کردن دسترسی این همکار و انتقال به آرشیو مطمئن هستید؟"))) return;
            try {
                const res = await fetch('/api/manage_users', {
                    method: 'POST', headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ action: 'delete', id: id })
                });
                const data = await res.json();
                if (data.status === 'success') {
                    showToast(`<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align: middle; margin-left: 4px;'><path d='M20 6 9 17l-5-5'/></svg> ` + data.message, 'success');
                    loadUsers();
                } else showToast(`<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align: middle; margin-left: 4px;'><path d='M18 6 6 18'/><path d='m6 6 12 12'/></svg> ` + data.message, 'error');
            } catch(err) { showToast('خطا در سرور', 'error'); }
        }

        async function restoreUser(id) {
            if(!(await window.customConfirm("آیا از فعالسازی مجدد و خروج این حساب کاربری از آرشیو مطمئن هستید؟"))) return;
            try {
                const res = await fetch('/api/manage_users', {
                    method: 'POST', headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ action: 'restore', id: id })
                });
                const data = await res.json();
                if (data.status === 'success') {
                    showToast(`<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align: middle; margin-left: 4px;'><path d='M20 6 9 17l-5-5'/></svg> ` + data.message, 'success');
                    loadUsers();
                } else {
                    showToast(`<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align: middle; margin-left: 4px;'><path d='M18 6 6 18'/><path d='m6 6 12 12'/></svg> ` + data.message, 'error');
                }
            } catch(e) { showToast('خطا در ارتباط با سرور', 'error'); }
        }
    </script>
</body>
</html>