    <div class="modal-box" style="width: 100%; max-width: 820px; max-height: 90vh; overflow-y: auto; box-sizing: border-box;">
        <h3 style="margin-bottom: 15px; color: var(--text-dark);">راهنمای اکسل مجموعه‌ها</h3>
        <div id="excelGuideBody"></div>
        <div style="display: flex; gap: 10px;"><button class="btn-primary" style="flex: 1;" onclick="document.getElementById('excelGuideModal').style.display='none'; document.getElementById('excelInput').click();">متوجه شدم، انتخاب فایل اکسل</button><button class="btn-outline" style="flex: 1;" onclick="document.getElementById('excelGuideModal').style.display='none'">بستن</button></div>
