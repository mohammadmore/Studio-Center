<!-- Excel Preview Modal -->
<div class="modal-overlay" id="excelPreviewModal">
    <div class="modal-box" style="width: 100%; max-width: 800px; box-sizing: border-box; max-height: 90vh; display: flex; flex-direction: column;">
        <h3 style="margin-bottom: 15px; color: var(--text-dark);">پیش‌نمایش مجموعه‌های اکسل</h3>
        <div id="excelPreviewContainer" style="overflow-y: auto; flex: 1; margin-bottom: 20px;">
            <!-- Preview items here -->
        </div>
        <div style="display: flex; gap: 10px;">
            <button type="button" class="btn-primary" style="flex: 1; font-size: 1.1rem; padding: 12px;" onclick="saveExcelCols()">ذخیره همه مجموعه‌ها</button>
            <button type="button" class="btn-outline"  onclick="document.getElementById('excelPreviewModal').style.display='none'" style="flex: 1;">انصراف</button>
        </div>
    </div>
</div>

<script>
    let pendingExcelCols = [];

    function openExcelGuideModal() {
        AsvaExcel.renderGuide('excelGuideBody', 'collections', { orgs: window.allOrgs, collections: window.allCollections });
        document.getElementById('excelGuideModal').style.display = 'flex';
    }

    async function handleExcelImport(event) {
        const file = event.target.files[0];
        event.target.value = '';
        const rows = await AsvaExcel.load(file, 'collections');
        if (!rows) return;
        pendingExcelCols = rows.map(r => ({ title: AsvaExcel.text(r.title), org: AsvaExcel.text(r.org), parent: AsvaExcel.text(r.parent) }));
        showExcelPreview();
    }

    function showExcelPreview() {
        const container = document.getElementById('excelPreviewContainer');
        container.innerHTML = '';
        
        pendingExcelCols.forEach((col, index) => {
            container.insertAdjacentHTML('beforeend', `
                <div style="margin-bottom: 15px; padding: 15px; background: rgba(128,128,128,0.05); border-radius: 10px; border: 1px solid var(--border-color); display: flex; gap: 15px; align-items: center;">
                    <div style="flex: 1; display: grid; grid-template-columns: 1fr 1fr; gap: 10px; font-size: 0.9rem;">
                        <div>عنوان: <span style="font-weight:bold;">${escapeHtml(col.title)}</span></div>
                        <div>برند: <span style="font-weight:bold;">${escapeHtml(col.org || 'بدون برند')}</span></div>
                        ${col.parent ? `<div>زیرمجموعه‌ی: <span style="font-weight:bold;">${escapeHtml(col.parent)}</span></div>` : ''}
                    </div>
                </div>
            `);
        });
        
        document.getElementById('excelPreviewModal').style.display = 'flex';
    }

    async function saveExcelCols() {
        if (pendingExcelCols.length === 0) return;
        
        if (window.showLoading) window.showLoading('در حال ذخیره...');
        try {
            const payload = {
                action: 'batch_add',
                cols: pendingExcelCols
            };
            
            const res = await fetch('/api/manage_collections', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify(payload)
            });
            const result = await res.json();
            
            if (window.hideLoading) window.hideLoading();
            
            if (result.status === 'success') {
                showToast(result.message || 'مجموعه‌های اکسل با موفقیت ذخیره شدند', 'success');
                document.getElementById('excelPreviewModal').style.display = 'none';
                loadData();
            } else {
                showToast(result.message || 'خطا در ذخیره مجموعه‌ها', 'error');
            }
        } catch(e) {
            if (window.hideLoading) window.hideLoading();
            showToast('خطا در ارتباط با سرور', 'error');
        }
    }
