                        <label style="font-size: 0.8rem; color: var(--text-gray); margin-bottom: 5px; display: block;">پلتفرم / بستر (خالی = بدون تغییر):</label>
                        <div class="multi-select" id="bulkPlatformContainer">
                            <input type="hidden" id="bulkPlatformValue" value="">
                            <div class="multi-select-display" onclick="toggleMultiSelect(this)">
