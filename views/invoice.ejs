    <script nonce="<%= nonce %>">
        function toPersianDigits(num) {
            if(!num && num !== 0) return '';
            const farsiDigits = ['۰', '۱', '۲', '۳', '۴', '۵', '۶', '۷', '۸', '۹'];
            return num.toString().replace(/\d/g, x => farsiDigits[x]);
        }
        function formatFarsiMoney(num) {
            return toPersianDigits(num.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ","));
        }

        function parseNumericInput(val) {
            if (!val && val !== 0) return 0;
            const persianToEnglish = s => s.toString().replace(/[۰-۹]/g, d => '۰۱۲۳۴۵۶۷۸۹'.indexOf(d));
            let clean = persianToEnglish(val.toString()).replace(/[^\d.]/g, '');
            return Number(clean) || 0;
        }

        window.availablePlatforms = [];
        let currentInvoiceData = {
            id: null,
            org_id: null,
            items: [],
            tax_percent: 0,
            discount: 0,
            paid_amount: 0,
            notes: ''
        };
        let currentOrganization = null;

        setTimeout( async () => {
            const urlParams = new URLSearchParams(window.location.search);
            const invoiceId = urlParams.get('id');

            // Load orgs
            try {
                const res = await fetch('/api/get_orgs', { cache: 'no-store' });
                const orgData = await res.json();
                const select = document.getElementById('orgSelector');
                (orgData.data || []).forEach(org => {
                    select.innerHTML += `<option value="${org.id}">${org.org_name}</option>`;
                });
            } catch (e) {
                console.error("Failed to load organizations:", e);
                if (typeof showToast === 'function') showToast('خطا در دریافت لیست سازمان‌ها.');
            }

            // Load platforms
            try {
                const pRes = await fetch('/api/manage_settings');
                const pResult = await pRes.json();
                if (pResult.status === 'success' && pResult.data && pResult.data.platform) {
                    window.availablePlatforms = pResult.data.platform.filter(p => p.is_active === 1 || p.is_active === undefined);
                    const bulkContainer = document.getElementById('bulkPlatformContainer');
                    if (bulkContainer) {
                        const dropdown = document.getElementById('bulkPlatformDropdown');
                        dropdown.innerHTML = '';
                        window.availablePlatforms.forEach(p => {
                            const name = p.setting_key || p.name || p.key;
                            dropdown.innerHTML += `<label><input type="checkbox" value="${name}" onchange="updateBulkMultiPlatform(this)"> ${name}</label>`;
                        });
                        dropdown.innerHTML += `<label><input type="checkbox" value="بدون پلتفرم" onchange="updateBulkMultiPlatform(this)"> بدون پلتفرم</label>`;
                    }
                    const platformSelect = document.getElementById('platformSelect');
                    if (platformSelect) {
                        window.availablePlatforms.forEach(p => {
                            const name = p.setting_key || p.name || p.key;
                            platformSelect.innerHTML += `<option value="${name}">${name}</option>`;
                        });
                        platformSelect.innerHTML += `<option value="بدون پلتفرم">بدون پلتفرم</option>`;
                    }
                }
                if (typeof renderItems === 'function') renderItems();
            } catch (e) { console.error("Error loading platforms", e); }
            
            // Load Studio info for header
            try {
                const sRes = await fetch('/api/get_studio_info');
                const sResult = await sRes.json();
                if (sResult.status === 'success' && sResult.data) {
                    const sd = sResult.data;
                    if (sd.name) {
                        document.getElementById('studioName').innerText = sd.name;
                        document.getElementById('footerStudioName').innerText = sd.name;
                    }
                    
                    const hasLight = !!sd.logo_light || !!sd.logo;
                    const hasDark = !!sd.logo_dark || !!sd.logo;
                    
                    if (hasLight) {
                        const logoL = document.getElementById('studioLogoLight');
                        logoL.src = sd.logo_light || sd.logo;
                        logoL.dataset.hasImage = "true";
                    }
                    if (hasDark) {
                        const logoD = document.getElementById('studioLogoDark');
                        logoD.src = sd.logo_dark || sd.logo_light || sd.logo;
                        logoD.dataset.hasImage = "true";
                    }
                    
                    window.updateInvoiceLogoDisplay = function() {
                        const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
                        const showLogoChecked = document.getElementById('showLogo') ? document.getElementById('showLogo').checked : true;
                        const showHeaderChecked = document.getElementById('showHeader') ? document.getElementById('showHeader').checked : true;
                        const shouldShow = showLogoChecked && showHeaderChecked;
                        
                        const logoL = document.getElementById('studioLogoLight');
                        const logoD = document.getElementById('studioLogoDark');
                        
                        if (logoL && logoL.dataset.hasImage === "true") logoL.style.display = (shouldShow && !isDark) ? 'block' : 'none';
                        if (logoD && logoD.dataset.hasImage === "true") logoD.style.display = (shouldShow && isDark) ? 'block' : 'none';
                    };
                    window.updateInvoiceLogoDisplay();
                    
                    // observer for theme changes
                    const observer = new MutationObserver((mutations) => {
                        mutations.forEach((mutation) => {
                            if (mutation.attributeName === 'data-theme') {
                                window.updateInvoiceLogoDisplay();
                            }
                        });
                    });
                    observer.observe(document.documentElement, { attributes: true });

                    if (sd.address) document.getElementById('studioAddress').innerText = 'آدرس: ' + sd.address;
                    
                    let contact = [];
                    if (sd.phone) contact.push('تلفن: ' + sd.phone);
                    if (sd.email) contact.push('ایمیل: ' + sd.email);
                    document.getElementById('studioContact').innerText = contact.join(' | ');
                    
                    let web = [];
                    if (sd.website) web.push(sd.website);
                    if (sd.instagram) web.push('Instagram: ' + sd.instagram);
                    document.getElementById('studioWeb').innerText = web.join(' | ');
                    
                    const accountHolder = sd.account_holder || sd.manager_name;
                    if (accountHolder) document.getElementById('footerManagerName').innerText = accountHolder;
                    if (sd.shaba) document.getElementById('shabaText').innerText = sd.shaba;
                    if (sd.card_number) document.getElementById('cardText').innerText = sd.card_number;
                }
            } catch(e) {}

            if (invoiceId) {
                // Load existing invoice
                loadInvoiceById(invoiceId);
            }
        });

        async function loadInvoiceById(id) {
            try {
                const response = await fetch(`/api/generate_invoice?invoice_id=${id}`);
                const data = await response.json();
                if(data.status === 'success') {
                    currentInvoiceData = {
                        id: data.invoice_id,
                        org_id: data.organization.id,
                        items: data.items || [],
                        tax_percent: 0,
                        discount: data.discount || 0,
                        paid_amount: data.paid_amount || 0,
                        notes: data.notes || ''
                    };
                    
                    // reverse-calculate tax percent for UI
                    if(data.tax > 0 && data.subtotal > 0) {
                        currentInvoiceData.tax_percent = Math.round((data.tax / data.subtotal) * 100);
                    }
                    
                    currentOrganization = data.organization;
                    
                    document.getElementById('orgSelector').value = data.organization.id;
                    document.getElementById('invNumber').innerText = toPersianDigits(data.invoice_number);
                    document.getElementById('invIssueDate').value = toPersianDigits(data.date || '');
                    document.getElementById('invDueDate').value = toPersianDigits(data.due_date || '');
                    document.getElementById('invStatus').value = data.status_name || 'draft';
                    document.getElementById('invNotes').value = data.notes || '';
                    document.getElementById('invTaxPercent').value = currentInvoiceData.tax_percent;
                    document.getElementById('invDiscount').value = currentInvoiceData.discount;
                    document.getElementById('invPaidAmount').value = currentInvoiceData.paid_amount;
                    
                    updateInvoiceUI();
                    setTimeout(toggleInvoiceParts, 100);
                } else showToast(data.message);
            } catch(e) { console.error(e); if (typeof showToast === 'function') showToast('خطای شبکه. لطفا دوباره تلاش کنید.', 'error'); }
        }

        
        jalaliDatepicker.startWatch({
            minDate: "attr",
            maxDate: "attr",
            time: false
        });

                function toggleDraftTimeInputs() {
            const noLimit = document.getElementById('draftNoTimeLimit').checked;
            const sDate = document.getElementById('draftStartDate');
            const eDate = document.getElementById('draftEndDate');
            sDate.disabled = noLimit;
            eDate.disabled = noLimit;
            if (noLimit) {
                sDate.dataset.prev = sDate.value;
                eDate.dataset.prev = eDate.value;
                sDate.value = '--/--/----';
                eDate.value = '--/--/----';
                sDate.style.backgroundColor = '#f3f4f6';
                eDate.style.backgroundColor = '#f3f4f6';
            } else {
                sDate.value = sDate.dataset.prev || '';
                eDate.value = eDate.dataset.prev || '';
                sDate.style.backgroundColor = '';
                eDate.style.backgroundColor = '';
            }
        }

        async function onDraftOrgChange() {
            const orgId = document.getElementById('orgSelector').value;
            const colSelect = document.getElementById('colSelect');
            if (colSelect) colSelect.innerHTML = '<option value="">همه مجموعه‌ها</option>';
            
            if (!orgId) return;
            
            try {
                const res = await fetch(`/api/get_collections?org_id=${orgId}`);
                const data = await res.json();
                if (data.status === 'success' && data.data && colSelect) {
                    data.data.forEach(col => {
                        colSelect.innerHTML += `<option value="${col.id}">${col.title}</option>`;
                    });
                }
            } catch(e) { console.error(e); if (typeof showToast === 'function') showToast('خطای شبکه. لطفا دوباره تلاش کنید.', 'error'); }
        }

        async function generateDraft() {
            const orgId = document.getElementById('orgSelector').value;
            if(!orgId) {
                if(typeof showToast === 'function') showToast('لطفا یک کارفرما انتخاب کنید.', 'warning');
                return;
            }
            
            const colId = document.getElementById('colSelect').value;
            const status = document.getElementById('statusSelect').value;
            const platform = document.getElementById('platformSelect').value;
            let startDate = document.getElementById('draftStartDate').value;
            let endDate = document.getElementById('draftEndDate').value;
            if (startDate === '--/--/----') startDate = '';
            if (endDate === '--/--/----') endDate = '';
            const noTimeLimit = document.getElementById('draftNoTimeLimit').checked;
            
            let url = `/api/generate_invoice?org_id=${orgId}`;
            if (colId) url += `&col_id=${colId}`;
            if (status) url += `&status=${status}`;
            if (platform) url += `&platform=${encodeURIComponent(platform)}`;
            if (!noTimeLimit) {
                if (startDate) url += `&start_date=${startDate}`;
                if (endDate) url += `&end_date=${endDate}`;
            }
            
            try {
                const response = await fetch(url);
                const data = await response.json();
                if(data.status === 'success') {
                    currentInvoiceData = {
                        id: null,
                        org_id: orgId,
                        items: data.items || [],
                        tax_percent: 0,
                        discount: 0,
                        paid_amount: 0,
                        notes: ''
                    };
                    currentOrganization = data.organization;
                    
                    document.getElementById('invNumber').innerText = '---'; // پیش نویس
                    document.getElementById('invIssueDate').value = toPersianDigits(data.date || '');
                    document.getElementById('invDueDate').value = '';
                    document.getElementById('invStatus').value = 'draft';
                    document.getElementById('invNotes').value = '';
                    document.getElementById('invTaxPercent').value = 0;
                    document.getElementById('invDiscount').value = 0;
                    document.getElementById('invPaidAmount').value = 0;
                    
                    updateInvoiceUI();
                    setTimeout(toggleInvoiceParts, 100);
                } else showToast(data.message);
            } catch(e) { console.error(e); if (typeof showToast === 'function') showToast('خطای شبکه. لطفا دوباره تلاش کنید.', 'error'); }
        }


        
        let currentCurrency = 'toman';
        function changeCurrency() {
            const newCurrency = document.getElementById('invCurrency').value;
            if (newCurrency === currentCurrency) return;
            
            const multiplier = newCurrency === 'rial' ? 10 : 0.1;
            
            // Update items
            currentInvoiceData.items.forEach(item => {
                item.unit_price = item.unit_price * multiplier;
                item.row_total = item.row_total * multiplier;
            });
            
            // Update discount and paid_amount
            currentInvoiceData.discount = currentInvoiceData.discount * multiplier;
            currentInvoiceData.paid_amount = currentInvoiceData.paid_amount * multiplier;
            
            // Update DOM Inputs directly if they have numeric values
            document.getElementById('invDiscount').value = formatFarsiMoney(currentInvoiceData.discount);
            document.getElementById('invPaidAmount').value = formatFarsiMoney(currentInvoiceData.paid_amount);
            
            // Update bulk edit fields
            document.getElementById('bulkPrice').value = '';
            
            // Update table headers
            const labels = document.querySelectorAll('.currency-label');
            labels.forEach(label => {
                label.innerText = newCurrency === 'rial' ? 'ریال' : 'تومان';
            });
            
            currentCurrency = newCurrency;
            
            renderItems();
            calculateTotals();
            if(typeof showToast === 'function') {
                showToast(`واحد پول به ${newCurrency === 'rial' ? 'ریال' : 'تومان'} تغییر یافت`, 'success');
            }
        }

        function renderItems() {
            selectedItems.clear();
            const selectAll = document.getElementById('selectAll');
            if (selectAll) selectAll.checked = false;
            updateSelectionUI();
            const tbody = document.getElementById('invoiceItems');
            tbody.innerHTML = '';
            
            if(currentInvoiceData.items.length === 0) {
                tbody.innerHTML = '<tr><td colspan="8" style="text-align:center;">موردی یافت نشد.</td></tr>';
            } else {
                currentInvoiceData.items.forEach((item, index) => {
                    tbody.innerHTML += `
                        <tr>
                            <td class="no-print" style="text-align: center;"><input type="checkbox" class="item-checkbox" data-index="${index}" onclick="handleCheckboxClick(event, ${index})" onchange="updateSelection()" style="cursor: pointer;"></td>
                            <td style="text-align: center;">${toPersianDigits(index + 1)}</td>
                            <td><input type="text" class="form-control" style="padding:5px;" value="${item.type}" onchange="updateItem(${index}, 'type', this.value)"></td>
                            <td>
                                <div class="multi-select">
                                    <div class="multi-select-display" onclick="toggleMultiSelect(this)">
                                        ${(item.platform || 'بدون پلتفرم').split(/[,،]/).filter(x => x.trim()).map(plt => `<span class="multi-select-tag">${plt.trim()}</span>`).join('')}
                                    </div>
                                    <div class="multi-select-dropdown">
                                        ${window.availablePlatforms.map(p => {
                                            const pName = p.setting_key || p.name || p.key;
                                            const isChecked = (item.platform || '').split(/[,،]/).map(s=>s.trim()).includes(pName) ? 'checked' : '';
                                            return `<label><input type="checkbox" value="${pName}" ${isChecked} onchange="updateMultiPlatform(${index}, this)"> ${pName}</label>`;
                                        }).join('')}
                                        <label><input type="checkbox" value="بدون پلتفرم" ${(!item.platform || item.platform === 'بدون پلتفرم') ? 'checked' : ''} onchange="updateMultiPlatform(${index}, this)"> بدون پلتفرم</label>
                                    </div>
                                </div>
                            </td>
                            <td><input type="text" inputmode="numeric" class="form-control" style="padding:5px; text-align:center;" value="${toPersianDigits(item.qty)}" onchange="updateItem(${index}, 'qty', parseNumericInput(this.value))"></td>
                            <td style="min-width: 130px;"><input type="text" inputmode="numeric" class="form-control" style="padding:5px; text-align: center;" value="${formatFarsiMoney(item.unit_price)}" onchange="updateItem(${index}, 'unit_price', parseNumericInput(this.value))"></td>
                            <td style="color:var(--primary-color); font-weight:bold; min-width: 150px; white-space: nowrap;">${formatFarsiMoney(item.qty * item.unit_price)}</td>
                            <td class="no-print"><button onclick="removeItem(${index})" style="background:none; border:none; color:red; cursor:pointer;"><svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align: middle; margin-left: 4px;'><path d='M18 6 6 18'/><path d='m6 6 12 12'/></svg></button></td>
                        </tr>
                    `;
                });
            }
        }

        function updateItem(index, field, value) {
            currentInvoiceData.items[index][field] = value;
            if(field === 'qty' || field === 'unit_price') {
                currentInvoiceData.items[index].row_total = currentInvoiceData.items[index].qty * currentInvoiceData.items[index].unit_price;
            }
            calculateTotals();
            renderItems(); // re-render to update row_total
        }

        function addManualItem() {
            currentInvoiceData.items.push({
                type: 'آیتم سفارشی جدید',
                platform: '---',
                qty: 1,
                unit_price: 0,
                row_total: 0
            });
            calculateTotals();
            renderItems();
        }

        function removeItem(index) {
            currentInvoiceData.items.splice(index, 1);
            calculateTotals();
            renderItems();
        }

        function calculateTotals() {
            let subtotal = 0;
            currentInvoiceData.items.forEach(i => subtotal += i.row_total);
            
            const taxPct = parseNumericInput(document.getElementById('invTaxPercent').value);
            const discount = parseNumericInput(document.getElementById('invDiscount').value);
            const paid = parseNumericInput(document.getElementById('invPaidAmount').value);
            
            // Format input display
            document.getElementById('invTaxPercent').value = toPersianDigits(taxPct);
            document.getElementById('invDiscount').value = formatFarsiMoney(discount);
            document.getElementById('invPaidAmount').value = formatFarsiMoney(paid);
            
            const taxAmt = Math.round(subtotal * (taxPct / 100));
            const total = subtotal + taxAmt - discount;
            
            currentInvoiceData.tax_percent = taxPct;
            currentInvoiceData.discount = discount;
            currentInvoiceData.paid_amount = paid;
            
            document.getElementById('invSubtotal').innerText = formatFarsiMoney(subtotal);
            document.getElementById('invTaxAmount').innerText = formatFarsiMoney(taxAmt);
            document.getElementById('invDiscountAmount').innerText = formatFarsiMoney(discount);
            document.getElementById('invTotal').innerText = formatFarsiMoney(total);
            document.getElementById('invPaidDisplay').innerText = formatFarsiMoney(paid);
            document.getElementById('invRemainingDisplay').innerText = formatFarsiMoney(total - paid);
        }

        const statusMap = {
            'draft': 'پیشنویس',
            'issued': 'صادر شده',
            'paid': 'پرداخت شده',
            'cancelled': 'لغو شده'
        };

        function updateInvoiceUI() {
            if(!currentOrganization) return;
            
            document.getElementById('invOrgName').innerText = currentOrganization.org_name || '---';
            document.getElementById('invOrgIndustry').innerText = currentOrganization.industry || '---';
            document.getElementById('invRepName').innerText = currentOrganization.contact_name || currentOrganization.rep_name || '---';
            document.getElementById('invRepPhone').innerText = toPersianDigits(currentOrganization.phone_number || currentOrganization.rep_phone || '---');
            
            document.getElementById('lblIssueDate').innerText = toPersianDigits(document.getElementById('invIssueDate').value || '---');
            document.getElementById('lblDueDate').innerText = toPersianDigits(document.getElementById('invDueDate').value || '---');
            document.getElementById('lblStatus').innerText = statusMap[document.getElementById('invStatus').value] || '---';
            
            renderItems();
            calculateTotals();
        }

        async function saveInvoice() {
            if(!currentInvoiceData.org_id) {
                showToast('ابتدا یک کارفرما انتخاب کنید.');
                return;
            }
            
            let subtotal = 0;
            currentInvoiceData.items.forEach(i => subtotal += i.row_total);
            const taxAmt = Math.round(subtotal * (currentInvoiceData.tax_percent / 100));
            const total = subtotal + taxAmt - currentInvoiceData.discount;

            const payload = {
                action: 'save',
                id: currentInvoiceData.id,
                org_id: currentInvoiceData.org_id,
                issue_date: document.getElementById('invIssueDate').value,
                due_date: document.getElementById('invDueDate').value,
                status: document.getElementById('invStatus').value,
                items: currentInvoiceData.items,
                subtotal: subtotal,
                tax: taxAmt,
                discount: currentInvoiceData.discount,
                total: total,
                notes: currentInvoiceData.notes,
                paid_amount: currentInvoiceData.paid_amount
            };

            try {
                const res = await fetch('/api/invoices', {
                    method: 'POST', headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify(payload)
                });
                const data = await res.json();
                if(data.status === 'success') {
                    showToast('فاکتور با موفقیت ذخیره شد.', 'success');
                    window.location.href = 'invoice?id=' + data.data.id;
                } else showToast(data.message);
            } catch(e) { console.error(e); showToast('خطا در ارتباط با سرور. لطفا اتصال را بررسی کنید.', 'error'); }
        }

        function toggleInvoiceParts() {
            const header = document.getElementById('invoiceHeader');
            if(header) header.style.display = document.getElementById('showHeader').checked ? 'flex' : 'none';
            
            if (typeof window.updateInvoiceLogoDisplay === 'function') window.updateInvoiceLogoDisplay();
            
            const invDetails = document.getElementById('invoiceMeta');
            if(invDetails) invDetails.style.display = document.getElementById('showInvDetails').checked ? 'block' : 'none';
            
            const clientDetails = document.getElementById('clientDetails');
            if(clientDetails) clientDetails.style.display = document.getElementById('showClientDetails').checked ? 'flex' : 'none';
            
            const footer = document.getElementById('invoiceFooter');
            if(footer) footer.style.display = document.getElementById('showFooter').checked ? 'block' : 'none';
        }
    </script>
    
    
    <!-- PDF Preview Modal -->
    <div id="pdfPreviewModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.8); z-index: 9999; align-items: center; justify-content: center; backdrop-filter: blur(5px);">
        <div style="background: var(--card-bg); width: 90%; max-width: 1000px; height: 90vh; border-radius: 16px; display: flex; flex-direction: column; overflow: hidden; box-shadow: 0 10px 40px rgba(0,0,0,0.3);">
            <!-- Modal Header -->
            <div style="display: flex; justify-content: space-between; align-items: center; padding: 20px; border-bottom: 1px solid var(--border-color); background: var(--bg-color);">
                <h3 style="margin: 0; display: flex; align-items: center; gap: 10px;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                    پیش‌نمایش چاپ و PDF
                </h3>
                <div style="display: flex; gap: 10px;">
                    <button class="btn-outline" onclick="closePreviewModal()" style="border: none; background: transparent; cursor: pointer;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                    </button>
                </div>
            </div>
            
            <!-- Modal Body (Preview) -->
            <div style="flex: 1; overflow: auto; padding: 30px; display: flex; justify-content: center; background: #525659;">
                <div id="previewContainer" style="background: white; padding: 40px; box-shadow: 0 4px 15px rgba(0,0,0,0.2); width: 210mm; min-height: 297mm; transform-origin: top center; direction: rtl;">
                    <!-- Clone goes here -->
                </div>
            </div>
            
            <!-- Modal Footer (Actions) -->
            <div style="padding: 20px; border-top: 1px solid var(--border-color); display: flex; justify-content: flex-end; gap: 15px; background: var(--bg-color);">
                <button class="btn-outline" onclick="closePreviewModal()">انصراف</button>
                <button class="btn-primary" onclick="executeNativePrint()" style="display: flex; align-items: center; gap: 8px;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 6 2 18 2 18 9"></polyline><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path><rect x="6" y="14" width="12" height="8"></rect></svg>
                    چاپ / دانلود PDF
                </button>
            </div>
        </div>
    </div>

    <script nonce="<%= nonce %>">
                                function printInvoice() {
            const invoicePaper = document.getElementById('invoicePaper');
            const previewContainer = document.getElementById('previewContainer');
            
            // Clone the invoice
            const clone = invoicePaper.cloneNode(true);
            
            // Remove the ID to avoid duplicates
            clone.removeAttribute('id');
            
            // Clean up the clone for preview
            clone.style.boxShadow = 'none';
            clone.style.margin = '0';
            clone.style.border = 'none';
            
            // Ensure inputs keep their values
            const originalInputs = invoicePaper.querySelectorAll('input, textarea, select');
            const clonedInputs = clone.querySelectorAll('input, textarea, select');
            
            originalInputs.forEach((input, index) => {
                if (clonedInputs[index]) {
                    if (input.tagName === 'SELECT') {
                        clonedInputs[index].value = input.value;
                    } else if (input.type === 'checkbox' || input.type === 'radio') {
                        clonedInputs[index].checked = input.checked;
                    } else {
                        clonedInputs[index].value = input.value;
                        // Replace input with text for cleaner preview
                        const div = document.createElement('div');
                        div.textContent = input.value;
                        div.style.padding = '8px';
                        div.style.fontFamily = 'inherit';
                        div.style.minHeight = '1.5em';
                        div.style.whiteSpace = 'pre-wrap';
                        div.style.wordBreak = 'break-word';
                        if (input.style.textAlign) {
                            div.style.textAlign = input.style.textAlign;
                        }
                        clonedInputs[index].parentNode.replaceChild(div, clonedInputs[index]);
                    }
                }
            });
            
            // Replace multi-selects for cleaner preview
            const originalMultiSelects = invoicePaper.querySelectorAll('.multi-select');
            const clonedMultiSelects = clone.querySelectorAll('.multi-select');
            originalMultiSelects.forEach((ms, index) => {
                if (clonedMultiSelects[index]) {
                    const display = ms.querySelector('.multi-select-display');
                    if (display) {
                        const div = document.createElement('div');
                        const tags = Array.from(display.querySelectorAll('.multi-select-tag'));
                        if (tags.length > 0) {
                            div.textContent = tags.map(t => t.textContent).join('، ');
                        } else {
                            div.textContent = display.textContent.trim();
                        }
                        div.style.padding = '8px';
                        div.style.fontFamily = 'inherit';
                        div.style.minHeight = '1.5em';
                        div.style.whiteSpace = 'pre-wrap';
                        div.style.wordBreak = 'break-word';
                        clonedMultiSelects[index].parentNode.replaceChild(div, clonedMultiSelects[index]);
                    }
                }
            });

            // Remove elements that shouldn't be printed/previewed
            clone.querySelectorAll('.no-print').forEach(el => el.remove());

            // Scale preview to fit screen if needed
            const scale = Math.min(1, (window.innerWidth * 0.8) / 800);
            previewContainer.style.transform = `scale(${scale})`;
            
            previewContainer.innerHTML = '';
            previewContainer.appendChild(clone);
            
            document.getElementById('pdfPreviewModal').style.display = 'flex';
        }
        
        function closePreviewModal() {
            document.getElementById('pdfPreviewModal').style.display = 'none';
        }
        
        function executeNativePrint() {
            closePreviewModal();
            setTimeout(() => {
                if (window.self !== window.top) {
                    const currentUrl = new URL(window.location.href);
                    currentUrl.searchParams.set('auto_print', '1');
                    if (typeof showToast === 'function') {
                        showToast("برای چاپ با کیفیت بالا، فاکتور در تب جدید مرورگر باز می‌شود...");
                    } else {
                        if(typeof window.showToast === 'function') window.showToast("برای چاپ فاکتور در تب جدید باز می‌شود.", "info"); else alert("برای چاپ فاکتور در تب جدید باز می‌شود.");
                    }
                    setTimeout(() => {
                        window.open(currentUrl.toString(), '_blank');
                    }, 1000);
                } else {
                    window.print();
                }
            }, 300);
        }
        
        // Auto print if opened in new tab with auto_print parameter
        window.addEventListener('DOMContentLoaded', () => {
            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.get('auto_print') === '1') {
                setTimeout(() => {
                    window.print();
                }, 1000);
            }
        });
    
        let selectedItems = new Set();
        let lastCheckedIndex = null;
        
        function toggleSelectAll(checkbox) {
            lastCheckedIndex = null;
            const checkboxes = document.querySelectorAll('.item-checkbox');
            if(checkbox.checked) {
                checkboxes.forEach(cb => {
                    cb.checked = true;
                    selectedItems.add(parseInt(cb.getAttribute('data-index')));
                });
            } else {
                checkboxes.forEach(cb => cb.checked = false);
                selectedItems.clear();
            }
            updateSelectionUI();
        }
        
        function handleCheckboxClick(event, index) {
            const checkboxes = Array.from(document.querySelectorAll('.item-checkbox'));
            
            if (event.shiftKey && lastCheckedIndex !== null) {
                const start = Math.min(index, lastCheckedIndex);
                const end = Math.max(index, lastCheckedIndex);
                
                // Get current state of the clicked checkbox (since onclick fires before onchange, but wait, for checkboxes onclick fires when value changes too)
                // Actually, the checkbox is already toggled when onclick fires.
                const isChecked = event.target.checked;
                
                checkboxes.forEach((cb) => {
                    const cbIndex = parseInt(cb.getAttribute('data-index'));
                    if (cbIndex >= start && cbIndex <= end) {
                        cb.checked = isChecked;
                    }
                });
                
                updateSelection();
            }
            
            lastCheckedIndex = index;
        }
        
        function updateSelection() {
            const checkboxes = document.querySelectorAll('.item-checkbox');
            let allChecked = true;
            selectedItems.clear();
            checkboxes.forEach(cb => {
                if(cb.checked) {
                    selectedItems.add(parseInt(cb.getAttribute('data-index')));
                } else {
                    allChecked = false;
                }
            });
            const selectAll = document.getElementById('selectAll');
            if (selectAll) selectAll.checked = (checkboxes.length > 0 && allChecked);
            updateSelectionUI();
        }
        
        function updateSelectionUI() {
            const bulkActions = document.getElementById('bulkActions');
            const selectedCount = document.getElementById('selectedCount');
            if(bulkActions && selectedCount) {
                if(selectedItems.size > 0) {
                    bulkActions.style.display = 'flex';
                    selectedCount.innerText = toPersianDigits(selectedItems.size);
                } else {
                    bulkActions.style.display = 'none';
                }
            }
        }
        
        async function deleteSelectedItems() {
            const confirmed = typeof window.customConfirm === 'function' 
                ? await window.customConfirm('آیا از حذف موارد انتخاب شده اطمینان دارید؟')
                : confirm('آیا از حذف موارد انتخاب شده اطمینان دارید؟');
            if(confirmed) {
                const indices = Array.from(selectedItems).sort((a,b) => b-a);
                indices.forEach(idx => {
                    currentInvoiceData.items.splice(idx, 1);
                });
                selectedItems.clear();
                const selectAll = document.getElementById('selectAll');
                if (selectAll) selectAll.checked = false;
                renderItems();
                updateSelectionUI();
                calculateTotals();
            }
        }
        
        function applyBulkEdit() {
            if (selectedItems.size === 0) return;
            const platform = document.getElementById('bulkPlatformValue').value;
            const qty = document.getElementById('bulkQty').value;
            const price = document.getElementById('bulkPrice').value;
            
            let updated = false;
            
            selectedItems.forEach(idx => {
                if (platform.trim() !== '') {
                    currentInvoiceData.items[idx].platform = platform;
                    updated = true;
                }
                if (qty !== '') {
                    currentInvoiceData.items[idx].qty = parseNumericInput(qty);
                    updated = true;
                }
                if (price !== '') {
                    currentInvoiceData.items[idx].unit_price = parseNumericInput(price);
                    updated = true;
                }
            });
            
            if (updated) {
                // Clear the inputs
                document.getElementById('bulkPlatformValue').value = '';
                document.querySelector('#bulkPlatformContainer .multi-select-display').innerHTML = '<span style="color:#9ca3af; font-size:0.85rem;">بدون تغییر</span>';
                document.querySelectorAll('#bulkPlatformContainer input[type="checkbox"]').forEach(cb => cb.checked = false);
                document.getElementById('bulkQty').value = '';
                document.getElementById('bulkPrice').value = '';
                
                renderItems();
                calculateTotals();
                if (typeof showToast === 'function') {
                    showToast('تغییرات با موفقیت اعمال شد', 'success');
                }
            }
        }
        
        function clearSelection() {
            const checkboxes = document.querySelectorAll('.item-checkbox');
            checkboxes.forEach(cb => cb.checked = false);
            selectedItems.clear();
            lastCheckedIndex = null;
            const selectAll = document.getElementById('selectAll');
            if (selectAll) selectAll.checked = false;
            updateSelectionUI();
        }

        function duplicateSelectedItems() {
            const indices = Array.from(selectedItems).sort((a,b) => a-b);
            const newItems = [];
            indices.forEach(idx => {
                newItems.push(JSON.parse(JSON.stringify(currentInvoiceData.items[idx])));
            });
            currentInvoiceData.items.push(...newItems);
            
            selectedItems.clear();
            const selectAll = document.getElementById('selectAll');
            if (selectAll) selectAll.checked = false;
            renderItems();
            updateSelectionUI();
            calculateTotals();
        }

        // We need to inject these functions before the script tag closes

    </script>
</body>
