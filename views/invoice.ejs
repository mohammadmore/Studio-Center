            <div class="table-responsive">
                <table class="invoice-table">
                    <thead>
                        <tr>
                            <th class="no-print" style="width: 30px; text-align: center;"><input type="checkbox" id="selectAll" onchange="toggleSelectAll(this)" style="cursor: pointer;"></th>
                            <th style="width: 50px; text-align: center;">ردیف</th>
                            <th style="min-width: 160px;">شرح خدمات / کالا</th>
                            <th style="min-width: 140px;">پلتفرم / بستر</th>
