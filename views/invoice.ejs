                        <span>مبلغ پرداخت شده (علیالحساب):</span>
                        <input type="text" inputmode="numeric" id="invPaidAmount" class="form-control" style="width: 100px; height: 25px; padding: 2px 5px; text-align: center;" value="0" onchange="this.value = formatFarsiMoney(parseNumericInput(this.value)); calculateTotals()">
                    </div>
                    <div class="totals-row">
                        <span>پرداخت شده:</span>
                        <strong id="invPaidDisplay" style="color: #16a34a;">۰</strong>
