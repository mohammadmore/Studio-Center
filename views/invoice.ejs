            .multi-select-display { border: none !important; background: transparent !important; padding: 5px !important; min-height: auto !important; }
            .multi-select-tag { background: transparent !important; border: none !important; color: black !important; padding: 0 !important; font-size: inherit !important; }
            .multi-select-tag:not(:last-child)::after { content: "، "; color: black; }
            input, textarea, select {
                border: none !important;
                background: transparent !important;
                box-shadow: none !important;
                appearance: none !important;
                -webkit-appearance: none !important;
                resize: none !important;
