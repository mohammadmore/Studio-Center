                        <input type="text" inputmode="numeric" id="invTaxPercent" class="form-control" style="width: 60px; height: 25px; padding: 2px 5px; text-align: center;" value="0" onchange="this.value = toPersianDigits(parseNumericInput(this.value)); calculateTotals()">
                    </div>
                    <div class="totals-row">
                        <span>مالیات:</span>
                        <strong id="invTaxAmount">۰</strong>
                    </div>
                    <div class="totals-row no-print">
                        <span>مبلغ تخفیف دستی (<span class="currency-label">تومان</span>):</span>
                        <input type="text" inputmode="numeric" id="invDiscount" class="form-control" style="width: 100px; height: 25px; padding: 2px 5px; text-align: center;" value="0" onchange="this.value = formatFarsiMoney(parseNumericInput(this.value)); calculateTotals()">
                    </div>
                    <div class="totals-row">
                        <span>تخفیف:</span>
                        <strong id="invDiscountAmount" style="color: var(--error-color);">۰</strong>
                    </div>
                    <div class="totals-row final">
                        <span>مبلغ قابل پرداخت:</span>
                        <strong id="invTotal">۰</strong>
                    </div>
