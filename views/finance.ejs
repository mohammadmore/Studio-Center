
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<script nonce="<%= nonce %>">
// Global Network Error Handler
(function() {
    if (window._fetchIntercepted) return;
    window._fetchIntercepted = true;
    const originalFetch = window.fetch;
    window.fetch = async function(...args) {
        try {
            return await originalFetch.apply(this, args);
        } catch (e) {
            // Suppress network error toasts which commonly trigger on dev server restart polling
            // console.error('Network Error:', e);
            return new Response(JSON.stringify({status: 'error', message: 'Network error'}), {
                status: 200, 
                headers: { 'Content-Type': 'application/json' }
            });
        }
    };
})();
</script>

        <base href="<%= typeof BASE_URL !== 'undefined' ? BASE_URL + '/' : '/' %>">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= STUDIO_NAME %> | داشبورد ناظر مالی</title>
    <link rel="stylesheet" href="assets/css/style.css?v=6">
    <style nonce="<%= nonce %>">
        .finance-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin-bottom: 30px; }
        .fin-card { background: var(--card-bg); padding: 25px; border-radius: 15px; border: 1px solid var(--border-color); box-shadow: 0 10px 15px -3px rgba(0,0,0,0.05); position: relative; overflow: hidden; }
        .fin-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 5px; }
        .card-rev::before {  }
        .card-exp::before { background: var(--error-color); }
        .card-profit::before { background: var(--success-color); }
        
        .fin-title { font-size: 1.1rem; color: var(--text-gray); margin-bottom: 15px; font-weight: bold; }
        .fin-amount { font-size: 2.2rem; font-weight: 900; color: var(--text-dark); margin-bottom: 5px; }
        .fin-currency { font-size: 1rem; color: var(--text-gray); }
        
        .expense-table { width: 100%; border-collapse: collapse; background: var(--card-bg); border-radius: 12px; overflow: hidden; border: 1px solid var(--border-color); }
        .expense-table th { background: rgba(128, 128, 128, 0.05); padding: 15px; text-align: right; border-bottom: 2px solid var(--border-color); color: var(--text-dark); }
        .expense-table td { padding: 15px; border-bottom: 1px solid var(--border-color); color: var(--text-gray); }
        .expense-table tr:hover td { background: rgba(128, 128, 128, 0.05); color: var(--primary-color); }
    </style>
</head>
<body>
    <%- include('sidebar') %>

    

    <main class="main-content">
        <div class="page-header-container flex-responsive">
            <div>
                <h1 class="page-title"><!-- @license lucide-static v1.28.0 - ISC -->
<svg
  class="lucide lucide-dollar-sign"
  xmlns="http://www.w3.org/2000/svg"
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <line x1="12" x2="12" y1="2" y2="22" />
  <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
</svg> <span>داشبورد ناظر مالی و حسابداری</span></h1>
                <p class="page-subtitle">بررسی درآمد‌ها، هزینه‌ها و سودآوری پروژه‌های استودیو</p>
            </div>
        </div>

        <div style="margin-bottom: 20px; display: flex; gap: 10px; align-items: center; flex-wrap: wrap;" class="flex-responsive">
            <input type="text" class="global-search-input" data-target="#expenseTableBody" placeholder="جستجوی سریع (کلمه مورد نظر را تایپ کنید)..." style="flex: 1; padding: 12px; border: 1px solid var(--border-color); border-radius: 8px; font-family: inherit;">
        </div>
    
                <p style="color: var(--text-gray);">نمای زنده از درآمد‌ها، هزینه‌های تولید و حاشیه سود خالص استودیو.</p>
            </div>
            <button class="btn-outline" style="background: var(--card-bg);" onclick="window.print()">🖨️ چاپ گزارش مالی</button>
        </div>

        <!-- کارت‌های آمار کلان -->
        <div class="finance-cards">
            <div class="fin-card card-rev">
                <div class="fin-title">درآمد ناخالص (ارزش قراردادها)</div>
                <div class="fin-amount" id="valRevenue">۰</div>
                <div class="fin-currency">تومان</div>
            </div>
            
            <div class="fin-card card-exp">
                <div class="fin-title">مجموع هزینه‌های تولید (خروج پول)</div>
                <div class="fin-amount" id="valExpenses" style="color: var(--error-color);">۰</div>
                <div class="fin-currency">تومان</div>
            </div>
            
            <div class="fin-card card-profit">
                <div class="fin-title">سود خالص سیستم (Net Profit)</div>
                <div class="fin-amount" id="valProfit" style="color: var(--success-color);">۰</div>
                <div class="fin-currency">تومان</div>
            </div>
        </div>

        <!-- جدول ریز هزینه‌ها -->
        
        <h3 class="flex-responsive" style="margin-bottom: 15px; color: var(--text-dark); display: flex; justify-content: space-between; align-items: center;">
            <svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align: middle; margin-left: 4px;'><rect width='8' height='4' x='8' y='2' rx='1' ry='1'/><path d='M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2'/><path d='M12 11h4'/><path d='M12 16h4'/><path d='M8 11h.01'/><path d='M8 16h.01'/></svg> ریز هزینه‌های ثبت شده توسط تیم تولید
            <button class="btn-primary"  onclick="openExpenseModal()" style="">+ ثبت هزینه جدید</button>
        </h3>

        
        <div style="margin-bottom: 15px;">
            <input type="text" id="searchExpenses" class="form-control" placeholder="جستجو در هزینه‌ها..." onkeyup="filterExpenses()" style="max-width: 300px;">
        </div>
    
        <div class="table-responsive"><table class="expense-table">
            <thead>
                <tr>
                    <th>ردیف</th>
                    <th>بابت (شرح هزینه)</th>
                    <th>پروژه / محتوای مرتبط</th>
                    <th>مبلغ کسر شده</th>
                    <th>تاریخ ثبت</th>
                </tr>
            </thead>
            <tbody id="expenseTableBody">
                <tr><td colspan="10"><div class="skeleton" style="height: 40px; width: 100%; border-radius: 4px;"></div></td></tr>
            </tbody>
        </table></div>
    </main>

    <script src="assets/js/app.js?v=4"></script>
    <script nonce="<%= nonce %>">
        async function loadFinanceData() {
            try {
                const res = await fetch('/api/get_finance_report');
                const result = await res.json();
                
                if(result.status === 'success') {
                    const data = result.data;
                    const formatMoney = (num) => new Intl.NumberFormat('fa-IR').format(num);

                    // آپدیت کارت‌های بالا
                    document.getElementById('valRevenue').innerText = formatMoney(data.total_revenue);
                    document.getElementById('valExpenses').innerText = formatMoney(data.total_expenses);
                    document.getElementById('valProfit').innerText = formatMoney(data.net_profit);

                    // آپدیت جدول ریز هزینه‌ها
                    const tbody = document.getElementById('expenseTableBody');
                    tbody.innerHTML = '';
                    
                    if(data.expenses.length === 0) {
                        tbody.innerHTML = `<tr><td colspan="5" style="text-align: center; padding: 40px 20px;">
                            <div style="display: flex; flex-direction: column; align-items: center; justify-content: center;">
                                <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--text-gray)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="opacity: 0.5; margin-bottom: 12px;"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
                                <div style="color: var(--text-gray); font-size: 1.1rem; font-weight: bold; margin-bottom: 4px;">هزینه‌ای ثبت نشده است</div>
                                <div style="color: #94a3b8; font-size: 0.9rem;">هزینه‌های ثبت شده روی محتوا‌های دپو در این جدول نمایش داده می‌شوند.</div>
                            </div>
                        </td></tr>`;
                    } else {
                        (data.expenses || []).forEach((exp, index) => {
                            const dateStr = typeof exp.date === 'string' && exp.date.includes('/') ? exp.date : new Date(exp.date).toLocaleDateString('fa-IR');
                            tbody.innerHTML += `
                                <tr>
                                    <td>${index + 1}</td>
                                    <td style="font-weight: bold; color: var(--text-dark);">${exp.description}</td>
                                    <td>${exp.project_name}</td>
                                    <td style="color: var(--error-color); font-weight: bold;">${formatMoney(exp.amount)} تومان</td>
                                    <td>${dateStr}</td>
                                </tr>
                            `;
                        });
                    }
                }
            } catch(e) {
                document.getElementById('expenseTableBody').innerHTML = '<tr><td colspan="5" style="text-align: center; color: red;">خطا در ارتباط با سرور حسابداری</td></tr>';
            }
        }

        setTimeout( () => {
            loadFinanceData();
        });
    </script>

    <!-- Modal for adding expense -->
    <div class="modal-overlay" id="expenseModal" style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(15, 23, 42, 0.7); backdrop-filter: blur(5px); justify-content: center; align-items: center; z-index: 1000; padding: 20px;">
        <div class="modal-box" style="background: var(--card-bg); width: 100%; width: 100%; max-width: 450px; box-sizing: border-box; padding: 30px; border-radius: 15px; box-shadow: 0 10px 25px rgba(0,0,0,0.1);">
            <h3 style="color: var(--primary-color); margin-bottom: 20px; margin-top: 0;">ثبت هزینه جدید</h3>
            
            <label style="display: block; font-weight: bold; margin-bottom: 8px;">بابت (شرح هزینه):</label>
            <input type="text" id="expDesc" style="width: 100%; padding: 12px; margin-bottom: 15px; border: 1px solid var(--border-color); border-radius: 8px;">
            
            <label style="display: block; font-weight: bold; margin-bottom: 8px;">پروژه / محتوا مرتبط:</label>
            <input type="text" id="expProject" style="width: 100%; padding: 12px; margin-bottom: 15px; border: 1px solid var(--border-color); border-radius: 8px;">
            
            <label style="display: block; font-weight: bold; margin-bottom: 8px;">مبلغ (تومان):</label>
            <input type="text" inputmode="numeric" id="expAmount" style="width: 100%; padding: 12px; margin-bottom: 20px; border: 1px solid var(--border-color); border-radius: 8px;">
            
            <div style="display: flex; gap: 10px; justify-content: flex-end;">
                <button type="button" class="btn-outline"  onclick="closeExpenseModal()" >انصراف</button>
                <button class="btn-primary"  onclick="saveExpense()" style="">ثبت هزینه</button>
            </div>
        </div>
    </div>
    
    <script nonce="<%= nonce %>">
        function openExpenseModal() {
            document.getElementById('expDesc').value = '';
            document.getElementById('expProject').value = '';
            document.getElementById('expAmount').value = '';
            document.getElementById('expenseModal').style.display = 'flex';
        }
        function closeExpenseModal() {
            document.getElementById('expenseModal').style.display = 'none';
        }
        async function saveExpense() {
            const desc = document.getElementById('expDesc').value;
            const project = document.getElementById('expProject').value;
            const amount = document.getElementById('expAmount').value;
            
            if(!desc || !amount) {
                showToast('لطفاً شرح هزینه و مبلغ را وارد کنید');
                return;
            }
            
            try {
                const res = await fetch('/api/save_expense', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ description: desc, project_name: project, amount: amount })
                });
                if((await res.json()).status === 'success') {
                    closeExpenseModal();
                    loadFinanceData();
                } else {
                    showToast('خطا در ثبت هزینه', 'error');
                }
            } catch(e) {
                showToast('خطا در ارتباط با سرور', 'error');
            }
        }
    
        function filterExpenses() {
            const query = document.getElementById('searchExpenses').value.toLowerCase();
            const rows = document.querySelectorAll('#expenseTableBody tr');
            rows.forEach(row => {
                if(row.children.length > 1) {
                    const text = row.innerText.toLowerCase();
                    row.style.display = text.includes(query) ? '' : 'none';
                }
            });
        }
</script>
</body>
</html>