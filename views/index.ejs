<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<script>
// Global Network Error Handler
(function() {
    if (window._fetchIntercepted) return;
    window._fetchIntercepted = true;
    const originalFetch = window.fetch;
    window.fetch = async function(...args) {
        try {
            return await originalFetch.apply(this, args);
        } catch (e) {
            // Suppress network error toasts which commonly trigger on dev server restart polling
            // console.error('Network Error:', e);
            return new Response(JSON.stringify({status: 'error', message: 'Network error'}), {
                status: 200, 
                headers: { 'Content-Type': 'application/json' }
            });
        }
    };
})();
</script>

        <base href="<%= typeof BASE_URL !== 'undefined' ? BASE_URL + '/' : '/' %>">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= STUDIO_NAME %> | سیستم یکپارچه (ERP)</title>
    <link rel="stylesheet" href="assets/css/style.css?v=6">
    <style>
        body { font-family: 'Vazirmatn', Tahoma, Arial, sans-serif !important; background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%); display: flex; justify-content: center; align-items: center; height: 100vh; margin: 0;  }
        .login-card { background: var(--card-bg); padding: 40px; border-radius: 20px; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5); width: 100%; width: 100%; max-width: 400px; box-sizing: border-box; }
        .login-header { text-align: center; margin-bottom: 30px; }
        .login-header h1 { font-weight: 900; color: var(--text-gray); margin-bottom: 5px; font-size: 1.8rem; }
        .login-header p { color: var(--text-gray); font-size: 0.9rem; margin: 0; }
        .btn-login { width: 100%; background: linear-gradient(135deg, var(--primary-color), #8b5cf6, #ec4899) !important; color: white; border: none; padding: 15px; border-radius: 10px; font-weight: bold; font-size: 1.1rem; cursor: pointer; transition: 0.3s; margin-top: 10px; }
        .btn-login:hover { filter: brightness(1.15); transform: translateY(-2px); }
        .error-msg { color: var(--error-color); font-size: 0.85rem; text-align: center; margin-top: 15px; font-weight: bold; min-height: 20px; }
    </style>
</head>
<body>
    <div class="login-card">
        
        <div class="login-header">
            <% if(STUDIO_LOGO) { %>
                <img alt="" src="<%= STUDIO_LOGO %>" style="max-height: 80px; margin-bottom: 10px; border-radius: 10px; background: var(--card-bg); padding: 5px;">
            <% } %>
            <h1 style="font-weight: 900; color: var(--text-gray); margin-bottom: 5px; font-size: 1.8rem;"><%= STUDIO_NAME %></h1>
        </div>
        
        <form onsubmit="doLogin(event)">
            <div class="form-group">
                <label>نام کاربری:</label>
                <input type="text" id="username" class="form-control" required placeholder="username" dir="ltr" style="text-align: left;">
            </div>
            <div class="form-group">
                <label>رمز عبور:</label>
                <input type="password" id="password" class="form-control" required placeholder="******" dir="ltr" style="text-align: left;">
            </div>
            <button type="submit" id="loginBtn" class="btn-login">ورود به پنل کاربری <svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align: middle; margin-left: 4px;'><path d='M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z'/><path d='m12 15-3-3a22 22 0 0 1 3.82-13 1.5 1.5 0 0 0-2.18 2.06c2.81 3.2 4.09 7.42 4.09 11.75v1.07'/><path d='m9 18 3 3a22 22 0 0 0 13-3.82 1.5 1.5 0 0 0-2.06-2.18c-3.2 2.81-7.42 4.09-11.75 4.09h-1.07'/></svg></button>
            <div id="errorMsg" class="error-msg"></div>
            <div style="margin-top: 20px; font-size: 0.75rem; color: #94a3b8; text-align: center;">
                <div style="font-weight: bold; letter-spacing: 0.5px;" dir="ltr">Powered by Asva Studio</div>
                <div style="margin-top: 4px;">توسعه یافته توسط شرکت دادهپردازان اسوا</div>
            </div>
        </form>
    </div>

    <script>
        async function doLogin(e) {
            e.preventDefault();
            const btn = document.getElementById('loginBtn');
            const err = document.getElementById('errorMsg');
            btn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle; margin-left: 4px;"><path d="M5 22h14"/><path d="M5 2h14"/><path d="M17 22v-4.172a2 2 0 0 0-.586-1.414L12 12l-4.414 4.414A2 2 0 0 0 7 17.828V22"/><path d="M7 2v4.172a2 2 0 0 0 .586 1.414L12 12l4.414-4.414A2 2 0 0 0 17 6.172V2"/></svg> در حال بررسی...`;
            btn.disabled = true;
            err.innerText = '';
            try {
                const res = await fetch('/api/login', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'}, credentials: 'include',
                    body: JSON.stringify({
                        username: document.getElementById('username').value,
                        password: document.getElementById('password').value
                    })
                });
                let result;
                const contentType = res.headers.get("content-type");
                if (contentType && contentType.indexOf("application/json") !== -1) {
                    result = await res.json();
                } else {
                    throw new Error("Server returned an invalid response (might be rebuilding).");
                }
                
                if (result.status === 'success') {
                    btn.style.background = 'var(--success-color)';
                    btn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle; margin-left: 4px;"><path d="M20 6 9 17l-5-5"/></svg> ورود موفق`;
                    setTimeout(() => { window.location.href = result.redirect; }, 600);
                } else {
                    err.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle; margin-left: 4px;"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg> ` + result.message;
                    btn.innerHTML = `ورود به پنل کاربری <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle; margin-left: 4px;"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="m12 15-3-3a22 22 0 0 1 3.82-13 1.5 1.5 0 0 0-2.18 2.06c2.81 3.2 4.09 7.42 4.09 11.75v1.07"/><path d="m9 18 3 3a22 22 0 0 0 13-3.82 1.5 1.5 0 0 0-2.06-2.18c-3.2 2.81-7.42 4.09-11.75 4.09h-1.07"/></svg>`;
                    btn.disabled = false;
                }
            } catch (error) {
                err.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle; margin-left: 4px;"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg> خطا در ارتباط با سرور`;
                btn.innerHTML = `ورود به پنل کاربری <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle; margin-left: 4px;"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="m12 15-3-3a22 22 0 0 1 3.82-13 1.5 1.5 0 0 0-2.18 2.06c2.81 3.2 4.09 7.42 4.09 11.75v1.07"/><path d="m9 18 3 3a22 22 0 0 0 13-3.82 1.5 1.5 0 0 0-2.06-2.18c-3.2 2.81-7.42 4.09-11.75 4.09h-1.07"/></svg>`;
                btn.disabled = false;
            }
        }
    </script>
<script src="assets/js/app.js?v=4"></script>
<%- include('ux-script') %>
</body>
</html>
