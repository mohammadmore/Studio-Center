    const iconGrid = document.getElementById('iconGrid');
    socialIcons.forEach(iconObj => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.style.cssText = 'background: rgba(128,128,128,0.05); border: 1px solid var(--border-color); border-radius: 8px; padding: 10px; cursor: pointer; display: flex; justify-content: center; align-items: center; color: var(--text-dark); transition: 0.2s;';
        btn.innerHTML = iconObj.svg;
        btn.title = iconObj.name;
        btn.onmouseover = () => btn.style.borderColor = 'var(--primary-color)';
        btn.onmouseout = () => btn.style.borderColor = 'var(--border-color)';
        btn.onclick = () => selectIcon(iconObj.svg);
        iconGrid.appendChild(btn);
    });

    function selectIcon(iconHtml) {
        document.getElementById('newItemIcon').value = iconHtml;
        document.getElementById('selectedIconDisplay').innerHTML = iconHtml ? iconHtml : 'انتخاب آیکون';
        document.getElementById('iconModal').style.display = 'none';
    }
    
    document.getElementById('customEmojiInput').addEventListener('input', function(e) {
        const val = this.value;
        const emojis = val.match(/[\p{Extended_Pictographic}]/gu);
        if (emojis && emojis.length > 0) {
            this.value = emojis[0];
        } else {
            this.value = '';
        }
    });

    function selectCustomEmoji() {
        const val = document.getElementById('customEmojiInput').value.trim();
        if(val) selectIcon(val);
    }
</script>

<div id="roleIconModal" class="modal-overlay" style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 999999; align-items: center; justify-content: center; background: rgba(0,0,0,0.6); backdrop-filter: blur(5px);">
    <div style="background: var(--bg-color); width: 90%; width: 100%; max-width: 500px; box-sizing: border-box; box-sizing: border-box; border-radius: 12px; padding: 20px; box-shadow: 0 10px 25px rgba(0,0,0,0.2); max-height: 90vh; display: flex; flex-direction: column;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; border-bottom: 1px solid var(--border-color); padding-bottom: 10px;">
            <h3 style="margin: 0; color: var(--text-dark);">انتخاب آیکون نقش</h3>
            <button type="button" onclick="document.getElementById('roleIconModal').style.display='none'" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: var(--text-gray);">&times;</button>
        </div>
        <div id="roleIconGrid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(60px, 1fr)); gap: 10px; overflow-y: auto; padding-right: 5px; flex: 1;">
        </div>
        <div style="margin-top: 15px; border-top: 1px solid var(--border-color); padding-top: 15px;">
            <div style="display: flex; gap: 10px; align-items: center; justify-content: space-between; flex-wrap: wrap;">
                <input type="text" id="customRoleEmojiInput" placeholder="ایموجی" class="form-control" style="width: 80px; text-align: center; font-size: 1.5rem; padding: 5px;">
                <div style="display: flex; gap: 8px; flex: 1; min-width: 180px;">
                    <button type="button" onclick="selectCustomRoleEmoji()" class="btn-primary" style="flex: 1; font-size: 0.9rem; padding: 8px;">ثبت ایموجی</button>
                    <button type="button" onclick="selectRoleIcon('')" class="btn-outline" style="flex: 1; font-size: 0.9rem; padding: 8px;">بدون آیکون</button>
                </div>
            </div>
        </div>
    </div>
</div>

