        async function reorderFont(filename, direction) {
            try {
                if (window.showLoading) window.showLoading("در حال جابجایی...");
                const currentOrder = currentFonts.map(f => f.filename);
                const res = await fetch('/api/reorder_fonts', {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ filename: filename, direction: direction, current_order: currentOrder })
                });
                const data = await res.json();
                if(data.status === "success") {
                    await loadFonts();
                } else {
                    if (window.showToast) window.showToast(data.message || "خطا در جابجایی", "error");
                }
            } catch(e) {
                if (window.showToast) window.showToast("خطا در ارتباط با سرور", "error");
            } finally {
                if (window.hideLoading) window.hideLoading();
            }
        }

