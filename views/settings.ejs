        async function uploadStudioLogo(input, type) {
            if (!input.files || input.files.length === 0) return;
            const file = input.files[0];
            
            if (file.size > 8 * 1024 * 1024) {
                 if (window.showToast) window.showToast('حجم فایل نباید بیشتر از 8 مگابایت باشد', 'error');
                 else alert('حجم فایل بیش از حد مجاز است');
                 input.value = '';
                 return;
            }

            const btnId = type === 'light' ? 'btnUploadStudioLogoLight' : 'btnUploadStudioLogoDark';
            const btn = document.getElementById(btnId);
            const originalText = btn ? btn.innerText : '+ آپلود تصویر';
            if (btn) {
                btn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle; margin-left: 4px;"><path d="M5 22h14"/><path d="M5 2h14"/><path d="M17 22v-4.172a2 2 0 0 0-.586-1.414L12 12l-4.414 4.414A2 2 0 0 0 7 17.828V22"/><path d="M7 2v4.172a2 2 0 0 0 .586 1.414L12 12l4.414-4.414A2 2 0 0 0 17 6.172V2"/></svg> در حال آپلود...`;
                btn.disabled = true;
            }
            const reader = new FileReader();
            reader.onload = async function(e) {
                const base64 = e.target.result;
                try {
                    const res = await fetch('/api/upload_image', { 
                        method: 'POST', 
                        headers: {'Content-Type': 'application/json'},
                        body: JSON.stringify({ image: base64 }) 
                    });
                    
                    if (res.status === 413) {
                        throw new Error("حجم فایل برای سرور بیش از حد بزرگ است");
                    }
                    
                    const result = await res.json();
                    
                    if (result.status === 'success') {
                        const logoInput = document.getElementById('studio_logo_' + type);
                        if (logoInput) logoInput.value = result.url;
                        updateStudioLogoPreview(type, result.url);
                        if (window.showToast) showToast('تصویر با موفقیت آپلود شد، در حال ذخیره...', 'success');
                        
                        // Auto-save the form
                        const saveBtn = document.querySelector('#studioInfoForm button[type="submit"]');
                        if (saveBtn) {
                            saveBtn.click();
                        }
                    } else {
                        if (window.showToast) showToast('خطا در آپلود: ' + (result.message||''), 'error');
                        else alert('خطا: ' + result.message);
                    }
                    if (btn) {
                        btn.innerHTML = originalText;
                        btn.disabled = false;
                    }
                    input.value = '';
                } catch(err) {
                    console.error(err);
                    if (window.showToast) showToast('خطا: ' + err.message, 'error');
                    else alert('خطا: ' + err.message);
                    if (btn) {
                        btn.innerHTML = originalText;
                        btn.disabled = false;
                    }
                    input.value = '';
                }
            };
            reader.onerror = function() {
                if (window.showToast) showToast('خطا در خواندن فایل', 'error');
                if (btn) {
                    btn.innerHTML = originalText;
                    btn.disabled = false;
                }
                input.value = '';
            };
            reader.readAsDataURL(file);
        }


                
