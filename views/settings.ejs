    <link rel="stylesheet" href="assets/css/style.css?v=1786775708516">
    <style>
        .settings-grid { display: grid; grid-template-columns: 1fr; gap: 30px; min-width: 0; }
        .settings-card { background: var(--card-bg); padding: 25px; border-radius: 12px; border: 1px solid var(--border-color); align-self: start; min-width: 0; }
        .card-title { font-size: 1.1rem; color: var(--text-dark); margin-bottom: 20px; padding-bottom: 10px; border-bottom: 2px solid var(--border-color); display:flex; align-items:center; gap:10px; font-weight:bold; }
        
        .upload-box { border: 2px dashed var(--primary-color); padding: 30px; text-align: center; border-radius: 12px; background: rgba(128, 128, 128, 0.05); cursor: pointer; transition: 0.2s; }
        .upload-box:hover { background: rgba(99, 102, 241, 0.15); }
        .upload-icon { font-size: 3rem; margin-bottom: 10px; display: block; }

        /* استایل‌های بخش مدیریت داده‌ها */
        .setting-tabs { display: flex; gap: 10px; margin-bottom: 20px; border-bottom: 1px solid var(--border-color); padding-bottom: 10px; overflow-x: auto; }
        .s-tab { background: none; border: none; padding: 8px 15px; cursor: pointer; font-family: inherit; font-weight: bold; color: var(--text-gray); border-radius: 8px 8px 0 0; transition: 0.2s; white-space: nowrap; }
        .s-tab.active { color: var(--primary-color); background: rgba(128, 128, 128, 0.05); border-bottom: 3px solid var(--primary-color); }
        
        .data-list { background: rgba(128, 128, 128, 0.05); border: 1px solid var(--border-color); border-radius: 8px; max-height: 300px; overflow-y: auto; margin-bottom: 20px; }
        .data-item { display: flex; justify-content: space-between; align-items: center; padding: 12px 15px; border-bottom: 1px solid var(--border-color); }
        .data-item:last-child { border-bottom: none; }
        .btn-delete { background: rgba(239, 68, 68, 0.15); color: var(--error-color); border: none; padding: 5px 10px; border-radius: 6px; cursor: pointer; font-size: 0.8rem; font-weight: bold; }
        
        .role-actions { display: flex; align-items: center; gap: 5px; }
        .role-btn { padding: 4px 8px; border-radius: 6px; cursor: pointer; border: none; font-weight: bold; }
        .btn-edit { background: #e0f2fe; color: #0284c7; font-size: 0.8rem; padding: 5px 10px; }
        .btn-up, .btn-down { background: #f3f4f6; color: #4b5563; border: 1px solid #d1d5db; font-size: 1rem; line-height: 1; }

        @media (max-width: 768px) { 
            .settings-grid { grid-template-columns: 1fr; } 
            
            .role-item {
                flex-direction: column;
                align-items: flex-start !important;
                gap: 15px;
            }
            .role-item > div:first-child {
                width: 100%;
            }
            .role-item-permissions {
                max-width: 100% !important;
                white-space: normal !important;
                line-height: 1.6;
            }
            .role-actions-wrapper {
                width: 100%;
            }
            .role-actions {
                flex-direction: row;
                width: 100%;
                gap: 5px;
            }
            .role-actions > button {
                flex: 1;
                padding: 8px 5px !important;
                font-size: 0.85rem !important;
                margin-left: 0 !important;
                text-align: center;
            }
            
            .font-actions-wrapper {
                flex-direction: column !important;
                width: 100%;
                gap: 10px !important;
            }
            .font-actions-row1 {
                display: flex;
                flex-direction: row;
                width: 100%;
                gap: 5px !important;
            }
            .font-actions-row1 > button {
                flex: 1;
                padding: 8px 5px !important;
                font-size: 0.85rem !important;
                text-align: center;
            }
            .font-actions-row2 {
                width: 100%;
            }
            .font-actions-row2 > button {
                width: 100%;
                padding: 10px !important;
                font-size: 0.95rem !important;
                text-align: center;
            }
            
            .add-item-form-wrapper {
                flex-direction: column !important;
                align-items: stretch !important;
            }
            .add-item-inputs {
                flex-direction: column !important;
                width: 100%;
            }
            .add-item-inputs > input, .add-item-inputs > button {
                width: 100%;
            }
            .add-item-buttons {
                width: 100%;
            }
            .add-item-buttons > button {
                flex: 1;
            }
        }
        .modal-box { box-sizing: border-box; }
    
    @media (max-width: 768px) {
        .role-form-row {
            flex-direction: column;
            gap: 15px;
        }
        .role-form-row > div {
            width: 100% !important;
            flex: none !important;
        }
    }
    </style>
</head>

