        function editRole(id) {
            const r = rolesData.find(x => x.id == id);
            if(!r) return;
            document.getElementById('roleModal').style.display = 'flex';
            document.getElementById('roleForm').reset();
            document.getElementById('roleId').value = r.id;
            document.getElementById('roleName').value = r.name;
            document.getElementById('roleIcon').value = r.icon || '';
            document.getElementById('selectedRoleIconDisplay').innerHTML = r.icon || 'انتخاب آیکون';
            
            document.querySelectorAll('input[name="perms"]').forEach(chk => {
                chk.checked = r.permissions.includes(chk.value);
            });
            
            document.getElementById('roleModalTitle').innerHTML = `<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align: middle;'><path d='M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z'/><path d='m15 5 4 4'/></svg> ویرایش نقش`;
            document.getElementById('saveRoleBtn').innerText = 'ذخیره تغییرات';
        }
        
        async function saveRole(e) {
            e.preventDefault();
            const id = document.getElementById('roleId').value;
            const name = document.getElementById('roleName').value;
            const icon = document.getElementById('roleIcon').value;
            const perms = Array.from(document.querySelectorAll('input[name="perms"]:checked')).map(chk => chk.value);
            
            const payload = {
                action: id ? 'edit' : 'add',
                id: id,
                name: name,
                permissions: perms,
                icon: icon
            };
            
            const btn = document.getElementById('saveRoleBtn');
            const originalText = btn.innerText;
            btn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle; margin-left: 4px;"><path d="M5 22h14"/><path d="M5 2h14"/><path d="M17 22v-4.172a2 2 0 0 0-.586-1.414L12 12l-4.414 4.414A2 2 0 0 0 7 17.828V22"/><path d="M7 2v4.172a2 2 0 0 0 .586 1.414L12 12l4.414-4.414A2 2 0 0 0 17 6.172V2"/></svg>`; btn.disabled = true;
            
            try {
                const res = await fetch('/api/manage_roles', {
                    method: 'POST', headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify(payload)
                });
                const data = await res.json();
                if(data.status === 'success') {
                    document.getElementById('roleModal').style.display = 'none';
                    loadRoles();
                } else showToast('خطا: ' + data.message);
            } catch(err) { showToast('خطا در ارتباط با سرور', 'error'); }
            finally { btn.innerText = originalText; btn.disabled = false; }
        }
        
        async function deleteRole(id) {
            if(!(await window.customConfirm('آیا از حذف این نقش مطمئن هستید؟'))) return;
            try {
                await fetch('/api/manage_roles', {
                    method: 'POST', headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ action: 'delete', id: id })
                });
                loadRoles();
            } catch(e) {}
        }

    </script>

