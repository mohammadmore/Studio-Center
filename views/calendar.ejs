            <div class="modal-header">
                <h3 class="modal-title">تخصیص محتوا به پیشنهاد قالب</h3>
                <button class="close-btn" onclick="document.getElementById('suggestionModal').style.display='none'">×</button>
            </div>
            <div style="padding: 20px;">
                <p style="color: var(--text-gray); margin-bottom:15px;">نوع محتوا: <strong id="sugType"></strong> | موضوع: <strong id="sugTopic"></strong></p>
                <input type="hidden" id="currentSuggestionId">
                
                <label style="font-weight: bold;">انتخاب از دپو برای این سازمان:</label>
                <div id="sugDepotList" style="max-height: 200px; overflow-y: auto; border: 1px solid var(--border-color); border-radius: 8px; padding: 10px; display: flex; flex-direction: column; gap: 8px; background: rgba(128, 128, 128, 0.05); margin-top: 10px; margin-bottom: 15px;">
