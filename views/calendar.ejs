        let currentOrgContents = [];
        let selectedContentId = null;

        async function loadOrgContents() {
            const orgId = document.getElementById('scheduleOrg').value;
            selectedContentId = null;
            if (!orgId) {
                document.getElementById('existingContentsSection').style.display = 'none';
                return;
            }
            try {
                const res = await fetch(`/api/get_org_contents?org_id=${orgId}`);
                const result = await res.json();
                if (result.status === 'success') {
                    // فیلتر محتوا‌های منتشر نشده (فرضا هرچه status غیر done یا بدون publish_date)
                    const targetType = document.getElementById('newScheduleType').value;
                    currentOrgContents = result.data.filter(c => c.status !== 'done').sort((a, b) => {
                        if (targetType) {
                            const aMatch = a.content_type === targetType ? -1 : 1;
                            const bMatch = b.content_type === targetType ? -1 : 1;
                            return aMatch - bMatch;
                        }
                        return 0;
                    });
                    renderOrgContents(currentOrgContents);
                    document.getElementById('existingContentsSection').style.display = 'flex';
                }
            } catch (e) { console.error(e); }
        }

