        let selectedDayStr = '';
        async function addNewContent(dayNumber) {
            // ساخت رشته تاریخ
            const y = currentYear.toString();
            const m = currentMonth.toString().padStart(2, '0');
            const d = dayNumber.toString().padStart(2, '0');
            selectedDayStr = `${y}/${m}/${d}`;
            
            // بستن مدال قبلی اگر باز است
            closeModal(true);
            
            const modal = document.getElementById('scheduleModal');
            document.getElementById('scheduleModalTitle').innerText = 'افزودن محتوا برای تاریخ ' + toPersianDigits(selectedDayStr);
            
            // ریست فرم
            document.getElementById('scheduleOrg').innerHTML = '<option value="">-- انتخاب سازمان --</option>';
            document.getElementById('existingContentsSection').style.display = 'none';
            document.getElementById('orgContentsList').innerHTML = '';
            document.getElementById('newScheduleTitle').value = '';
            document.getElementById('newContentSection').style.display = 'none';
            if (document.getElementById('toggleNewContentWrapper')) {
                document.getElementById('toggleNewContentWrapper').style.display = 'block';
            }
            
            try {
                // لود سازمان‌ها
                const orgRes = await fetch('/api/get_orgs', { cache: 'no-store' });
                const orgData = await orgRes.json();
                if (orgData.data) {
                    const select = document.getElementById('scheduleOrg');
                    orgData.data.forEach(o => {
                        select.innerHTML += `<option value="${o.id}">${o.org_name}</option>`;
                    });
                }
                
                // لود همکاران
                const colRes = await fetch('/api/get_colleagues');
                const colData = await colRes.json();
                const mgrSelect = document.getElementById('newScheduleManager');
                const teamSelect = document.getElementById('newScheduleTeamCheckboxes');
                mgrSelect.innerHTML = '<option value="">-- انتخاب مدیر پروژه --</option>';
                teamSelect.innerHTML = '';
                if (colData.users) {
                    (colData.users || []).forEach(u => {
                        mgrSelect.innerHTML += `<option value="${u.full_name}">${u.full_name}</option>`;
                        teamSelect.innerHTML += `<label style="display:flex; align-items:center; gap:6px; font-size:0.9rem; cursor:pointer;"><input type="checkbox" name="newScheduleTeam_cb" value="${u.full_name}"> ${u.full_name}</label>`;
                    });
                }

                // لود انواع محتوا و مراحل
                const setRes = await fetch('/api/manage_settings', { cache: 'no-store' });
                const setData = await setRes.json();
                if (setData.data) {
                    if (setData.data.content_type) {
                        const tSelect = document.getElementById('newScheduleType');
                        tSelect.innerHTML = '';
                        (setData.data && setData.data.content_type || []).forEach(t => {
                            tSelect.innerHTML += `<option value="${t.setting_key}">${t.setting_key}</option>`;
                        });
                    }
                    if (setData.data.stages) {
                        const stagesDiv = document.getElementById('newScheduleStages');
                        stagesDiv.innerHTML = '';
                        (setData.data && setData.data.stages || []).forEach(s => {
                            stagesDiv.innerHTML += `<label><input type="checkbox" value="${s.setting_key}"> ${s.setting_key}</label>`;
                        });
                    }
                }
            } catch (e) { console.error(e); }
            
            modal.style.display = 'flex';
        }

