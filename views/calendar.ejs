        window.updateKanbanStatus = async function() {
            if(!window.currentDrawerContentId) return;
            const newStatus = document.getElementById('drawerKanbanStatus').value;
            try {
                const res = await fetch('/api/update_content_details', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({
                        id: window.currentDrawerContentId,
                        status: newStatus
                    })
                });
                const data = await res.json();
                if(data.status === 'success') {
                    if(window.showToast) window.showToast('وضعیت با موفقیت به‌روز شد', 'success');
                    // update local data
                    for (let day in window.monthlyData) {
                        let match = window.monthlyData[day].find(i => i.id == window.currentDrawerContentId);
                        if (match) { match.status = newStatus; break; }
                    }
                } else {
                    if(window.showToast) window.showToast(data.message || 'خطا در ذخیرهسازی', 'error');
                }
            } catch(e) {
                console.error(e);
                if(window.showToast) window.showToast('خطا در ارتباط با سرور', 'error');
            }
        };

        
