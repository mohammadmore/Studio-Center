        async function submitSchedule() {
            const orgId = document.getElementById('scheduleOrg').value;
            if (!orgId) return showToast('لطفاً سازمان را انتخاب کنید.');
            const newTitle = document.getElementById('newScheduleTitle').value.trim();
            const publishTime = document.getElementById('newScheduleTime').value;

            // Date validation (past date check)
            let today = jalaali.toJalaali(new Date());
            let todayStr = `${today.jy}/${today.jm.toString().padStart(2, '0')}/${today.jd.toString().padStart(2, '0')}`;
            let isPastDate = selectedDayStr < todayStr;

            if (isPastDate) {
                showCustomConfirm("از آنجا که این تاریخ گذشته است، فرض بر این است که محتوا قبلا منتشر شده و اکنون صرفا برای مستندسازی اضافه می‌شود.\nوضعیت این محتوا به طور خودکار روی «منتشر شده» تنظیم خواهد شد.\n\nآیا تایید می‌کنید؟", () => {
                    executeSubmitSchedule('published');
                });
                return;
            }
            executeSubmitSchedule(undefined);
        }

        async function executeSubmitSchedule(customStatus) {
            const orgId = document.getElementById('scheduleOrg').value;
            const newTitle = document.getElementById('newScheduleTitle').value.trim();
            const publishTime = document.getElementById('newScheduleTime').value;


            const isRecurring = document.getElementById('isRecurring').checked;
            const recurrenceInterval = parseInt(window.toEnglishDigits(document.getElementById('recurrenceInterval').value)) || 7;
            const recurrenceCount = parseInt(window.toEnglishDigits(document.getElementById('recurrenceCount').value)) || 12;
            const countInStats = document.getElementById('countInStats').checked;
            
            const recurrenceData = isRecurring ? {
                is_recurring: true,
                recurrence_interval_days: recurrenceInterval,
                recurrence_count: recurrenceCount,
                count_in_stats: countInStats
            } : {};

            if (selectedContentId && !newTitle) {
                // برنامه‌ریزی محتوای موجود
                try {
                    const res = await fetch('/api/schedule_content', {
                        method: 'POST',
                        headers: {'Content-Type': 'application/json'},
                        body: JSON.stringify({ id: selectedContentId, publish_date: selectedDayStr,
                            publish_time: publishTime, status: customStatus, ...recurrenceData })
                    });
                    const result = await res.json();
                    if (result.status === 'success') {
                        closeScheduleModal(true);
                        renderCalendar(); // آپدیت تقویم
                    } else showToast('خطا: ' + result.message);
                } catch(e) { console.error(e); showToast('خطا در ارتباط با سرور', 'error'); }
            } else if (newTitle) {
                // ایجاد محتوای جدید
                const type = document.getElementById('newScheduleType').value;
                const project_manager = document.getElementById('newScheduleManager').value;
                const assigned_colleagues = Array.from(document.querySelectorAll('input[name="newScheduleTeam_cb"]:checked')).map(cb => cb.value);
                const stageBoxes = document.querySelectorAll('#newScheduleStages input[type="checkbox"]:checked');
                const stages = Array.from(stageBoxes).map(cb => cb.value);

                const components_count = {};
                document.querySelectorAll('.comp-count-sched').forEach(input => {
                    const val = parseInt(window.toEnglishDigits(input.value));
                    if (val > 0) components_count[input.dataset.name] = val;
                });

                try {
                    const res = await fetch('/api/add_content', {
                        method: 'POST',
                        headers: {'Content-Type': 'application/json'},
                        body: JSON.stringify({
                            title: newTitle, 
                            type, 
                            org_id: orgId,
                            publish_date: selectedDayStr,
                            publish_time: publishTime,
                            status: customStatus,
                            project_manager,
                            assigned_colleagues,
                            stages,
                            components_count,
                            ...recurrenceData
                        })
                    });
                    const result = await res.json();
                    if (result.status === 'success') {
                        closeScheduleModal(true);
                        renderCalendar(); // آپدیت تقویم
                    } else showToast('خطا: ' + result.message);
                } catch(e) { console.error(e); showToast('خطا در ارتباط با سرور', 'error'); }
            } else {
                showToast('لطفاً یک محتوا از لیست انتخاب کنید یا عنوان محتوای جدید را وارد نمایید.');
            }
        }

        async function initCalendar() {
            // Start rendering calendar immediately so its data fetching happens concurrently
            const renderPromise = renderCalendar();
            try {
                if (!window.allOrgs) {
                    const [orgRes, colRes, setRes] = await Promise.all([
                        fetch('/api/get_orgs', { cache: 'no-store' }),
                        fetch('/api/get_colleagues'),
                        fetch('/api/manage_settings', { cache: 'no-store' })
                    ]);
                    window.allOrgs = (await orgRes.json()).data || [];
                    window.allColleagues = (await colRes.json()).users || [];
                    window.allSettings = (await setRes.json()).data || {};
                    const collectionsRes = await fetch('/api/get_collections');
                    window.allCollections = (await collectionsRes.json()).data || [];
                }
                const filter = document.getElementById('orgFilter');
                filter.innerHTML = '<option value="all">همه تیم‌ها</option>';
                (window.allOrgs || []).forEach(org => {
                    filter.innerHTML += `<option value="${org.id}">${org.org_name}</option>`;
                });
                
                const tFilter = document.getElementById('typeFilter');
                tFilter.innerHTML = '<option value="all">همه محتوا‌ها</option>';
                if (window.allSettings && window.allSettings.content_type) {
                    (window.allSettings.content_type || []).forEach(t => {
                        tFilter.innerHTML += `<option value="${t.setting_key}">${t.setting_key}</option>`;
                    });
                }
            } catch(e) { console.log(e); }
            await renderPromise;
        }
        setTimeout( () => { applyViewMode(); initCalendar(); });
    </script>
<script src="assets/js/app.js?v=4"></script>
    <%- include('partials/content-identity') %>
</body>
</html>