    <script src="assets/js/jalaali.min.js?v=2"></script>
<script>
        // --- Excel Schedule Modal Logic ---
        let parsedExcelScheduleRows = [];
        let excelScheduleWarnings = [];

        function openExcelScheduleModal() {
            document.getElementById('excelScheduleModal').style.display = 'flex';
            resetExcelScheduleModal();
        }

        function closeExcelScheduleModal() {
            document.getElementById('excelScheduleModal').style.display = 'none';
        }

        function resetExcelScheduleModal() {
            parsedExcelScheduleRows = [];
            excelScheduleWarnings = [];
            document.getElementById('excelScheduleInput').value = '';
            document.getElementById('excelScheduleDropZone').style.display = 'block';
            document.getElementById('excelSchedulePreviewArea').style.display = 'none';
            document.getElementById('excelScheduleWarningsArea').style.display = 'none';
            document.getElementById('btnSubmitExcelSchedule').style.display = 'flex';
            document.getElementById('btnForceSubmitExcelSchedule').style.display = 'none';
        }

        async function handleExcelScheduleFile(file) {
            if (!file) return;
            if (!window.XLSX) {
                if (window.showToast) window.showToast('کتابخانه پردازش اکسل بارگذاری نشده است. صفحه را رفرش کنید', 'error');
                return;
            }
            try {
                const data = await file.arrayBuffer();
                const workbook = XLSX.read(data, { type: 'array' });
                const firstSheetName = workbook.SheetNames[0];
                const worksheet = workbook.Sheets[firstSheetName];
                const rows = XLSX.utils.sheet_to_json(worksheet);

                if (!rows || rows.length === 0) {
                    if (window.showToast) window.showToast('هیچ داده‌ای در فایل اکسل یافت نشد', 'error');
                    return;
                }

                parsedExcelScheduleRows = rows.map(r => ({
                    content_id: r['شناسه محتوا'] || r['شناسه'] || r['id'],
                    org_name: r['نام تیم'] || r['تیم'] || r['سازمان'] || r['org'],
                    publish_date: r['تاریخ انتشار'] || r['publish_date'],
                    publish_time: r['زمان انتشار'] || r['ساعت انتشار'] || r['publish_time']
                })).filter(r => r.content_id && r.org_name && String(r.org_name).trim() !== '' && !isNaN(parseInt(r.content_id)));

                if (parsedExcelScheduleRows.length === 0) {
                    if (window.showToast) window.showToast('هیچ ردیف معتبری حاوی شناسه محتوا و نام تیم یافت نشد', 'error');
                    return;
                }

                renderExcelSchedulePreview();
            } catch (e) {
                console.error(e);
                if (window.showToast) window.showToast('خطا در خواندن و پردازش فایل اکسل', 'error');
            }
        }

        function renderExcelSchedulePreview() {
            const tbody = document.getElementById('excelSchedulePreviewTableBody');
            tbody.innerHTML = '';
            document.getElementById('excelScheduleCountBadge').innerText = parsedExcelScheduleRows.length + ' مورد';

            parsedExcelScheduleRows.forEach((r, idx) => {
                const tr = document.createElement('tr');
                tr.style.borderBottom = '1px solid rgba(128, 128, 128, 0.05)';
                tr.innerHTML = `
                    <td style="padding: 8px 10px; font-weight: 600; color: var(--text-gray);">${idx + 1}</td>
                    <td style="padding: 8px 10px; font-weight: bold; color: var(--text-dark);">${r.content_id}</td>
                    <td style="padding: 8px 10px;">${r.org_name}</td>
                    <td style="padding: 8px 10px; font-family: monospace;">${r.publish_date || '-'} ${r.publish_time || ''}</td>
                `;
                tbody.appendChild(tr);
            });

            document.getElementById('excelScheduleDropZone').style.display = 'none';
            document.getElementById('excelSchedulePreviewArea').style.display = 'block';
        }

        async function submitExcelSchedule(force = false) {
            if (!parsedExcelScheduleRows || parsedExcelScheduleRows.length === 0) return;

            const btnId = force ? 'btnForceSubmitExcelSchedule' : 'btnSubmitExcelSchedule';
            const submitBtn = document.getElementById(btnId);
            const originalHtml = submitBtn.innerHTML;
            submitBtn.disabled = true;
            submitBtn.innerHTML = 'در حال پردازش...';

            try {
                const res = await fetch('/api/bulk_schedule_contents', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ items: parsedExcelScheduleRows, force })
                });
                const result = await res.json();

                if (result.status === 'success') {
                    if (window.showToast) window.showToast(result.message || 'زمان‌بندی‌ها با موفقیت اعمال شدند', 'success');
                    closeExcelScheduleModal();
                    renderCalendar(); // Refresh calendar
                } else if (result.status === 'warning') {
                    // Show warnings
                    document.getElementById('excelScheduleWarningsArea').style.display = 'block';
                    const warningsList = document.getElementById('excelScheduleWarningsList');
                    warningsList.innerHTML = result.warnings.map(w => `<li>${w}</li>`).join('');
                    
                    document.getElementById('btnSubmitExcelSchedule').style.display = 'none';
                    document.getElementById('btnForceSubmitExcelSchedule').style.display = 'flex';
                } else {
                    if (window.showToast) window.showToast(result.message || 'خطا در ثبت زمان‌بندی‌ها', 'error');
                }
            } catch (e) {
                console.error(e);
                if (window.showToast) window.showToast('خطا در ارتباط با سرور', 'error');
            } finally {
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalHtml;
            }
        }

</script>
    <style>
        .calendar-container {
            background: var(--card-bg);
            border-radius: 12px;
            padding: 20px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.03); transition: all 0.3s ease;
            margin-top: 20px;
        }
        
        .calendar-header-actions {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .calendar-nav {
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }
        .calendar-nav button {
            background: rgba(99, 102, 241, 0.1);
            color: var(--primary-color) !important;
            border: 1px solid rgba(99, 102, 241, 0.3) !important;
            padding: 8px 16px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 0.95rem;
            font-weight: bold;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            height: 38px;
            box-sizing: border-box;
            line-height: 1;
            vertical-align: middle;
        }
        .calendar-nav button svg {
            display: inline-block;
            vertical-align: middle;
            flex-shrink: 0;
        }
        .calendar-nav button:hover {
            background: rgba(99, 102, 241, 0.2);
            border-color: rgba(99, 102, 241, 0.5) !important;
            transform: translateY(-1px);
        }

        .calendar-grid {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 10px;
            background: var(--card-bg);
            border-radius: 12px;
            overflow: hidden;
            max-width: 1100px;
            margin: 0 auto;
        }

        .calendar-day-name {
            background: rgba(128, 128, 128, 0.05);
            text-align: center;
            font-weight: bold;
            padding: 15px 0;
            color: var(--text-gray);
            font-size: 0.95rem;
        }

        .calendar-cell {
            background: var(--card-bg);
            height: 130px;
            padding: 10px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: flex-end;
            transition: background 0.2s;
            position: relative;
            cursor: pointer;
            overflow: hidden;
            box-sizing: border-box;
            width: 100%;
            min-width: 0;
            border: 1px solid var(--border-color);
            border-radius: 8px;
        }

        .calendar-cell:hover {
            background: rgba(128, 128, 128, 0.05);
        }

        .calendar-cell.empty-cell {
            background: rgba(128, 128, 128, 0.1);
            cursor: default;
        }

        .calendar-cell.today {
            background: #eff6ff;
            box-shadow: inset 0 0 0 2px var(--primary-color);
        }
        
        .calendar-cell.holiday {
            background: #fce7f3 !important;
            border-color: #fbcfe8 !important;
            border-style: solid !important;
        }
        .calendar-cell.routine-holiday {
            background: rgba(244, 63, 94, 0.05) !important;
            border-color: #fbcfe8 !important;
            border-style: dashed !important;
        }
        .calendar-cell.special-holiday {
            background: #fecdd3 !important;
            border-color: #fda4af !important;
            border-style: solid !important;
        }

        .day-number {
            font-size: 1.2rem;
            font-weight: bold;
            color: var(--text-gray);
            margin-bottom: 15px;
            width: 100%;
            text-align: right;
        }
        
        .today .day-number {
            color: var(--primary-color);
        }
        
        .holiday .day-number {
            color: var(--error-color) !important;
        }

        .content-badge {
            background: linear-gradient(135deg, var(--primary-color), #4338ca);
            color: white;
            font-size: 1.2rem;
            font-weight: bold;
            padding: 10px;
            min-width: 40px;
            text-align: center;
            border-radius: 50%;
            box-shadow: 0 4px 6px rgba(67, 56, 202, 0.3);
            transition: transform 0.2s;
        }
        
        .calendar-cell:hover .content-badge {
            transform: scale(1.1);
        }

        /* --- استایل‌های پاپ‌آپ (Modal) --- */
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(8px);
            z-index: 1000;
            justify-content: center;
            align-items: center;
            backdrop-filter: blur(3px);
        }

        .modal-content {
            background: var(--card-bg);
            border-radius: 12px;
            padding: 25px;
            width: 90%;
            width: 100%; max-width: 500px; box-sizing: border-box;
            max-height: 80vh;
            overflow-y: auto;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
            animation: modalFadeIn 0.3s ease;
        }

        @keyframes modalFadeIn {
            from { opacity: 0; transform: translateY(-20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            border-bottom: 2px solid var(--border-color);
            padding-bottom: 10px;
        }

        .modal-title {
            font-size: 1.3rem;
            font-weight: 900;
            color: var(--primary-color);
            margin: 0;
        }

        .close-modal {
            background: none;
            border: none;
            font-size: 1.5rem;
            cursor: pointer;
            color: #94a3b8;
        }
        .close-modal:hover { color: var(--error-color); }

        .popup-item {
            background: rgba(128, 128, 128, 0.05);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 15px;
            margin-bottom: 15px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .popup-item-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
        }

        .popup-org-name {
            font-weight: bold;
            color: var(--text-gray);
            font-size: 1.05rem;
        }

        .popup-content-type {
            background: rgba(99, 102, 241, 0.15);
            color: var(--primary-color);
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 0.8rem;
            font-weight: bold;
        }

        .popup-item-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            color: var(--text-gray);
            font-size: 0.85rem;
            border-top: 1px dashed var(--border-color);
            padding-top: 8px;
        }
        
        .popup-time {
            display: flex;
            align-items: center;
            gap: 5px;
            font-weight: bold;
        }

        /* استایل دکمه افزودن محتوا در پاپ‌آپ خالی */
        .btn-add-content {
            background: linear-gradient(135deg, var(--success-color), #059669);
            color: white;
            border: none;
            padding: 12px 25px;
            border-radius: 8px;
            font-size: 1rem;
            font-weight: bold;
            cursor: pointer;
            box-shadow: 0 4px 6px rgba(16, 185, 129, 0.2);
            transition: transform 0.2s, box-shadow 0.2s;
            margin-top: 10px;
        }
        .btn-add-content:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 8px rgba(16, 185, 129, 0.3);
        }
    
        @media (max-width: 768px) {
            .calendar-day-name {
                writing-mode: vertical-rl;
                transform: rotate(180deg);
                height: 70px;
                font-size: 0.75rem !important;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 5px 0 !important;
            }
            .desktop-event-item {
                display: none !important;
            }
            .mobile-count-badge {
                display: block !important;
            }
            .calendar-cell {
                min-height: 70px !important;
                padding: 2px !important;
            }
            .calendar-cell > div:first-child {
                font-size: 0.9rem;
                margin-bottom: 2px;
            }
        }
        .mobile-count-badge {
            display: none;
            
            color: white;
            border-radius: 4px;
            padding: 2px;
            font-size: 0.8rem;
            text-align: center;
            width: 100%;
            box-sizing: border-box;
            margin-top: 4px;
        }

    </style>
