    <script>
    window.selectedBatchIds = [];
    
    function toggleBatchSelect(id, isChecked) {
        id = parseInt(id);
        if (isChecked) {
            if (!window.selectedBatchIds.includes(id)) window.selectedBatchIds.push(id);
        } else {
            window.selectedBatchIds = window.selectedBatchIds.filter(x => x !== id);
        }
        updateBatchUI();
    }
    
    function updateBatchUI() {
        const bar = document.getElementById('batchActionsBar');
        const count = document.getElementById('batchCount');
        
        document.querySelectorAll('.batch-checkbox').forEach(cb => {
            cb.checked = window.selectedBatchIds.includes(parseInt(cb.value));
        });
    
        if (window.selectedBatchIds.length > 0) {
            bar.style.display = 'flex';
            count.innerText = window.toPersianDigits(window.selectedBatchIds.length) + ' محتوا انتخاب شده';
        } else {
            bar.style.display = 'none';
        }
    }
    
    function clearBatchSelection() {
        window.selectedBatchIds = [];
        updateBatchUI();
    }
    
    function openBatchEditModal() {
        if (window.selectedBatchIds.length === 0) return;
        document.getElementById('batchEditCountLabel').innerText = window.toPersianDigits(window.selectedBatchIds.length);
        document.getElementById('batchAction').value = '';
        toggleBatchFields();
        document.getElementById('batchEditModal').style.display = 'flex';
    }
    
    function toggleBatchFields() {
        const action = document.getElementById('batchAction').value;
        const container = document.getElementById('batchFieldsContainer');
        const submitBtn = document.getElementById('batchSubmitBtn');
        
        document.getElementById('bf-status').style.display = 'none';
        document.getElementById('bf-shift-dates').style.display = 'none';
        document.getElementById('bf-manager').style.display = 'none';
        document.getElementById('bf-team').style.display = 'none';
        
        if (!action) {
            container.style.display = 'none';
            submitBtn.style.display = 'none';
            return;
        }
        
        container.style.display = 'block';
        submitBtn.style.display = 'inline-block';
        
        if (action === 'status') document.getElementById('bf-status').style.display = 'block';
        if (action === 'shift_dates') document.getElementById('bf-shift-dates').style.display = 'block';
        if (action === 'manager') {
            document.getElementById('bf-manager').style.display = 'block';
            let html = '<option value="">-- تعیین نشده --</option>';
            if(window.allColleagues) {
                window.allColleagues.forEach(c => {
                    html += `<option value="${c.full_name}">${c.full_name}</option>`;
                });
            }
            document.getElementById('batchManagerInput').innerHTML = html;
        }
        if (action === 'team') {
            document.getElementById('bf-team').style.display = 'block';
            let html = '';
            if(window.allColleagues) {
                window.allColleagues.forEach(c => {
                    html += `<label style="display:flex; align-items:center; gap:6px;"><input type="checkbox" name="batchTeamInput_cb" value="${c.id}"> ${c.full_name}</label>`;
                });
            }
            document.getElementById('batchTeamInput').innerHTML = html;
        }
        
        if (action === 'delete') {
            container.style.display = 'none'; // No fields for delete
        }
    }
    
    async function submitBatchEdit() {
        const action = document.getElementById('batchAction').value;
        if (!action) return;
        
        let payload = {
            ids: window.selectedBatchIds,
            action: action
        };
        
        if (action === 'delete') {
            if (!(await window.customConfirm('آیا از حذف گروهی این محتوا‌ها اطمینان دارید؟'))) return;
        } else if (action === 'status') {
            payload.status = document.getElementById('batchStatusInput').value;
        } else if (action === 'shift_dates') {
            payload.shift_days = document.getElementById('batchShiftDaysInput').value;
        } else if (action === 'manager') {
            payload.project_manager = document.getElementById('batchManagerInput').value;
        } else if (action === 'team') {
            const cbs = Array.from(document.querySelectorAll('input[name="batchTeamInput_cb"]:checked'));
            payload.team = cbs.map(cb => cb.value);
        }
        
        try {
            const res = await fetch('/api/batch_edit_contents', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify(payload)
            });
            const result = await res.json();
            if (result.status === 'success') {
                if(window.showToast) window.showToast('عملیات گروهی با موفقیت انجام شد.', 'success');
                document.getElementById('batchEditModal').style.display = 'none';
                clearBatchSelection();
                if (typeof renderCalendar === 'function') renderCalendar();
            } else {
                if(window.showToast) window.showToast('خطا: ' + result.message, 'error');
            }
        } catch(e) {
            console.error(e);
            if(window.showToast) window.showToast('خطا در ارتباط با سرور', 'error');
        }
    }

        let currentDate = new Date();
