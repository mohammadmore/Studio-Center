        window.handleAttachmentUpload = async function(event) {
            const file = event.target.files[0];
            if (!file) return;
            
            if(!window.currentDrawerContentId) {
                if(window.showToast) window.showToast('محتوایی انتخاب نشده است', 'error');
                return;
            }

            const formData = new FormData();
            formData.append('file', file);

            try {
                if(window.showToast) window.showToast('در حال آپلود...', 'info');
                
                const res = await fetch('/api/upload_file', {
                    method: 'POST',
                    body: formData
                });
                const data = await res.json();
                if(data.status === 'success') {
                    const newAtt = { url: data.url, name: file.name };
                    window.currentDrawerContentAttachments.push(newAtt);
                    
                    const updateRes = await fetch('/api/update_content_details', {
                        method: 'POST',
                        headers: {'Content-Type': 'application/json'},
                        body: JSON.stringify({
                            id: window.currentDrawerContentId,
                            attachments: window.currentDrawerContentAttachments
                        })
                    });
                    const updateData = await updateRes.json();
                    
                    if(updateData.status === 'success') {
                        if(window.showToast) window.showToast('فایل با موفقیت ضمیمه شد', 'success');
                        renderDrawerAttachments(window.currentDrawerContentAttachments);
                        
                        for (let day in window.monthlyData) {
                            let items = window.monthlyData[day];
                            for (let it of items) {
                                if (it.id == window.currentDrawerContentId) {
                                    it.attachments = window.currentDrawerContentAttachments;
                                }
                            }
                        }
                    } else {
                        if(window.showToast) window.showToast(updateData.message || 'خطا در ذخیره مشخصات فایل', 'error');
                    }
                } else {
                    if(window.showToast) window.showToast(data.message || 'خطا در آپلود فایل', 'error');
                }
            } catch(e) {
                console.error(e);
                if(window.showToast) window.showToast('ارتباط با سرور برقرار نشد', 'error');
            }
            
            event.target.value = '';
        };

