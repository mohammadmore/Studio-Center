<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<script nonce="<%= nonce %>">
// Global Network Error Handler
(function() {
    if (window._fetchIntercepted) return;
    window._fetchIntercepted = true;
    const originalFetch = window.fetch;
    window.fetch = async function(...args) {
        try {
            return await originalFetch.apply(this, args);
        } catch (e) {
            // Suppress network error toasts which commonly trigger on dev server restart polling
            // console.error('Network Error:', e);
            return new Response(JSON.stringify({status: 'error', message: 'Network error'}), {
                status: 200, 
                headers: { 'Content-Type': 'application/json' }
            });
        }
    };
})();
</script>

        <base href="<%= typeof BASE_URL !== 'undefined' ? BASE_URL + '/' : '/' %>">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= STUDIO_NAME %> | افزودن همکار جدید</title>
    <link rel="stylesheet" href="assets/css/style.css?v=6">
        <link href="assets/css/cropper.min.css" rel="stylesheet">
    <script src="assets/js/cropper.min.js" defer></script>
    <style nonce="<%= nonce %>">
                .upload-trigger { border: 2px dashed #ddd; padding: 20px; text-align: center; border-radius: 8px; cursor: pointer; color: #666; margin-bottom: 10px; }
        .upload-trigger:hover { border-color: var(--primary-color); background: rgba(128, 128, 128, 0.05); }
        .img-container { width: 100%; max-height: 300px; display: none; margin-bottom: 15px; }
        .img-container img { max-width: 100%; }
        .form-section { background: var(--card-bg); border-radius: 12px; padding: 25px; margin-bottom: 25px; border: 1px solid var(--border-color); box-shadow: 0 2px 8px -1px rgba(0,0,0,0.03); }
        .section-title { font-size: 1.1rem; font-weight: 800; color: var(--primary-color); margin-bottom: 20px; border-bottom: 2px solid var(--border-color); padding-bottom: 10px; }
        .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
        .roles-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 15px; }
        .role-checkbox-card { background: rgba(128, 128, 128, 0.05); border: 1px solid var(--border-color); border-radius: 8px; padding: 15px; display: flex; align-items: center; cursor: pointer; transition: 0.2s; }
        .role-checkbox-card:hover { border-color: var(--primary-color); }
        .role-checkbox-card input[type="checkbox"] { margin-left: 15px; transform: scale(1.3); cursor: pointer; }
        .role-title { font-weight: bold; color: var(--text-dark); display: block; }
        .role-desc { font-size: 0.8rem; color: var(--text-gray); }
    </style>
</head>

<body>
    <%- include('sidebar') %>

    

    <main class="main-content">
        <div class="page-header-container flex-responsive">
            <div>
                <h1 class="page-title"><!-- @license lucide-static v1.28.0 - ISC -->
<svg
  class="lucide lucide-user-plus"
  xmlns="http://www.w3.org/2000/svg"
