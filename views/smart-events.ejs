                <tbody>
                    <tr>
                        <td style="padding: 10px; border: 1px solid #ddd;">عنوان مناسبت</td>
                        <td style="padding: 10px; border: 1px solid #ddd;">نوع تقویم<br><small>(شمسی/قمری/میلادی)</small></td>
                        <td style="padding: 10px; border: 1px solid #ddd;">روز<br><small>(عدد)</small></td>
                        <td style="padding: 10px; border: 1px solid #ddd;">ماه<br><small>(عدد)</small></td>
