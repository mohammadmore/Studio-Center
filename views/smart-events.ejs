                        <th style="padding: 10px; border: 1px solid #ddd;">ستون ۴</th>
                        <th style="padding: 10px; border: 1px solid #ddd;">ستون ۵</th>
                        <th style="padding: 10px; border: 1px solid #ddd;">ستون ۶</th>
                        <th style="padding: 10px; border: 1px solid #ddd;">ستون ۷</th>
                        <th style="padding: 10px; border: 1px solid #ddd;">ستون ۸</th>
                    </tr>
