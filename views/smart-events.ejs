    <script src="assets/js/app.js?v=4"></script>
    <script>
        const monthNames = ["فروردین", "اردیبهشت", "خرداد", "تیر", "مرداد", "شهریور", "مهر", "آبان", "آذر", "دی", "بهمن", "اسفند"];
        const dayNames = ["یکشنبه", "دوشنبه", "سه‌شنبه", "چهارشنبه", "پنج‌شنبه", "جمعه", "شنبه"];
        
        let currentDate = new Date();
        let currentJalali = jalaali.toJalaali(currentDate);
        let currentYear = currentJalali.jy;
        let currentMonth = currentJalali.jm;
        
        window.monthlyData = {};
        
        let currentViewMode = window.innerWidth <= 768 ? 'list' : 'grid';

        function toPersianDigits(str) {
            const persianNumbers = ['۰', '۱', '۲', '۳', '۴', '۵', '۶', '۷', '۸', '۹'];
            if(!str && str !== 0) return '';
            return str.toString().replace(/[0-9]/g, function (w) {
                return persianNumbers[+w];
            });
        }

        async function loadOrganizations() {
            try {
                const res = await fetch('/api/get_orgs', { cache: 'no-store' });
                const data = await res.json();
                if(data.status === 'success') {
                    const sel = document.getElementById('orgSelector');
                    const newEventOrgSel = document.getElementById('newEventOrg');
                    const viewOrgSel = document.getElementById('viewOrgSelector');
                    (data.data || []).forEach(org => {
                        sel.innerHTML += `<option value="${org.id}">${org.org_name}</option>`;
                        if(newEventOrgSel) newEventOrgSel.innerHTML += `<option value="${org.id}">${org.org_name}</option>`;
                        if(viewOrgSel) viewOrgSel.innerHTML += `<option value="${org.id}">${org.org_name}</option>`;
                    });
                }
            } catch(e) {}
        }
        
        function applyViewMode() {
            const btn = document.getElementById('viewToggleBtn');
            const grid = document.getElementById('calendar-grid');
            const list = document.getElementById('list-view-container');
            if(!btn || !grid || !list) return;
            if (currentViewMode === 'list') {
                btn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg> نمایش تقویم`;
                grid.style.display = 'none';
                list.style.display = 'block';
            } else {
                btn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="8" height="4" x="8" y="2" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="M12 11h4"/><path d="M12 16h4"/><path d="M8 11h.01"/><path d="M8 16h.01"/></svg> نمایش فهرستی`;
                grid.style.display = 'grid';
                list.style.display = 'none';
            }
        }
        
        function toggleViewMode() {
            currentViewMode = currentViewMode === 'grid' ? 'list' : 'grid';
            applyViewMode();
            renderCalendar();
        }

        async function renderCalendar() {
            document.getElementById('current-month-label').innerText = monthNames[currentMonth - 1] + " " + toPersianDigits(currentYear);
            document.getElementById('newEventMonth').value = currentMonth;
                document.getElementById('newEventBaseYear').value = window.toPersianDigits(currentYear);
            document.getElementById('newEventIsHoliday').checked = false;
            
            let daysInMonth = 31;
            if (currentMonth > 6 && currentMonth < 12) daysInMonth = 30;
            if (currentMonth === 12) {
                daysInMonth = jalaali.isLeapJalaaliYear(currentYear) ? 30 : 29;
            }

            let firstDayGregorian = jalaali.toGregorian(currentYear, currentMonth, 1);
            let firstDayDateObj = new Date(firstDayGregorian.gy, firstDayGregorian.gm - 1, firstDayGregorian.gd);
            let firstDayOfWeek = (firstDayDateObj.getDay() + 1) % 7; 

            window.monthlyData = {};
            
            let routineHolidays = [5]; // Default to Friday
            try {
                const response = await fetch(`/api/get_smart_events_monthly?year=${currentYear}&month=${currentMonth}&org_id=${document.getElementById('viewOrgSelector').value}`, { cache: 'no-store' });
                const data = await response.json();
                if(data.status === 'success') {
                    if(data.routine_holidays) routineHolidays = data.routine_holidays; window.routineHolidays = routineHolidays;
                    (data.data || []).forEach(item => {
                        let day = parseInt(item.publish_day); 
                        if(!window.monthlyData[day]) window.monthlyData[day] = [];
                        window.monthlyData[day].push(item);
                    });
                }
            } catch (e) { console.error(e); }

            const grid = document.getElementById('calendar-grid');
            const cells = grid.querySelectorAll('.calendar-cell');
            cells.forEach(cell => cell.remove());

            let newCellsHtml = '';
            for (let i = 0; i < firstDayOfWeek; i++) {
                newCellsHtml += `<div class="calendar-cell empty-cell"></div>`;
            }

            let todayJalali = jalaali.toJalaali(new Date());

            for (let d = 1; d <= daysInMonth; d++) {
                let isToday = (d === todayJalali.jd && currentMonth === todayJalali.jm && currentYear === todayJalali.jy) ? 'today' : '';
                
                let gregorianDay = jalaali.toGregorian(currentYear, currentMonth, d);
                let jsDate = new Date(gregorianDay.gy, gregorianDay.gm - 1, gregorianDay.gd);
                let currentDayOfWeek = jsDate.getDay();
                let isRoutineHoliday = routineHolidays.includes(currentDayOfWeek);
                let isSpecialHoliday = false;
                
                // Also check if there's any event on this day that is marked as a holiday
                if(window.monthlyData[d] && window.monthlyData[d].some(ev => ev.is_holiday == 1)) {
                    isSpecialHoliday = true;
                }
                let isHoliday = isRoutineHoliday || isSpecialHoliday;
                let holidayClass = isSpecialHoliday ? 'holiday special-holiday' : (isRoutineHoliday ? 'holiday routine-holiday' : '');

                let dayNameStr = dayNames[jsDate.getDay()];
                let cellHtml = `<div class="calendar-cell ${isToday} ${holidayClass}" style="cursor: pointer;" onclick="openDayDetail(${d}, '${dayNameStr}')">
                                    <div class="day-number">${toPersianDigits(d)}</div>`;
                
                
                if(window.monthlyData[d]) {
                    const count = window.monthlyData[d].length;
                    cellHtml += `<div class="mobile-count-badge">${toPersianDigits(count)} مناسبت</div>`;

                    const maxVisible = 2;
                    let visibleEvents = window.monthlyData[d].slice(0, maxVisible);
                    let hiddenCount = count - maxVisible;

                    visibleEvents.forEach(ev => {
                        let typeClass = ev.calendar_type ? ev.calendar_type : 'custom';
                        
                        let logoHtml = '';
                        if (ev.org_id && ev.org_logo) {
                            logoHtml = `<img src="${ev.org_logo}" alt="logo" style="width: 16px; height: 16px; border-radius: 50%; display: inline-block; vertical-align: middle; margin-left: 4px; object-fit: cover; border: 1px solid white; box-shadow: 0 1px 2px rgba(0,0,0,0.1);" loading="lazy">`;
                        } else if (ev.org_id) {
                            logoHtml = `<span style="display: inline-block; width: 14px; height: 14px; background: #6366f1; color: white; border-radius: 50%; font-size: 0.5rem; text-align: center; line-height: 14px; vertical-align: middle; margin-left: 4px;">${ev.org_name ? ev.org_name.charAt(0) : 'ا'}</span>`;
                        }
                        cellHtml += `
                            <div class="event-badge event-badge-${typeClass}" style="padding: 6px 8px; font-weight: bold; font-size: 0.8rem; border: 1px solid; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; width: 100%; box-sizing: border-box; display: flex; align-items: center;">
                                ${logoHtml}
                                <span style="overflow: hidden; text-overflow: ellipsis;">${ev.title}</span>
                            </div>
                        `;
                    });

                    if(hiddenCount > 0) {
                        cellHtml += `<div style="font-size: 0.8rem; color: var(--text-gray); margin-top: 4px;">+ ${toPersianDigits(hiddenCount)} مورد دیگر</div>`;
                    }
                }
                
                cellHtml += '</div>';
                newCellsHtml += cellHtml;
            }
            grid.insertAdjacentHTML('beforeend', newCellsHtml);
            
            renderListView();
            
            // Clear link container
            document.getElementById('linkContainer').style.display = 'none';
        }
        
        function renderListView() {
            const tbody = document.getElementById('list-view-body');
            tbody.innerHTML = '';
            
            let hasItems = false;
            let routineHolidays = window.routineHolidays || [5];
            
            Object.keys(window.monthlyData).sort((a,b)=>a-b).forEach(day => {
                let d = parseInt(day);
                let gregorianDay = jalaali.toGregorian(currentYear, currentMonth, d);
                let jsDate = new Date(gregorianDay.gy, gregorianDay.gm - 1, gregorianDay.gd);
                let currentDayOfWeek = jsDate.getDay();
                let isRoutineHoliday = routineHolidays.includes(currentDayOfWeek);
                let isSpecialHoliday = false;
                if(window.monthlyData[d] && window.monthlyData[d].some(ev => ev.is_holiday == 1)) {
                    isSpecialHoliday = true;
                }
                let isHoliday = isRoutineHoliday || isSpecialHoliday;
                
                window.monthlyData[day].forEach(ev => {
                    hasItems = true;
                    let badgeText = 'ملی';
                    if(ev.calendar_type === 'shamsi') badgeText = 'ملی (شمسی)';
                    else if(ev.calendar_type === 'ghamari') badgeText = 'مذهبی (قمری)';
                    else if(ev.calendar_type === 'miladi') badgeText = 'جهانی (میلادی)';
                    else badgeText = 'اختصاصی';

                    
                    
                    let dayColor = isHoliday ? 'var(--error-color)' : 'var(--primary-color)';
                    

                    const rowHtml = `
                        <tr class="list-row ${isSpecialHoliday ? 'special-holiday' : (isRoutineHoliday ? 'routine-holiday' : '')}" style=" transition: 0.2s;" onmouseover="this.style.opacity='0.8'" onmouseout="this.style.opacity='1'">
                            <td style="padding: 12px 10px;"><input type="checkbox" class="ev-cb" value="${ev.id}" data-title="${ev.title}"></td>
                            <td style="padding: 12px 10px; font-weight:bold; color:${dayColor};">${dayNames[currentDayOfWeek]} ${toPersianDigits(day)} ${monthNames[currentMonth-1]} ${toPersianDigits(currentYear)}</td>

                            <td style="padding: 12px 10px; font-weight:bold; color: var(--text-gray); display: flex; align-items: center;">
                                ${ev.org_id && ev.org_logo ? `<img alt="" src="${ev.org_logo}" style="width: 20px; height: 20px; border-radius: 50%; margin-left: 8px; object-fit: cover; border: 1px solid white; box-shadow: 0 1px 2px rgba(0,0,0,0.1);" loading="lazy">` : (ev.org_id ? `<span style="display: inline-block; width: 20px; height: 20px; background: #6366f1; color: white; border-radius: 50%; font-size: 0.6rem; text-align: center; line-height: 20px; margin-left: 8px;">${ev.org_name ? ev.org_name.charAt(0) : 'ا'}</span>` : '')}
                                ${ev.title}
                            </td>
                            <td style="padding: 12px 10px; display: flex; align-items: center; justify-content: space-between;">
                                <div style="display: flex; align-items: center;">
                                    <span style="background: var(--card-bg); border: 1px solid var(--border-color); color:${isHoliday ? '#9f1239' : '#475569'}; padding:4px 8px; border-radius:6px; font-size:0.8rem;">${badgeText}</span>
                                    ${ev.org_id && ev.org_name ? `<span style="background:${ev.org_color || '#6366f1'}; color:#ffffff; padding:4px 8px; border-radius:6px; font-size:0.8rem; margin-right: 5px;">${ev.org_name}</span>` : ''}
                                </div>
                                ${(USER_ROLE === 1 || USER_ROLE === 2) ? `
                                <div style="display: flex; gap: 8px;">
                                    <button onclick="deleteEvent(${ev.id})" style="background: none; border: none; cursor: pointer; color: var(--error-color); font-size: 1.1rem;" title="حذف"><svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align: middle; margin-left: 4px;'><path d='M3 6h18'/><path d='M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6'/><path d='M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2'/><line x1='10' x2='10' y1='11' y2='17'/><line x1='14' x2='14' y1='11' y2='17'/></svg></button>
                                </div>
                                ` : ''}
                            </td>
                        </tr>
                    `;
                    tbody.innerHTML += rowHtml;
                });
            });

            if (!hasItems) {
                tbody.innerHTML = '<tr><td colspan="4" style="text-align:center; padding:30px; color:#94a3b8;">رویدادی برای این ماه ثبت نشده است</td></tr>';
            }
        }

        
        async function uploadExcelFile(input) {
            if (!input.files || input.files.length === 0) return;
            const file = input.files[0];
            const formData = new FormData();
            formData.append('excelFile', file);
            
            try {
                showToast('در حال آپلود و پردازش فایل اکسل...');
                
                const res = await fetch('/api/upload_smart_events', {
                    method: 'POST',
                    body: formData
                });
                const data = await res.json();
                
                if (data.status === 'success') {
                    showToast(data.message);
                    renderCalendar();
                } else {
                    showToast(data.message || 'خطا در آپلود فایل');
                }
            } catch (e) {
                showToast('خطا در ارتباط با سرور.', 'error');
            } finally {
                input.value = '';
            }
        }
        
        function changeMonth(step) {
            currentMonth += step;
            if (currentMonth > 12) {
                currentMonth = 1;
                currentYear++;
            } else if (currentMonth < 1) {
                currentMonth = 12;
                currentYear--;
            }
            renderCalendar();
        }

        function goToToday() {
            let today = jalaali.toJalaali(new Date());
            currentYear = today.jy;
            currentMonth = today.jm;
            renderCalendar();
        }
        
        function openAddEventModal() {
            document.getElementById('addEventModalTitle').innerText = 'افزودن مناسبت جدید';
            document.getElementById('editEventId').value = '';
            document.getElementById('newEventTitle').value = '';
                    document.getElementById('newEventBaseYear').value = window.toPersianDigits(currentYear);
            document.getElementById('newEventIsCustomOrg').checked = false;
            document.getElementById('newEventOrgContainer').style.display = 'none';
            document.getElementById('newEventOrg').value = '';
            document.getElementById('addEventModal').style.display = 'flex';
        }
        
        let itemToDeleteId = null;
        function deleteEvent(id) {
            itemToDeleteId = id;
            document.getElementById('confirmModalText').innerText = 'آیا از حذف این مناسبت اطمینان دارید؟';
            document.getElementById('customConfirmModal').style.display = 'flex';
            document.getElementById('confirmModalYes').onclick = async function() {
                document.getElementById('customConfirmModal').style.display = 'none';
                try {
                const res = await fetch('/api/manage_smart_events', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ action: 'delete', id: id })
                });
                const data = await res.json();
                if(data.status === 'success') {
                    showToast('مناسبت با موفقیت حذف شد');
                    closeDayDetailModal();
                    renderCalendar();
                } else {
                    showToast(data.message, 'error');
                }
            } catch(e) {
                showToast('خطا در ارتباط با سرور', 'error');
            }
        }
        }
        
        
        
        function closeAddEventModal() {
            document.getElementById('addEventModal').style.display = 'none';
        }

        async function submitNewEvent() {
            const title = document.getElementById('newEventTitle').value;
            const description = document.getElementById('newEventDescription').value;
            const type = document.getElementById('newEventType').value;
            const baseYear = window.toEnglishDigits(document.getElementById('newEventBaseYear').value || '');
            const isHoliday = document.getElementById('newEventIsHoliday').checked ? 1 : 0;
         const isCustomOrg = document.getElementById('newEventIsCustomOrg').checked;
         const orgId = isCustomOrg ? document.getElementById('newEventOrg').value : null;
            const day = window.toEnglishDigits(document.getElementById('newEventDay').value);
            const month = document.getElementById('newEventMonth').value;
            
            if (!title || !day || !month) {
                showToast('لطفاً همه فیلد‌ها را پر کنید.');
                return;
            }
            
            try {
                const res = await fetch('/api/manage_smart_events', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ action: 'add', title, description, calendar_type: type, base_year: baseYear, is_holiday: isHoliday, shamsi_day: day, shamsi_month: month, org_id: orgId })
                });
                const data = await res.json();
                if (data.status === 'success') {
                    closeAddEventModal();
                    document.getElementById('newEventTitle').value = '';
                    renderCalendar();
                } else {
                    showToast('خطا در ذخیره.', 'error');
                }
            } catch(e) {
                showToast('خطا در ارتباط با سرور.', 'error');
            }
        }

        function generateClientLink() {
            const orgId = document.getElementById('orgSelector').value;
            if (!orgId) {
                showToast('لطفاً کارفرمای هدف را انتخاب کنید.');
                return;
            }
            const baseUrl = window.location.origin;
            const link = `${baseUrl}/client-events?year=${currentYear}&month=${currentMonth}&org_id=${orgId}`;
            
            document.getElementById('clientLinkInput').value = link;
            document.getElementById('clientLinkAnchor').href = link;
            document.getElementById('linkContainer').style.display = 'block';
        }

        function copyClientLink() {
            const copyText = document.getElementById("clientLinkInput");
            copyText.select();
            copyText.setSelectionRange(0, 99999);
            document.execCommand("copy");
            showToast("لینک در کلیپبورد کپی شد.");
        }

        setTimeout( () => {
            applyViewMode();
            loadOrganizations();
            renderCalendar();
        });
    
        setTimeout( () => {
        const typeEl = document.getElementById('newEventType');
        if (typeEl) {
            typeEl.addEventListener('change', function() {
            const type = this.value;
            const monthSel = document.getElementById('newEventMonth');
            
            const shamsiMonths = ["فروردین", "اردیبهشت", "خرداد", "تیر", "مرداد", "شهریور", "مهر", "آبان", "آذر", "دی", "بهمن", "اسفند"];
            const miladiMonths = ["ژانویه", "فوریه", "مارس", "آوریل", "مه", "ژوئن", "ژوئیه", "اوت", "سپتامبر", "اکتبر", "نوامبر", "دسامبر"];
            const ghamariMonths = ["محرم", "صفر", "ربیعالاول", "ربیعالثانی", "جمادیالاول", "جمادیالثانی", "رجب", "شعبان", "رمضان", "شوال", "ذیقعده", "ذیحجه"];
            
            let targetMonths = shamsiMonths;
            if (type === 'miladi') targetMonths = miladiMonths;
            else if (type === 'ghamari') targetMonths = ghamariMonths;
            
            monthSel.innerHTML = '';
            targetMonths.forEach((m, idx) => {
                monthSel.innerHTML += `<option value="${idx + 1}">${m}</option>`;
            });
            monthSel.value = currentMonth; // Try to keep current month index
            });
        }
    });
    
        let selectedDayForNewEvent = null;
        function openDayDetail(day, dayNameStr = '') {
            selectedDayForNewEvent = day;
            
            let gregorian = jalaali.toGregorian(currentYear, currentMonth, day);
            let jsDate = new Date(gregorian.gy, gregorian.gm - 1, gregorian.gd);
            let dayName = dayNameStr || dayNames[jsDate.getDay()];
            let jalaliText = `${dayName}، ${toPersianDigits(day)} ${monthNames[currentMonth - 1]} ${toPersianDigits(currentYear)}`;
            let hijriText = new Intl.DateTimeFormat('fa-IR-u-ca-islamic', {day: 'numeric', month: 'long', year: 'numeric'}).format(jsDate);
            let miladiText = new Intl.DateTimeFormat('fa-IR-u-ca-gregory', {day: 'numeric', month: 'long', year: 'numeric'}).format(jsDate);
            
            document.getElementById('dayDetailTitle').innerHTML = `<div style="font-size: 1.4rem; font-weight: bold; color: var(--text-gray); margin-bottom: 5px;">${jalaliText}</div><div style="font-size: 0.9rem; color: var(--text-gray); font-weight: normal; margin-top: 4px;">${hijriText} &nbsp;|&nbsp; ${miladiText}</div>`;
            
            const list = document.getElementById('dayDetailList');
            list.innerHTML = '';
            
            if (window.monthlyData[day] && window.monthlyData[day].length > 0) {
                window.monthlyData[day].forEach(ev => {
                    let badgeText = 'ملی';
                    if(ev.calendar_type === 'shamsi') badgeText = 'ملی (شمسی)';
                    else if(ev.calendar_type === 'ghamari') badgeText = 'مذهبی (قمری)';
                    else if(ev.calendar_type === 'miladi') badgeText = 'جهانی (میلادی)';
                    else badgeText = 'اختصاصی';
                    
                    let logoHtml = '';
                    if (ev.org_id && ev.org_logo) {
                        logoHtml = `<img src="${ev.org_logo}" alt="logo" style="width: 20px; height: 20px; border-radius: 50%; display: inline-block; vertical-align: middle; margin-left: 8px; object-fit: cover; border: 1px solid white; box-shadow: 0 1px 2px rgba(0,0,0,0.1);" loading="lazy">`;
                    } else if (ev.org_id) {
                        logoHtml = `<span style="display: inline-block; width: 20px; height: 20px; background: #6366f1; color: white; border-radius: 50%; font-size: 0.6rem; text-align: center; line-height: 20px; vertical-align: middle; margin-left: 8px;">${ev.org_name ? ev.org_name.charAt(0) : 'ا'}</span>`;
                    }
                    
                    list.innerHTML += `
                        <div title="${ev.description ? ev.description.replace(/"/g, '&quot;') : ''}" onclick="if(!event.target.closest('button')) showEventInfoModal('${encodeURIComponent(JSON.stringify(ev)).replace(/'/g, '%27')}')" style="background: rgba(128, 128, 128, 0.05); padding: 10px; border-radius: 8px; border: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center; cursor: pointer; transition: background 0.2s;" onmouseover="this.style.background='rgba(128,128,128,0.1)'" onmouseout="this.style.background='rgba(128,128,128,0.05)'">
                            <div style="display: flex; align-items: center;">
                                ${logoHtml}
                                <span style="font-weight: bold; color: var(--text-gray);">${ev.title}</span>
                            </div>
                            <div style="display: flex; align-items: center; gap: 8px;">
                                <span style="font-size: 0.75rem; background: rgba(99, 102, 241, 0.15); color: #4338ca; padding: 3px 6px; border-radius: 4px;">${badgeText}</span>
                                ${(USER_ROLE === 1 || USER_ROLE === 2) ? `
                                <button onclick="deleteEvent(${ev.id})" style="background: none; border: none; cursor: pointer; color: var(--error-color); font-size: 1.1rem;" title="حذف"><svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align: middle; margin-left: 4px;'><path d='M3 6h18'/><path d='M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6'/><path d='M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2'/><line x1='10' x2='10' y1='11' y2='17'/><line x1='14' x2='14' y1='11' y2='17'/></svg></button>
                                ` : ''}
                            </div>
                        </div>
                    `;
                });
            } else {
                list.innerHTML = '<div style="color: #94a3b8; text-align: center; padding: 10px;">مناسبتی برای این روز ثبت نشده است.</div>';
            }
            
            document.getElementById('dayDetailModal').style.display = 'flex';
        }
        
        function closeDayDetailModal() {
            document.getElementById('dayDetailModal').style.display = 'none';
            selectedDayForNewEvent = null;
        }
        
        function openAddEventFromDay() {
            const dayToSet = selectedDayForNewEvent;
            closeDayDetailModal();
            openAddEventModal();
            if (dayToSet) {
                document.getElementById('newEventDay').value = window.toPersianDigits(dayToSet);
                document.getElementById('newEventMonth').value = currentMonth;
            }
        }
    </script>

<div class="modal-overlay" id="customConfirmModal" style="z-index: 2147483647 !important;">
    <div class="modal-box" style="text-align: center; padding: 30px;">
        <h3 style="margin-bottom: 20px; color: var(--text-gray);" id="confirmModalText">آیا از حذف این مورد اطمینان دارید؟</h3>
        <div style="display: flex; gap: 10px; justify-content: center;">
            <button class="btn-danger"  id="confirmModalYes" style="background: var(--error-color); border: none; padding: 8px 20px;">بله، حذف کن</button>
            <button type="button" class="btn-outline"  onclick="document.getElementById('customConfirmModal').style.display='none'" >خیر، انصراف</button>
        </div>
    </div>
</div>


    <div class="modal-overlay" id="eventInfoModal" style="display: none; z-index: 9999999;">
        <div class="modal-box" style="text-align: right; width: 100%; max-width: 400px; box-sizing: border-box;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
                <h3 id="infoModalTitle" style="color: var(--primary-color); margin: 0; font-size: 1.2rem;"></h3>
                <button onclick="document.getElementById('eventInfoModal').style.display='none'" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: #94a3b8;">&times;</button>
            </div>
            <div id="infoModalDesc" style="color: var(--text-gray); line-height: 1.6; white-space: pre-wrap; font-size: 0.95rem; background: rgba(128,128,128,0.05); padding: 15px; border-radius: 8px;">
            </div>
        </div>
    </div>
    
    <script>
    function showEventInfoModal(evStr) {
        const ev = JSON.parse(decodeURIComponent(evStr));
        if (!ev.description) return;
        document.getElementById('infoModalTitle').innerText = ev.title;
        document.getElementById('infoModalDesc').innerText = ev.description;
        document.getElementById('eventInfoModal').style.display = 'flex';
    }
    </script>

</body>
</html>