                        <td style="padding: 10px; border: 1px solid #ddd;">اختصاصی<br><small>(۰ یا ۱)</small></td>
                        <td style="padding: 10px; border: 1px solid #ddd;">نام سازمان<br><small>(در غیر اینصورت ۰)</small></td>
                    </tr>
                </tbody>
            </table></div>
            <div style="background: #eff6ff; padding: 15px; border-radius: 8px; margin-bottom: 20px; font-size: 0.9rem; line-height: 1.6; color: #1e40af;">
                <strong>مثال:</strong><br>
                روز پزشک | شمسی | 1 | 6 | 1403 | 0 | 0 | 0<br>
                سالگرد تاسیس ونوس | میلادی | 15 | 8 | 1403 | 0 | 1 | کلینیک زیبایی ونوس<br>
                عید نوروز | شمسی | 1 | 1 | 1403 | 1 | 0 | 0
            </div>
            <div style="display: flex; gap: 10px;">
                <button class="btn-primary" style="background: var(--success-color); flex: 1;" onclick="document.getElementById('excelUpload').click(); document.getElementById('excelGuideModal').style.display='none'"><svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align: middle; margin-left: 4px;'><path d='M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4'/><polyline points='7 10 12 15 17 10'/><line x1='12' x2='12' y1='15' y2='3'/></svg> متوجه شدم، آپلود اکسل</button>
                <button type="button" class="btn-outline"  onclick="document.getElementById('excelGuideModal').style.display='none'" style="flex: 1;">بستن</button>
