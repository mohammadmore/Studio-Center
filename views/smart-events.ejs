                <label style="display: block; margin-bottom: 5px; color: var(--text-gray); font-weight: bold;">عنوان مناسبت</label>
                <input type="text" id="newEventTitle" placeholder="مثال: روز جهانی عکاسی" style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 6px; box-sizing: border-box;">
            </div>
            
            <div style="margin-bottom: 15px;">
                <label style="display: block; margin-bottom: 5px; color: var(--text-gray); font-weight: bold;">توضیحات (اختیاری)</label>
                <textarea id="newEventDescription" rows="3" placeholder="توضیحات مناسبت..." style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 6px; box-sizing: border-box; resize: vertical; font-family: inherit;"></textarea>
            </div>
            
            <div style="margin-bottom: 15px;">
                <label style="display: block; margin-bottom: 5px; color: var(--text-gray); font-weight: bold;">نوع تقویم</label>
                <select id="newEventType" style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 6px; box-sizing: border-box;">
                    <option value="shamsi">ملی (شمسی) - تکرار شونده در تقویم شمسی</option>
                    <option value="ghamari">مذهبی (قمری) - تکرار شونده در تقویم قمری</option>
                    <option value="miladi">جهانی (میلادی) - تکرار شونده در تقویم میلادی</option>
                    
                </select>
            </div>
            
            <div style="margin-bottom: 25px;">
                <label style="display: block; margin-bottom: 5px; color: var(--text-gray); font-weight: bold;">روز مبنا (در تقویم شمسی)</label>
                <div style="display: flex; gap: 10px;">
                    <input type="text" inputmode="numeric" id="newEventBaseYear" placeholder="سال (مثال: 1403)" style="flex: 1; padding: 10px; border: 1px solid #ddd; border-radius: 6px;">
                    <input type="text" inputmode="numeric" id="newEventDay" placeholder="روز" min="1" max="31" style="flex: 1; padding: 10px; border: 1px solid #ddd; border-radius: 6px;">
                    <select id="newEventMonth" style="flex: 2; padding: 10px; border: 1px solid #ddd; border-radius: 6px;">
                        <option value="1">فروردین</option>
                        <option value="2">اردیبهشت</option>
                        <option value="3">خرداد</option>
                        <option value="4">تیر</option>
                        <option value="5">مرداد</option>
                        <option value="6">شهریور</option>
                        <option value="7">مهر</option>
                        <option value="8">آبان</option>
                        <option value="9">آذر</option>
                        <option value="10">دی</option>
                        <option value="11">بهمن</option>
                        <option value="12">اسفند</option>
                    </select>
                </div>
            </div>
            
            
            <div style="margin-bottom: 20px;">
                <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; color: var(--text-gray); font-weight: bold;">
                    <input type="checkbox" id="newEventIsHoliday" style="transform: scale(1.2);">
                    این رویداد تعطیل رسمی است
                </label>
            </div>
            <div style="margin-bottom: 20px;">
                <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; color: var(--text-gray); font-weight: bold;">
                    <input type="checkbox" id="newEventIsCustomOrg" onchange="document.getElementById('newEventOrgContainer').style.display = this.checked ? 'block' : 'none';" style="transform: scale(1.2);">
                    مناسبت اختصاصی سازمانی
                </label>
                <div id="newEventOrgContainer" style="display: none; margin-top: 10px;">
                    <select id="newEventOrg" style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 6px; box-sizing: border-box;">
                        <option value="">-- انتخاب سازمان --</option>
                    </select>
                </div>
            </div>

            <div style="display: flex; gap: 10px;">
                <button class="btn-primary" style="flex: 1; background: var(--success-color);" onclick="submitNewEvent()">ذخیره مناسبت</button>
                <button type="button" class="btn-outline"  onclick="closeAddEventModal()" style="flex: 1;">انصراف</button>
            </div>
        </div>
    </div>

    
