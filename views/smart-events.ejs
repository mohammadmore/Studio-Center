<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<script>
// Global Network Error Handler
(function() {
    if (window._fetchIntercepted) return;
    window._fetchIntercepted = true;
    const originalFetch = window.fetch;
    window.fetch = async function(...args) {
        try {
            return await originalFetch.apply(this, args);
        } catch (e) {
            // Suppress network error toasts which commonly trigger on dev server restart polling
            // console.error('Network Error:', e);
            return new Response(JSON.stringify({status: 'error', message: 'Network error'}), {
                status: 200, 
                headers: { 'Content-Type': 'application/json' }
            });
        }
    };
})();
</script>

        <base href="<%= typeof BASE_URL !== 'undefined' ? BASE_URL + '/' : '/' %>">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= STUDIO_NAME %> | سامانه مناسبت‌های هوشمند</title>
    <link rel="stylesheet" href="assets/css/style.css?v=6">
    <script src="assets/js/jalaali.min.js?v=2"></script>
    <script>
        const USER_ROLE = "<%= (typeof user !== "undefined" && user) ? user.role_id : '' %>";
        function toggleAllEvents(source) {
            const checkboxes = document.querySelectorAll('.ev-cb');
            checkboxes.forEach(cb => cb.checked = source.checked);
        }
        
        function openDeleteBatchModal() {
            const selected = Array.from(document.querySelectorAll('.ev-cb:checked')).map(cb => cb.value);
            if (selected.length === 0) {
                showToast('لطفاً حداقل یک رویداد را انتخاب کنید.');
                return;
            }
            document.getElementById('deleteBatchModal').style.display = 'flex';
        }
        
        async function finalDeleteBatchSubmit() {
            const selected = Array.from(document.querySelectorAll('.ev-cb:checked')).map(cb => cb.value);
            if (selected.length === 0) return;
            
            document.getElementById('finalDeleteBatchBtn').innerText = 'در حال حذف...';
            document.getElementById('finalDeleteBatchBtn').disabled = true;
            
            try {
                // Delete them one by one or create a new endpoint. We can use a loop.
                let successCount = 0;
                for (let id of selected) {
                    const res = await fetch('/api/manage_smart_events', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ action: 'delete', id: id })
                    });
                    const data = await res.json();
                    if(data.status === 'success') successCount++;
                }
                
                                showToast(successCount + ' مناسبت با موفقیت حذف شد', 'success');
                document.getElementById('deleteBatchModal').style.display = 'none';
                document.getElementById('finalDeleteBatchBtn').innerText = 'بله، حذف کن';
                document.getElementById('finalDeleteBatchBtn').disabled = false;
                if(document.getElementById('selectAllEv')) document.getElementById('selectAllEv').checked = false; renderCalendar();
                renderCalendar();
            } catch(e) {
                console.error(e);
                showToast('خطا در ارتباط با سرور', 'error');
                document.getElementById('finalDeleteBatchBtn').innerText = 'بله، حذف کن';
                document.getElementById('finalDeleteBatchBtn').disabled = false;
            }
        }

        function openConfirmModal() {
            const selected = Array.from(document.querySelectorAll('.ev-cb:checked')).map(cb => cb.dataset.title);
            if (selected.length === 0) {
                showToast('لطفاً حداقل یک رویداد را انتخاب کنید.');
                return;
            }
            document.getElementById('confirmModal').style.display = 'flex';
        }
        function closeConfirmModal() {
            document.getElementById('confirmModal').style.display = 'none';
        }
        async function finalSubmit() {
            const orgId = document.getElementById('orgSelector').value || 1; // Default to org 1 if not selected, or require selection?
            const selected = Array.from(document.querySelectorAll('.ev-cb:checked')).map(cb => cb.dataset.title);
            if (selected.length === 0) return;
            
            document.getElementById('finalBtn').innerText = 'در حال ارسال...';
            document.getElementById('finalBtn').disabled = true;
            
            try {
                const res = await fetch('/api/confirm_events', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ selected_events: selected, org_id: orgId })
                });
                const data = await res.json();
                if (data.status === 'success') {
                    showToast(data.message);
                    closeConfirmModal();
                    // uncheck all
                    document.querySelectorAll('.ev-cb').forEach(cb => cb.checked = false);
                    if(document.getElementById('selectAllEv')) document.getElementById('selectAllEv').checked = false; renderCalendar();
                } else {
                    showToast(data.message || 'خطا در ارسال.');
                }
            } catch(e) {
                showToast('خطا در ارتباط با سرور.', 'error');
            }
            document.getElementById('finalBtn').innerText = 'بله، تایید می‌کنم';
            document.getElementById('finalBtn').disabled = false;
        }
</script>
    <style>
        .calendar-container {
            background: var(--card-bg);
            border-radius: 12px;
            padding: 25px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.02);
            border: 1px solid var(--border-color);
        }
        .calendar-header-actions {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
            border-bottom: 2px solid var(--border-color);
            padding-bottom: 15px;
        }
        .calendar-nav {
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }
        .calendar-nav button {
            background: rgba(99, 102, 241, 0.1);
            color: var(--primary-color) !important;
            border: 1px solid rgba(99, 102, 241, 0.3) !important;
            padding: 8px 16px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 0.95rem;
            font-weight: bold;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            height: 38px;
            box-sizing: border-box;
            line-height: 1;
            vertical-align: middle;
        }
        .calendar-nav button svg {
            display: inline-block;
            vertical-align: middle;
            flex-shrink: 0;
        }
        .calendar-nav button:hover {
            background: rgba(99, 102, 241, 0.2);
            border-color: rgba(99, 102, 241, 0.5) !important;
            transform: translateY(-1px);
        }
        .calendar-grid {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 10px;
            background: var(--card-bg);
            border-radius: 12px;
            overflow: hidden;
            max-width: 1100px;
            margin: 0 auto;
        }
        .calendar-day-name {
            text-align: center;
            font-weight: bold;
            color: var(--text-gray);
            padding-bottom: 10px;
            border-bottom: 2px solid var(--border-color);
        }
        .calendar-cell {
            background: var(--card-bg);
            height: 130px;
            padding: 10px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: flex-start;
            transition: background 0.2s;
            position: relative;
            cursor: pointer;
            overflow: hidden;
            box-sizing: border-box;
            width: 100%;
            min-width: 0;
            border: 1px solid var(--border-color);
            border-radius: 8px;
        }
        .calendar-cell:hover {
            background: rgba(128, 128, 128, 0.05);
        }
        .calendar-cell.empty-cell {
            background: rgba(128, 128, 128, 0.1);
            cursor: default;
        }
        .calendar-cell.today {
            background: #eff6ff;
            box-shadow: inset 0 0 0 2px var(--primary-color);
        }
        
        .calendar-cell.holiday {
            background: #fce7f3 !important;
            border-color: #fbcfe8 !important;
            border-style: solid !important;
        }
        .calendar-cell.routine-holiday {
            background: rgba(244, 63, 94, 0.05) !important;
            border-color: #fbcfe8 !important;
            border-style: dashed !important;
        }
        .calendar-cell.special-holiday {
            background: #fecdd3 !important;
            border-color: #fda4af !important;
            border-style: solid !important;
        }
        .day-number {
            font-size: 1.2rem;
            font-weight: bold;
            color: var(--text-gray);
            margin-bottom: 10px;
            width: 100%;
            text-align: right;
        }
        
        .today .day-number {
            color: var(--primary-color);
        }
        
        .holiday .day-number {
            color: var(--error-color) !important;
        }
        .today .day-number {
            color: var(--primary-color);
        }
        
        .event-badge {
            font-size: 0.75rem;
            padding: 4px 8px;
            border-radius: 6px;
            margin-bottom: 4px;
            width: 100%;
            text-align: center;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            display: flex;
            align-items: center;
            gap: 4px;
            border: 1px solid transparent;
        }
        .event-badge input { margin: 0; cursor: pointer; }
        
        /* List View styles */
        .list-view-container {
            display: none;
            background: var(--card-bg);
            border-radius: 12px;
            border: 1px solid var(--border-color);
            padding: 20px;
            overflow-x: auto;
        }
        .modal-overlay { display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(15, 23, 42, 0.7); backdrop-filter: blur(5px); justify-content: center; align-items: center; z-index: 1000; }
        .modal-box { background: var(--card-bg); width: 90%; width: 100%; max-width: 500px; box-sizing: border-box; padding: 30px; border-radius: 15px; text-align: center; }
    
        @media (max-width: 768px) {
            .calendar-day-name {
                writing-mode: vertical-rl;
                transform: rotate(180deg);
                height: 70px;
                font-size: 0.75rem !important;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 5px 0 !important;
            }
            .event-badge {
                display: none !important;
            }
            .mobile-count-badge {
                display: block !important;
            }
            .calendar-cell {
                min-height: 70px !important;
                padding: 2px !important;
            }
            .calendar-cell .day-number {
                font-size: 0.9rem;
                margin-bottom: 2px;
            }
            
            /* Responsive List View */
            .list-view-container table, .list-view-container thead, .list-view-container tbody, .list-view-container tr, .list-view-container td, .list-view-container th {
                display: block;
                width: 100%;
                min-width: 0 !important;
            }
            .list-view-container thead tr {
                display: none;
            }
            .list-row {
                display: flex !important;
                flex-direction: column;
                background: var(--card-bg);
                border: 1px solid var(--border-color);
                border-radius: 8px;
                margin-bottom: 15px;
                padding: 12px;
                position: relative;
            }
            .list-row td {
                border: none !important;
                padding: 4px 0 !important;
                white-space: normal;
                display: flex;
                width: 100%;
                box-sizing: border-box;
            }
            .list-row td:nth-child(1) {
                position: absolute;
                top: 15px;
                right: 12px;
                width: auto;
            }
            .list-row td:nth-child(2) {
                padding-right: 32px !important;
                font-size: 0.9rem;
            }
            .list-row td:nth-child(3) {
                padding-right: 32px !important;
                font-size: 1.05rem;
                margin-top: 4px;
                margin-bottom: 8px;
                align-items: flex-start !important;
            }
            .list-row td:nth-child(4) {
                padding-right: 32px !important;
                flex-direction: row;
                justify-content: space-between;
                width: 100%;
            }
        }
        .mobile-count-badge {
            display: none;
            
            color: white;
            border-radius: 4px;
            padding: 2px;
            font-size: 0.8rem;
            text-align: center;
            width: 100%;
            box-sizing: border-box;
            margin-top: 4px;
        }

    </style>
</head>
