            display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;
            background: var(--card-bg); padding: 20px; border-radius: 12px; border: 1px solid var(--border-color);
        }
        
        /* استایل اختصاصی تایملاین (خط زمانی) */
        .timeline-container {
            position: relative; padding: 20px 0;
        }
        .timeline-container::before {
            content: ''; position: absolute; top: 0; bottom: 0; right: 20px; width: 4px;
            background: var(--border-color); border-radius: 2px;
        }
        .timeline-item {
            position: relative; padding-right: 50px; margin-bottom: 25px;
