<%
  const clientNavItems = [
    ['client-dashboard', 'خانه'],
    ['client-review', 'تایید محتوا'],
    ['client-requests', 'درخواست‌ها'],
    ['client-files', 'فایل‌های تحویلی'],
    ['client-quotes', 'پیش‌فاکتور و فاکتور'],
    ['monthly-report', 'گزارش ماهانه'],
    ['client-brand-kit', 'کیت برند'],
    ['client-events', 'مناسبت‌ها'],
  ];
  const navCurrent = typeof current !== 'undefined' ? current : '';
%>
<link rel="stylesheet" href="assets/css/workflow.css">
<nav class="wf-client-nav no-print" aria-label="منوی پنل کارفرما">
    <% clientNavItems.forEach(function (n) { %>
        <a class="wf-btn <%= navCurrent === n[0] ? 'primary' : '' %>" href="<%= n[0] %>"<%- navCurrent === n[0] ? ' aria-current="page"' : '' %>><%= n[1] %></a>
    <% }) %>
</nav>
