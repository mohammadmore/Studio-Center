async function saveAllEditFields(id, closeAfterSave = false) {
    const title = document.getElementById('edit_title').value;
    const org_id = document.getElementById('edit_org_id').value;
    const content_type = document.getElementById('edit_content_type').value;
    const project_manager = document.getElementById('edit_project_manager').value;
    const typedColTitle = document.getElementById('edit_collection_title').value.trim();
    let collection_id = null;
    if (typedColTitle) {
        const found = (window.allCollections || []).find(c => c.title === typedColTitle);
        if (found) collection_id = found.id;
        else collection_id = typedColTitle; // We will pass string to let server know it's a new one
    }

    const assigned_colleagues = Array.from(document.querySelectorAll('input[name="edit_team_cb"]:checked')).map(cb => cb.value);
    
    const publish_date = window.toEnglishDigits ? window.toEnglishDigits(document.getElementById('edit_publish_date').value) : document.getElementById('edit_publish_date').value;
    const publish_time = window.toEnglishDigits ? window.toEnglishDigits(document.getElementById('edit_publish_time').value) : document.getElementById('edit_publish_time').value;
    
    const publish_platforms = Array.from(document.querySelectorAll('input[name="edit_platforms"]:checked')).map(cb => cb.value);
    const stages = Array.from(document.querySelectorAll('input[name="edit_stages"]:checked')).map(cb => cb.value);
    const status = document.getElementById('edit_status').value;

    try {
        
        const components_count = {};
        document.querySelectorAll('.edit-comp-count').forEach(input => {
            const val = parseInt(window.toEnglishDigits(input.value));
            if (val > 0) components_count[input.dataset.name] = val;
        });
        
        const payload = {
            id, title, org_id, collection_id: collection_id, content_type, project_manager, 
            assigned_colleagues, publish_date, publish_time, publish_platforms, stages,
            components_count, status
        };
        const res = await fetch('/api/update_content_details', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify(payload)
        });
        const result = await res.json();
        if (result.status === 'success') {
            window.hasUnsavedChanges = false;
            await loadDepot();
            showToast('تغییرات با موفقیت ذخیره شد', 'success');
            if (closeAfterSave) {
                closeDetailsModal();
            } else {
                openContentDetails(id, false);
            }
        } else {
            showToast('خطا در ثبت اطلاعات', 'error');
        }
    } catch (e) {
        console.error(e);
        showToast('خطا در ارتباط با سرور', 'error');
    }
}
window.saveAllEditFields = saveAllEditFields;


window.filterCol = function() {
    const term = document.getElementById('edit_collection_title').value.toLowerCase();
    const orgSelect = document.getElementById('edit_org_id');
    const orgId = orgSelect ? orgSelect.value : '';
    
    const items = document.querySelectorAll('.col-radio-item');
    Array.from(items).forEach(item => {
        const name = item.querySelector('.col-title').innerText.toLowerCase();
        const itemOrgId = item.getAttribute('data-org-id');
        
        let orgMatch = true;
        if (orgId && itemOrgId && itemOrgId !== "null" && itemOrgId !== orgId) {
            orgMatch = false;
        }
        
        if (name.includes(term) && orgMatch) {
            item.style.display = 'flex';
        } else {
            item.style.display = 'none';
        }
    });
    const checkedRadio = document.querySelector('input[name="edit_col_radio"]:checked');
    if (checkedRadio && checkedRadio.value !== document.getElementById('edit_collection_title').value) {
        checkedRadio.checked = false;
    }
};

window.filterTeam = function() {
    const term = document.getElementById('team_filter').value.toLowerCase();
    const items = document.querySelectorAll('.team-checkbox-item');
    Array.from(items).forEach(item => {
        const name = item.querySelector('.team-name').innerText.toLowerCase();
        if (name.includes(term)) {
            item.style.display = 'flex';
        } else {
            item.style.display = 'none';
        }
    });
};

async function saveField(id, field, value) {
    try {
        const payload = { id };
        payload[field] = value;
        const res = await fetch('/api/update_content_details', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify(payload)
        });
        const result = await res.json();
        if (result.status === 'success') {
            await loadDepot();
            openContentDetails(id);
        } else {
            showToast('خطا در ثبت اطلاعات', 'error');
        }
    } catch(e) {
        console.error(e);
        showToast('خطا در ارتباط با سرور', 'error');
    }
}
window.saveField = saveField;

async function archiveContent(id) {
    if(!(await window.customConfirm('آیا از آرشیو کردن این محتوا اطمینان دارید؟ محتوا از دپو خارج شده و به بخش آرشیو می‌رود.'))) return;
    try {
        const res = await fetch('/api/add_content', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({ action: 'update_status', id: parseInt(id), status: 'archived' })
        });
        const result = await res.json();
        if (result.status === 'success') {
            closeDetailsModal();
            loadDepot(); // reload the board
        } else {
            showToast(result.message);
        }
    } catch(e) {
        showToast('خطا در ارتباط با سرور', 'error');
    }
}
window.archiveContent = archiveContent;

async function deleteContent(id) {
    if (!(await window.customConfirm("آیا از حذف این محتوا اطمینان دارید؟"))) return;
    try {
        const res = await fetch('/api/add_content', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({ action: 'delete', id: parseInt(id) })
        });
        const result = await res.json();
        if (result.status === 'success') {
            closeDetailsModal();
            loadDepot();
            
            if (result.bin_id) {
                window.showToast('محتوا به سطل زباله منتقل شد', 'info', {
                    text: 'بازگردانی',
                    callback: async () => {
                        await fetch('/api/recycle_bin', {
                            method: 'POST',
                            headers: {'Content-Type': 'application/json'},
                            body: JSON.stringify({ action: 'restore', bin_id: result.bin_id })
                        });
                        window.showToast('محتوا با موفقیت بازگردانی شد', 'success');
                        loadDepot();
                    }
                });
            } else {
                window.showToast('محتوا با موفقیت حذف شد', 'success');
            }
        } else {
            showToast(result.message);
        }
    } catch(e) {
        showToast('خطا در ارتباط با سرور', 'error');
    }
}
window.deleteContent = deleteContent;



function closeDetailsModal() {
    if (window.hasUnsavedChanges) {
        document.getElementById('contentIdentityConfirmModal').style.display = 'flex';
        return;
    }
    const overlay = document.getElementById('detailsModal');
    if (overlay) {
        overlay.querySelector('.side-drawer').style.transform = 'translateX(-100%)';
        setTimeout(() => {
            overlay.style.display = 'none';
        }, 300);
    }
}
window.closeDetailsModal = closeDetailsModal;

async function toggleStage(id, stage, isChecked) {
    try {
        const res = await fetch('/api/toggle_stage', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({ id, stage, isChecked })
        });
        const result = await res.json();
        if (result.status === 'success') {
            const item = window.allDepotItems.find(i => i.id == id);
            if(item) {
                if(!item.completed_stages) item.completed_stages = [];
                if(isChecked) {
                    if(!item.completed_stages.includes(stage)) item.completed_stages.push(stage);
                } else {
                    item.completed_stages = item.completed_stages.filter(s => s !== stage);
                }
                openContentDetails(id); // refresh modal
            }
        }
    } catch(e) {
        console.error(e);
    }
}
window.toggleStage = toggleStage;

window.handleManagerChange = function() {
    const mgrValue = document.getElementById('edit_project_manager') ? document.getElementById('edit_project_manager').value.trim() : '';
    const teamCheckboxes = document.querySelectorAll('input[name="edit_team_cb"]');
    teamCheckboxes.forEach(cb => {
        const itemDiv = cb.closest('.team-checkbox-item');
        if (itemDiv) {
            if (cb.value === mgrValue) {
                cb.checked = true;
                cb.disabled = true;
                itemDiv.style.opacity = '0.5';
            } else {
                cb.disabled = false;
                itemDiv.style.opacity = '1';
            }
        }
    });
};

window.toEnglishDigits = function (str) {
    const persianNumbers = ['۰', '۱', '۲', '۳', '۴', '۵', '۶', '۷', '۸', '۹'];
    const arabicNumbers  = ['٠', '١', '٢', '٣', '٤', '٥', '٦', '٧', '٨', '٩'];
    if (!str) return str;
    return str.toString().replace(/[۰-۹]/g, function (w) {
        return persianNumbers.indexOf(w);
    }).replace(/[٠-٩]/g, function (w) {
        return arabicNumbers.indexOf(w);
    });
};

window.formatPublishDate = function(dateStr, timeStr) {
    let timePart = timeStr ? ' - ساعت ' + timeStr : '';
    if (!dateStr) return '<span style="color:#94a3b8">تعیین نشده</span>';
    const parts = window.toEnglishDigits(dateStr).split('/');
    if (parts.length === 3 && window.jalaali) {
        const y = parseInt(parts[0]);
        const m = parseInt(parts[1]);
        const d = parseInt(parts[2]);
        const g = window.jalaali.toGregorian(y, m, d);
        const date = new Date(g.gy, g.gm - 1, g.gd);
        const days = ['یکشنبه', 'دوشنبه', 'سه‌شنبه', 'چهارشنبه', 'پنج‌شنبه', 'جمعه', 'شنبه'];
        const dayName = days[date.getDay()];
        return dayName + ' ' + window.toPersianDigits(dateStr) + (timePart ? window.toPersianDigits(timePart) : '');
    }
    return window.toPersianDigits(`${dateStr}${timePart}`);
};

window.contentIdentityConfirmSave = async function() {
    document.getElementById('contentIdentityConfirmModal').style.display = 'none';
    if (window.currentEditingContentId) {
        if (window.currentContentEditMode) {
            await saveAllEditFields(window.currentEditingContentId, true);
        } else {
            // In view mode, we only have caption
            const captionVal = document.getElementById('caption_text') ? document.getElementById('caption_text').value : '';
            await saveField(window.currentEditingContentId, 'caption', captionVal);
            window.closeDetailsModal();
        }
    }
};

window.contentIdentityConfirmDiscard = function() {
    document.getElementById('contentIdentityConfirmModal').style.display = 'none';
    window.hasUnsavedChanges = false;
    window.closeDetailsModal();
};

window.contentIdentityConfirmCancel = function() {
    document.getElementById('contentIdentityConfirmModal').style.display = 'none';
};

</script>