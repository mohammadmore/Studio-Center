<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<script nonce="<%= nonce %>">
// Global Network Error Handler
(function() {
    if (window._fetchIntercepted) return;
    window._fetchIntercepted = true;
    const originalFetch = window.fetch;
    window.fetch = async function(...args) {
        try {
            return await originalFetch.apply(this, args);
        } catch (e) {
            // Suppress network error toasts which commonly trigger on dev server restart polling
            // console.error('Network Error:', e);
            return new Response(JSON.stringify({status: 'error', message: 'Network error'}), {
                status: 200, 
                headers: { 'Content-Type': 'application/json' }
            });
        }
    };
})();
</script>

        <base href="<%= typeof BASE_URL !== 'undefined' ? BASE_URL + '/' : '/' %>">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= STUDIO_NAME %> | موتور قالبساز هوشمند</title>
    <link rel="stylesheet" href="assets/css/style.css?v=6">
    <style nonce="<%= nonce %>">
        .template-controls { display: flex; gap: 15px; margin-bottom: 30px; align-items: center; background: var(--card-bg); padding: 20px; border-radius: 12px; box-shadow: 0 2px 15px -3px rgba(0,0,0,0.04); transition: box-shadow 0.3s ease, transform 0.3s ease; }
        .template-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 20px; }
        .template-card { background: var(--card-bg); padding: 25px; border-radius: 15px; box-shadow: 0 2px 15px -3px rgba(0,0,0,0.04); transition: box-shadow 0.3s ease, transform 0.3s ease; display: flex; flex-direction: column; gap: 15px; position: relative; overflow: hidden; transition: 0.3s; }
        .template-card:hover { transform: translateY(-5px); box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1); }
        .template-title { font-size: 1.25rem; font-weight: bold; color: var(--primary-color); border-bottom: 2px solid var(--border-color); padding-bottom: 10px; }
        .template-details { flex: 1; color: var(--text-dark); }
        
        .btn-apply { width: 100%; background: var(--success-color); color: white; border: none; padding: 12px; border-radius: 8px; font-weight: bold; cursor: pointer; transition: 0.2s; margin-top: 10px;}
        .btn-apply:hover { background: #059669; }
        .btn-edit {  color: white; border: none; padding: 8px 12px; border-radius: 6px; cursor: pointer; flex: 1; }
        .btn-delete { background: var(--error-color); color: white; border: none; padding: 8px 12px; border-radius: 6px; cursor: pointer; flex: 1; }
        .card-actions { display: flex; gap: 10px; margin-top: 15px; }

        .modal-overlay { display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(15, 23, 42, 0.7); backdrop-filter: blur(5px); justify-content: center; align-items: center; z-index: 1000; overflow-y: auto;}
        .modal-box { background: var(--card-bg); width: 90%; width: 100%; max-width: 650px; box-sizing: border-box; padding: 30px; border-radius: 15px; margin: 20px auto;}
        
        .items-list { border: 1px solid var(--border-color); border-radius: 8px; overflow-x: auto; margin-top: 15px; }
        .item-row { min-width: 100%; max-width: 450px; box-sizing: border-box; }
        .item-row { display: grid; grid-template-columns: 80px 1fr 1fr 80px 40px; gap: 10px; padding: 10px; border-bottom: 1px solid var(--border-color); align-items: center; }
        .item-row:last-child { border-bottom: none; }
        .item-header { background: rgba(128, 128, 128, 0.05); font-weight: bold; color: var(--text-gray); }
        
        .item-row input, .item-row select { padding: 8px; border: 1px solid #ddd; border-radius: 6px; width: 100%; }
        
        .add-item-btn { margin-top: 10px; background: var(--border-color); color: var(--text-gray); border: none; padding: 8px 15px; border-radius: 6px; cursor: pointer; width: 100%; font-weight: bold; }
        .add-item-btn:hover { background: var(--border-color); }
    </style>
</head>

