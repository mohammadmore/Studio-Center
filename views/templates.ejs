    <!-- Types for select -->
    <script nonce="<%= nonce %>">
        let contentTypes = [];
        let allTemplates = [];
        
        setTimeout( async () => {
            await loadSettings();
            loadTemplates();
        });

        async function loadSettings() {
            try {
                const res = await fetch('/api/manage_settings');
                const data = await res.json();
                if(data.status === 'success') {
                    contentTypes = data.data.content_type || [];
                }
            } catch(e) { console.error(e); }
        }

        async function loadTemplates() {
            try {
                const res = await fetch('/api/get_content_templates');
                const templates = await res.json();
                allTemplates = templates;
                renderTemplates();
            } catch(e) {
                document.getElementById('templateContainer').innerHTML = '<div style="color:red; text-align:center; grid-column:1/-1;">خطا در اتصال به دیتابیس</div>';
            }
        }

        function renderTemplates() {
            const container = document.getElementById('templateContainer');
            container.innerHTML = '';
            
            if(allTemplates.length === 0) {
                container.innerHTML = `
                <div style="grid-column:1/-1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 60px 20px; text-align: center; background: var(--card-bg); border-radius: 16px; border: 1px dashed var(--border-color); margin-top: 20px;">
                    <div style="width: 80px; height: 80px; background: rgba(99, 102, 241, 0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-bottom: 20px;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--primary-color)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
                    </div>
                    <h3 style="font-size: 1.5rem; color: var(--text-dark); margin-bottom: 10px;">هیچ پکیج قالبی وجود ندارد!</h3>
                    <p style="color: var(--text-gray); width: 100%; max-width: 450px; box-sizing: border-box; margin-bottom: 25px; line-height: 1.6;">با تعریف قالب‌های روتین (مثلاً پک ماهیانه شامل ۱۰ پست و ۵ استوری)، می‌توانید تقویم محتوایی مشتریان را با یک کلیک و در چند ثانیه پر کنید.</p>
                    <button class="btn-primary"  onclick="openModal()" style=""  >
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                        ساخت اولین قالب
                    </button>
                </div>`;
                return;
            }
            
            allTemplates.forEach(tpl => {
                const itemsCount = tpl.items ? tpl.items.length : 0;
                let previewItems = '';
                if (tpl.items) {
                    previewItems = tpl.items.slice(0, 4).map(i => `<div style="padding:4px; background: rgba(128, 128, 128, 0.05); border-radius:4px; margin-bottom:4px; font-size:0.85rem;">روزم ${i.dayOffset}: ${i.type} - ${i.topic}</div>`).join('');
                    if (itemsCount > 4) previewItems += `<div style="font-size:0.8rem; color: var(--text-gray); text-align:center;">+ ${itemsCount - 4} آیتم دیگر...</div>`;
                }

                container.innerHTML += `
                    <div class="template-card" data-title="${tpl.name}">
                        <div class="template-title">${tpl.name}</div>
                        <div class="template-details">
                            <div style="margin-bottom: 10px; font-weight:bold; font-size:0.9rem; color: var(--text-gray);">تعداد محتوا: ${itemsCount} آیتم</div>
                            ${previewItems}
                        </div>
                        <div class="card-actions">
                            <button class="btn-edit" onclick="editTemplate(${tpl.id})"><svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align: middle;'><path d='M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z'/><path d='m15 5 4 4'/></svg> ویرایش</button>
                            <button class="btn-delete" onclick="deleteTemplate(${tpl.id})"><svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align: middle; margin-left: 4px;'><path d='M3 6h18'/><path d='M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6'/><path d='M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2'/><line x1='10' x2='10' y1='11' y2='17'/><line x1='14' x2='14' y1='11' y2='17'/></svg> حذف</button>
                        </div>
                        <button class="btn-apply" onclick="window.location.href='calendar'"><svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align: middle; margin-left: 4px;'><path d='M8 2v4'/><path d='M16 2v4'/><rect width='18' height='18' x='3' y='4' rx='2'/><path d='M3 10h18'/></svg> اعمال در تقویم</button>
                    </div>
                `;
            });
            filterTemplates();
        }

        function filterTemplates() {
            const query = document.getElementById('searchInput').value.toLowerCase();
            const cards = document.querySelectorAll('.template-card');
            cards.forEach(card => {
                const title = card.getAttribute('data-title').toLowerCase();
                if(title.includes(query)) card.style.display = 'flex';
                else card.style.display = 'none';
            });
        }
        
        // Form Management
        function openModal(template = null) {
            const modal = document.getElementById('templateModal');
            const container = document.getElementById('itemsContainer');
            container.innerHTML = '';
            
            if (template) {
                document.getElementById('modalTitle').innerHTML = `<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align: middle;'><path d='M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z'/><path d='m15 5 4 4'/></svg> ویرایش قالب`;
                document.getElementById('editTemplateId').value = template.id;
                document.getElementById('templateName').value = template.name;
                
                if (template.items) {
                    Array.from(template.items).forEach(item => addItemRow(item));
                }
            } else {
                document.getElementById('modalTitle').innerHTML = `<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' style='vertical-align: middle; margin-left: 4px;'><path d='M5 12h14'/><path d='M12 5v14'/></svg> ساخت قالب جدید`;
                document.getElementById('editTemplateId').value = '';
                document.getElementById('templateName').value = '';
                addItemRow(); // add one empty row
            }
            
            modal.style.display = 'flex';
        }
        
        function closeModal() {
            document.getElementById('templateModal').style.display = 'none';
        }
        
        function addEmptyItem() {
            addItemRow();
        }
        
        function addItemRow(data = {dayOffset: 1, type: '', topic: '', count: 1}) {
            const container = document.getElementById('itemsContainer');
            const row = document.createElement('div');
            row.className = 'item-row';
            
            let typeOptions = '<option value="">-- نوع محتوا --</option>';
            contentTypes.forEach(t => {
                typeOptions += `<option value="${t.setting_key}" ${data.type === t.setting_key ? 'selected' : ''}>${t.setting_key}</option>`;
            });
            // Fallback for custom old types not in settings
            if (data.type && !contentTypes.find(t => t.setting_key === data.type)) {
                typeOptions += `<option value="${data.type}" selected>${data.type}</option>`;
            }
            
            row.innerHTML = `
                <input type="text" inputmode="numeric" min="1" max="31" class="item-day" value="${window.toPersianDigits(data.dayOffset || 1)}" required>
                <select class="item-type" required>${typeOptions}</select>
                <input type="text" class="item-topic" value="${data.topic || ''}" placeholder="موضوع..." required>
                <input type="text" inputmode="numeric" min="1" class="item-count" value="${window.toPersianDigits(data.count || 1)}" required>
                <button type="button" style="background:none; border:none; color:var(--error-color); font-size:1.2rem; cursor:pointer;" onclick="this.parentElement.remove()">&times;</button>
            `;
            container.appendChild(row);
        }
        
        function editTemplate(id) {
            const tpl = allTemplates.find(t => t.id === id);
            if (tpl) openModal(tpl);
        }
        
        async function deleteTemplate(id) {
            if(!(await window.customConfirm('آیا از حذف این قالب اطمینان دارید؟'))) return;
            
            try {
                const res = await fetch('/api/manage_content_template', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ action: 'delete', template: { id } })
                });
                const result = await res.json();
                if (result.status === 'success') {
                    loadTemplates();
                } else {
                    showToast(result.message);
                }
            } catch(e) { showToast('خطا در حذف قالب', 'error'); }
        }
        
        async function saveTemplate(e) {
            e.preventDefault();
            
            const id = document.getElementById('editTemplateId').value;
            const name = document.getElementById('templateName').value;
            
            const itemRows = document.querySelectorAll('#itemsContainer .item-row');
            const items = [];
            itemRows.forEach(row => {
                const dayOffset = parseInt(window.toEnglishDigits(row.querySelector('.item-day').value)) || 1;
                const type = row.querySelector('.item-type').value;
                const topic = row.querySelector('.item-topic').value;
                const count = parseInt(window.toEnglishDigits(row.querySelector('.item-count').value)) || 1;
                items.push({ dayOffset, type, topic, count });
            });
            
            const payload = {
                action: id ? 'update' : 'add',
                template: {
                    id: id ? parseInt(id) : null,
                    name,
                    items
                }
            };
            
            try {
                const res = await fetch('/api/manage_content_template', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify(payload)
                });
                const result = await res.json();
                if (result.status === 'success') {
                    closeModal();
                    loadTemplates();
                } else {
                    showToast(result.message);
                }
            } catch(e) {
                showToast('خطا در ذخیره قالب', 'error');
            }
        }

        let pendingExcelTemplates = [];

        function openExcelGuideModal() {
            document.getElementById('excelGuideModal').style.display = 'flex';
        }

        function handleExcelImport(event) {
            const file = event.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function(e) {
                const data = new Uint8Array(e.target.result);
                const workbook = XLSX.read(data, { type: 'array' });
                const sheetName = workbook.SheetNames[0];
                const worksheet = workbook.Sheets[sheetName];
                const json = XLSX.utils.sheet_to_json(worksheet, { header: 1 });
                
                if (json.length < 2) {
                    showToast('فایل اکسل خالی است یا فرمت نامعتبر است', 'error');
                    return;
                }

                // parse columns
                const headers = json[0].map(h => typeof h === 'string' ? h.trim() : h);
                const nameIdx = headers.indexOf('نام قالب');
                const offsetIdx = headers.indexOf('فاصله روز');
                const typeIdx = headers.indexOf('نوع محتوا');
                const topicIdx = headers.indexOf('موضوع');
                const countIdx = headers.indexOf('تعداد');

                if (nameIdx === -1 || offsetIdx === -1 || typeIdx === -1 || topicIdx === -1 || countIdx === -1) {
                    showToast('ستون‌های فایل اکسل صحیح نیست. لطفا راهنمای اکسل را مطالعه کنید.', 'error');
                    return;
                }

                const templatesMap = {};
                
                for (let i = 1; i < json.length; i++) {
                    const row = json[i];
                    if (!row || row.length === 0 || !row[nameIdx]) continue;
                    
                    const tplName = String(row[nameIdx]).trim();
                    const dayOffset = parseInt(row[offsetIdx]) || 1;
                    const type = row[typeIdx] ? String(row[typeIdx]).trim() : '';
                    const topic = row[topicIdx] ? String(row[topicIdx]).trim() : '';
                    const count = parseInt(row[countIdx]) || 1;

                    if (!templatesMap[tplName]) {
                        templatesMap[tplName] = { name: tplName, items: [] };
                    }
                    
                    templatesMap[tplName].items.push({
                        dayOffset, type, topic, count
                    });
                }

                pendingExcelTemplates = Object.values(templatesMap);
                if (pendingExcelTemplates.length === 0) {
                    showToast('هیچ قالبی در فایل یافت نشد', 'error');
                    return;
                }

                showExcelPreview();
            };
            reader.readAsArrayBuffer(file);
            event.target.value = ''; // reset
        }

        function showExcelPreview() {
            const container = document.getElementById('excelPreviewContainer');
            container.innerHTML = '';
            
            pendingExcelTemplates.forEach((tpl, index) => {
                let itemsHtml = tpl.items.map(item => `
                    <div style="display: flex; gap: 10px; font-size: 0.9rem; margin-bottom: 5px; padding: 5px; background: var(--card-bg); border-radius: 6px; border: 1px solid var(--border-color);">
                        <div style="flex: 1;">روز: <span style="font-weight:bold;">${item.dayOffset}</span></div>
                        <div style="flex: 1;">نوع: <span style="font-weight:bold;">${item.type}</span></div>
                        <div style="flex: 2;">موضوع: <span style="font-weight:bold;">${item.topic}</span></div>
                        <div style="flex: 1;">تعداد: <span style="font-weight:bold;">${item.count}</span></div>
                    </div>
                `).join('');

                container.innerHTML += `
                    <div style="margin-bottom: 15px; padding: 15px; background: rgba(128,128,128,0.05); border-radius: 10px; border: 1px solid var(--border-color);">
                        <h4 style="margin-bottom: 10px; color: var(--primary-color);">${index + 1}. ${tpl.name}</h4>
                        ${itemsHtml}
                    </div>
                `;
            });
            
            document.getElementById('excelPreviewModal').style.display = 'flex';
        }

        async function saveExcelTemplates() {
            if (pendingExcelTemplates.length === 0) return;
            
            if (window.showLoading) window.showLoading('در حال ذخیره...');
            try {
                const payload = {
                    action: 'batch_add',
                    templates: pendingExcelTemplates
                };
                
                const res = await fetch('/api/manage_content_template', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify(payload)
                });
                const result = await res.json();
                
                if (window.hideLoading) window.hideLoading();
                
                if (result.status === 'success') {
                    showToast('قالب‌های اکسل با موفقیت ذخیره شدند', 'success');
                    document.getElementById('excelPreviewModal').style.display = 'none';
                    loadTemplates();
                } else {
                    showToast(result.message || 'خطا در ذخیره قالب‌ها', 'error');
                }
            } catch(e) {
                if (window.hideLoading) window.hideLoading();
                showToast('خطا در ارتباط با سرور', 'error');
            }
        }
    </script>
<script src="assets/js/app.js?v=4"></script>
</body>
</html>
