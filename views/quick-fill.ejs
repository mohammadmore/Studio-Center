<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
<base href="<%= typeof BASE_URL !== 'undefined' ? BASE_URL + '/' : '/' %>">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= STUDIO_NAME %> | تکمیل سریع</title>
    <link href="assets/css/style.css?v=6" rel="stylesheet">
    <link rel="stylesheet" href="assets/css/jalalidatepicker.min.css">
    <script src="assets/js/jalalidatepicker.min.js" defer></script>
    <style>
        .qf-top { display: flex; flex-direction: column; gap: 10px; margin: 6px auto 16px; max-width: 760px; }
        .qf-progress { background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 14px; padding: 10px 14px; }
        .qf-progress .txt { display: flex; justify-content: space-between; gap: 8px; font-size: 0.88rem; margin-bottom: 6px; flex-wrap: wrap; }
        .qf-progress .bar { height: 8px; border-radius: 8px; background: rgba(128,128,128,0.15); overflow: hidden; }
        .qf-progress .bar > span { display: block; height: 100%; width: 0; border-radius: 8px; background: linear-gradient(90deg, var(--primary-color), #ec4899); transition: width .5s ease; }
        .qf-filters { display: grid; grid-template-columns: 1fr 1fr auto; gap: 8px; align-items: center; }
        .qf-filters select { min-width: 0; }
        @media (max-width: 600px) { .qf-filters { grid-template-columns: 1fr 1fr; } .qf-filters label.toggle { grid-column: 1 / -1; justify-content: center; } }
        .qf-filters label.toggle { display: inline-flex; align-items: center; gap: 6px; cursor: pointer; font-size: 0.9rem; padding: 8px 12px; border: 1px solid var(--border-color); border-radius: 10px; background: var(--card-bg); min-height: 42px; }

        .qf-stage { position: relative; max-width: 640px; margin: 54px auto 30px; min-height: 420px; }
        .qf-ghost { position: absolute; inset: 0; border-radius: 22px; background: var(--card-bg); border: 1px solid var(--border-color); pointer-events: none; }
        .qf-ghost.g1 { transform: translateY(14px) scale(.96); opacity: .7; }
        .qf-ghost.g2 { transform: translateY(28px) scale(.92); opacity: .4; }
        .qf-card { position: relative; z-index: 2; background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 22px; box-shadow: 0 18px 50px rgba(15,23,42,0.12); padding: 52px 22px 18px; transition: transform .28s ease, opacity .28s ease; touch-action: pan-y; }
        .qf-card.enter { transform: scale(.94) translateY(16px); opacity: 0; }
        .qf-card.leave-left { transform: translateX(-120%) rotate(-12deg); opacity: 0; }
        .qf-card.leave-right { transform: translateX(120%) rotate(12deg); opacity: 0; }
        .qf-card.leave-done { transform: translateY(-40px) scale(.96); opacity: 0; }
        .qf-card.dragging { transition: none; }
        .qf-card:focus { outline: none; }
        .qf-card:focus-visible { box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary-color) 35%, transparent), 0 18px 50px rgba(15,23,42,0.12); }
        /* The project manager's picture sits on the top edge: half on the card, half above it. */
        .qf-avatar { position: absolute; top: -40px; left: 50%; transform: translateX(-50%); width: 80px; height: 80px; border-radius: 50%; border: 4px solid var(--card-bg); background: var(--primary-color); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 1.8rem; font-weight: 800; overflow: hidden; box-shadow: 0 8px 20px rgba(15,23,42,0.18); }
        .qf-avatar img { width: 100%; height: 100%; object-fit: cover; }
        .qf-avatar.none { background: rgba(128,128,128,0.25); color: var(--text-gray); }
        .qf-manager-name { text-align: center; font-size: 0.8rem; color: var(--text-gray); margin: -6px 0 10px; }
        .qf-head { text-align: center; margin-bottom: 14px; }
        .qf-org { display: inline-flex; align-items: center; gap: 6px; font-size: 0.82rem; font-weight: bold; padding: 3px 10px; border-radius: 999px; background: rgba(128,128,128,0.08); }
        .qf-org img { width: 18px; height: 18px; border-radius: 50%; object-fit: cover; }
        .qf-org .dot { width: 10px; height: 10px; border-radius: 50%; }
        .qf-title { font-size: 1.3rem; font-weight: 800; margin: 8px 0 6px; line-height: 1.5; color: var(--text-dark); }
        .qf-chips { display: flex; flex-wrap: wrap; gap: 6px; justify-content: center; }
        .qf-chip { font-size: 0.78rem; padding: 2px 10px; border-radius: 999px; background: rgba(128,128,128,0.08); color: var(--text-gray); border: 1px solid var(--border-color); display: inline-flex; align-items: center; gap: 4px; }
        .qf-chip.mine { background: color-mix(in srgb, var(--primary-color) 14%, transparent); color: var(--primary-color); border-color: color-mix(in srgb, var(--primary-color) 35%, transparent); font-weight: bold; }
        .qf-chip.late { color: var(--error-color); border-color: color-mix(in srgb, var(--error-color) 40%, transparent); background: color-mix(in srgb, var(--error-color) 8%, transparent); }
        .qf-gaps { font-size: 0.82rem; color: var(--text-gray); text-align: center; margin: 4px 0 12px; }
        .qf-field { border-top: 1px dashed var(--border-color); padding: 12px 0; }
        .qf-field > .lbl { font-weight: bold; font-size: 0.92rem; margin-bottom: 8px; display: flex; align-items: center; gap: 6px; color: var(--text-dark); }
        .qf-opts { display: flex; flex-wrap: wrap; gap: 6px; }
        .qf-opt { border: 1px solid var(--border-color); background: var(--card-bg); color: var(--text-dark); border-radius: 999px; padding: 6px 12px; cursor: pointer; font: inherit; font-size: 0.86rem; display: inline-flex; align-items: center; gap: 6px; min-height: 36px; }
        .qf-opt:hover { border-color: var(--primary-color); }
        .qf-opt.on { background: var(--primary-color); color: #fff; border-color: var(--primary-color); }
        .qf-opt[hidden] { display: none; }
        /* A field pre-filled from a similar card: thick blue-to-purple frame and a label. */
        .qf-field.qf-prefilled { border: 3px solid transparent; border-radius: 16px; padding: 10px 12px; margin: 6px 0;
            background: linear-gradient(var(--glass-3, var(--card-bg)), var(--glass-3, var(--card-bg))) padding-box, linear-gradient(135deg, #3b82f6, #8b5cf6) border-box; }
        .qf-prefill-tag { margin-inline-start: auto; display: inline-flex; align-items: center; gap: 4px; font-size: 0.74rem; font-weight: bold; color: #fff; padding: 2px 10px; border-radius: 999px;
            background: linear-gradient(135deg, #3b82f6, #8b5cf6); box-shadow: 0 4px 12px -6px #6d28d9; cursor: help; }
        select.suggested { outline: 2px dashed #8b5cf6; outline-offset: 2px; }
        .qf-opt.suggested { outline: 2px dashed #8b5cf6; outline-offset: 2px; background: color-mix(in srgb, #8b5cf6 12%, var(--card-bg)); }
        .qf-suggest-val { display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; border-radius: 999px; outline: 2px dashed #8b5cf6; outline-offset: 2px; background: color-mix(in srgb, #8b5cf6 12%, var(--card-bg)); font-size: 0.86rem; margin-bottom: 8px; }
        .qf-confirm, .qf-dismiss { border: none; border-radius: 999px; padding: 3px 12px; font: inherit; font-size: 0.76rem; font-weight: bold; cursor: pointer; }
        .qf-confirm { color: #fff; background: linear-gradient(135deg, #22c55e, #059669); box-shadow: 0 4px 12px -6px #059669; }
        .qf-dismiss { background: transparent; color: var(--text-gray); text-decoration: underline; }
        .qf-field.qf-confirmed { border: 3px solid transparent; border-radius: 16px; padding: 10px 12px; margin: 6px 0;
            background: linear-gradient(var(--glass-3, var(--card-bg)), var(--glass-3, var(--card-bg))) padding-box, linear-gradient(135deg, #22c55e, #059669) border-box; }
        .qf-ok-tag { margin-inline-start: auto; font-size: 0.74rem; font-weight: bold; color: #059669; }
        .qf-why { font-size: 0.8rem; color: var(--text-gray); margin: -2px 0 8px; line-height: 1.7; }
        .qf-opt .av { width: 22px; height: 22px; border-radius: 50%; object-fit: cover; background: rgba(128,128,128,0.2); display: inline-flex; align-items: center; justify-content: center; font-size: 0.7rem; font-weight: bold; }
        .qf-row { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
        .qf-owner { display: grid; grid-template-columns: minmax(90px, auto) 1fr; gap: 8px; align-items: center; margin-bottom: 6px; font-size: 0.88rem; }
        .qf-hint { font-size: 0.78rem; color: var(--text-gray); margin-top: 4px; }
        .qf-stage { margin-bottom: 18px; }
        .qf-floatbar { position: sticky; bottom: 14px; z-index: 30; max-width: 640px; margin: 0 auto 10px; padding: 10px 12px 8px; border-radius: 18px;
            background: var(--glass-3, var(--card-bg)); -webkit-backdrop-filter: blur(22px) saturate(160%); backdrop-filter: blur(22px) saturate(160%);
            border: 1px solid var(--glass-line, var(--border-color)); box-shadow: inset 0 1px 0 rgba(255,255,255,.5), 0 18px 40px -16px rgba(30,27,75,.45); }
        .qf-floatbar[hidden] { display: none; }
        /* Toasts appear above the floating bar, never over its buttons. */
        #global-toast-container { bottom: 150px !important; }
        .qf-pending { font-size: 0.8rem; color: #6d28d9; text-align: center; margin-bottom: 6px; font-weight: bold; }
        [data-theme="dark"] .qf-pending { color: #c4b5fd; }
        .qf-pending[hidden] { display: none; }
        .qf-actions { display: grid; grid-template-columns: 1fr 1fr 2fr; gap: 8px; }
        .qf-actions button { min-height: 46px; border-radius: 12px; font: inherit; font-weight: bold; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; gap: 6px; }
        .qf-actions .skip, .qf-actions .later { background: var(--card-bg); border: 1px solid var(--border-color); color: var(--text-dark); }
        .qf-actions .save { background: linear-gradient(135deg, var(--primary-color), #8b5cf6); color: #fff; border: none; }
        .qf-actions .save:disabled { opacity: .5; cursor: default; }
        .qf-keys { text-align: center; font-size: 0.75rem; color: var(--text-gray); margin-top: 6px; }
        .qf-keys kbd { border: 1px solid var(--border-color); border-bottom-width: 2px; border-radius: 5px; padding: 0 5px; font-family: inherit; font-size: 0.72rem; }
        .qf-batch { max-width: 640px; margin: 0 auto 14px; background: color-mix(in srgb, var(--primary-color) 8%, var(--card-bg)); border: 1px solid color-mix(in srgb, var(--primary-color) 35%, transparent); border-radius: 14px; padding: 10px 14px; display: none; }
        .qf-batch.open { display: block; }
        .qf-batch .t { font-size: 0.88rem; font-weight: bold; margin-bottom: 8px; display: flex; justify-content: space-between; gap: 8px; }
        .qf-batch .t button { background: none; border: none; color: var(--text-gray); cursor: pointer; font: inherit; }
        .qf-done { text-align: center; padding: 60px 20px; }
        .qf-done .big { width: 96px; height: 96px; border-radius: 50%; margin: 0 auto 14px; background: color-mix(in srgb, var(--success-color, #16a34a) 15%, transparent); color: var(--success-color, #16a34a); display: flex; align-items: center; justify-content: center; font-size: 3rem; }
        .qf-done h2 { margin: 0 0 6px; }
        .qf-done p { color: var(--text-gray); margin: 0; }
        @media (max-width: 600px) {
            .qf-card { padding: 50px 14px 14px; border-radius: 18px; }
            .qf-row { grid-template-columns: 1fr; }
            .qf-actions { grid-template-columns: 1fr 1fr; }
            .qf-actions .save { grid-column: 1 / -1; order: -1; }
            .qf-keys { display: none; }
        }
    </style>
</head>
<body>
<%- include('sidebar') %>

<main class="main-content">
    <div class="page-header-container flex-responsive">
        <div>
            <h1 class="page-title"><i class=ai data-ic=sparkles style="color: var(--primary-color)"></i> <span>تکمیل سریع</span></h1>
            <p class="page-subtitle">کارت‌های ناقص یکی‌یکی می‌آیند و فقط جاهای خالی‌شان را می‌بینید؛ هر چند تا خواستید پر کنید، بقیه را رد کنید.</p>
        </div>
    </div>

    <div class="qf-top">
        <div class="qf-progress" aria-live="polite">
            <div class="txt"><span id="qfDoneTxt">—</span><span id="qfLeftTxt"></span></div>
            <div class="bar"><span id="qfBar"></span></div>
        </div>
        <div class="qf-filters">
            <select id="qfOrg" class="form-control" aria-label="برند"><option value="">همه‌ی برندها</option></select>
            <select id="qfField" class="form-control" aria-label="نوع جای خالی"><option value="">همه‌ی جاهای خالی</option></select>
            <label class="toggle"><input type="checkbox" id="qfMine"> فقط کارهای من</label>
            <label class="toggle" title="کارت‌های منتشرشده‌ای که چیزی (مثلاً مدیر پروژه) ندارند"><input type="checkbox" id="qfPublished"> منتشرشده‌ها هم <span id="qfPubCount"></span></label>
        </div>
    </div>

    <div class="qf-batch" id="qfBatch" role="region" aria-label="پر کردن گروهی"></div>

    <div class="qf-stage" id="qfStage">
        <div class="qf-done"><p>در حال بارگذاری…</p></div>
    </div>

    <!-- Floating actions: always at the bottom of the screen, no scrolling needed. -->
    <div class="qf-floatbar" id="qfFloat" hidden>
        <div class="qf-pending" id="qfPending" hidden></div>
        <div class="qf-actions">
            <button type="button" class="skip" id="qfSkip" title="رد کن (Esc)"><i class=ai data-ic=arrow-left></i> رد کن</button>
            <button type="button" class="later" id="qfLater" title="تا فردا نشان نده"><i class=ai data-ic=clock></i> بعداً</button>
            <button type="button" class="save" id="qfSave" disabled><i class=ai data-ic=check></i> ذخیره و بعدی</button>
        </div>
        <div class="qf-keys"><kbd>Enter</kbd> ذخیره و بعدی (در کپشن <kbd>Ctrl</kbd>+<kbd>Enter</kbd>) · <kbd>Esc</kbd> رد کن · روی گوشی: کارت را به کنار بکشید</div>
    </div>
</main>

<script>
(function () {
    "use strict";
    const $ = (id) => document.getElementById(id);
    const fa = (v) => window.toPersianDigits ? window.toPersianDigits(String(v)) : String(v);
    const esc = (v) => window.escapeHtml(v == null ? '' : String(v));
    const STATUS = { raw: 'ورودی خام', todo: 'در صف انتظار', doing: 'در حال تولید', in_progress: 'در حال تولید', review: 'ارزیابی استودیو', client_review: 'ارزیابی کارفرما', needs_revision: 'نیاز به اصلاح', done: 'تکمیل شده', approved_by_client: 'تایید کارفرما', ready_to_publish: 'آماده انتشار', scheduled: 'زمان‌بندی شده', published: 'منتشر شده' };
    const ICON = { content_type: 'tag', collection: 'folder', project_manager: 'user', stages: 'list-checks', team: 'users', stage_owners: 'user', publish_date: 'calendar-days', platforms: 'smartphone', caption: 'notebook-pen', media: 'link' };
    // Values that make sense to repeat on the next cards of the same brand.
    const SHAREABLE = ['content_type', 'collection', 'project_manager', 'stages', 'team', 'platforms'];

    let queue = [], idx = 0, fields = [], doneToday = 0, startTotal = 0, initialField = '';
    let settingsData = {}, people = [], colsByOrg = {}, draft = {};

    const active = (list) => (list || []).filter(x => x && x.is_active !== 0);
    const personName = (p) => p.full_name || p.username;
    const normName = (s) => String(s == null ? '' : s).replace(/ي/g, 'ی').replace(/ك/g, 'ک').replace(/\s+/g, ' ').trim();
    const sameName = (a, b) => !!normName(a) && normName(a) === normName(b);
    const initials = (n) => String(n || '?').trim().charAt(0) || '?';

    async function loadOptions() {
        const [s, c] = await Promise.all([
            fetch('/api/manage_settings', { cache: 'no-store' }).then(r => r.json()).catch(() => ({})),
            fetch('/api/get_colleagues', { cache: 'no-store' }).then(r => r.json()).catch(() => ({})),
        ]);
        settingsData = (s && s.data) || {};
        people = (c && (c.data || c.users)) || [];
        const orgs = await fetch('/api/get_orgs', { cache: 'no-store' }).then(r => r.json()).catch(() => ({}));
        $('qfOrg').insertAdjacentHTML('beforeend', ((orgs && orgs.data) || []).map(o => `<option value="${esc(o.id)}">${esc(o.org_name)}</option>`).join(''));
    }
    async function collectionsOf(orgId) {
        const key = String(orgId || '');
        if (!colsByOrg[key]) {
            const r = await fetch('/api/get_collections' + (orgId ? '?org_id=' + encodeURIComponent(orgId) : ''), { cache: 'no-store' }).then(r => r.json()).catch(() => ({}));
            colsByOrg[key] = ((r && r.data) || []).filter(c => c.status !== 'archived');
        }
        return colsByOrg[key];
    }

    async function loadQueue(keepId) {
        const p = new URLSearchParams();
        if ($('qfOrg').value) p.set('org', $('qfOrg').value);
        const field = $('qfField').value || initialField;
        if (field) p.set('field', field);
        if ($('qfMine').checked) p.set('mine', '1');
        if ($('qfPublished').checked) p.set('published', '1');
        const r = await fetch('/api/quick_fill?' + p, { cache: 'no-store' }).then(r => r.json());
        if (r.status !== 'success') { $('qfStage').innerHTML = `<div class="qf-done"><p>${esc(r.message || 'بارگذاری نشد')}</p></div>`; return; }
        if (!fields.length) {
            fields = r.fields;
            $('qfField').insertAdjacentHTML('beforeend', fields.map(f => `<option value="${f.key}">${esc(f.label)}</option>`).join(''));
            if (initialField) { $('qfField').value = initialField; initialField = ''; }
        }
        queue = r.items;
        $('qfPubCount').textContent = r.published_hidden ? '(' + fa(r.published_hidden) + ')' : '';
        doneToday = r.done_today || 0;
        startTotal = queue.length;
        idx = 0;
        if (keepId) { const i = queue.findIndex(x => x.id === keepId); if (i > 0) idx = i; }
        // The server puts unseen cards first; if the first one was already seen, all were.
        else if (queue.length && queue[0].seen && window.showToast && !loadQueue.toldRound) {
            loadQueue.toldRound = true;
            window.showToast('همه‌ی کارت‌ها را یک دور دیده‌اید؛ از کارتی که زودتر از همه دیدید دوباره شروع می‌شود.', 'info');
        }
        renderProgress();
        await renderCard();
    }

    function renderProgress() {
        const left = queue.length;
        $('qfDoneTxt').textContent = doneToday ? `امروز ${fa(doneToday)} کارت کامل شد` : 'امروز هنوز کارتی کامل نشده';
        $('qfLeftTxt').textContent = left ? `${fa(left)} کارت ناقص مانده` : '';
        const pct = doneToday + left ? Math.round(doneToday / (doneToday + left) * 100) : 100;
        $('qfBar').style.width = pct + '%';
        if (window.updateQuickFillBadge) window.updateQuickFillBadge(left);
    }

    // ───────── Card ─────────
    function avatarHtml(m) {
        if (!m) return '<div class="qf-avatar none" title="بدون مدیر پروژه"><i class=ai data-ic=user></i></div>';
        const url = m.avatar_url && window.safeUrl ? window.safeUrl(m.avatar_url) : '';
        return `<div class="qf-avatar" title="مدیر پروژه: ${esc(m.name)}">${url ? `<img src="${esc(url)}" alt="" data-fallback-icon="user">` : esc(initials(m.name))}</div>`;
    }
    function personOpt(p, on, attrs) {
        const url = p.avatar_url && window.safeUrl ? window.safeUrl(p.avatar_url) : '';
        return `<button type="button" class="qf-opt${on ? ' on' : ''}" ${attrs}>${url ? `<img class="av" src="${esc(url)}" alt="">` : `<span class="av">${esc(initials(personName(p)))}</span>`}${esc(personName(p))}</button>`;
    }
    async function fieldHtml(key, item) {
        const label = (fields.find(f => f.key === key) || {}).label || key;
        let body = '';
        if (key === 'content_type') {
            const list = active(settingsData.content_type);
            body = list.length ? `<div class="qf-opts" data-single="content_type">${list.map(t => `<button type="button" class="qf-opt" data-v="${esc(t.setting_key)}">${esc(t.setting_key)}</button>`).join('')}</div>` : `<div class="qf-hint">نوع محتوایی در «تنظیمات پایه ← نوع محتوا و تعرفه» تعریف نشده است.</div>`;
        } else if (key === 'collection') {
            const cols = await collectionsOf(item.org && item.org.id);
            body = `<input class="form-control" id="qfCol" list="qfColList" placeholder="یک مجموعه را انتخاب کنید یا نام تازه بنویسید" autocomplete="off">
                <datalist id="qfColList">${cols.map(c => `<option value="${esc(c.title)}"></option>`).join('')}</datalist>
                <div class="qf-hint" id="qfColHint"></div>`;
        } else if (key === 'project_manager') {
            body = `<div class="qf-opts" data-single="project_manager">${people.map(p => personOpt(p, false, `data-v="${esc(personName(p))}"`)).join('')}</div>`;
        } else if (key === 'stages') {
            const list = active(settingsData.stages);
            body = list.length ? `<div class="qf-opts" data-multi="stages">${list.map(s => `<button type="button" class="qf-opt" data-v="${esc(s.setting_key)}">${esc(s.setting_key)}</button>`).join('')}</div>` : `<div class="qf-hint">مرحله‌ای در «تنظیمات پایه ← مراحل تولید» تعریف نشده است.</div>`;
        } else if (key === 'team') {
            // The card's project manager is not offered as a team member.
            const mgr = item.manager && item.manager.name;
            body = `<div class="qf-opts" data-multi="team">${people.map(p => personOpt(p, false, `data-v="${esc(personName(p))}"${sameName(personName(p), mgr) ? ' hidden' : ''}`)).join('')}</div>`;
        } else if (key === 'stage_owners') {
            body = item.stage_owners_missing.map(st => `<div class="qf-owner"><span>${esc(st)}</span><select class="form-control" data-owner="${esc(st)}"><option value="">— انتخاب مسئول —</option>${people.map(p => `<option value="${esc(p.id)}">${esc(personName(p))}</option>`).join('')}</select></div>`).join('');
        } else if (key === 'publish_date') {
            body = `<div class="qf-row"><input class="form-control" id="qfDate" data-jdp placeholder="تاریخ انتشار، مثلاً ۱۴۰۵/۰۹/۰۱" value="${esc(fa(item.publish_date || ''))}" autocomplete="off"><input class="form-control" type="time" id="qfTime" value="${esc(item.publish_time || '')}"></div>`;
        } else if (key === 'platforms') {
            const list = active(settingsData.platform);
            body = list.length ? `<div class="qf-opts" data-multi="platforms">${list.map(s => `<button type="button" class="qf-opt" data-v="${esc(s.setting_key)}">${esc(s.setting_key)}</button>`).join('')}</div>` : `<div class="qf-hint">پلتفرمی در «تنظیمات پایه ← پلتفرم‌های انتشار» تعریف نشده است.</div>`;
        } else if (key === 'caption') {
            body = `<textarea class="form-control" id="qfCaption" rows="3" placeholder="متن کپشن…" style="resize:vertical"></textarea>`;
        } else if (key === 'media') {
            body = `<div class="qf-row"><input class="form-control" id="qfVideo" dir="ltr" placeholder="لینک ویدیو https://…"><input class="form-control" id="qfCover" dir="ltr" placeholder="لینک کاور https://…"></div>`;
        }
        return `<div class="qf-field" data-key="${key}"><div class="lbl"><i class=ai data-ic=${ICON[key] || 'circle'}></i> ${esc(label)}</div>${body}</div>`;
    }

    /** As many as the boxes shown: one per stage without an owner, two for date + time. */
    function gapCount(item, shown) {
        return shown.reduce((n, k) => n + (k === 'stage_owners' ? Math.max(1, (item.stage_owners_missing || []).length)
            : k === 'publish_date' ? (item.publish_date ? 0 : 1) + (item.publish_time ? 0 : 1) || 1
            : k === 'media' ? 2 : 1), 0);
    }

    async function renderCard(direction) {
        const stage = $('qfStage');
        $('qfFloat').hidden = !queue.length;
        if (!queue.length) {
            stage.innerHTML = `<div class="qf-done"><div class="big"><i class=ai data-ic=circle-check></i></div><h2>همه‌چیز کامل است</h2><p>${doneToday ? `امروز ${fa(doneToday)} کارت را کامل کردید. ` : ''}کارت ناقصی ${$('qfOrg').value || $('qfField').value || $('qfMine').checked ? 'با این فیلترها ' : ''}باقی نمانده است.</p></div>`;
            return;
        }
        if (idx >= queue.length) idx = 0;
        const item = queue[idx];
        draft = {};
        // Filtering by one kind of gap shows only that field, so the user can stay on one task.
        const focus = $('qfField').value;
        const shown = focus && item.missing.includes(focus) ? [focus] : item.missing;
        const parts = await Promise.all(shown.map(k => fieldHtml(k, item)));
        const org = item.org;
        const orgHtml = org ? `<span class="qf-org">${org.logo ? `<img src="${esc(window.safeUrl ? window.safeUrl(org.logo) : org.logo)}" alt="">` : `<span class="dot" style="background:${esc(window.safeColor ? (window.safeColor(org.color) || 'var(--primary-color)') : 'var(--primary-color)')}"></span>`}${esc(org.name)}</span>` : '<span class="qf-org">بدون برند</span>';
        const chips = [
            item.mine ? '<span class="qf-chip mine"><i class=ai data-ic=user></i> کار شما</span>' : '',
            item.seen ? '<span class="qf-chip" title="این کارت را قبلاً در «تکمیل سریع» دیده‌اید"><i class=ai data-ic=eye></i> قبلاً دیده‌اید</span>' : '',
            `<span class="qf-chip">${esc(STATUS[item.status] || item.status)}</span>`,
            item.content_type ? `<span class="qf-chip">${esc(item.content_type)}</span>` : '',
            item.collection ? `<span class="qf-chip"><i class=ai data-ic=folder></i> ${esc(item.collection.title)}</span>` : '',
            item.publish_date ? `<span class="qf-chip${item.overdue ? ' late' : ''}"><i class=ai data-ic=calendar></i> ${esc(fa(item.publish_date))}${item.overdue ? ' — گذشته' : ''}</span>` : '',
        ].join('');
        const html = `<div class="qf-ghost g2"></div><div class="qf-ghost g1"></div>
            <article class="qf-card enter" id="qfCard" tabindex="-1" aria-label="${esc(item.title)}">
                ${avatarHtml(item.manager)}
                <div class="qf-manager-name">${item.manager ? 'مدیر پروژه: ' + esc(item.manager.name) : 'هنوز مدیر پروژه ندارد'}</div>
                <div class="qf-head">${orgHtml}<div class="qf-title">${esc(item.title)}</div><div class="qf-chips">${chips}</div></div>
                <div class="qf-gaps">${fa(gapCount(item, shown))} جای خالی${shown.length < item.missing.length ? ' (فقط «' + esc((fields.find(f => f.key === focus) || {}).label || '') + '» نمایش داده شده)' : ''} — کارت ${fa(idx + 1)} از ${fa(queue.length)}</div>
                ${parts.join('')}
            </article>`;
        stage.innerHTML = html;
        const card = $('qfCard');
        requestAnimationFrame(() => requestAnimationFrame(() => card.classList.remove('enter')));
        if (window.jalaliDatepicker && $('qfDate')) { try { jalaliDatepicker.startWatch({ persianDigits: true, time: false, hideAfterChange: true, autoHide: true }); } catch (e) {} }
        wireCard(card, item);
        updatePending(null);
        // Remember that this card was shown: the next visit continues after it.
        if (!item.seen) {
            item.seen = true;
            fetch('/api/quick_fill_seen', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: item.id }) }).catch(() => {});
        }
        if (item.collection) await addCollectionDefaults(item, item.collection.id);
        if ($('qfCard') !== card) return;
        applyPrefill(card, item);
        readDraft(card);
        // Typing fields get the focus; with only choice buttons the card itself does (keys still work).
        const firstField = card.querySelector('.qf-field');
        const first = firstField && firstField.querySelector('input:not([type=time])');
        if (window.matchMedia('(min-width: 700px)').matches) (first || card).focus({ preventScroll: true });
    }

    function wireCard(card, item) {
        card.addEventListener('click', (e) => {
            const conf = e.target.closest('[data-confirm], [data-dismiss]');
            if (conf) { resolveSuggestion(card, item, conf.dataset.confirm || conf.dataset.dismiss, !!conf.dataset.confirm); return; }
            const opt = e.target.closest('.qf-opt');
            if (!opt) return;
            const single = opt.parentElement.dataset.single, multi = opt.parentElement.dataset.multi;
            if (single) {
                const was = opt.classList.contains('on');
                opt.parentElement.querySelectorAll('.qf-opt').forEach(o => o.classList.remove('on'));
                if (!was) opt.classList.add('on');
                if (single === 'project_manager') {
                    // A manager picked here leaves the team chips; the previous one comes back.
                    const chosen = was ? (item.manager && item.manager.name) : opt.dataset.v;
                    card.querySelectorAll('[data-multi="team"] .qf-opt').forEach(o => {
                        const isMgr = sameName(o.dataset.v, chosen);
                        o.hidden = isMgr;
                        if (isMgr) o.classList.remove('on');
                    });
                }
            } else if (multi) opt.classList.toggle('on');
            readDraft(card);
        });
        card.addEventListener('input', (e) => { readDraft(card); if (e.target.id === 'qfCol') collectionPicked(card, item); });
        card.addEventListener('change', (e) => { readDraft(card); if (e.target.id === 'qfCol') collectionPicked(card, item); });
        $('qfSave').onclick = () => save(item);
        $('qfSkip').onclick = () => skip('left');
        $('qfLater').onclick = () => later(item);
        // Swipe (touch / mouse): far enough sideways means "skip".
        let startX = null, dx = 0;
        card.addEventListener('pointerdown', (e) => {
            if (e.pointerType === 'mouse' || e.target.closest('input, textarea, select, button, datalist')) return;
            startX = e.clientX; dx = 0; card.classList.add('dragging');
        });
        card.addEventListener('pointermove', (e) => {
            if (startX === null) return;
            dx = e.clientX - startX;
            card.style.transform = `translateX(${dx}px) rotate(${dx / 25}deg)`;
        });
        const end = () => {
            if (startX === null) return;
            card.classList.remove('dragging');
            startX = null;
            if (Math.abs(dx) > 110) { card.style.transform = ''; skip(dx < 0 ? 'left' : 'right'); }
            else card.style.transform = '';
        };
        card.addEventListener('pointerup', end);
        card.addEventListener('pointercancel', end);
    }

    function readDraft(card) {
        const d = {};
        card.querySelectorAll('[data-single]').forEach(box => { const on = box.querySelector('.qf-opt.on'); if (on) d[box.dataset.single] = on.dataset.v; });
        card.querySelectorAll('[data-multi]').forEach(box => { const on = [...box.querySelectorAll('.qf-opt.on')].map(o => o.dataset.v); if (on.length) d[box.dataset.multi] = on; });
        const col = $('qfCol');
        if (col && col.value.trim()) {
            const item = queue[idx];
            const cols = colsByOrg[String((item.org && item.org.id) || '')] || [];
            const match = cols.find(c => c.title === col.value.trim());
            d.collection = match ? match.id : col.value.trim();
            $('qfColHint').textContent = match ? '✓ در همین مجموعه قرار می‌گیرد.' : 'مجموعه‌ای با این نام نیست؛ موقع ذخیره می‌پرسیم که ساخته شود یا نه (و کجا).';
        } else if ($('qfColHint')) $('qfColHint').textContent = '';
        const owners = {};
        card.querySelectorAll('[data-owner]').forEach(s => { if (s.value) owners[s.dataset.owner] = s.value; });
        if (Object.keys(owners).length) d.stage_owners = owners;
        const date = $('qfDate'), time = $('qfTime');
        if (date && date.value.trim()) d.publish_date = window.toEnglishDigits ? window.toEnglishDigits(date.value.trim()) : date.value.trim();
        if (time && time.value) d.publish_time = time.value;
        const cap = $('qfCaption'); if (cap && cap.value.trim()) d.caption = cap.value.trim();
        const v = $('qfVideo'), c = $('qfCover');
        if (v && v.value.trim()) d.video_link = v.value.trim();
        if (c && c.value.trim()) d.cover_link = c.value.trim();
        draft = d;
        $('qfSave').disabled = !Object.keys(d).length;
        return d;
    }

    function leave(cls) {
        return new Promise((resolve) => {
            const card = $('qfCard');
            if (!card) return resolve();
            card.classList.add(cls);
            setTimeout(resolve, 260);
        });
    }

    async function skip(dir) {
        if (!queue.length) return;
        await leave(dir === 'right' ? 'leave-right' : 'leave-left');
        const [it] = queue.splice(idx, 1);
        queue.push(it);
        if (idx >= queue.length) idx = 0;
        renderCard();
    }

    async function later(item) {
        await fetch('/api/quick_fill_snooze', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: item.id }) }).catch(() => {});
        await leave('leave-left');
        queue.splice(idx, 1);
        renderProgress();
        renderCard();
        if (window.showToast) window.showToast('این کارت تا فردا نشان داده نمی‌شود', 'info');
    }

    async function save(item) {
        const values = Object.assign({}, Object.keys(draft).length ? draft : readDraft($('qfCard')));
        if (!Object.keys(values).length) return;
        // A collection name that does not exist yet is created only after the user confirms it.
        if (typeof values.collection === 'string' && window.confirmNewCollection) {
            const orgId = item.org && item.org.id;
            const ok = await window.confirmNewCollection(values.collection, orgId, colsByOrg[String(orgId || '')] || []);
            if (!ok) { if ($('qfCol')) $('qfCol').focus(); return; }
            if (ok.parent_id) values.collection_parent_id = ok.parent_id;
        }
        $('qfSave').disabled = true;
        let r;
        try {
            r = await fetch('/api/quick_fill_save', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: item.id, values }) }).then(x => x.json());
        } catch (e) { r = { status: 'error', message: 'خطا در ارتباط با سرور' }; }
        if (r.status !== 'success') { $('qfSave').disabled = false; if (window.showToast) window.showToast(r.message || 'ذخیره نشد', 'error'); return; }
        doneToday = r.done_today || doneToday;
        delete prefills[item.id];
        const res = r.data[0] || { missing: [] };
        offerBatch(item, values);
        await leave('leave-done');
        if (res.missing.length) {
            // Still has gaps (filled only some): it goes to the back of the line.
            const [it] = queue.splice(idx, 1);
            it.missing = res.missing;
            queue.push(it);
        } else queue.splice(idx, 1);
        if (idx >= queue.length) idx = 0;
        renderProgress();
        renderCard();
    }

    // ───────── Same value for the next cards of the same brand ─────────
    function valueLabel(key, v) {
        if (key === 'collection') { const cols = Object.values(colsByOrg).flat(); const c = cols.find(x => x.id === v); return c ? c.title : v; }
        return Array.isArray(v) ? v.join('، ') : v;
    }
    // ───────── Pre-fill similar cards (never saved without the user) ─────────
    // A value is offered for the next cards only when they are the same brand AND match the
    // card just saved on at least MIN_SIMILAR of these attributes. Accepting only pre-fills
    // the field on those cards (marked in blue/purple); each is saved when the user saves it.
    const MIN_SIMILAR = 3;
    const PREFILL_LABEL = 'پیشنهاد از کارت مشابه';
    const prefills = {}; // card id -> { values: {key: value}, from: title, why: [labels] }
    const SIM_ATTRS = [
        ['collection', 'مجموعه'], ['content_type', 'نوع محتوا'], ['project_manager', 'مدیر پروژه'],
        ['stages', 'مراحل تولید'], ['platforms', 'پلتفرم‌ها'], ['team', 'همکاران'],
    ];
    const listKey = (v) => (Array.isArray(v) ? v.map(normName).filter(Boolean).sort().join('|') : '');
    function collectionTitle(v, orgId) {
        if (v == null || v === '') return '';
        if (typeof v === 'object') return normName(v.title);
        const cols = colsByOrg[String(orgId || '')] || Object.values(colsByOrg).flat();
        const c = cols.find(x => String(x.id) === String(v));
        return normName(c ? c.title : v);
    }
    /** The card's attributes after a save: its own values plus what was just filled. */
    function attrsOf(item, values) {
        values = values || {};
        const orgId = item.org && item.org.id;
        return {
            collection: values.collection !== undefined ? collectionTitle(values.collection, orgId) : collectionTitle(item.collection, orgId),
            content_type: normName(values.content_type !== undefined ? values.content_type : item.content_type),
            project_manager: normName(values.project_manager !== undefined ? values.project_manager : (item.manager && item.manager.name)),
            stages: listKey(values.stages !== undefined ? values.stages : item.stages),
            platforms: listKey(values.platforms !== undefined ? values.platforms : item.platforms),
            team: listKey(values.team !== undefined ? values.team : item.team),
        };
    }
    function similarity(a, b) {
        return SIM_ATTRS.filter(([k]) => a[k] && b[k] && a[k] === b[k]).map(([, label]) => label);
    }
    function offerBatch(item, values) {
        const box = $('qfBatch');
        const orgId = item.org && item.org.id;
        const mine = attrsOf(item, values);
        // Similar cards: same brand and at least MIN_SIMILAR matching attributes.
        const similar = queue.filter(x => x.id !== item.id && (x.org && x.org.id) === orgId)
            .map(x => ({ x, why: similarity(mine, attrsOf(x, prefills[x.id] && prefills[x.id].values)) }))
            .filter(s => s.why.length >= MIN_SIMILAR);
        const offers = SHAREABLE.filter(k => values[k] !== undefined).map(k => {
            const hits = similar.filter(s => s.x.missing.includes(k)).slice(0, 10);
            return { key: k, value: values[k], hits };
        }).filter(o => o.hits.length);
        if (!offers.length) { box.classList.remove('open'); return; }
        const label = (k) => (fields.find(f => f.key === k) || {}).label || k;
        const whyAll = [...new Set(offers.flatMap(o => o.hits.flatMap(h => h.why)))];
        box.innerHTML = `<div class="t"><span><i class=ai data-ic=sparkles></i> این مقدار برای کارت‌های مشابه بعدی هم پیشنهاد شود؟</span><button type="button" data-close aria-label="بستن">✕</button></div>
            <div class="qf-why">کارت‌هایی که با این کارت در دست‌کم ${fa(MIN_SIMILAR)} مورد یکی‌اند (${esc(whyAll.join('، '))}). فقط پیش‌پر می‌شوند؛ ذخیره با خود شماست.</div>
            <div class="qf-opts">${offers.map((o, i) => `<button type="button" class="qf-opt" data-batch="${i}">${esc(label(o.key))}: ${esc(valueLabel(o.key, o.value))} — ${fa(o.hits.length)} کارت مشابه</button>`).join('')}</div>`;
        box.classList.add('open');
        box.onclick = (e) => {
            if (e.target.closest('[data-close]')) { box.classList.remove('open'); return; }
            const b = e.target.closest('[data-batch]');
            if (!b) return;
            const o = offers[Number(b.dataset.batch)];
            for (const h of o.hits) {
                const pf = prefills[h.x.id] || (prefills[h.x.id] = { values: {}, from: item.title, why: h.why });
                pf.values[o.key] = o.value;
                if (pf.src) delete pf.src[o.key];
                pf.from = item.title;
                pf.why = h.why;
            }
            b.remove();
            // The next card may already be on screen: pre-fill it right away.
            const shownCard = $('qfCard'), shownItem = queue[idx];
            if (shownCard && shownItem && prefills[shownItem.id]) { applyPrefill(shownCard, shownItem); readDraft(shownCard); }
            if (window.showToast) window.showToast(`روی ${fa(o.hits.length)} کارت مشابه پیش‌پر شد؛ هر کدام را وقتی رسید تأیید کنید`, 'info');
            if (!box.querySelector('[data-batch]')) box.classList.remove('open');
        };
    }

    // ───────── «پیش‌فرض مجموعه»: the card's collection suggests its default values ─────────
    // Shown like a similar-card suggestion (gradient frame) and applied only after «تایید».
    const DEFAULT_TO_FIELD = { content_type: 'content_type', project_manager: 'project_manager', team: 'team', stages: 'stages', platforms: 'platforms', stage_owners: 'stage_owners', publish_time: 'publish_date' };
    async function addCollectionDefaults(item, colId) {
        const cols = await collectionsOf(item.org && item.org.id);
        let col = cols.find(c => String(c.id) === String(colId));
        if (!col) col = (await collectionsOf('')).find(c => String(c.id) === String(colId));
        const d = col && col.effective_defaults;
        if (!d) return;
        const from = d._from || {};
        Object.entries(DEFAULT_TO_FIELD).forEach(([dk, fk]) => {
            let value = d[dk];
            if (value === undefined || !item.missing.includes(fk)) return;
            if (dk === 'stage_owners') {
                // Only stages of this card that still have no owner.
                const v = {};
                (item.stage_owners_missing || []).forEach(st => { if (value[st] && people.some(p => String(p.id) === String(value[st]))) v[st] = value[st]; });
                if (!Object.keys(v).length) return;
                value = v;
            }
            if (dk === 'publish_time') { if (item.publish_time) return; value = { publish_time: value }; }
            const pf = prefills[item.id] || (prefills[item.id] = { values: {}, from: '', why: [], src: {} });
            pf.src = pf.src || {};
            if (pf.values[fk] !== undefined) return; // a suggestion from a similar card stays
            pf.values[fk] = value;
            pf.src[fk] = { kind: 'collection', col: col.id, label: 'پیش‌فرض مجموعه', tip: `پیش‌فرض مجموعه «${from[dk] || col.title}»` };
        });
    }
    /** A collection typed or confirmed on the card brings that collection's defaults. */
    async function collectionPicked(card, item) {
        const inp = $('qfCol');
        const cols = colsByOrg[String((item.org && item.org.id) || '')] || [];
        const match = inp ? cols.find(c => c.title === inp.value.trim()) : null;
        const id = match ? match.id : null;
        if (card.dataset.cdCol === String(id)) return;
        card.dataset.cdCol = String(id);
        // Suggestions of the previously picked collection go away.
        const pf = prefills[item.id];
        if (pf && pf.src) Object.keys(pf.values).forEach(k => { if (pf.src[k] && pf.src[k].kind === 'collection' && k !== 'collection') resolveSuggestion(card, item, k, false); });
        if (!id) return;
        await addCollectionDefaults(item, id);
        if ($('qfCard') === card) { applyPrefill(card, item); readDraft(card); }
    }

    /** Marks a pre-filled field and selects its value; the user still confirms by saving. */
    function applyPrefill(card, item) {
        const pf = prefills[item.id];
        if (!pf) return;
        Object.entries(pf.values).forEach(([key, value]) => {
            const field = card.querySelector(`.qf-field[data-key="${key}"]`);
            if (!field || field.classList.contains('qf-prefilled')) return;
            const src = pf.src && pf.src[key];
            const tip = src ? src.tip : `از کارت «${pf.from}» — مشابه در: ${pf.why.join('، ')}`;
            field.classList.add('qf-prefilled');
            const lbl = field.querySelector('.lbl');
            if (lbl) lbl.insertAdjacentHTML('beforeend', `<span class="qf-prefill-tag" title="${esc(tip)}"><i class=ai data-ic=sparkles></i> ${esc(src ? src.label : PREFILL_LABEL)}</span>
                <button type="button" class="qf-confirm" data-confirm="${key}" title="این پیشنهاد وارد کارت شود"><i class=ai data-ic=check></i> تایید</button>
                <button type="button" class="qf-dismiss" data-dismiss="${key}">نه</button>`);
            if (src && src.kind === 'collection' && lbl) lbl.insertAdjacentHTML('afterend', `<div class="qf-why">${esc(tip)}</div>`);
            // Only marked as a suggestion: nothing is selected until the user confirms it.
            if (key === 'collection') {
                const col = Object.values(colsByOrg).flat().find(c => String(c.id) === String(value));
                field.querySelector('.lbl').insertAdjacentHTML('afterend', `<div class="qf-suggest-val"><i class=ai data-ic=folder></i> ${esc(col ? col.title : String(value))}</div>`);
                return;
            }
            if (key === 'stage_owners') {
                Object.entries(value).forEach(([st, pid]) => {
                    const sel = [...field.querySelectorAll('[data-owner]')].find(s => s.dataset.owner === st);
                    if (sel && !sel.value) { sel.classList.add('suggested'); sel.title = 'پیشنهاد: ' + personName(people.find(p => String(p.id) === String(pid)) || {}); }
                });
                field.querySelector('.lbl').insertAdjacentHTML('afterend', `<div class="qf-suggest-val"><i class=ai data-ic=user></i> ${esc(Object.entries(value).map(([st, pid]) => st + ': ' + personName(people.find(p => String(p.id) === String(pid)) || { full_name: '?' })).join('، '))}</div>`);
                return;
            }
            if (key === 'publish_date' && value && value.publish_time) {
                field.querySelector('.lbl').insertAdjacentHTML('afterend', `<div class="qf-suggest-val"><i class=ai data-ic=clock></i> ساعت ${esc(fa(value.publish_time))}</div>`);
                return;
            }
            const vals = Array.isArray(value) ? value : [value];
            field.querySelectorAll('.qf-opt').forEach(o => { if (!o.hidden && vals.some(v => sameName(v, o.dataset.v))) o.classList.add('suggested'); });
        });
        updatePending(card);
    }
    function updatePending(card) {
        const n = card ? card.querySelectorAll('.qf-field.qf-prefilled').length : 0;
        const box = $('qfPending');
        box.hidden = !n;
        box.textContent = n ? `${fa(n)} پیشنهاد هنوز تایید نشده؛ تا تایید نکنید وارد کارت نمی‌شود.` : '';
    }
    /** "Confirm": the suggested value becomes the field's value. "No": the suggestion goes away. */
    function resolveSuggestion(card, item, key, accept) {
        const field = card.querySelector(`.qf-field[data-key="${key}"]`);
        const pf = prefills[item.id];
        if (!field || !pf) return;
        const value = pf.values[key];
        if (accept) {
            if (key === 'collection') {
                const col = Object.values(colsByOrg).flat().find(c => String(c.id) === String(value));
                const inp = field.querySelector('#qfCol');
                if (inp) { inp.value = col ? col.title : String(value); inp.dispatchEvent(new Event('input', { bubbles: true })); }
            } else if (key === 'stage_owners') {
                field.querySelectorAll('[data-owner]').forEach(s => { if (value[s.dataset.owner] && !s.value) s.value = String(value[s.dataset.owner]); });
            } else if (key === 'publish_date' && value && value.publish_time) {
                const tm = field.querySelector('#qfTime');
                if (tm && !tm.value) tm.value = value.publish_time;
            } else {
                const single = field.querySelector('[data-single]');
                if (single) single.querySelectorAll('.qf-opt').forEach(o => o.classList.remove('on'));
                field.querySelectorAll('.qf-opt.suggested').forEach(o => o.classList.add('on'));
            }
        }
        field.querySelectorAll('.suggested').forEach(o => o.classList.remove('suggested'));
        field.querySelectorAll('.qf-prefill-tag, .qf-confirm, .qf-dismiss, .qf-suggest-val, .qf-why').forEach(el => el.remove());
        if (pf.src) delete pf.src[key];
        field.classList.remove('qf-prefilled');
        if (accept) {
            field.classList.add('qf-confirmed');
            field.querySelector('.lbl').insertAdjacentHTML('beforeend', '<span class="qf-ok-tag"><i class=ai data-ic=check></i> تایید شد</span>');
        }
        delete pf.values[key];
        if (!Object.keys(pf.values).length) delete prefills[item.id];
        readDraft(card);
        updatePending(card);
    }

    // Keyboard: Enter saves (Ctrl+Enter inside the caption), Esc skips.
    document.addEventListener('keydown', (e) => {
        if (!$('qfCard')) return;
        if (document.querySelector('.wf-overlay')) return; // a dialog is open (e.g. new collection)
        if (document.querySelector('.jdp-container') && getComputedStyle(document.querySelector('.jdp-container')).display !== 'none' && e.key === 'Escape') return;
        if (e.key === 'Escape') { e.preventDefault(); skip('left'); }
        else if (e.key === 'Enter') {
            const inArea = e.target.tagName === 'TEXTAREA';
            if (inArea && !(e.ctrlKey || e.metaKey)) return;
            // On a choice button Space picks it; Enter always means "save and next".
            e.preventDefault();
            if (!$('qfSave').disabled) $('qfSave').click();
        }
    });

    ['qfOrg', 'qfField', 'qfMine', 'qfPublished'].forEach(id => $(id).addEventListener('change', () => loadQueue()));
    window.addEventListener('DOMContentLoaded', async () => {
        const q = new URLSearchParams(location.search);
        await loadOptions();
        if (q.get('org')) $('qfOrg').value = q.get('org');
        if (q.get('mine') === '1') $('qfMine').checked = true;
        // A field from the link is used by the first load itself (no second load).
        initialField = q.get('field') || '';
        await loadQueue();
    });
})();
</script>
</body>
</html>
