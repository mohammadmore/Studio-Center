{
  "name": "asva-studio",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "esbuild server.ts --bundle --platform=node --target=node18 --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "NODE_ENV=test tsx --test tests/*.test.ts",
    "migrate": "tsx scripts/migrate.ts"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cookie-session": "^2.1.1",
    "dotenv": "^17.4.2",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.6.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "jalaali-js": "^2.0.0",
    "lru-cache": "^11.5.2",
    "moment-hijri": "^3.0.0",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "socket.io": "^4.8.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-session": "^2.0.49",
    "@types/express": "^4.17.21",
    "@types/hpp": "^0.2.7",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.12.12",
    "@types/supertest": "^6.0.3",
    "esbuild": "^0.21.3",
    "supertest": "^7.2.2",
    "tsx": "^4.10.5",
    "typescript": "^5.4.5"
  },
  "optionalDependencies": {
    "firebase-admin": "^14.2.0"
  },
  "engines": {
    "node": ">=18.18"
  },
  "private": true
}
